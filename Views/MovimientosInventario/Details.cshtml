@model WebApplication1.Models.MovimientoInventario

@{
    ViewData["Title"] = "Detalle del movimiento";

    var cantidad = Model.Cantidad;
    var costo = Model.CostoUnitario ?? 0;
    var total = cantidad * costo;

    var tipoMovimiento =
        Model.IdTipoMovimientoInventarioNavigation?.Nombre
        ?? "Sin tipo";

    var insumo =
        Model.IdInsumoNavigation?.Nombre
        ?? "Sin insumo";

    var codigoInsumo =
        Model.IdInsumoNavigation?.CodigoInsumo
        ?? "—";

    var ubicacion =
        Model.IdUbicacionNavigation?.Nombre
        ?? "Sin ubicación";

    var codigoLote =
        Model.IdLoteNavigation?.CodigoLote
        ?? "Sin lote";

    var usuario =
        (
            (Model.IdUsuarioNavigation?.Nombres ?? "") +
            " " +
            (Model.IdUsuarioNavigation?.Apellidos ?? "")
        ).Trim();

    if (string.IsNullOrWhiteSpace(usuario))
    {
        usuario = "Usuario no disponible";
    }

    var esEntrada =
        tipoMovimiento.Contains(
            "entrada",
            StringComparison.OrdinalIgnoreCase)
        ||
        tipoMovimiento.Contains(
            "compra",
            StringComparison.OrdinalIgnoreCase)
        ||
        tipoMovimiento.Contains(
            "ingreso",
            StringComparison.OrdinalIgnoreCase)
        ||
        tipoMovimiento.Contains(
            "recepción",
            StringComparison.OrdinalIgnoreCase)
        ||
        tipoMovimiento.Contains(
            "recepcion",
            StringComparison.OrdinalIgnoreCase);

    var esSalida =
        tipoMovimiento.Contains(
            "salida",
            StringComparison.OrdinalIgnoreCase)
        ||
        tipoMovimiento.Contains(
            "consumo",
            StringComparison.OrdinalIgnoreCase)
        ||
        tipoMovimiento.Contains(
            "merma",
            StringComparison.OrdinalIgnoreCase)
        ||
        tipoMovimiento.Contains(
            "despacho",
            StringComparison.OrdinalIgnoreCase)
        ||
        tipoMovimiento.Contains(
            "egreso",
            StringComparison.OrdinalIgnoreCase);

    var claseMovimiento =
        esEntrada
            ? "success"
            : esSalida
                ? "danger"
                : "warning";

    var iconoMovimiento =
        esEntrada
            ? "bi-arrow-down-circle"
            : esSalida
                ? "bi-arrow-up-circle"
                : "bi-sliders";

}

<div class="container-fluid">
    <!-- ========================================================= -->
    <!-- ENCABEZADO -->
    <!-- ========================================================= -->

    <div class="d-flex flex-column flex-md-row
        justify-content-between
        align-items-md-center
        gap-3
        mb-4">

        <div>

            <div class="d-flex align-items-center gap-2 mb-2">

                <a asp-controller="MovimientosInventario"
                   asp-action="Index"
                   class="btn btn-sm btn-light">

                    <i class="bi bi-arrow-left"></i>

                    Volver

                </a>

            </div>

            <h1 class="h3 mb-1 fw-bold">

                Detalle del movimiento

            </h1>

            <p class="text-muted mb-0">

                Información completa del movimiento
                de inventario registrado.

            </p>

        </div>

        <!-- ===================================================== -->
        <!-- ACCIONES -->
        <!-- ===================================================== -->

        <div class="d-flex flex-wrap gap-2">

            <!-- AJUSTE -->

            <a asp-controller="MovimientosInventario"
               asp-action="Ajuste"
               asp-route-id="@Model.IdMovimientoInventario"
               class="btn btn-warning">

                <i class="bi bi-sliders me-1"></i>

                Ajustar movimiento

            </a>

            <!-- VOLVER -->

            <a asp-controller="MovimientosInventario"
               asp-action="Index"
               class="btn btn-primary">

                <i class="bi bi-list-ul me-1"></i>

                Historial

            </a>

        </div>

    </div>

    <!-- ========================================================= -->
    <!-- MENSAJES -->
    <!-- ========================================================= -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["Mensaje"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-triangle me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <!-- ========================================================= -->
    <!-- IDENTIFICACIÓN -->
    <!-- ========================================================= -->

    <div class="card border-0 mb-4">

        <div class="card-body p-4">

            <div class="row align-items-center">

                <div class="col-lg-8">

                    <div class="d-flex
                        align-items-center
                        gap-3">

                        <div class="rounded-circle
                            bg-primary-subtle
                            text-primary
                            d-flex
                            align-items-center
                            justify-content-center"
                             style="width:64px;height:64px;">

                            <i class="bi @iconoMovimiento fs-2"></i>

                        </div>

                        <div>

                            <div class="text-muted small">

                                MOVIMIENTO DE INVENTARIO

                            </div>

                            <h2 class="h4 mb-1 fw-bold">

                                Movimiento
                                #@Model.IdMovimientoInventario

                            </h2>

                            <div class="text-muted">

                                @Model.FechaMovimiento.ToString(
                                    "dd/MM/yyyy HH:mm")

                            </div>

                        </div>

                    </div>

                </div>

                <div class="col-lg-4 mt-3 mt-lg-0 text-lg-end">

                    <span class="badge
                        bg-@claseMovimiento
                        fs-6
                        px-3
                        py-2">

                        <i class="bi @iconoMovimiento me-1"></i>

                        @tipoMovimiento

                    </span>

                </div>

            </div>

        </div>

    </div>

    <!-- ========================================================= -->
    <!-- INFORMACIÓN PRINCIPAL -->
    <!-- ========================================================= -->

    <div class="row g-4">

        <!-- ===================================================== -->
        <!-- INSUMO -->
        <!-- ===================================================== -->

        <div class="col-lg-6">

            <div class="card border-0 h-100">

                <div class="card-header py-3">

                    <h5 class="mb-0">

                        <i class="bi bi-box-seam me-2 text-primary"></i>

                        Insumo

                    </h5>

                </div>

                <div class="card-body">

                    <div class="mb-3">

                        <div class="text-muted small mb-1">

                            Código

                        </div>

                        <div class="fw-semibold">

                            @codigoInsumo

                        </div>

                    </div>

                    <div class="mb-3">

                        <div class="text-muted small mb-1">

                            Nombre

                        </div>

                        <div class="fw-semibold">

                            @insumo

                        </div>

                    </div>

                    <div>

                        <div class="text-muted small mb-1">

                            Ubicación

                        </div>

                        <div class="fw-semibold">

                            <i class="bi bi-geo-alt me-1 text-primary"></i>

                            @ubicacion

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- ===================================================== -->
        <!-- LOTE -->
        <!-- ===================================================== -->

        <div class="col-lg-6">

            <div class="card border-0 h-100">

                <div class="card-header py-3">

                    <h5 class="mb-0">

                        <i class="bi bi-upc-scan me-2 text-primary"></i>

                        Lote

                    </h5>

                </div>

                <div class="card-body">

                    <div class="mb-3">

                        <div class="text-muted small mb-1">

                            Código de lote

                        </div>

                        <div class="fw-semibold">

                            @codigoLote

                        </div>

                    </div>

                    @if (Model.IdLoteNavigation != null)
                    {
                        <div class="mb-3">

                            <div class="text-muted small mb-1">

                                Identificador del lote

                            </div>

                            <div class="fw-semibold">

                                #@Model.IdLote

                            </div>

                        </div>

                        @if (Model.IdLoteNavigation.FechaRegistro != default)
                        {
                            <div>

                                <div class="text-muted small mb-1">

                                    Fecha de registro

                                </div>

                                <div class="fw-semibold">

                                    @Model.IdLoteNavigation
                                    .FechaRegistro
                                    .ToString("dd/MM/yyyy")

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-light mb-0">

                            <i class="bi bi-info-circle me-1"></i>

                            Este movimiento no está asociado
                            a un lote específico.

                        </div>
                    }

                </div>

            </div>

        </div>

        <!-- ===================================================== -->
        <!-- CANTIDAD Y COSTO -->
        <!-- ===================================================== -->

        <div class="col-lg-6">

            <div class="card border-0 h-100">

                <div class="card-header py-3">

                    <h5 class="mb-0">

                        <i class="bi bi-calculator me-2 text-primary"></i>

                        Cantidad y costo

                    </h5>

                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <div class="border rounded p-3">

                                <div class="text-muted small mb-1">

                                    Cantidad

                                </div>

                                <div class="fs-4 fw-bold">

                                    @cantidad.ToString("N2")

                                </div>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="border rounded p-3">

                                <div class="text-muted small mb-1">

                                    Costo unitario

                                </div>

                                <div class="fs-4 fw-bold">

                                    @if (Model.CostoUnitario.HasValue)
                                    {
                                        @costo.ToString("N2")
                                    }
                                    else
                                    {
                                        <span class="text-muted">

                                            No especificado

                                        </span>
                                    }

                                </div>

                            </div>

                        </div>

                        <div class="col-12">

                            <div class="border rounded p-3
                                bg-primary-subtle">

                                <div class="text-muted small mb-1">

                                    Valor del movimiento

                                </div>

                                <div class="fs-3 fw-bold text-primary">

                                    @if (Model.CostoUnitario.HasValue)
                                    {
                                        @total.ToString("N2")
                                    }
                                    else
                                    {
                                        <span>

                                            No calculado

                                        </span>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- ===================================================== -->
        <!-- TIPO Y FECHA -->
        <!-- ===================================================== -->

        <div class="col-lg-6">

            <div class="card border-0 h-100">

                <div class="card-header py-3">

                    <h5 class="mb-0">

                        <i class="bi bi-clock-history me-2 text-primary"></i>

                        Información del movimiento

                    </h5>

                </div>

                <div class="card-body">

                    <div class="mb-3">

                        <div class="text-muted small mb-1">

                            Tipo de movimiento

                        </div>

                        <span class="badge
                            bg-@claseMovimiento
                            px-3
                            py-2">

                            @tipoMovimiento

                        </span>

                    </div>

                    <div class="mb-3">

                        <div class="text-muted small mb-1">

                            Fecha y hora

                        </div>

                        <div class="fw-semibold">

                            @Model.FechaMovimiento.ToString(
                                "dd/MM/yyyy HH:mm:ss")

                        </div>

                    </div>

                    <div>

                        <div class="text-muted small mb-1">

                            ID del movimiento

                        </div>

                        <div class="fw-semibold">

                            #@Model.IdMovimientoInventario

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- ===================================================== -->
        <!-- REFERENCIA -->
        <!-- ===================================================== -->

        <div class="col-lg-6">

            <div class="card border-0 h-100">

                <div class="card-header py-3">

                    <h5 class="mb-0">

                        <i class="bi bi-link-45deg me-2 text-primary"></i>

                        Referencia

                    </h5>

                </div>

                <div class="card-body">

                    @if (!string.IsNullOrWhiteSpace(Model.Referencia))
                    {
                        <div class="fw-semibold">

                            @Model.Referencia

                        </div>
                    }
                    else
                    {
                        <div class="text-muted">

                            No se especificó una referencia.

                        </div>
                    }

                </div>

            </div>

        </div>

        <!-- ===================================================== -->
        <!-- USUARIO -->
        <!-- ===================================================== -->

        <div class="col-lg-6">

            <div class="card border-0 h-100">

                <div class="card-header py-3">

                    <h5 class="mb-0">

                        <i class="bi bi-person me-2 text-primary"></i>

                        Usuario que registró

                    </h5>

                </div>

                <div class="card-body">

                    <div class="d-flex
                        align-items-center
                        gap-3">

                        <div class="rounded-circle
                            bg-primary
                            text-white
                            d-flex
                            align-items-center
                            justify-content-center"
                             style="width:48px;height:48px;">

                            <i class="bi bi-person-fill"></i>

                        </div>

                        <div>

                            <div class="fw-semibold">

                                @usuario

                            </div>

                            <div class="text-muted small">

                                ID usuario: @Model.IdUsuario

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- ===================================================== -->
        <!-- DESCRIPCIÓN -->
        <!-- ===================================================== -->

        <div class="col-12">

            <div class="card border-0">

                <div class="card-header py-3">

                    <h5 class="mb-0">

                        <i class="bi bi-card-text me-2 text-primary"></i>

                        Descripción

                    </h5>

                </div>

                <div class="card-body">

                    @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
                    {
                        <p class="mb-0"
                           style="white-space: pre-line;">

                            @Model.Descripcion

                        </p>
                    }
                    else
                    {
                        <p class="text-muted mb-0">

                            No se proporcionó una descripción
                            para este movimiento.

                        </p>
                    }

                </div>

            </div>

        </div>

    </div>

    <!-- ========================================================= -->
    <!-- AVISO DE HISTORIAL -->
    <!-- ========================================================= -->

    <div class="alert alert-info mt-4">

        <div class="d-flex gap-3">

            <div>

                <i class="bi bi-info-circle-fill fs-4"></i>

            </div>

            <div>

                <div class="fw-semibold mb-1">

                    Historial protegido

                </div>

                <div>

                    Los movimientos registrados no se editan
                    ni se eliminan. Si necesitas corregir este
                    movimiento, utiliza

                    <strong>Ajustar movimiento</strong>.

                    El sistema registrará un nuevo movimiento
                    para conservar la trazabilidad del inventario.

                </div>

            </div>

        </div>

    </div>

    <!-- ========================================================= -->
    <!-- BOTONES INFERIORES -->
    <!-- ========================================================= -->

    <div class="d-flex
        justify-content-between
        align-items-center
        flex-wrap
        gap-2
        mt-4
        pb-4">

        <a asp-controller="MovimientosInventario"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>

            Volver al historial

        </a>

        <a asp-controller="MovimientosInventario"
           asp-action="Ajuste"
           asp-route-id="@Model.IdMovimientoInventario"
           class="btn btn-warning">

            <i class="bi bi-sliders me-1"></i>

            Ajustar movimiento

        </a>

    </div>

</div>
@model WebApplication1.ViewModels.EntradaInventarioViewModel

@{
    ViewData["Title"] = "Movimiento de inventario";
}

<div class="container">

    <div class="mb-4">

        <h1 class="h3">
            Movimiento de inventario
        </h1>

        <p class="text-muted">
            Registra una entrada de inventario.
        </p>

    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Entrada"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="row g-3">

                    <div class="col-md-6">

                        <label asp-for="IdInsumo"
                               class="form-label">
                            Insumo
                        </label>

                        <select asp-for="IdInsumo"
                                asp-items="ViewBag.Insumos"
                                class="form-select">

                            <option value="">
                                -- Seleccione un insumo --
                            </option>

                        </select>

                        <span asp-validation-for="IdInsumo"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="IdUbicacion"
                               class="form-label">
                            Ubicación
                        </label>

                        <select asp-for="IdUbicacion"
                                asp-items="ViewBag.Ubicaciones"
                                class="form-select">

                            <option value="">
                                -- Seleccione una ubicación --
                            </option>

                        </select>

                        <span asp-validation-for="IdUbicacion"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-4">

                        <label asp-for="Cantidad"
                               class="form-label">
                            Cantidad
                        </label>

                        <input asp-for="Cantidad"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control" />

                        <span asp-validation-for="Cantidad"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-4">

                        <label asp-for="CostoUnitario"
                               class="form-label">
                            Costo unitario
                        </label>

                        <input asp-for="CostoUnitario"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control" />

                        <span asp-validation-for="CostoUnitario"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-4">

                        <label asp-for="CodigoLote"
                               class="form-label">
                            Código de lote
                        </label>

                        <input asp-for="CodigoLote"
                               class="form-control"
                               maxlength="50" />

                    </div>

                    <div class="col-md-6">

                        <label asp-for="FechaFabricacion"
                               class="form-label">
                            Fecha de fabricación
                        </label>

                        <input asp-for="FechaFabricacion"
                               type="date"
                               class="form-control" />

                    </div>

                    <div class="col-md-6">

                        <label asp-for="FechaVencimiento"
                               class="form-label">
                            Fecha de vencimiento
                        </label>

                        <input asp-for="FechaVencimiento"
                               type="date"
                               class="form-control" />

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Referencia"
                               class="form-label">
                            Referencia
                        </label>

                        <input asp-for="Referencia"
                               class="form-control"
                               maxlength="50"
                               placeholder="Ej. COMP-00015" />

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Observacion"
                               class="form-label">
                            Observación
                        </label>

                        <input asp-for="Observacion"
                               class="form-control"
                               maxlength="250" />

                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-success">

                        <i class="bi bi-box-arrow-in-down"></i>
                        Registrar entrada

                    </button>

                    <a asp-controller="Inventario"
                       asp-action="Index"
                       class="btn btn-secondary">

                        Cancelar

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
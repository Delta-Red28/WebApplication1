@model WebApplication1.Models.MovimientoInventario

@{
    ViewData["Title"] = "Ajuste de movimiento";

    var movimientoOriginal =
        ViewBag.MovimientoOriginal
        as WebApplication1.Models.MovimientoInventario;

    var nombreInsumo =
        movimientoOriginal?.IdInsumoNavigation?.Nombre
        ?? Model.IdInsumoNavigation?.Nombre
        ?? "Sin información";

    var codigoInsumo =
        movimientoOriginal?.IdInsumoNavigation?.CodigoInsumo
        ?? Model.IdInsumoNavigation?.CodigoInsumo;

    var nombreUbicacion =
        movimientoOriginal?.IdUbicacionNavigation?.Nombre
        ?? Model.IdUbicacionNavigation?.Nombre
        ?? "Sin información";

    var tipoOriginal =
        movimientoOriginal?.IdTipoMovimientoInventarioNavigation?.Nombre
        ?? Model.IdTipoMovimientoInventarioNavigation?.Nombre
        ?? "Sin información";

    var loteOriginal =
        movimientoOriginal?.IdLoteNavigation?.CodigoLote
        ?? Model.IdLoteNavigation?.CodigoLote;


}

<div class="container-fluid">
    <!-- ========================================================= -->
    <!-- ENCABEZADO -->
    <!-- ========================================================= -->

    <div class="d-flex flex-column flex-md-row
        justify-content-between
        align-items-md-center
        gap-3 mb-4">

        <div>

            <div class="d-flex align-items-center gap-2 mb-2">

                <a asp-action="Details"
                   asp-route-id="@Model.IdMovimientoInventario"
                   class="btn btn-light border">

                    <i class="bi bi-arrow-left"></i>

                </a>

                <h2 class="mb-0 fw-bold">

                    Ajuste de movimiento

                </h2>

            </div>

            <p class="text-muted mb-0">

                Registra un nuevo movimiento para corregir el movimiento original.

            </p>

        </div>


        <div>

            <span class="badge bg-warning text-dark fs-6 px-3 py-2">

                <i class="bi bi-exclamation-triangle me-1"></i>

                Ajuste

            </span>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- AVISO -->
    <!-- ========================================================= -->

    <div class="alert alert-warning border-0 rounded-4 shadow-sm mb-4">

        <div class="d-flex gap-3">

            <div class="fs-4">

                <i class="bi bi-info-circle"></i>

            </div>

            <div>

                <h6 class="fw-bold mb-1">

                    El movimiento original no será modificado

                </h6>

                <p class="mb-0">

                    Los movimientos de inventario forman parte del historial.
                    Este ajuste generará un nuevo movimiento que compensará
                    o corregirá el movimiento seleccionado.

                </p>

            </div>

        </div>

    </div>


    <div class="row g-4">


        <!-- ===================================================== -->
        <!-- MOVIMIENTO ORIGINAL -->
        <!-- ===================================================== -->

        <div class="col-12 col-xl-5">

            <div class="card border-0 rounded-4 shadow-sm">

                <div class="card-header
                    border-0
                    rounded-top-4
                    py-3">

                    <div class="d-flex align-items-center gap-2">

                        <i class="bi bi-clock-history
                        text-primary fs-5"></i>

                        <h5 class="mb-0 fw-bold">

                            Movimiento original

                        </h5>

                    </div>

                </div>


                <div class="card-body">


                    <!-- ID -->

                    <div class="mb-3">

                        <label class="small text-muted">

                            ID del movimiento

                        </label>

                        <div class="fw-bold">

                            #@Model.IdMovimientoInventario

                        </div>

                    </div>


                    <!-- FECHA -->

                    <div class="mb-3">

                        <label class="small text-muted">

                            Fecha

                        </label>

                        <div class="fw-semibold">

                            <i class="bi bi-calendar3 me-1"></i>

                            @Model.FechaMovimiento.ToString("dd/MM/yyyy HH:mm")

                        </div>

                    </div>


                    <!-- INSUMO -->

                    <div class="mb-3">

                        <label class="small text-muted">

                            Insumo

                        </label>

                        <div class="fw-semibold">

                            @nombreInsumo

                        </div>

                        @if (!string.IsNullOrWhiteSpace(codigoInsumo))
                        {
                            <small class="text-muted">

                                Código: @codigoInsumo

                            </small>
                        }

                    </div>


                    <!-- UBICACIÓN -->

                    <div class="mb-3">

                        <label class="small text-muted">

                            Ubicación

                        </label>

                        <div class="fw-semibold">

                            <i class="bi bi-geo-alt me-1"></i>

                            @nombreUbicacion

                        </div>

                    </div>


                    <!-- TIPO -->

                    <div class="mb-3">

                        <label class="small text-muted">

                            Tipo de movimiento

                        </label>

                        <div>

                            <span class="badge bg-secondary">

                                @tipoOriginal

                            </span>

                        </div>

                    </div>


                    <!-- LOTE -->

                    <div class="mb-3">

                        <label class="small text-muted">

                            Lote

                        </label>

                        <div class="fw-semibold">

                            @if (!string.IsNullOrWhiteSpace(loteOriginal))
                            {
                                <i class="bi bi-box-seam me-1"></i>

                                @loteOriginal
                            }
                            else
                            {
                                <span class="text-muted">

                                    Sin lote

                                </span>
                            }

                        </div>

                    </div>


                    <!-- CANTIDAD -->

                    <div class="p-3 rounded-3 bg-light border">

                        <div class="small text-muted">

                            Cantidad original

                        </div>

                        <div class="fs-3 fw-bold text-primary">

                            @Model.Cantidad.ToString("N2")

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- NUEVO AJUSTE -->
        <!-- ===================================================== -->

        <div class="col-12 col-xl-7">

            <div class="card border-0 rounded-4 shadow-sm">

                <div class="card-header
                    border-0
                    rounded-top-4
                    py-3">

                    <div class="d-flex align-items-center gap-2">

                        <i class="bi bi-sliders
                        text-primary fs-5"></i>

                        <h5 class="mb-0 fw-bold">

                            Registrar ajuste

                        </h5>

                    </div>

                </div>


                <div class="card-body">

                    <form asp-action="Ajuste"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="IdMovimientoInventario" />


                        <!-- ================================================= -->
                        <!-- TIPO DE AJUSTE -->
                        <!-- ================================================= -->

                        <div class="mb-4">

                            <label class="form-label fw-semibold">

                                Tipo de ajuste

                            </label>

                            <select name="tipoAjuste"
                                    class="form-select"
                                    required>

                                <option value="">

                                    Seleccione una opción

                                </option>

                                <option value="CorreccionEntrada">

                                    Corrección de entrada

                                </option>

                                <option value="CorreccionSalida">

                                    Corrección de salida

                                </option>

                            </select>

                            <div class="form-text">

                                Selecciona si deseas compensar una entrada
                                o una salida registrada anteriormente.

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- CANTIDAD -->
                        <!-- ================================================= -->

                        <div class="mb-4">

                            <label class="form-label fw-semibold">

                                Cantidad a ajustar

                            </label>

                            <div class="input-group">

                                <span class="input-group-text">

                                    <i class="bi bi-box-seam"></i>

                                </span>

                                <input name="cantidadAjuste"
                                       type="number"
                                       class="form-control"
                                       min="0.01"
                                       step="0.01"
                                       value="@Model.Cantidad"
                                       required />

                            </div>

                            <div class="form-text">

                                Puedes introducir una cantidad menor,
                                igual o diferente a la original.

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- REFERENCIA -->
                        <!-- ================================================= -->

                        <div class="mb-4">

                            <label class="form-label fw-semibold">

                                Referencia

                            </label>

                            <input name="referenciaAjuste"
                                   type="text"
                                   class="form-control"
                                   maxlength="50"
                                   value="Ajuste movimiento #@Model.IdMovimientoInventario"
                                   required />

                        </div>


                        <!-- ================================================= -->
                        <!-- DESCRIPCIÓN -->
                        <!-- ================================================= -->

                        <div class="mb-4">

                            <label class="form-label fw-semibold">

                                Motivo del ajuste

                            </label>

                            <textarea name="descripcionAjuste"
                                      class="form-control"
                                      rows="4"
                                      maxlength="250"
                                      placeholder="Indique el motivo por el cual se realiza el ajuste..."
                                      required></textarea>

                            <div class="form-text">

                                El motivo quedará registrado en el historial.

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- CONFIRMACIÓN -->
                        <!-- ================================================= -->

                        <div class="alert alert-light border rounded-3">

                            <div class="form-check">

                                <input class="form-check-input"
                                       type="checkbox"
                                       id="confirmarAjuste"
                                       required />

                                <label class="form-check-label"
                                       for="confirmarAjuste">

                                    Confirmo que la información del ajuste
                                    es correcta y entiendo que se generará
                                    un nuevo movimiento en el historial.

                                </label>

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- BOTONES -->
                        <!-- ================================================= -->

                        <div class="d-flex
                            flex-column
                            flex-sm-row
                            justify-content-end
                            gap-2">

                            <a asp-action="Details"
                               asp-route-id="@Model.IdMovimientoInventario"
                               class="btn btn-light border">

                                <i class="bi bi-x-lg me-1"></i>

                                Cancelar

                            </a>


                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-check-lg me-1"></i>

                                Registrar ajuste

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
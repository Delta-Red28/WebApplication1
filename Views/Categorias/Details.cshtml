@model WebApplication1.Models.Categorium

@{
    ViewData["Title"] = "Detalle de categoría";

    var productos = Model.Productos ?? new List<WebApplication1.Models.Producto>();

    var totalProductos = productos.Count();

    var productosActivos = productos.Count(p => p.Estado);

    var productosInactivos = totalProductos - productosActivos;
}

<div class="container-fluid">

    <!-- ============================================================
         ENCABEZADO
         ============================================================ -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-tags-fill text-primary me-2"></i>

                @Model.Nombre

            </h2>

            <p class="text-muted mb-0">

                Detalle de la categoría y sus platillos

            </p>

        </div>


        <div class="d-flex gap-2">

            <!-- EDITAR CATEGORÍA -->

            <a asp-action="Edit"
               asp-route-id="@Model.IdCategoria"
               class="btn btn-primary">

                <i class="bi bi-pencil me-1"></i>

                Editar

            </a>


            <!-- VOLVER -->

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>

                Volver

            </a>

        </div>

    </div>


    <!-- ============================================================
         INFORMACIÓN DE LA CATEGORÍA
         ============================================================ -->

    <div class="row g-4 mb-4">


        <!-- INFORMACIÓN PRINCIPAL -->

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex align-items-start">


                        <!-- ICONO -->

                        <div class="rounded-3
                            bg-primary
                            bg-opacity-10
                            text-primary
                            p-3
                            me-3">

                            <i class="bi bi-egg-fried fs-2"></i>

                        </div>


                        <!-- INFORMACIÓN -->

                        <div class="flex-grow-1">

                            <div class="d-flex
                                justify-content-between
                                align-items-start">

                                <div>

                                    <h3 class="fw-bold mb-1">

                                        @Model.Nombre

                                    </h3>

                                    <small class="text-muted">

                                        Categoría #@Model.IdCategoria

                                    </small>

                                </div>


                                <!-- ESTADO -->
                                @if (Model.Estado)
                                {
                                    <span class="badge rounded-pill
                                        bg-success-subtle
                                        text-success">

                                        <i class="bi bi-check-circle me-1"></i>

                                        Activa

                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill
                                        bg-secondary-subtle
                                        text-secondary">

                                        <i class="bi bi-pause-circle me-1"></i>

                                        Inactiva

                                    </span>
                                }

                            </div>

                        </div>

                    </div>


                    <hr class="my-4" />


                    <!-- DESCRIPCIÓN -->

                    <div class="mb-4">

                        <div class="text-muted small mb-2">

                            Descripción

                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
                        {
                            <p class="mb-0">

                                @Model.Descripcion

                            </p>
                        }
                        else
                        {
                            <p class="text-muted fst-italic mb-0">

                                Esta categoría no tiene descripción.

                            </p>
                        }

                    </div>


                    <!-- DATOS -->

                    <div class="row g-3">

                        <div class="col-md-6">

                            <div class="border rounded p-3">

                                <div class="text-muted small mb-1">

                                    ID de categoría

                                </div>

                                <div class="fw-bold">

                                    #@Model.IdCategoria

                                </div>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="border rounded p-3">

                                <div class="text-muted small mb-1">

                                    Fecha de registro

                                </div>

                                <div class="fw-bold">

                                    @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ========================================================
             ESTADO DE CATEGORÍA
             ======================================================== -->

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-3">

                        Estado de la categoría

                    </h5>


                    @if (Model.Estado)
                    {
                        <div class="alert alert-success">

                            <div class="d-flex">

                                <i class="bi bi-check-circle-fill me-2 mt-1"></i>

                                <div>

                                    <strong>Categoría activa</strong>

                                    <div class="small mt-1">

                                        La categoría está disponible
                                        actualmente.

                                    </div>

                                </div>

                            </div>

                        </div>


                        <form asp-action="Desactivar"
                              asp-route-id="@Model.IdCategoria"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-danger w-100"
                                    onclick="return confirm('¿Deseas desactivar esta categoría?');">

                                <i class="bi bi-pause-circle me-1"></i>

                                Desactivar categoría

                            </button>

                        </form>
                    }
                    else
                    {
                        <div class="alert alert-secondary">

                            <div class="d-flex">

                                <i class="bi bi-pause-circle-fill me-2 mt-1"></i>

                                <div>

                                    <strong>Categoría inactiva</strong>

                                    <div class="small mt-1">

                                        Esta categoría está desactivada.

                                    </div>

                                </div>

                            </div>

                        </div>


                        <form asp-action="Activar"
                              asp-route-id="@Model.IdCategoria"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-success w-100">

                                <i class="bi bi-check-circle me-1"></i>

                                Activar categoría

                            </button>

                        </form>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- ============================================================
         RESUMEN DE PRODUCTOS
         ============================================================ -->

    <div class="row g-3 mb-4">


        <!-- TOTAL -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="rounded-circle
                        bg-primary
                        bg-opacity-10
                        text-primary
                        p-3
                        me-3">

                        <i class="bi bi-egg-fried fs-4"></i>

                    </div>

                    <div>

                        <div class="text-muted small">

                            Total de platillos

                        </div>

                        <div class="fs-4 fw-bold">

                            @totalProductos

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ACTIVOS -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="rounded-circle
                        bg-success
                        bg-opacity-10
                        text-success
                        p-3
                        me-3">

                        <i class="bi bi-check-circle-fill fs-4"></i>

                    </div>

                    <div>

                        <div class="text-muted small">

                            Platillos activos

                        </div>

                        <div class="fs-4 fw-bold text-success">

                            @productosActivos

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- INACTIVOS -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="rounded-circle
                        bg-secondary
                        bg-opacity-10
                        text-secondary
                        p-3
                        me-3">

                        <i class="bi bi-pause-circle-fill fs-4"></i>

                    </div>

                    <div>

                        <div class="text-muted small">

                            Platillos inactivos

                        </div>

                        <div class="fs-4 fw-bold text-secondary">

                            @productosInactivos

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ============================================================
         PLATILLOS DE LA CATEGORÍA
         ============================================================ -->

    <div class="card border-0 shadow-sm">

        <!-- CABECERA -->

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex
                justify-content-between
                align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">

                        <i class="bi bi-egg-fried text-primary me-2"></i>

                        Platillos de @Model.Nombre

                    </h5>

                    <small class="text-muted">

                        Productos registrados dentro de esta categoría.

                    </small>

                </div>


                <div class="d-flex align-items-center gap-2">

                    <span class="badge bg-primary-subtle text-primary">

                        @totalProductos
                        @(totalProductos == 1 ? "platillo" : "platillos")

                    </span>


                    <!-- =================================================
                         NUEVO PLATILLO
                         ================================================= -->

                    <a asp-controller="Productos"
                       asp-action="Create"
                       asp-route-idCategoria="@Model.IdCategoria"
                       class="btn btn-primary">

                        <i class="bi bi-plus-lg me-1"></i>

                        Nuevo platillo

                    </a>

                </div>

            </div>

        </div>


        <!-- ============================================================
             CONTENIDO
             ============================================================ -->

        <div class="card-body">

            @if (productos.Any())
            {
                <div class="row g-4">

                    @foreach (var producto in productos)
                    {
                        <div class="col-xl-4 col-lg-6">

                            <div class="card
                                border
                                h-100
                                product-card">


                                <!-- =================================================
                                     IMAGEN
                                     ================================================= -->
                                @if (!string.IsNullOrWhiteSpace(producto.Imagen))
                                {
                                    <div class="product-image-container">

                                        <img src="@producto.Imagen"
                                             alt="@producto.Nombre"
                                             class="product-image" />

                                    </div>
                                }
                                else
                                {
                                    <div class="product-image-placeholder">

                                        <i class="bi bi-image fs-1"></i>

                                        <span>
                                            Sin imagen
                                        </span>

                                    </div>
                                }


                                <!-- =================================================
                                     CUERPO
                                     ================================================= -->

                                <div class="card-body">


                                    <!-- ESTADO -->

                                    <div class="d-flex
                                        justify-content-between
                                        align-items-start
                                        mb-2">

                                        @if (producto.Estado)
                                        {
                                            <span class="badge rounded-pill
                                                bg-success-subtle
                                                text-success">

                                                <i class="bi bi-check-circle me-1"></i>

                                                Activo

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill
                                                bg-secondary-subtle
                                                text-secondary">

                                                <i class="bi bi-pause-circle me-1"></i>

                                                Inactivo

                                            </span>
                                        }


                                        <!-- ESTADO DEL PRODUCTO -->
                                        @if (producto.IdEstadoProductoNavigation != null)
                                        {
                                            <span class="badge bg-light text-dark border">

                                                @producto.IdEstadoProductoNavigation.Nombre

                                            </span>
                                        }

                                    </div>


                                    <!-- NOMBRE -->

                                    <h5 class="fw-bold mb-1">

                                        @producto.Nombre

                                    </h5>


                                    <!-- CÓDIGO -->

                                    <small class="text-muted">

                                        Código:
                                        @producto.CodigoProducto

                                    </small>


                                    <!-- DESCRIPCIÓN -->
                                    @if (!string.IsNullOrWhiteSpace(producto.Descripcion))
                                    {
                                        <p class="text-muted small mt-3 mb-3">

                                            @producto.Descripcion

                                        </p>
                                    }
                                    else
                                    {
                                        <p class="text-muted small fst-italic mt-3 mb-3">

                                            Sin descripción.

                                        </p>
                                    }


                                    <!-- PRECIO Y PREPARACIÓN -->

                                    <div class="d-flex
                                        justify-content-between
                                        align-items-center
                                        mb-3">

                                        <div>

                                            <div class="text-muted small">

                                                Precio

                                            </div>

                                            <div class="fs-5
                                                fw-bold
                                                text-primary">

                                                C$
                                                @producto.PrecioVenta.ToString("N2")

                                            </div>

                                        </div>


                                        @if (producto.TiempoPreparacion.HasValue)
                                        {
                                            <div class="text-end">

                                                <div class="text-muted small">

                                                    Preparación

                                                </div>

                                                <div class="fw-semibold">

                                                    <i class="bi bi-clock me-1"></i>

                                                    @producto.TiempoPreparacion min

                                                </div>

                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-end">

                                                <div class="text-muted small">

                                                    Preparación

                                                </div>

                                                <div class="text-muted">

                                                    No definida

                                                </div>

                                            </div>
                                        }

                                    </div>


                                    <!-- INFORMACIÓN ADICIONAL -->

                                    <div class="border-top pt-3">

                                        <div class="small text-muted mb-2">

                                            <i class="bi bi-upc me-1"></i>

                                            Código:
                                            <strong>
                                                @producto.CodigoProducto
                                            </strong>

                                        </div>


                                        @if (producto.ControlaInventario)
                                        {
                                            <div class="small text-success">

                                                <i class="bi bi-box-seam me-1"></i>

                                                Controla inventario

                                            </div>
                                        }
                                        else
                                        {
                                            <div class="small text-muted">

                                                <i class="bi bi-box-seam me-1"></i>

                                                No controla inventario

                                            </div>
                                        }

                                    </div>

                                </div>


                                <!-- =================================================
                                     ACCIONES
                                     ================================================= -->

                                <div class="card-footer
                                    bg-white
                                    border-0
                                    pt-0
                                    pb-3">

                                    <div class="d-flex gap-2">


                                        <!-- VER -->

                                        <a asp-controller="Productos"
                                           asp-action="Details"
                                           asp-route-id="@producto.IdProducto"
                                           class="btn btn-sm
                                            btn-outline-secondary
                                            flex-fill">

                                            <i class="bi bi-eye me-1"></i>

                                            Ver

                                        </a>


                                        <!-- EDITAR -->

                                        <a asp-controller="Productos"
                                           asp-action="Edit"
                                           asp-route-id="@producto.IdProducto"
                                           class="btn btn-sm
                                            btn-outline-primary
                                            flex-fill">

                                            <i class="bi bi-pencil me-1"></i>

                                            Editar

                                        </a>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <!-- ========================================================
                     SIN PRODUCTOS
                     ======================================================== -->

                <div class="text-center py-5">

                    <div class="rounded-circle
                        bg-primary
                        bg-opacity-10
                        text-primary
                        d-inline-flex
                        align-items-center
                        justify-content-center
                        p-4
                        mb-3">

                        <i class="bi bi-egg-fried fs-1"></i>

                    </div>


                    <h5 class="fw-bold">

                        No hay platillos en esta categoría

                    </h5>


                    <p class="text-muted mb-4">

                        Todavía no existen productos registrados
                        dentro de <strong>@Model.Nombre</strong>.

                    </p>


                    <!-- NUEVO PLATILLO -->

                    <a asp-controller="Productos"
                       asp-action="Create"
                       asp-route-idCategoria="@Model.IdCategoria"
                       class="btn btn-primary">

                        <i class="bi bi-plus-lg me-1"></i>

                        Crear primer platillo

                    </a>

                </div>
            }

        </div>

    </div>

</div>


<!-- ============================================================
     ESTILOS
     ============================================================ -->

<style>

    .product-card {
        transition: all 0.2s ease;
        overflow: hidden;
    }

        .product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 .4rem 1rem rgba(0, 0, 0, .10);
        }

    .product-image-container {
        width: 100%;
        height: 190px;
        overflow: hidden;
        background-color: #f8f9fa;
    }

    .product-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .product-image-placeholder {
        width: 100%;
        height: 190px;
        background-color: #f8f9fa;
        color: #adb5bd;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

</style>
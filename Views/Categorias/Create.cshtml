@model WebApplication1.Models.Categorium

@{
    ViewData["Title"] = "Nueva categoría";
}

<div class="container-fluid">

    <!-- ============================================================
         ENCABEZADO
         ============================================================ -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-tags-fill text-primary me-2"></i>

                Nueva categoría

            </h2>

            <p class="text-muted mb-0">

                Registra una nueva categoría para organizar los platillos.

            </p>

        </div>


        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>

            Volver

        </a>

    </div>


    <!-- ============================================================
         FORMULARIO
         ============================================================ -->

    <div class="row justify-content-center">

        <div class="col-xl-8 col-lg-10">

            <div class="card border-0 shadow-sm">


                <!-- =================================================
                     CABECERA
                     ================================================= -->

                <div class="card-header bg-white border-0 py-3">

                    <div class="d-flex align-items-center">

                        <div class="rounded-3
                            bg-primary
                            bg-opacity-10
                            text-primary
                            p-3
                            me-3">

                            <i class="bi bi-tags fs-4"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-1">

                                Información de la categoría

                            </h5>

                            <small class="text-muted">

                                Completa los datos de la nueva categoría.

                            </small>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     CUERPO
                     ================================================= -->

                <div class="card-body p-4">

                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- =================================================
                             ERRORES
                             ================================================= -->

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>


                        <div class="row g-4">


                            <!-- =================================================
                                 NOMBRE
                                 ================================================= -->

                            <div class="col-12">

                                <label asp-for="Nombre"
                                       class="form-label fw-semibold">

                                    Nombre de la categoría

                                </label>

                                <input asp-for="Nombre"
                                       class="form-control"
                                       placeholder="Ej. Hamburguesas" />

                                <span asp-validation-for="Nombre"
                                      class="text-danger small">
                                </span>

                                <div class="form-text">

                                    Escribe un nombre claro para identificar
                                    fácilmente la categoría.

                                </div>

                            </div>


                            <!-- =================================================
                                 DESCRIPCIÓN
                                 ================================================= -->

                            <div class="col-12">

                                <label asp-for="Descripcion"
                                       class="form-label fw-semibold">

                                    Descripción

                                </label>

                                <textarea asp-for="Descripcion"
                                          class="form-control"
                                          rows="5"
                                          placeholder="Describe brevemente esta categoría..."></textarea>

                                <span asp-validation-for="Descripcion"
                                      class="text-danger small">
                                </span>

                                <div class="form-text">

                                    Puedes agregar información adicional
                                    sobre los platillos que pertenecerán
                                    a esta categoría.

                                </div>

                            </div>

                        </div>


                        <hr class="my-4" />


                        <!-- =================================================
                             INFORMACIÓN
                             ================================================= -->

                        <div class="alert alert-primary">

                            <div class="d-flex">

                                <i class="bi bi-info-circle-fill me-2 mt-1"></i>

                                <div>

                                    <strong>
                                        Categoría activa
                                    </strong>

                                    <div class="small mt-1">

                                        La categoría se creará como activa
                                        y estará disponible para agregar
                                        platillos.

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- =================================================
                             BOTONES
                             ================================================= -->

                        <div class="d-flex
                            justify-content-end
                            gap-2">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">

                                <i class="bi bi-x-lg me-1"></i>

                                Cancelar

                            </a>


                            <button type="submit"
                                    class="btn btn-primary px-4">

                                <i class="bi bi-check-lg me-1"></i>

                                Guardar categoría

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
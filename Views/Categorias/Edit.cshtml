@model WebApplication1.Models.Categorium

@{
    ViewData["Title"] = "Editar categoría";
}

<div class="container-fluid">

    <!-- ============================================================
         ENCABEZADO
         ============================================================ -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                <i class="bi bi-pencil-square text-primary me-2"></i>
                Editar categoría
            </h2>

            <p class="text-muted mb-0">
                Modifica la información de la categoría
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Volver

        </a>

    </div>


    <!-- ============================================================
         FORMULARIO
         ============================================================ -->

    <div class="row justify-content-center">

        <div class="col-xl-8 col-lg-10">

            <div class="card border-0 shadow-sm">


                <!-- ==================================================
                     CABECERA DE LA TARJETA
                     ================================================== -->

                <div class="card-header bg-white border-0 py-3">

                    <div class="d-flex align-items-center">

                        <div class="rounded-3
                                    bg-primary
                                    bg-opacity-10
                                    text-primary
                                    p-3
                                    me-3">

                            <i class="bi bi-tags-fill fs-4"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-1">
                                Información de la categoría
                            </h5>

                            <small class="text-muted">
                                Actualiza el nombre y la descripción
                                de la categoría.
                            </small>

                        </div>

                    </div>

                </div>


                <!-- ==================================================
                     CUERPO
                     ================================================== -->

                <div class="card-body p-4">

                    <form asp-action="Edit"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- ==================================================
                             ID
                             ================================================== -->

                        <input type="hidden"
                               asp-for="IdCategoria" />


                        <!-- ==================================================
                             ERRORES DE VALIDACIÓN
                             ================================================== -->

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>


                        <!-- ==================================================
                             NOMBRE
                             ================================================== -->

                        <div class="mb-4">

                            <label asp-for="Nombre"
                                   class="form-label fw-semibold">

                                Nombre de la categoría

                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-white">

                                    <i class="bi bi-tag text-primary"></i>

                                </span>

                                <input asp-for="Nombre"
                                       class="form-control"
                                       placeholder="Ej. Bebidas" />

                            </div>

                            <span asp-validation-for="Nombre"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- ==================================================
                             DESCRIPCIÓN
                             ================================================== -->

                        <div class="mb-4">

                            <label asp-for="Descripcion"
                                   class="form-label fw-semibold">

                                Descripción

                            </label>

                            <textarea asp-for="Descripcion"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Describe brevemente esta categoría..."></textarea>

                            <span asp-validation-for="Descripcion"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- ==================================================
                             ESTADO
                             ================================================== -->

                        <div class="alert
                                    @(Model.Estado
                                        ? "alert-success"
                                        : "alert-secondary")">

                            <div class="d-flex align-items-center">

                                @if (Model.Estado)
                                {
                                    <i class="bi bi-check-circle-fill
                                              fs-5
                                              me-2"></i>

                                    <div>

                                        <strong>
                                            Categoría activa
                                        </strong>

                                        <div class="small">
                                            Esta categoría está disponible
                                            actualmente para utilizarse.
                                        </div>

                                    </div>
                                }
                                else
                                {
                                    <i class="bi bi-pause-circle-fill
                                              fs-5
                                              me-2"></i>

                                    <div>

                                        <strong>
                                            Categoría inactiva
                                        </strong>

                                        <div class="small">
                                            Esta categoría está desactivada.
                                            Puedes activarla desde la vista
                                            de detalles.
                                        </div>

                                    </div>
                                }

                            </div>

                        </div>


                        <!-- ==================================================
                             DATOS DEL SISTEMA
                             ================================================== -->

                        <div class="row g-3 mb-4">


                            <!-- ID -->

                            <div class="col-md-6">

                                <div class="border rounded p-3 h-100">

                                    <div class="text-muted small mb-1">

                                        ID de categoría

                                    </div>

                                    <div class="fw-bold">

                                        #@Model.IdCategoria

                                    </div>

                                </div>

                            </div>


                            <!-- FECHA -->

                            <div class="col-md-6">

                                <div class="border rounded p-3 h-100">

                                    <div class="text-muted small mb-1">

                                        Fecha de registro

                                    </div>

                                    <div class="fw-bold">

                                        @Model.FechaRegistro.ToString(
                                            "dd/MM/yyyy HH:mm")

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- ==================================================
                             INFORMACIÓN
                             ================================================== -->

                        <div class="alert alert-info mb-4">

                            <div class="d-flex">

                                <i class="bi bi-info-circle-fill me-2 mt-1"></i>

                                <div>

                                    <strong>
                                        Información
                                    </strong>

                                    <div class="small mt-1">

                                        El estado y la fecha de registro
                                        son administrados por el sistema.
                                        Para activar o desactivar esta
                                        categoría utiliza las opciones
                                        correspondientes en la vista
                                        de detalles.

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- ==================================================
                             BOTONES
                             ================================================== -->

                        <div class="d-flex
                                    justify-content-end
                                    gap-2">

                            <!-- CANCELAR -->

                            <a asp-action="Details"
                               asp-route-id="@Model.IdCategoria"
                               class="btn btn-outline-secondary">

                                <i class="bi bi-x-lg me-1"></i>

                                Cancelar

                            </a>


                            <!-- GUARDAR -->

                            <button type="submit"
                                    class="btn btn-primary px-4">

                                <i class="bi bi-check-lg me-1"></i>

                                Guardar cambios

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ============================================================z
     VALIDACIÓN
     ============================================================ -->

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
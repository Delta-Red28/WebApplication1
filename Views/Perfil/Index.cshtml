<!-- ================================================= -->
<!-- SEGURIDAD -->
<!-- ================================================= -->

<style>

    /* =====================================================
       TARJETA DE SEGURIDAD
    ====================================================== */

    .security-card {
        overflow: hidden;

        margin-top: 25px;

        border: 1px solid #eee5dc;

        border-radius: 18px;

        background: #fffdf9;

        box-shadow:
            0 7px 24px rgba(53, 35, 31, 0.07);
    }


    /* =====================================================
       CABECERA
    ====================================================== */

    .security-card-header {
        padding: 24px 28px 20px;

        border-bottom: 1px solid #f0e8e1;

        background: #fffdf9;
    }


    .security-header-content {
        display: flex;

        align-items: center;

        gap: 12px;
    }


    .security-icon {
        width: 42px;
        height: 42px;

        display: flex;

        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 12px;

        background: #f7e8e5;

        color: #8f2923;

        font-size: 19px;
    }


    .security-card-header h5 {
        margin: 0;

        color: #392622;

        font-size: 20px;

        font-weight: 700;
    }


    .security-card-header p {
        margin: 4px 0 0;

        color: #958680;

        font-size: 14px;

        line-height: 1.5;
    }


    /* =====================================================
       CUERPO
    ====================================================== */

    .security-card-body {
        padding: 25px 28px;
    }


    /* =====================================================
       BLOQUE CONTRASEÑA
    ====================================================== */

    .password-security-box {
        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 25px;

        padding: 20px;

        border: 1px solid #eee3da;

        border-radius: 14px;

        background:
            linear-gradient(
                135deg,
                #fffaf4 0%,
                #fffdf9 100%
            );
    }


    .password-security-info {
        display: flex;

        align-items: center;

        gap: 15px;

        min-width: 0;
    }


    .password-icon {
        width: 48px;
        height: 48px;

        display: flex;

        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 13px;

        background: #f5e6c9;

        color: #9b6b2f;

        font-size: 20px;
    }


    .password-security-info h6 {
        margin: 0 0 5px;

        color: #44312c;

        font-size: 16px;

        font-weight: 700;
    }


    .password-security-info p {
        margin: 0;

        color: #8f817b;

        font-size: 13px;

        line-height: 1.5;
    }


    /* =====================================================
       INDICADOR DE SEGURIDAD
    ====================================================== */

    .security-status {
        display: inline-flex;

        align-items: center;

        gap: 6px;

        margin-top: 8px;

        color: #6e625d;

        font-size: 11px;

        font-weight: 600;
    }


    .security-status-dot {
        width: 7px;
        height: 7px;

        border-radius: 50%;

        background: #43a47f;

        box-shadow:
            0 0 0 3px rgba(67, 164, 127, 0.10);
    }


    /* =====================================================
       BOTÓN
    ====================================================== */

    .security-password-btn {
        display: inline-flex;

        align-items: center;

        justify-content: center;

        flex-shrink: 0;

        min-height: 46px;

        padding: 10px 18px;

        border: 1px solid #8f2923;

        border-radius: 11px;

        background: #8f2923;

        color: #ffffff;

        font-size: 13px;

        font-weight: 700;

        text-decoration: none;

        box-shadow:
            0 5px 14px rgba(143, 41, 35, 0.18);

        transition:
            background-color 0.2s ease,
            border-color 0.2s ease,
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }


    .security-password-btn:hover {
        background: #6f1e1a;

        border-color: #6f1e1a;

        color: #ffffff;

        transform: translateY(-2px);

        box-shadow:
            0 8px 20px rgba(143, 41, 35, 0.27);
    }


    .security-password-btn:active {
        transform: translateY(0);
    }


    /* =====================================================
       INFORMACIÓN INFERIOR
    ====================================================== */

    .security-note {
        display: flex;

        align-items: flex-start;

        gap: 9px;

        margin-top: 17px;

        padding: 12px 14px;

        border-radius: 10px;

        background: #faf6ef;

        color: #857770;

        font-size: 12px;

        line-height: 1.5;
    }


    .security-note i {
        margin-top: 1px;

        color: #b18435;

        font-size: 14px;

        flex-shrink: 0;
    }

</style>


<div class="security-card">


    <!-- =====================================================
         CABECERA
    ====================================================== -->

    <div class="security-card-header">

        <div class="security-header-content">

            <div class="security-icon">

                <i class="bi bi-shield-lock-fill"></i>

            </div>


            <div>

                <h5>
                    Seguridad
                </h5>


                <p>
                    Administra y protege el acceso a tu cuenta.
                </p>

            </div>

        </div>

    </div>


    <!-- =====================================================
         CUERPO
    ====================================================== -->

    <div class="security-card-body">


        <div class="password-security-box">


            <!-- =================================================
                 INFORMACIÓN
            ================================================== -->

            <div class="password-security-info">

                <div class="password-icon">

                    <i class="bi bi-key-fill"></i>

                </div>


                <div>

                    <h6>
                        Contraseña
                    </h6>


                    <p>
                        Mantén tu contraseña actualizada para
                        proteger tu cuenta.
                    </p>


                    <div class="security-status">

                        <span class="security-status-dot"></span>

                        Cuenta protegida

                    </div>

                </div>

            </div>


            <!-- =================================================
                 BOTÓN
            ================================================== -->

            <a asp-controller="Account"
               asp-action="CambiarPassword"
               class="security-password-btn">

                <i class="bi bi-key-fill me-2"></i>

                Cambiar contraseña

            </a>


        </div>


        <!-- =================================================
             NOTA DE SEGURIDAD
        ================================================== -->

        <div class="security-note">

            <i class="bi bi-info-circle-fill"></i>

            <div>

                Por seguridad, utiliza una contraseña que sea
                difícil de adivinar y evita compartirla con otras
                personas.

            </div>

        </div>


    </div>

</div>
@model WebApplication1.Models.Usuario

@{
    ViewData["Title"] = "Editar mi perfil";

    var nombreCompleto =
        $"{Model.Nombres} {Model.Apellidos}".Trim();

    var rol =
        Model.IdRolNavigation?.Nombre ?? "Usuario";
}


<style>

    /* =========================================================
       CONTENEDOR PRINCIPAL
    ========================================================= */

    .profile-page {
        color: #332522;
        width: 100%;
        max-width: 100%;
        overflow-x: hidden;
    }


    /* =========================================================
       ENCABEZADO
    ========================================================= */

    .profile-header {
        position: relative;

        overflow: hidden;

        padding: 28px 30px;

        margin-bottom: 25px;

        border-radius: 18px;

        background: linear-gradient(
            135deg,
            #671f1b 0%,
            #8f2923 100%
        );

        color: white;

        box-shadow:
            0 10px 30px rgba(103, 31, 27, 0.18);
    }


    .profile-header::before {
        content: "";

        position: absolute;

        width: 220px;
        height: 220px;

        right: -80px;
        top: -125px;

        border-radius: 50%;

        background: rgba(217, 164, 65, 0.14);

        pointer-events: none;
    }


    .profile-header::after {
        content: "";

        position: absolute;

        width: 150px;
        height: 150px;

        right: 120px;
        bottom: -110px;

        border-radius: 50%;

        background: rgba(255, 255, 255, 0.05);

        pointer-events: none;
    }


    .profile-header-content {
        position: relative;

        z-index: 2;

        max-width: 100%;
    }


    .profile-header-icon {
        width: 52px;
        height: 52px;

        display: flex;

        align-items: center;
        justify-content: center;

        margin-bottom: 14px;

        border-radius: 14px;

        background: rgba(255, 255, 255, 0.12);

        border: 1px solid rgba(255, 255, 255, 0.14);

        color: #f2cf76;

        font-size: 23px;
    }


    .profile-header h2 {
        margin: 0 0 6px;

        font-family:
            Georgia,
            "Times New Roman",
            serif;

        font-size: 28px;

        font-weight: 700;
    }


    .profile-header p {
        margin: 0;

        color: rgba(255, 255, 255, 0.76);

        font-size: 14px;

        line-height: 1.6;

        max-width: 700px;
    }


    .profile-header-decoration {
        position: absolute;

        right: 32px;
        bottom: 10px;

        z-index: 1;

        color: rgba(255, 255, 255, 0.08);

        font-size: 76px;

        pointer-events: none;
    }


    /* =========================================================
       CONTENEDOR DEL FORMULARIO
    ========================================================= */

    .profile-card {
        overflow: hidden;

        width: 100%;

        border: 1px solid #eee5dc;

        border-radius: 18px;

        background: #fffdf9;

        box-shadow:
            0 7px 24px rgba(53, 35, 31, 0.07);
    }


    /* =========================================================
       CABECERA DEL FORMULARIO
    ========================================================= */

    .profile-card-header {
        padding: 24px 28px 20px;

        border-bottom: 1px solid #f0e8e1;

        background: #fffdf9;
    }


    .profile-section-title {
        display: flex;

        align-items: center;

        gap: 12px;

        min-width: 0;
    }


    .profile-section-icon {
        width: 42px;
        height: 42px;

        display: flex;

        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 12px;

        background: #f7e8e5;

        color: #8f2923;

        font-size: 19px;
    }


    .profile-card-header h5 {
        margin: 0;

        color: #392622;

        font-size: 20px;

        font-weight: 700;
    }


    .profile-card-header p {
        margin: 4px 0 0;

        color: #958680;

        font-size: 14px;

        line-height: 1.5;
    }


    /* =========================================================
       CUERPO
    ========================================================= */

    .profile-card-body {
        padding: 28px;
    }


    /* =========================================================
       CAMPOS
    ========================================================= */

    .profile-form-label {
        display: block;

        margin-bottom: 8px;

        color: #4a342e;

        font-size: 14px;

        font-weight: 700;
    }


    .profile-input-group {
        display: flex;

        width: 100%;

        overflow: hidden;

        border: 1px solid #e4d9d0;

        border-radius: 12px;

        background: #ffffff;

        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease;
    }


    .profile-input-group:focus-within {
        border-color: #a52a24;

        box-shadow:
            0 0 0 3px rgba(165, 42, 36, 0.10);
    }


    .profile-input-group .input-group-text {
        min-width: 45px;

        display: flex;

        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border: none;

        background: #fffaf4;

        color: #a27625;

        font-size: 16px;
    }


    .profile-input {
        width: 100%;
        min-width: 0;

        height: 48px;

        border: none !important;

        box-shadow: none !important;

        background: transparent;

        color: #382622;

        font-size: 14px;
    }


    .profile-input::placeholder {
        color: #b5aaa4;
    }


    .profile-input:focus {
        background: transparent;
    }


    .profile-input-plain {
        width: 100%;
        min-width: 0;

        height: 48px;

        border: 1px solid #e4d9d0;

        border-radius: 12px;

        box-shadow: none !important;

        color: #382622;

        font-size: 14px;

        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease;
    }


    .profile-input-plain:focus {
        border-color: #a52a24;

        box-shadow:
            0 0 0 3px rgba(165, 42, 36, 0.10) !important;
    }


    /* =========================================================
       VALIDACIONES
    ========================================================= */

    .profile-validation {
        display: block;

        margin-top: 6px;

        color: #a52a24;

        font-size: 12px;

        word-break: break-word;
    }


    /* =========================================================
       SECCIÓN INFORMACIÓN BLOQUEADA
    ========================================================= */

    .protected-section {
        margin-top: 30px;

        padding-top: 25px;

        border-top: 1px solid #eee5dc;
    }


    .protected-title {
        display: flex;

        align-items: center;

        gap: 10px;

        margin-bottom: 18px;

        min-width: 0;
    }


    .protected-title-icon {
        width: 38px;
        height: 38px;

        display: flex;

        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 10px;

        background: #f2eee9;

        color: #786d68;

        font-size: 16px;
    }


    .protected-title h6 {
        margin: 0;

        color: #45332e;

        font-size: 16px;

        font-weight: 700;
    }


    .protected-title p {
        margin: 3px 0 0;

        color: #9a8c86;

        font-size: 12px;

        line-height: 1.5;
    }


    /* =========================================================
       CAMPOS BLOQUEADOS
    ========================================================= */

    .readonly-field {
        width: 100%;
        min-width: 0;

        height: 48px;

        border: 1px solid #e8e1db;

        border-radius: 12px;

        background: #f7f5f2 !important;

        color: #756a65 !important;

        font-size: 14px;

        box-shadow: none !important;

        text-overflow: ellipsis;
    }


    .readonly-help {
        display: block;

        margin-top: 7px;

        color: #9a8d87;

        font-size: 11px;

        line-height: 1.5;
    }


    /* =========================================================
       ESTADO DE CUENTA
    ========================================================= */

    .account-status {
        display: inline-flex;

        align-items: center;

        gap: 7px;

        margin-top: 2px;

        padding: 7px 11px;

        border-radius: 20px;

        background: #eef7f3;

        border: 1px solid #d8ebe3;

        color: #39786d;

        font-size: 12px;

        font-weight: 700;
    }


    .account-status.inactive {
        background: #f8e9e7;

        border-color: #efd4d0;

        color: #8f2923;
    }


    .status-dot {
        width: 7px;
        height: 7px;

        flex-shrink: 0;

        border-radius: 50%;

        background: #43a47f;

        box-shadow:
            0 0 0 3px rgba(67, 164, 127, 0.10);
    }


    .account-status.inactive .status-dot {
        background: #a52a24;

        box-shadow:
            0 0 0 3px rgba(165, 42, 36, 0.10);
    }


    /* =========================================================
       ALERTA DE ERRORES
    ========================================================= */

    .profile-alert {
        margin-bottom: 25px;

        padding: 13px 16px;

        border: 1px solid #efd0cc;

        border-radius: 12px;

        background: #fdf0ee;

        color: #84251f;

        font-size: 13px;

        overflow-wrap: break-word;
    }


    .profile-alert:empty {
        display: none;
    }


    /* =========================================================
       BOTONES
    ========================================================= */

    .profile-actions {
        display: flex;

        align-items: center;

        justify-content: flex-end;

        gap: 10px;

        margin-top: 30px;

        padding-top: 23px;

        border-top: 1px solid #eee5dc;
    }


    .profile-btn-cancel,
    .profile-btn-save {
        min-height: 46px;

        display: inline-flex;

        align-items: center;
        justify-content: center;

        white-space: nowrap;

        flex-shrink: 0;

        font-size: 14px;

        font-weight: 600;
    }


    .profile-btn-cancel {
        padding: 10px 18px;

        border: 1px solid #e2d9d2;

        border-radius: 11px;

        background: #ffffff;

        color: #665852;

        transition:
            background-color 0.2s ease,
            border-color 0.2s ease,
            transform 0.2s ease;
    }


    .profile-btn-cancel:hover {
        background: #f8f4f0;

        border-color: #d6c9c0;

        color: #4f403b;

        transform: translateY(-1px);
    }


    .profile-btn-save {
        padding: 10px 20px;

        border: none;

        border-radius: 11px;

        background: #8f2923;

        color: #ffffff;

        box-shadow:
            0 5px 14px rgba(143, 41, 35, 0.20);

        transition:
            background-color 0.2s ease,
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }


    .profile-btn-save:hover {
        background: #6f1e1a;

        color: #ffffff;

        transform: translateY(-2px);

        box-shadow:
            0 8px 20px rgba(143, 41, 35, 0.28);
    }


    .profile-btn-save:active {
        transform: translateY(0);
    }


    /* =========================================================
       DECORACIÓN INFERIOR
    ========================================================= */

    .profile-footer-decoration {
        display: flex;

        align-items: center;

        justify-content: center;

        gap: 9px;

        margin-top: 20px;

        color: #c49743;

        font-size: 10px;

        letter-spacing: 2px;

        text-align: center;
    }


    .profile-footer-decoration::before,
    .profile-footer-decoration::after {
        content: "";

        width: 35px;
        height: 1px;

        flex-shrink: 0;

        background: #e5d6be;
    }


    /* =========================================================
       TABLETS
    ========================================================= */

    @@media (max-width: 991.98px) {

        .profile-header {
            padding: 25px 24px;
        }


        .profile-card-body {
            padding: 24px;
        }


        .profile-card-header {
            padding: 22px 24px 19px;
        }


        .profile-header-decoration {
            right: 20px;
            font-size: 65px;
        }

    }


    /* =========================================================
       CELULARES
    ========================================================= */

    @@media (max-width: 767.98px) {

        /* -----------------------------------------
           CONTENEDOR
        ----------------------------------------- */

        .profile-page {
            padding-left: 12px;
            padding-right: 12px;
        }


        /* -----------------------------------------
           ENCABEZADO
        ----------------------------------------- */

        .profile-header {
            padding: 22px 18px;

            margin-bottom: 18px;

            border-radius: 14px;
        }


        .profile-header-icon {
            width: 46px;
            height: 46px;

            margin-bottom: 11px;

            border-radius: 12px;

            font-size: 20px;
        }


        .profile-header h2 {
            font-size: 23px;

            line-height: 1.25;
        }


        .profile-header p {
            font-size: 13px;

            line-height: 1.5;

            padding-right: 10px;
        }


        .profile-header-decoration {
            display: none;
        }


        /* -----------------------------------------
           TARJETA
        ----------------------------------------- */

        .profile-card {
            border-radius: 14px;
        }


        .profile-card-header {
            padding: 18px 16px;
        }


        .profile-section-title {
            align-items: flex-start;

            gap: 10px;
        }


        .profile-section-icon {
            width: 38px;
            height: 38px;

            border-radius: 10px;

            font-size: 17px;
        }


        .profile-card-header h5 {
            font-size: 17px;

            line-height: 1.3;
        }


        .profile-card-header p {
            font-size: 12px;

            line-height: 1.5;
        }


        /* -----------------------------------------
           CUERPO
        ----------------------------------------- */

        .profile-card-body {
            padding: 18px 16px;
        }


        /* -----------------------------------------
           CAMPOS
        ----------------------------------------- */

        .profile-form-label {
            margin-bottom: 7px;

            font-size: 13px;
        }


        .profile-input,
        .profile-input-plain,
        .readonly-field {
            height: 45px;

            font-size: 13px;
        }


        .profile-input-group .input-group-text {
            min-width: 42px;

            font-size: 14px;
        }


        .profile-input-group {
            border-radius: 10px;
        }


        .profile-input-plain,
        .readonly-field {
            border-radius: 10px;
        }


        /* -----------------------------------------
           SECCIÓN PROTEGIDA
        ----------------------------------------- */

        .protected-section {
            margin-top: 24px;

            padding-top: 20px;
        }


        .protected-title {
            align-items: flex-start;

            gap: 9px;

            margin-bottom: 15px;
        }


        .protected-title-icon {
            width: 34px;
            height: 34px;

            border-radius: 9px;

            font-size: 14px;
        }


        .protected-title h6 {
            font-size: 14px;

            line-height: 1.35;
        }


        .protected-title p {
            font-size: 11px;

            line-height: 1.45;
        }


        .readonly-help {
            font-size: 10px;

            line-height: 1.45;
        }


        /* -----------------------------------------
           ESTADO
        ----------------------------------------- */

        .account-status {
            font-size: 11px;

            padding: 6px 10px;
        }


        /* -----------------------------------------
           BOTONES
        ----------------------------------------- */

        .profile-actions {
            flex-direction: column;

            align-items: stretch;

            gap: 9px;

            margin-top: 24px;

            padding-top: 20px;
        }


        .profile-btn-cancel,
        .profile-btn-save {
            width: 100%;

            min-height: 45px;

            padding: 10px 14px;

            font-size: 13px;

            box-sizing: border-box;
        }


        /* -----------------------------------------
           DECORACIÓN
        ----------------------------------------- */

        .profile-footer-decoration {
            margin-top: 17px;

            font-size: 9px;

            letter-spacing: 1.5px;
        }


        .profile-footer-decoration::before,
        .profile-footer-decoration::after {
            width: 25px;
        }

    }


    /* =========================================================
       CELULARES PEQUEÑOS
       Ej: 320px - 375px
    ========================================================= */

    @@media (max-width: 375px) {

        .profile-page {
            padding-left: 8px;
            padding-right: 8px;
        }


        .profile-header {
            padding: 20px 15px;

            border-radius: 12px;
        }


        .profile-header h2 {
            font-size: 21px;
        }


        .profile-header p {
            font-size: 12px;
        }


        .profile-card-header {
            padding: 16px 13px;
        }


        .profile-card-body {
            padding: 16px 13px;
        }


        .profile-section-icon {
            width: 35px;
            height: 35px;

            font-size: 15px;
        }


        .profile-card-header h5 {
            font-size: 16px;
        }


        .profile-card-header p {
            font-size: 11px;
        }


        .protected-title-icon {
            width: 32px;
            height: 32px;
        }


        .protected-title h6 {
            font-size: 13px;
        }


        .profile-input,
        .profile-input-plain,
        .readonly-field {
            font-size: 12px;
        }


        .profile-footer-decoration {
            gap: 6px;

            font-size: 8px;
        }


        .profile-footer-decoration::before,
        .profile-footer-decoration::after {
            width: 20px;
        }

    }


    /* =========================================================
       EVITAR DESBORDAMIENTOS
    ========================================================= */

    .profile-page *,
    .profile-page *::before,
    .profile-page *::after {
        box-sizing: border-box;
    }


    .profile-page input,
    .profile-page button,
    .profile-page a {
        max-width: 100%;
    }


</style>


<div class="container-fluid profile-page">


    <!-- =====================================================
         ENCABEZADO
    ====================================================== -->

    <div class="profile-header">

        <div class="profile-header-content">

            <div class="profile-header-icon">

                <i class="bi bi-person-gear"></i>

            </div>


            <h2>
                Editar mi perfil
            </h2>


            <p>
                Actualiza tu información personal y mantén
                tus datos al día.
            </p>

        </div>


        <div class="profile-header-decoration">

            <i class="bi bi-person-circle"></i>

        </div>

    </div>


    <!-- =====================================================
         TARJETA PRINCIPAL
    ====================================================== -->

    <div class="row">

        <div class="col-xl-8 col-lg-10">

            <div class="profile-card">


                <!-- =================================================
                     CABECERA
                ================================================== -->

                <div class="profile-card-header">

                    <div class="profile-section-title">

                        <div class="profile-section-icon">

                            <i class="bi bi-person-vcard-fill"></i>

                        </div>


                        <div>

                            <h5>
                                Información personal
                            </h5>


                            <p>
                                Puedes modificar únicamente tu información personal.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     CUERPO
                ================================================== -->

                <div class="profile-card-body">

                    <form asp-controller="Perfil"
                          asp-action="Editar"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- =================================================
                             ERRORES GENERALES
                        ================================================== -->

                        <div asp-validation-summary="ModelOnly"
                             class="profile-alert"
                             role="alert">
                        </div>


                        <!-- =================================================
                             INFORMACIÓN EDITABLE
                        ================================================== -->

                        <div class="row g-4">


                            <!-- NOMBRES -->

                            <div class="col-md-6">

                                <label class="profile-form-label">

                                    Nombres

                                </label>


                                <input type="text"
                                       name="nombres"
                                       value="@Model.Nombres"
                                       class="form-control profile-input-plain"
                                       maxlength="100"
                                       required />


                                <span asp-validation-for="Nombres"
                                      class="profile-validation">
                                </span>

                            </div>


                            <!-- APELLIDOS -->

                            <div class="col-md-6">

                                <label class="profile-form-label">

                                    Apellidos

                                </label>


                                <input type="text"
                                       name="apellidos"
                                       value="@Model.Apellidos"
                                       class="form-control profile-input-plain"
                                       maxlength="100"
                                       required />


                                <span asp-validation-for="Apellidos"
                                      class="profile-validation">
                                </span>

                            </div>


                            <!-- CORREO -->

                            <div class="col-md-6">

                                <label class="profile-form-label">

                                    Correo electrónico

                                </label>


                                <div class="input-group profile-input-group">

                                    <span class="input-group-text">

                                        <i class="bi bi-envelope-fill"></i>

                                    </span>


                                    <input type="email"
                                           name="correo"
                                           value="@Model.Correo"
                                           class="form-control profile-input"
                                           maxlength="150"
                                           required />

                                </div>


                                <span asp-validation-for="Correo"
                                      class="profile-validation">
                                </span>

                            </div>


                            <!-- TELÉFONO -->

                            <div class="col-md-6">

                                <label class="profile-form-label">

                                    Teléfono

                                </label>


                                <div class="input-group profile-input-group">

                                    <span class="input-group-text">

                                        <i class="bi bi-telephone-fill"></i>

                                    </span>


                                    <input type="text"
                                           name="telefono"
                                           value="@Model.Telefono"
                                           class="form-control profile-input"
                                           maxlength="30" />

                                </div>


                                <span asp-validation-for="Telefono"
                                      class="profile-validation">
                                </span>

                            </div>


                        </div>


                        <!-- =================================================
                             INFORMACIÓN PROTEGIDA
                        ================================================== -->

                        <div class="protected-section">


                            <div class="protected-title">

                                <div class="protected-title-icon">

                                    <i class="bi bi-lock-fill"></i>

                                </div>


                                <div>

                                    <h6>
                                        Información administrada por el sistema
                                    </h6>


                                    <p>
                                        Estos datos no pueden modificarse desde tu perfil.
                                    </p>

                                </div>

                            </div>


                            <div class="row g-4">


                                <!-- USUARIO -->

                                <div class="col-md-6">

                                    <label class="profile-form-label">

                                        Nombre de usuario

                                    </label>


                                    <input type="text"
                                           class="form-control readonly-field"
                                           value="@Model.Usuario1"
                                           readonly />


                                    <small class="readonly-help">

                                        El nombre de usuario solo puede ser
                                        modificado por un administrador.

                                    </small>

                                </div>


                                <!-- ROL -->

                                <div class="col-md-6">

                                    <label class="profile-form-label">

                                        Rol

                                    </label>


                                    <input type="text"
                                           class="form-control readonly-field"
                                           value="@rol"
                                           readonly />


                                    <small class="readonly-help">

                                        El rol es administrado por el sistema.

                                    </small>

                                </div>


                                <!-- ESTADO -->

                                <div class="col-md-6">

                                    <label class="profile-form-label">

                                        Estado de la cuenta

                                    </label>


                                    @if (Model.Estado)
                                    {
                                        <div>

                                            <span class="account-status">

                                                <span class="status-dot"></span>

                                                Cuenta activa

                                            </span>

                                        </div>
                                    }
                                    else
                                    {
                                        <div>

                                            <span class="account-status inactive">

                                                <span class="status-dot"></span>

                                                Cuenta inactiva

                                            </span>

                                        </div>
                                    }

                                </div>


                                <!-- FECHA REGISTRO -->

                                <div class="col-md-6">

                                    <label class="profile-form-label">

                                        Fecha de registro

                                    </label>


                                    <input type="text"
                                           class="form-control readonly-field"
                                           value="@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")"
                                           readonly />

                                </div>


                            </div>

                        </div>


                        <!-- =================================================
                             BOTONES
                        ================================================== -->

                        <div class="profile-actions">



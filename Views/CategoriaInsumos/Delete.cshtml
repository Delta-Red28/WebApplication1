@model WebApplication1.Models.CategoriaInsumo

@{
    ViewData["Title"] = "Eliminar categoría de insumo";
}

<div class="container-fluid">

    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            Eliminar categoría de insumo
        </h2>

        <p class="text-muted mb-0">
            Confirma la eliminación de la categoría.
        </p>

    </div>


    <div class="card border-0">

        <div class="card-body p-4">


            <div class="alert alert-warning">

                <i class="bi bi-exclamation-triangle me-2"></i>

                ¿Estás seguro de que deseas eliminar esta categoría?

            </div>


            <div class="row g-4 mb-4">


                <div class="col-md-6">

                    <div class="text-muted small">
                        Código
                    </div>

                    <div class="fw-semibold">

                        CAT-@Model.IdCategoriaInsumo.ToString("00")

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="text-muted small">
                        Nombre
                    </div>

                    <div class="fw-semibold">

                        @Model.Nombre

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="text-muted small">
                        Insumos asociados
                    </div>

                    <div class="fw-semibold">

                        @Model.Insumos.Count

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="text-muted small">
                        Estado
                    </div>

                    @if (Model.Estado)
                    {
                        <span class="badge bg-success">
                            Activa
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            Inactiva
                        </span>
                    }

                </div>

            </div>


            @if (Model.Insumos.Any())
            {
                <div class="alert alert-danger">

                    <i class="bi bi-shield-exclamation me-2"></i>

                    <strong>No se puede eliminar esta categoría.</strong>

                    <br />

                    Tiene
                    <strong>@Model.Insumos.Count</strong>
                    insumo(s) asociado(s).

                    Primero debes reasignar esos insumos a otra categoría.

                </div>


                <div class="d-flex justify-content-end">

                    <a asp-action="Index"
                       class="btn btn-primary">

                        <i class="bi bi-arrow-left me-1"></i>

                        Volver

                    </a>

                </div>
            }
            else
            {
                <form asp-action="Delete"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           asp-for="IdCategoriaInsumo" />


                    <div class="d-flex justify-content-end gap-2">

                        <a asp-action="Index"
                           class="btn btn-light">

                            Cancelar

                        </a>


                        <button type="submit"
                                class="btn btn-danger">

                            <i class="bi bi-trash me-1"></i>

                            Sí, eliminar

                        </button>

                    </div>

                </form>
            }

        </div>

    </div>

</div>
@model WebApplication1.Models.CategoriaInsumo

@{
    ViewData["Title"] = "Nueva categoría de insumo";
}

<div class="container-fluid">

    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            Nueva categoría de insumo
        </h2>

        <p class="text-muted mb-0">
            Registra una nueva categoría para organizar los insumos.
        </p>

    </div>


    <div class="card border-0">

        <div class="card-header py-3">

            <h5 class="mb-0">
                Información de la categoría
            </h5>

        </div>


        <div class="card-body">

            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()


                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- NOMBRE -->

                <div class="mb-3">

                    <label asp-for="Nombre"
                           class="form-label fw-semibold">

                        Nombre

                    </label>

                    <input asp-for="Nombre"
                           class="form-control"
                           placeholder="Ej. Carnes, verduras, bebidas..." />

                    <span asp-validation-for="Nombre"
                          class="text-danger">
                    </span>

                </div>


                <!-- DESCRIPCIÓN -->

                <div class="mb-3">

                    <label asp-for="Descripcion"
                           class="form-label fw-semibold">

                        Descripción

                    </label>

                    <textarea asp-for="Descripcion"
                              class="form-control"
                              rows="4"
                              placeholder="Describe la categoría..."></textarea>

                    <span asp-validation-for="Descripcion"
                          class="text-danger">
                    </span>

                </div>


                <!-- ESTADO -->

                <div class="form-check form-switch mb-4">

                    <input asp-for="Estado"
                           class="form-check-input"
                           type="checkbox"
                           checked />

                    <label asp-for="Estado"
                           class="form-check-label">

                        Categoría activa

                    </label>

                </div>


                <!-- BOTONES -->

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-light">

                        <i class="bi bi-arrow-left me-1"></i>

                        Cancelar

                    </a>


                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-lg me-1"></i>

                        Guardar categoría

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
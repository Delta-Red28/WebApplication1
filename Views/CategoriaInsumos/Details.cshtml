@model WebApplication1.Models.CategoriaInsumo

@{
    ViewData["Title"] = "Detalle de categoría de insumo";
}

<div class="container-fluid">

    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            Detalle de categoría de insumo
        </h2>

        <p class="text-muted mb-0">
            Información completa de la categoría.
        </p>

    </div>


    <div class="row g-4">


        <!-- INFORMACIÓN -->

        <div class="col-lg-8">

            <div class="card border-0">

                <div class="card-header py-3">

                    <h5 class="mb-0">
                        Información general
                    </h5>

                </div>


                <div class="card-body">


                    <!-- ID -->

                    <div class="mb-4">

                        <div class="text-muted small">
                            Código
                        </div>

                        <div class="fw-semibold fs-5">

                            CAT-@Model.IdCategoriaInsumo.ToString("00")

                        </div>

                    </div>


                    <!-- NOMBRE -->

                    <div class="mb-4">

                        <div class="text-muted small">
                            Nombre
                        </div>

                        <div class="fw-semibold fs-5">

                            @Model.Nombre

                        </div>

                    </div>


                    <!-- DESCRIPCIÓN -->

                    <div class="mb-4">

                        <div class="text-muted small">
                            Descripción
                        </div>

                        @if (string.IsNullOrWhiteSpace(Model.Descripcion))
                        {
                            <div class="text-muted">
                                Sin descripción
                            </div>
                        }
                        else
                        {
                            <div>
                                @Model.Descripcion
                            </div>
                        }

                    </div>


                    <!-- ESTADO -->

                    <div class="mb-4">

                        <div class="text-muted small">
                            Estado
                        </div>

                        @if (Model.Estado)
                        {
                            <span class="badge bg-success">
                                Activa
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Inactiva
                            </span>
                        }

                    </div>


                    <!-- FECHA -->

                    <div>

                        <div class="text-muted small">
                            Fecha de registro
                        </div>

                        <div>

                            @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- RESUMEN -->

        <div class="col-lg-4">

            <div class="card border-0">

                <div class="card-header py-3">

                    <h5 class="mb-0">
                        Uso de la categoría
                    </h5>

                </div>


                <div class="card-body text-center py-4">

                    <i class="bi bi-box-seam fs-1 text-primary"></i>

                    <div class="display-5 fw-bold mt-2">

                        @Model.Insumos.Count

                    </div>

                    <div class="text-muted">

                        @(Model.Insumos.Count == 1
                            ? "insumo asociado"
                            : "insumos asociados")

                    </div>

                </div>

            </div>


            <!-- ACCIONES -->

            <div class="card border-0 mt-4">

                <div class="card-body">

                    <div class="d-grid gap-2">

                        <a asp-action="Edit"
                           asp-route-id="@Model.IdCategoriaInsumo"
                           class="btn btn-primary">

                            <i class="bi bi-pencil me-1"></i>

                            Editar categoría

                        </a>


                        <a asp-action="Delete"
                           asp-route-id="@Model.IdCategoriaInsumo"
                           class="btn btn-outline-danger">

                            <i class="bi bi-trash me-1"></i>

                            Eliminar categoría

                        </a>


                        <a asp-action="Index"
                           class="btn btn-light">

                            <i class="bi bi-arrow-left me-1"></i>

                            Volver al listado

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- INSUMOS -->

    <div class="card border-0 mt-4">

        <div class="card-header py-3">

            <h5 class="mb-0">
                Insumos asociados
            </h5>

        </div>


        <div class="card-body p-0">

            @if (!Model.Insumos.Any())
            {
                <div class="text-center py-5">

                    <i class="bi bi-inbox fs-1 text-muted"></i>

                    <p class="text-muted mt-3 mb-0">

                        No hay insumos asociados a esta categoría.

                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead>

                            <tr>

                                <th>
                                    Código
                                </th>

                                <th>
                                    Insumo
                                </th>

                                <th>
                                    Descripción
                                </th>

                                <th class="text-end">
                                    Costo
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var insumo in Model.Insumos)
                            {
                                <tr>

                                    <td class="fw-semibold">

                                        @insumo.CodigoInsumo

                                    </td>


                                    <td>

                                        @insumo.Nombre

                                    </td>


                                    <td>

                                        @if (string.IsNullOrWhiteSpace(insumo.Descripcion))
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }
                                        else
                                        {
                                            @insumo.Descripcion
                                        }

                                    </td>


                                    <td class="text-end">

                                        @insumo.CostoPromedio.ToString("C2")

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>
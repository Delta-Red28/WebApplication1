@{
    Layout = null;
    ViewData["Title"] = "Iniciar Sesión";

    string errorGeneral = "";

    if (ViewData.ModelState.TryGetValue("", out var erroresGenerales))
    {
        if (erroresGenerales != null && erroresGenerales.Errors.Count > 0)
        {
            errorGeneral = erroresGenerales.Errors[0].ErrorMessage;
        }
    }

    string usuarioActual = "";

    if (ViewData.ModelState.TryGetValue("usuario", out var usuarioState))
    {
        if (usuarioState != null)
        {
            usuarioActual = usuarioState.AttemptedValue ?? "";
        }
    }
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <title>Iniciar Sesión - Restaurante</title>


    <!-- =====================================================
         BOOTSTRAP
    ====================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />


    <!-- =====================================================
         BOOTSTRAP ICONS
    ====================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <style>

        /* =====================================================
           RESET
        ====================================================== */

        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }


        html,
        body {
            width: 100%;
            min-height: 100%;
            margin: 0;
            padding: 0;
        }


        body {
            font-family:
                "Segoe UI",
                Arial,
                Helvetica,
                sans-serif;

            background: #f4f5f7;

            overflow-x: hidden;
        }


        /* =====================================================
           PÁGINA PRINCIPAL
        ====================================================== */

        .login-page {

            width: 100%;

            min-height: 100vh;
            min-height: 100svh;

            display: flex;

            align-items: center;
            justify-content: center;

            padding: 30px;

            position: relative;

            background:
                linear-gradient(
                    135deg,
                    #eceff3 0%,
                    #f8f8f8 50%,
                    #e9ecef 100%
                );

            opacity: 0;

            transition:
                opacity .7s ease;
        }


        .login-page.visible {
            opacity: 1;
        }


        /* =====================================================
           DECORACIÓN DEL FONDO
        ====================================================== */

        .background-circle {

            position: fixed;

            width: 500px;
            height: 500px;

            border-radius: 50%;

            pointer-events: none;

            opacity: .45;

            filter: blur(2px);
        }


        .background-circle.one {

            top: -300px;
            right: -180px;

            background:
                rgba(100, 100, 100, .06);
        }


        .background-circle.two {

            bottom: -320px;
            left: -200px;

            background:
                rgba(0, 0, 0, .035);
        }


        /* =====================================================
           CONTENEDOR PRINCIPAL
        ====================================================== */

        .login-wrapper {

            width: 100%;

            max-width: 1050px;

            min-height: 620px;

            position: relative;

            z-index: 5;

            display: grid;

            grid-template-columns:
                48% 52%;

            overflow: hidden;

            border-radius: 26px;

            background: #ffffff;

            box-shadow:
                0 30px 80px rgba(0, 0, 0, .16),
                0 10px 30px rgba(0, 0, 0, .08);

            opacity: 0;

            transform:
                translateY(45px)
                scale(.96);

            transition:
                opacity .8s ease,
                transform 1s
                cubic-bezier(.16, 1, .3, 1);
        }


        .login-wrapper.show {

            opacity: 1;

            transform:
                translateY(0)
                scale(1);
        }


        /* =====================================================
           PANEL IZQUIERDO
        ====================================================== */

        .login-brand {

            min-height: 620px;

            padding:
                55px 50px;

            position: relative;

            overflow: hidden;

            display: flex;

            flex-direction: column;

            justify-content: center;

            align-items: center;

            text-align: center;

            color: #ffffff;

            background:
                linear-gradient(
                    145deg,
                    #76261f 0%,
                    #4b1512 100%
                );
        }


        /* =====================================================
           DECORACIÓN PANEL
        ====================================================== */

        .brand-circle {

            position: absolute;

            border-radius: 50%;

            pointer-events: none;

            border:
                1px solid
                rgba(255,255,255,.08);
        }


        .brand-circle.circle-one {

            width: 390px;
            height: 390px;

            top: -190px;
            left: -190px;

            background:
                rgba(255,255,255,.035);
        }


        .brand-circle.circle-two {

            width: 500px;
            height: 500px;

            bottom: -310px;
            right: -260px;

            background:
                rgba(0,0,0,.07);
        }


        /* =====================================================
           LOGO
        ====================================================== */

        .brand-logo {

            width: 95px;
            height: 95px;

            margin-bottom: 28px;

            display: flex;

            align-items: center;
            justify-content: center;

            position: relative;

            z-index: 2;

            border-radius: 24px;

            background:
                rgba(255,255,255,.13);

            border:
                1px solid
                rgba(255,255,255,.22);

            box-shadow:
                0 18px 35px
                rgba(0,0,0,.18);

            backdrop-filter:
                blur(8px);

            opacity: 0;

            transform:
                translateY(-20px)
                scale(.8);

            transition:
                opacity .6s ease .25s,
                transform .8s
                cubic-bezier(.175,.885,.32,1.275) .25s;
        }


        .login-wrapper.show .brand-logo {

            opacity: 1;

            transform:
                translateY(0)
                scale(1);
        }


        .brand-logo i {

            font-size: 47px;

            color: #ffffff;
        }


        /* =====================================================
           TITULO BRAND
        ====================================================== */

        .brand-title {

            position: relative;

            z-index: 2;

            margin: 0;

            color: #ffffff;

            font-family:
                Georgia,
                "Times New Roman",
                serif;

            font-size: 40px;

            font-weight: 700;

            letter-spacing: .3px;

            opacity: 0;

            transform:
                translateY(20px);

            transition:
                opacity .6s ease .45s,
                transform .7s ease .45s;
        }


        .login-wrapper.show .brand-title {

            opacity: 1;

            transform:
                translateY(0);
        }


        .brand-subtitle {

            position: relative;

            z-index: 2;

            margin:
                10px 0 0;

            color:
                rgba(255,255,255,.78);

            font-size: 13px;

            letter-spacing: 2.5px;

            text-transform: uppercase;

            opacity: 0;

            transform:
                translateY(15px);

            transition:
                opacity .6s ease .6s,
                transform .7s ease .6s;
        }


        .login-wrapper.show .brand-subtitle {

            opacity: 1;

            transform:
                translateY(0);
        }


        /* =====================================================
           DESCRIPCIÓN
        ====================================================== */

        .brand-description {

            max-width: 340px;

            margin:
                30px auto 0;

            position: relative;

            z-index: 2;

            color:
                rgba(255,255,255,.72);

            font-size: 14px;

            line-height: 1.7;

            opacity: 0;

            transform:
                translateY(15px);

            transition:
                opacity .6s ease .75s,
                transform .7s ease .75s;
        }


        .login-wrapper.show .brand-description {

            opacity: 1;

            transform:
                translateY(0);
        }


        /* =====================================================
           CARACTERÍSTICAS
        ====================================================== */

        .brand-features {

            width: 100%;

            max-width: 350px;

            margin-top: 38px;

            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 12px;

            position: relative;

            z-index: 2;
        }


        .feature {

            padding:
                14px 7px;

            border-radius:
                12px;

            background:
                rgba(255,255,255,.07);

            border:
                1px solid
                rgba(255,255,255,.08);

            opacity: 0;

            transform:
                translateY(15px);

            transition:
                opacity .5s ease,
                transform .6s ease,
                background .2s ease,
                transform .2s ease;
        }


        .feature:nth-child(1) {
            transition-delay: .9s;
        }


        .feature:nth-child(2) {
            transition-delay: 1s;
        }


        .feature:nth-child(3) {
            transition-delay: 1.1s;
        }


        .login-wrapper.show .feature {

            opacity: 1;

            transform:
                translateY(0);
        }


        .feature:hover {

            background:
                rgba(255,255,255,.11);

            transform:
                translateY(-2px);
        }


        .feature i {

            display: block;

            margin-bottom: 6px;

            font-size: 18px;

            color:
                rgba(255,255,255,.9);
        }


        .feature span {

            display: block;

            color:
                rgba(255,255,255,.72);

            font-size: 10px;

            line-height: 1.3;
        }


        /* =====================================================
           PANEL DERECHO
        ====================================================== */

        .login-form-panel {

            min-width: 0;

            display: flex;

            align-items: center;

            justify-content: center;

            padding:
                55px 65px;

            background:
                #ffffff;
        }


        .login-form-content {

            width: 100%;

            max-width: 420px;

            opacity: 0;

            transform:
                translateX(25px);

            transition:
                opacity .7s ease .4s,
                transform .8s
                cubic-bezier(.22,1,.36,1) .4s;
        }


        .login-wrapper.show .login-form-content {

            opacity: 1;

            transform:
                translateX(0);
        }


        /* =====================================================
           CABECERA FORMULARIO
        ====================================================== */

        .form-top {

            margin-bottom:
                30px;
        }


        .form-top .small-title {

            margin: 0 0 8px;

            color:
                #9b3028;

            font-size: 11px;

            font-weight: 700;

            letter-spacing: 2px;

            text-transform:
                uppercase;
        }


        .form-top h2 {

            margin: 0;

            color:
                #302522;

            font-size: 30px;

            font-weight: 700;
        }


        .form-top p {

            margin:
                8px 0 0;

            color:
                #8d8581;

            font-size: 14px;
        }


        /* =====================================================
           DECORACIÓN
        ====================================================== */

        .form-decoration {

            display: flex;

            align-items: center;

            justify-content: flex-start;

            gap: 10px;

            margin-bottom:
                25px;

            color:
                #b28745;

            font-size: 12px;
        }


        .form-decoration::before,
        .form-decoration::after {

            content: "";

            width: 40px;

            height: 1px;

            background:
                #e1d8d2;
        }


        /* =====================================================
           ERROR GENERAL
        ====================================================== */

        .login-error {

            display: flex;

            align-items: flex-start;

            gap: 10px;

            margin-bottom: 22px;

            padding:
                13px 14px;

            border:
                1px solid #ecc7c3;

            border-radius:
                12px;

            background:
                #fff2f0;

            color:
                #8c2923;

            font-size: 13px;

            line-height:
                1.5;

            animation:
                errorAppear .35s ease;
        }


        .login-error i {

            flex-shrink: 0;

            margin-top: 1px;

            font-size: 17px;
        }


        @@keyframes errorAppear {

            from {
                opacity: 0;
                transform: translateY(-8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }

        }


        /* =====================================================
           LABEL
        ====================================================== */

        .login-form-panel .form-label {

            display: block;

            margin-bottom: 8px;

            color:
                #49332e;

            font-size: 14px;

            font-weight: 600;
        }


        /* =====================================================
           INPUT GROUP
        ====================================================== */

        .login-form-panel .input-group {

            width: 100%;

            min-height: 54px;

            overflow: hidden;

            border:
                1px solid #ded8d4;

            border-radius:
                12px;

            background:
                #ffffff;

            transition:
                border-color .2s ease,
                box-shadow .2s ease,
                transform .2s ease;
        }


        .login-form-panel .input-group:hover {

            border-color:
                #c9bfba;
        }


        .login-form-panel .input-group:focus-within {

            border-color:
                #9b3028;

            box-shadow:
                0 0 0 4px
                rgba(155,48,40,.09);

            transform:
                translateY(-1px);
        }


        /* =====================================================
           ICONO INPUT
        ====================================================== */

        .login-form-panel .input-group-text {

            border: none;

            background:
                transparent;

            color:
                #aa7a36;

            padding-left: 16px;

            padding-right: 10px;

            font-size: 17px;
        }


        /* =====================================================
           INPUT
        ====================================================== */

        .login-form-panel .form-control {

            height: 52px;

            min-width: 0;

            border: none !important;

            outline: none !important;

            box-shadow: none !important;

            background:
                transparent;

            color:
                #35231f;

            font-size: 14px;
        }


        .login-form-panel .form-control::placeholder {

            color:
                #b6aaa5;
        }


        /* =====================================================
           BOTÓN PASSWORD
        ====================================================== */

        .password-toggle {

            border: none !important;

            cursor: pointer;

            color:
                #a67a3a !important;

            background:
                transparent !important;

            padding:
                0 16px;

            transition:
                color .2s ease,
                background .2s ease;
        }


        .password-toggle:hover {

            color:
                #671f1b !important;

            background:
                rgba(103,31,27,.04) !important;
        }


        .password-toggle:focus {

            outline: none !important;

            box-shadow: none !important;
        }


        /* =====================================================
           ERRORES CAMPOS
        ====================================================== */

        .field-validation-error {

            display: block;

            margin-top: 6px;

            padding-left: 2px;

            color:
                #a52a24;

            font-size: 12px;

            font-weight: 500;

            animation:
                errorAppear .3s ease;
        }


        /* =====================================================
           BOTÓN LOGIN
        ====================================================== */

        .btn-login {

            width: 100%;

            min-height: 54px;

            margin-top: 4px;

            border: none !important;

            border-radius: 12px;

            color: #ffffff !important;

            background:
                linear-gradient(
                    135deg,
                    #9d3028,
                    #751f1b
                );

            font-size: 15px;

            font-weight: 700;

            letter-spacing: .2px;

            box-shadow:
                0 9px 20px
                rgba(117,31,27,.22);

            transition:
                transform .2s ease,
                box-shadow .2s ease,
                background .2s ease;
        }


        .btn-login:hover {

            color: #ffffff !important;

            background:
                linear-gradient(
                    135deg,
                    #8d2923,
                    #641915
                );

            transform:
                translateY(-2px);

            box-shadow:
                0 13px 25px
                rgba(117,31,27,.30);
        }


        .btn-login:active {

            transform:
                translateY(0);
        }


        /* =====================================================
           LOADING BOTÓN
        ====================================================== */

        .btn-login.loading {

            pointer-events: none;

            background:
                linear-gradient(
                    135deg,
                    #72201c,
                    #571714
                );

            cursor:
                wait;
        }


        .login-spinner {

            display: none;

            width: 16px;

            height: 16px;

            margin-right: 8px;

            vertical-align: -3px;

            border:
                2px solid
                rgba(255,255,255,.30);

            border-top-color:
                #ffffff;

            border-radius:
                50%;

            animation:
                loginSpin .7s linear infinite;
        }


        .btn-login.loading .login-spinner {

            display: inline-block;
        }


        .btn-login.loading .login-icon {

            display: none;
        }


        @@keyframes loginSpin {

            to {
                transform: rotate(360deg);
            }

        }


        /* =====================================================
           FOOTER
        ====================================================== */

        .footer-text {

            margin-top: 25px;

            text-align: center;

            color:
                #a0928c;

            font-size: 11px;

            line-height: 1.5;
        }


        .footer-text span {

            margin: 0 4px;

            color:
                #c3943b;
        }


        /* =====================================================
           OVERLAY LOGIN
        ====================================================== */

        .login-success-overlay {

            position: fixed;

            inset: 0;

            z-index: 100;

            display: flex;

            align-items: center;

            justify-content: center;

            padding: 20px;

            background:
                rgba(35,11,9,.42);

            backdrop-filter:
                blur(6px);

            -webkit-backdrop-filter:
                blur(6px);

            opacity: 0;

            visibility: hidden;

            pointer-events: none;

            transition:
                opacity .35s ease,
                visibility .35s ease;
        }


        .login-success-overlay.active {

            opacity: 1;

            visibility: visible;

            pointer-events: all;
        }


        /* =====================================================
           MENSAJE LOADING
        ====================================================== */

        .success-message {

            width: 100%;

            max-width: 340px;

            padding:
                32px 28px;

            border-radius:
                20px;

            background:
                rgba(255,253,249,.98);

            box-shadow:
                0 25px 70px
                rgba(0,0,0,.30);

            text-align: center;

            transform:
                translateY(18px)
                scale(.92);

            opacity: 0;

            transition:
                transform .45s
                cubic-bezier(.22,1,.36,1),
                opacity .35s ease;
        }


        .login-success-overlay.active
        .success-message {

            transform:
                translateY(0)
                scale(1);

            opacity: 1;
        }


        /* =====================================================
           SPINNER GRANDE
        ====================================================== */

        .success-spinner {

            width: 58px;

            height: 58px;

            margin:
                0 auto 18px;

            position: relative;

            border:
                4px solid
                #eaded9;

            border-top-color:
                #8f2923;

            border-right-color:
                #b28745;

            border-radius:
                50%;

            animation:
                successSpin .85s linear infinite;
        }


        @@keyframes successSpin {

            to {
                transform:
                    rotate(360deg);
            }

        }


        /* =====================================================
           CÍRCULO INTERNO
        ====================================================== */

        .success-spinner::after {

            content: "";

            position: absolute;

            top: 50%;
            left: 50%;

            width: 8px;
            height: 8px;

            transform:
                translate(-50%, -50%);

            border-radius: 50%;

            background:
                #8f2923;

            box-shadow:
                0 0 10px
                rgba(143,41,35,.30);
        }


        /* =====================================================
           TEXTO SUCCESS
        ====================================================== */

        .success-message strong {

            display: block;

            color:
                #3c2521;

            font-size: 17px;

            font-weight: 700;
        }


        .success-message span {

            display: block;

            margin-top: 6px;

            color:
                #8b7c76;

            font-size: 12px;
        }


        /* =====================================================
           PUNTO ANIMADO
        ====================================================== */

        .loading-dots {

            display: inline-flex;

            gap: 4px;

            margin-left: 3px;

            vertical-align: middle;
        }


        .loading-dots span {

            width: 4px;

            height: 4px;

            margin: 0;

            display: block;

            border-radius: 50%;

            background:
                #a67a3a;

            animation:
                dotPulse 1.2s infinite ease-in-out;
        }


        .loading-dots span:nth-child(1) {

            animation-delay:
                0s;
        }


        .loading-dots span:nth-child(2) {

            animation-delay:
                .15s;
        }


        .loading-dots span:nth-child(3) {

            animation-delay:
                .30s;
        }


        @@keyframes dotPulse {

            0%,
            60%,
            100% {
                opacity: .25;
                transform: scale(.75);
            }

            30% {
                opacity: 1;
                transform: scale(1);
            }

        }


        /* =====================================================
           TABLET
        ====================================================== */

        @@media (max-width: 900px) {

            .login-page {

                padding: 20px;
            }


            .login-wrapper {

                max-width: 760px;

                min-height: 560px;

                grid-template-columns:
                    42% 58%;
            }


            .login-brand {

                min-height: 560px;

                padding:
                    40px 25px;
            }


            .brand-logo {

                width: 78px;
                height: 78px;

                margin-bottom: 22px;
            }


            .brand-logo i {

                font-size: 38px;
            }


            .brand-title {

                font-size: 30px;
            }


            .brand-description {

                font-size: 13px;
            }


            .brand-features {

                grid-template-columns:
                    1fr;

                max-width: 180px;

                margin-top: 25px;
            }


            .feature {

                padding: 9px;
            }


            .feature i {

                display: inline-block;

                margin-right: 5px;

                margin-bottom: 0;
            }


            .login-form-panel {

                padding:
                    40px 38px;
            }

        }


        /* =====================================================
           MÓVIL
        ====================================================== */

        @@media (max-width: 700px) {

            .login-page {

                min-height: 100svh;

                padding:
                    15px;

                align-items: flex-start;
            }


            .login-wrapper {

                width: 100%;

                max-width: 500px;

                min-height: auto;

                display: flex;

                flex-direction: column;

                border-radius: 20px;

                margin:
                    auto 0;
            }


            .login-brand {

                min-height: auto;

                padding:
                    38px 25px 35px;
            }


            .brand-circle.circle-one {

                width: 280px;
                height: 280px;

                top: -180px;
                left: -150px;
            }


            .brand-circle.circle-two {

                width: 300px;
                height: 300px;

                right: -200px;
                bottom: -230px;
            }


            .brand-logo {

                width: 70px;
                height: 70px;

                margin-bottom: 17px;

                border-radius: 18px;
            }


            .brand-logo i {

                font-size: 34px;
            }


            .brand-title {

                font-size: 29px;
            }


            .brand-subtitle {

                margin-top: 7px;

                font-size: 9px;

                letter-spacing: 2px;
            }


            .brand-description {

                max-width: 320px;

                margin-top: 18px;

                font-size: 12px;

                line-height: 1.5;
            }


            .brand-features {

                display: none;
            }


            .login-form-panel {

                padding:
                    32px 25px 28px;
            }


            .login-form-content {

                max-width: none;
            }


            .form-top {

                margin-bottom: 24px;
            }


            .form-top .small-title {

                font-size: 10px;

                letter-spacing: 1.7px;
            }


            .form-top h2 {

                font-size: 25px;
            }


            .form-top p {

                font-size: 13px;
            }


            .form-decoration {

                margin-bottom: 21px;
            }


            .footer-text {

                margin-top: 20px;
            }


            .success-message {

                max-width: 310px;

                padding:
                    28px 22px;
            }

        }


        /* =====================================================
           CELULARES PEQUEÑOS
        ====================================================== */

        @@media (max-width: 400px) {

            .login-page {

                padding:
                    10px;
            }


            .login-wrapper {

                border-radius:
                    17px;
            }


            .login-brand {

                padding:
                    28px 18px 27px;
            }


            .brand-logo {

                width: 60px;
                height: 60px;

                margin-bottom: 14px;
            }


            .brand-logo i {

                font-size: 29px;
            }


            .brand-title {

                font-size: 25px;
            }


            .brand-description {

                display: none;
            }


            .login-form-panel {

                padding:
                    27px 18px 24px;
            }


            .form-top h2 {

                font-size: 23px;
            }


            .login-form-panel .input-group {

                min-height: 50px;
            }


            .login-form-panel .form-control {

                height: 48px;

                font-size: 13px;
            }


            .btn-login {

                min-height: 51px;
            }


            .success-spinner {

                width: 52px;

                height: 52px;
            }

        }


        /* =====================================================
           MUY PEQUEÑO
        ====================================================== */

        @@media (max-height: 650px) and (min-width: 701px) {

            .login-page {

                padding:
                    15px;
            }


            .login-wrapper {

                min-height:
                    540px;
            }


            .login-brand {

                min-height:
                    540px;

                padding:
                    30px 40px;
            }


            .brand-description {

                margin-top:
                    20px;
            }


            .brand-features {

                margin-top:
                    22px;
            }

        }


        /* =====================================================
           ACCESIBILIDAD
        ====================================================== */

        @@media (prefers-reduced-motion: reduce) {

            *,
            *::before,
            *::after {

                animation-duration:
                    .01ms !important;

                animation-iteration-count:
                    1 !important;

                transition-duration:
                    .01ms !important;
            }

        }

    </style>

</head>


<body>


    <!-- =====================================================
         PÁGINA
    ====================================================== -->

    <main class="login-page"
          id="loginPage">


        <!-- =================================================
             DECORACIÓN
        ================================================== -->

        <div class="background-circle one"></div>

        <div class="background-circle two"></div>


        <!-- =================================================
             CONTENEDOR
        ================================================== -->

        <div class="login-wrapper"
             id="loginWrapper">


            <!-- =================================================
                 PANEL IZQUIERDO
            ================================================== -->

            <section class="login-brand">


                <div class="brand-circle circle-one"></div>

                <div class="brand-circle circle-two"></div>


                <!-- =================================================
                     LOGO
                ================================================== -->

                <div class="brand-logo">

                    <i class="bi bi-shop-window"></i>

                </div>


                <!-- =================================================
                     TITULO
                ================================================== -->

                <h1 class="brand-title">

                    Restaurante

                </h1>


                <p class="brand-subtitle">

                    Sistema de Gestión

                </p>


                <!-- =================================================
                     DESCRIPCIÓN
                ================================================== -->

                <p class="brand-description">

                    Administra tu restaurante de forma sencilla,
                    rápida y segura desde un solo lugar.

                </p>


                <!-- =================================================
                     CARACTERÍSTICAS
                ================================================== -->

                <div class="brand-features">


                    <div class="feature">

                        <i class="bi bi-person-check-fill"></i>

                        <span>
                            Acceso personalizado
                        </span>

                    </div>


                    <div class="feature">

                        <i class="bi bi-speedometer2"></i>

                        <span>
                            Gestión rápida
                        </span>

                    </div>


                    <div class="feature">

                        <i class="bi bi-shield-lock-fill"></i>

                        <span>
                            Sesión protegida
                        </span>

                    </div>


                </div>


            </section>


            <!-- =================================================
                 PANEL DERECHO
            ================================================== -->

            <section class="login-form-panel">


                <div class="login-form-content">


                    <!-- =================================================
                         CABECERA
                    ================================================== -->

                    <div class="form-top">

                        <p class="small-title">
                            Acceso administrativo
                        </p>

                        <h2>
                            Bienvenido
                        </h2>

                        <p>
                            Ingresa tus datos para continuar.
                        </p>

                    </div>


                    <!-- =================================================
                         DECORACIÓN
                    ================================================== -->

                    <div class="form-decoration">

                        ✦

                    </div>


                    <!-- =================================================
                         ERROR GENERAL
                    ================================================== -->

                    @if (!string.IsNullOrWhiteSpace(errorGeneral))
                    {
                        <div class="login-error"
                             role="alert">

                            <i class="bi bi-exclamation-circle-fill"></i>

                            <div>
                                @errorGeneral
                            </div>

                        </div>
                    }


                    <!-- =================================================
                         FORMULARIO
                    ================================================== -->

                    <form asp-controller="Account"
                          asp-action="Login"
                          method="post"
                          id="loginForm">


                        @Html.AntiForgeryToken()


                        <!-- =================================================
                             RETURN URL
                        ================================================== -->

                        <input type="hidden"
                               name="returnUrl"
                               value="@ViewBag.ReturnUrl" />


                        <!-- =================================================
                             USUARIO
                        ================================================== -->

                        <div class="mb-4">


                            <label for="usuario"
                                   class="form-label">

                                Usuario

                            </label>


                            <div class="input-group">


                                <span class="input-group-text">

                                    <i class="bi bi-person-fill"></i>

                                </span>


                                <input type="text"
                                       id="usuario"
                                       name="usuario"
                                       class="form-control"
                                       placeholder="Ingrese su usuario"
                                       autocomplete="username"
                                       value="@usuarioActual" />

                            </div>


                            @if (ViewData.ModelState.TryGetValue("usuario", out var usuarioErrors))
                            {
                                if (usuarioErrors != null &&
                                    usuarioErrors.Errors.Count > 0)
                                {
                                    <span class="field-validation-error">

                                        @usuarioErrors.Errors[0].ErrorMessage

                                    </span>
                                }
                            }


                        </div>


                        <!-- =================================================
                             CONTRASEÑA
                        ================================================== -->

                        <div class="mb-4">


                            <label for="password"
                                   class="form-label">

                                Contraseña

                            </label>


                            <div class="input-group">


                                <span class="input-group-text">

                                    <i class="bi bi-lock-fill"></i>

                                </span>


                                <input type="password"
                                       id="password"
                                       name="password"
                                       class="form-control"
                                       placeholder="Ingrese su contraseña"
                                       autocomplete="current-password" />


                                <button type="button"
                                        class="input-group-text password-toggle"
                                        id="togglePassword"
                                        aria-label="Mostrar contraseña"
                                        title="Mostrar contraseña">

                                    <i class="bi bi-eye-fill"></i>

                                </button>


                            </div>


                            @if (ViewData.ModelState.TryGetValue("password", out var passwordErrors))
                            {
                                if (passwordErrors != null &&
                                    passwordErrors.Errors.Count > 0)
                                {
                                    <span class="field-validation-error">

                                        @passwordErrors.Errors[0].ErrorMessage

                                    </span>
                                }
                            }


                        </div>


                        <!-- =================================================
                             BOTÓN
                        ================================================== -->

                        <button type="submit"
                                class="btn btn-login"
                                id="loginButton">


                            <span class="login-spinner"></span>


                            <i class="bi bi-box-arrow-in-right me-2 login-icon"></i>


                            <span class="login-button-text">

                                Iniciar Sesión

                            </span>


                        </button>


                    </form>


                    <!-- =================================================
                         FOOTER
                    ================================================== -->

                    <div class="footer-text">

                        <span>✦</span>

                        Panel administrativo del restaurante

                        <span>✦</span>

                    </div>


                </div>


            </section>


        </div>


    </main>


    <!-- =====================================================
         OVERLAY LOGIN
    ====================================================== -->

    <div class="login-success-overlay"
         id="loginSuccessOverlay"
         aria-hidden="true">


        <div class="success-message"
             role="status"
             aria-live="polite">


            <!-- =================================================
                 SPINNER
            ================================================== -->

            <div class="success-spinner"></div>


            <!-- =================================================
                 MENSAJE
            ================================================== -->

            <strong>

                ¡Bienvenido al sistema!

            </strong>


            <span>

                Entrando al panel

                <span class="loading-dots">

                    <span></span>
                    <span></span>
                    <span></span>

                </span>

            </span>


        </div>


    </div>


    <!-- =====================================================
         BOOTSTRAP JS
    ====================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


    <script>

        document.addEventListener("DOMContentLoaded", function () {


            /* =====================================================
               ELEMENTOS
            ===================================================== */

            const loginPage =
                document.getElementById("loginPage");

            const loginWrapper =
                document.getElementById("loginWrapper");

            const loginForm =
                document.getElementById("loginForm");

            const loginButton =
                document.getElementById("loginButton");

            const togglePassword =
                document.getElementById("togglePassword");

            const passwordInput =
                document.getElementById("password");

            const successOverlay =
                document.getElementById(
                    "loginSuccessOverlay"
                );


            /* =====================================================
               ANIMACIÓN DE ENTRADA
            ===================================================== */

            setTimeout(function () {

                if (loginPage) {

                    loginPage.classList.add("visible");

                }

            }, 50);


            setTimeout(function () {

                if (loginWrapper) {

                    loginWrapper.classList.add("show");

                }

            }, 120);


            /* =====================================================
               MOSTRAR / OCULTAR CONTRASEÑA
            ===================================================== */

            if (
                togglePassword &&
                passwordInput
            ) {

                togglePassword.addEventListener(
                    "click",
                    function () {

                        const mostrar =
                            passwordInput.type === "password";


                        passwordInput.type =
                            mostrar
                                ? "text"
                                : "password";


                        const icon =
                            togglePassword.querySelector("i");


                        if (!icon) {
                            return;
                        }


                        if (mostrar) {

                            icon.classList.remove(
                                "bi-eye-fill"
                            );

                            icon.classList.add(
                                "bi-eye-slash-fill"
                            );

                            togglePassword.setAttribute(
                                "aria-label",
                                "Ocultar contraseña"
                            );

                            togglePassword.setAttribute(
                                "title",
                                "Ocultar contraseña"
                            );

                        }
                        else {

                            icon.classList.remove(
                                "bi-eye-slash-fill"
                            );

                            icon.classList.add(
                                "bi-eye-fill"
                            );

                            togglePassword.setAttribute(
                                "aria-label",
                                "Mostrar contraseña"
                            );

                            togglePassword.setAttribute(
                                "title",
                                "Mostrar contraseña"
                            );

                        }

                    }
                );

            }


            /* =====================================================
               SUBMIT
            ===================================================== */

            if (
                loginForm &&
                loginButton
            ) {

                loginForm.addEventListener(
                    "submit",
                    function (event) {


                        /* -----------------------------------------
                           EVITAR DOBLE ENVÍO
                        ----------------------------------------- */

                        if (
                            loginButton.classList.contains(
                                "loading"
                            )
                        ) {

                            event.preventDefault();

                            return;

                        }


                        /* -----------------------------------------
                           OBTENER CAMPOS
                        ----------------------------------------- */

                        const usuario =
                            document.getElementById("usuario");

                        const password =
                            document.getElementById("password");


                        /* -----------------------------------------
                           VALIDACIÓN BÁSICA
                        ----------------------------------------- */

                        if (
                            !usuario ||
                            !password
                        ) {

                            return;

                        }


                        const usuarioValue =
                            usuario.value.trim();

                        const passwordValue =
                            password.value.trim();


                        /* -----------------------------------------
                           NO MOSTRAR LOADING SI ESTÁ VACÍO
                        ----------------------------------------- */

                        if (
                            usuarioValue === "" ||
                            passwordValue === ""
                        ) {

                            return;

                        }


                        /* -----------------------------------------
                           ESTADO LOADING DEL BOTÓN
                        ----------------------------------------- */

                        loginButton.classList.add(
                            "loading"
                        );


                        const buttonText =
                            loginButton.querySelector(
                                ".login-button-text"
                            );


                        if (buttonText) {

                            buttonText.textContent =
                                "Iniciando sesión...";

                        }


                        /* -----------------------------------------
                           DESACTIVAR CAMPOS
                        ----------------------------------------- */

                        usuario.readOnly = true;

                        password.readOnly = true;


                        /* -----------------------------------------
                           MOSTRAR OVERLAY
                        ----------------------------------------- */

                        if (successOverlay) {

                            setTimeout(function () {

                                successOverlay.classList.add(
                                    "active"
                                );

                                successOverlay.setAttribute(
                                    "aria-hidden",
                                    "false"
                                );

                            }, 180);

                        }

                    }
                );

            }


            /* =====================================================
               ENTER EN LOS CAMPOS
            ===================================================== */

            const inputs =
                document.querySelectorAll(
                    "#usuario, #password"
                );


            inputs.forEach(function (input) {

                input.addEventListener(
                    "keydown",
                    function (event) {

                        if (
                            event.key === "Enter" &&
                            loginButton &&
                            !loginButton.classList.contains("loading")
                        ) {

                            loginForm.requestSubmit();

                        }

                    }
                );

            });

        });

    </script>


</body>

</html>
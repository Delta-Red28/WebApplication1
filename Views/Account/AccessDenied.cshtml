@{
    Layout = null;
    ViewData["Title"] = "Acceso Denegado";
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Acceso Denegado - Restaurante</title>


    <!-- Bootstrap -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />


    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <style>

            * {
                box-sizing: border-box;
            }


            /* FONDO */

            body {
                min-height: 100vh;
                margin: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: "Segoe UI", sans-serif;
                background: linear-gradient( rgba(47, 18, 13, 0.88), rgba(47, 18, 13, 0.92) ), url("https://images.unsplash.com/photo-1515003197210-e0cd71810b5f?auto=format&fit=crop&w=1920&q=80");
                background-size: cover;
                background-position: center;
                background-attachment: fixed;
                padding: 20px;
            }


            /*CONTENEDOR */

            .access-container {
                width: 100%;
                max-width: 500px;
            }


            /*TARJETA*/

            .access-card {
                border: none;
                border-radius: 26px;
                overflow: hidden;
                background: #fffaf3;
                box-shadow: 0 25px 60px rgba(0, 0, 0, 0.35);
            }


            /* ENCABEZADO */

            .access-header {
                position: relative;
                text-align: center;
                padding: 45px 30px 38px;
                background: #671f1b;
                color: white;
            }


                /* Decoración inferior */

                .access-header::after {
                    content: "";
                    position: absolute;
                    bottom: -12px;
                    left: 0;
                    width: 100%;
                    height: 25px;
                    background: #671f1b;
                    clip-path: polygon( 0 0, 5% 40%, 10% 0, 15% 40%, 20% 0, 25% 40%, 30% 0, 35% 40%, 40% 0, 45% 40%, 50% 0, 55% 40%, 60% 0, 65% 40%, 70% 0, 75% 40%, 80% 0, 85% 40%, 90% 0, 95% 40%, 100% 0 );
                }


            /*ICONO */

            .access-icon {
                width: 85px;
                height: 85px;
                margin: 0 auto 18px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                background: #d9a441;
                color: #671f1b;
                font-size: 38px;
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
            }


            /*TITULO*/

            .access-header h2 {
                margin: 0;
                font-family: Georgia, serif;
                font-size: 32px;
                font-weight: 700;
            }


            .access-header p {
                margin-top: 8px;
                margin-bottom: 0;
                color: #f4dca6;
                font-size: 14px;
                letter-spacing: 1px;
                text-transform: uppercase;
            }


            /*CUERPO*/

            .access-body {
                padding: 48px 42px 38px;
                text-align: center;
            }


            /*DECORACIÓN*/

            .food-decoration {
                color: #d9a441;
                font-size: 18px;
                letter-spacing: 8px;
                margin-bottom: 18px;
            }


            /*MENSAJE*/

            .access-message h5 {
                color: #3e2723;
                font-size: 21px;
                font-weight: 700;
                margin-bottom: 10px;
            }


            .access-message p {
                color: #8a7770;
                font-size: 15px;
                line-height: 1.6;
                margin-bottom: 25px;
            }


            /*ALERTA */

            .access-alert {
                padding: 14px 18px;
                border-radius: 12px;
                background: #f8dfdc;
                color: #7a211c;
                font-size: 14px;
                margin-bottom: 25px;
            }


            /*BOTON*/

            .btn-login {
                width: 100%;
                height: 52px;
                border: none;
                border-radius: 13px;
                background: #8f2923;
                color: white;
                font-size: 16px;
                font-weight: 700;
                transition: all 0.25s ease;
                box-shadow: 0 5px 15px rgba(143, 41, 35, 0.25);
            }


                .btn-login:hover {
                    background: #6f1e1a;
                    color: white;
                    transform: translateY(-2px);
                    box-shadow: 0 8px 20px rgba(143, 41, 35, 0.35);
                }


                .btn-login:active {
                    transform: translateY(0);
                }


            /*PIE*/

            .footer-text {
                text-align: center;
                margin-top: 24px;
                color: #9a8981;
                font-size: 12px;
            }


                .footer-text span {
                    color: #9b6b2f;
                }


            /*RESPONSIVE */

            @@media (max-width: 480px) {

                body {
                    background-attachment: scroll;
                    padding: 15px;
                }

                .access-header {
                    padding: 38px 20px 32px;
                }

                    .access-header h2 {
                        font-size: 28px;
                    }

                .access-icon {
                    width: 75px;
                    height: 75px;
                    font-size: 32px;
                }

                .access-body {
                    padding: 40px 24px 30px;
                }
            }

    </style>

</head>


<body>


    <div class="access-container">


        <div class="card access-card">


            <!-- ENCABEZADO-->

            <div class="access-header">


                <div class="access-icon">

                    <i class="bi bi-shield-lock-fill"></i>

                </div>


                <h2>
                    Acceso Denegado
                </h2>


                <p>
                    Sistema de Gestión
                </p>


            </div>


            <!-- CUERPO -->

            <div class="access-body">


                <div class="food-decoration">
                    • • •
                </div>


                <div class="access-message">

                    <h5>
                        No tienes permiso para acceder
                    </h5>


                    <p>
                        Tu cuenta no cuenta con los permisos necesarios
                        para acceder a esta sección del sistema.
                    </p>

                </div>


                <div class="access-alert">

                    <i class="bi bi-exclamation-circle-fill me-2"></i>

                    Si crees que esto es un error,
                    contacta al administrador del sistema.

                </div>


                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-login">

                    <i class="bi bi-house-door-fill me-2"></i>

                    Volver al inicio

                </a>


                <div class="footer-text">

                    <span>✦</span>

                    Panel administrativo del restaurante

                    <span>✦</span>

                </div>


            </div>


        </div>


    </div>


</body>

</html>
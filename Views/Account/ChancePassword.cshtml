@model WebApplication1.Controllers.CambiarPasswordViewModel

@{
    Layout = null;
    ViewData["Title"] = "Cambiar Contraseña";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Cambiar Contraseña - Restaurante</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
            body {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #f4f6f9;
            }

            .password-container {
                width: 100%;
                max-width: 460px;
            }

            .password-card {
                border: none;
                border-radius: 15px;
                box-shadow: 0 5px 25px rgba(0,0,0,0.10);
            }

            .password-header {
                text-align: center;
                padding: 30px 25px 10px;
            }

                .password-header h2 {
                    font-weight: 600;
                }

                .password-header p {
                    color: #6c757d;
                }

            .password-body {
                padding: 25px 30px 30px;
            }

            .form-control {
                height: 45px;
            }

            .btn-password {
                width: 100%;
                height: 45px;
                font-weight: 500;
            }

            .required-message {
                font-size: 0.9rem;
            }
    </style>
</head>

<body>

    <div class="password-container">

        <div class="card password-card">

            <div class="password-header">
                <h2>Cambiar Contraseña</h2>

                <p class="mb-0">
                    Por seguridad, debe establecer una nueva contraseña
                    antes de continuar.
                </p>
            </div>

            <div class="password-body">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert">
                </div>

                <div class="alert alert-warning" role="alert">
                    Su contraseña actual es una contraseña inicial.
                    Debe cambiarla para continuar utilizando el sistema.
                </div>

                <form asp-controller="Account"
                      asp-action="CambiarPassword"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="PasswordActual"
                               class="form-label">
                            Contraseña actual
                        </label>

                        <input asp-for="PasswordActual"
                               class="form-control"
                               autocomplete="current-password"
                               placeholder="Ingrese su contraseña actual" />

                        <span asp-validation-for="PasswordActual"
                              class="text-danger required-message">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NuevaPassword"
                               class="form-label">
                            Nueva contraseña
                        </label>

                        <input asp-for="NuevaPassword"
                               class="form-control"
                               autocomplete="new-password"
                               placeholder="Ingrese su nueva contraseña" />

                        <span asp-validation-for="NuevaPassword"
                              class="text-danger required-message">
                        </span>

                        <div class="form-text">
                            La nueva contraseña debe tener al menos
                            8 caracteres.
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmarPassword"
                               class="form-label">
                            Confirmar nueva contraseña
                        </label>

                        <input asp-for="ConfirmarPassword"
                               class="form-control"
                               autocomplete="new-password"
                               placeholder="Repita su nueva contraseña" />

                        <span asp-validation-for="ConfirmarPassword"
                              class="text-danger required-message">
                        </span>
                    </div>

                    <button type="submit"
                            class="btn btn-primary btn-password">
                        Cambiar contraseña
                    </button>

                </form>

                <div class="text-center mt-3">
                    <a asp-controller="Account"
                       asp-action="Logout"
                       class="text-decoration-none">
                        Cerrar sesión
                    </a>
                </div>

            </div>
        </div>

    </div>

</body>
</html>
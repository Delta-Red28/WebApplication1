@model WebApplication1.Models.CambiarPasswordViewModel

@{
    Layout = null;
    ViewData["Title"] = "Cambiar Contraseña";

    bool debeCambiarPassword =
        ViewBag.DebeCambiarPassword == true;
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Cambiar Contraseña - Restaurante</title>


    <!-- =========================================================
         BOOTSTRAP
         ========================================================= -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />


    <!-- =========================================================
         BOOTSTRAP ICONS
         ========================================================= -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <style>

        /* =========================================================
           GENERAL
           ========================================================= */

        * {
            box-sizing: border-box;
        }


        /* =========================================================
           FONDO
           ========================================================= */

        body {
            min-height: 100vh;
            margin: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            font-family: "Segoe UI", sans-serif;

            background:
                linear-gradient(
                    rgba(47, 18, 13, 0.88),
                    rgba(47, 18, 13, 0.92)
                ),
                url("https://images.unsplash.com/photo-1515003197210-e0cd71810b5f?auto=format&fit=crop&w=1920&q=80");

            background-size: cover;
            background-position: center;
            background-attachment: fixed;

            padding: 20px;
        }


        /* =========================================================
           CONTENEDOR
           ========================================================= */

        .password-container {
            width: 100%;
            max-width: 500px;
        }


        /* =========================================================
           TARJETA
           ========================================================= */

        .password-card {
            border: none;
            border-radius: 26px;

            overflow: hidden;

            background: #fffaf3;

            box-shadow:
                0 25px 60px rgba(0, 0, 0, 0.35);
        }


        /* =========================================================
           ENCABEZADO
           ========================================================= */

        .password-header {
            position: relative;

            text-align: center;

            padding: 40px 30px 38px;

            background: #671f1b;

            color: white;
        }


        /* Decoración inferior */

        .password-header::after {
            content: "";

            position: absolute;

            bottom: -12px;
            left: 0;

            width: 100%;
            height: 25px;

            background: #671f1b;

            clip-path: polygon(
                0 0,
                5% 40%,
                10% 0,
                15% 40%,
                20% 0,
                25% 40%,
                30% 0,
                35% 40%,
                40% 0,
                45% 40%,
                50% 0,
                55% 40%,
                60% 0,
                65% 40%,
                70% 0,
                75% 40%,
                80% 0,
                85% 40%,
                90% 0,
                95% 40%,
                100% 0
            );
        }


        /* =========================================================
           ICONO
           ========================================================= */

        .password-icon {
            width: 80px;
            height: 80px;

            margin: 0 auto 17px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;

            background: #d9a441;

            color: #671f1b;

            font-size: 35px;

            box-shadow:
                0 8px 20px rgba(0, 0, 0, 0.25);
        }


        /* =========================================================
           TITULO
           ========================================================= */

        .password-header h2 {
            margin: 0;

            font-family: Georgia, serif;

            font-size: 30px;
            font-weight: 700;

            letter-spacing: 0.5px;
        }


        .password-header p {
            margin-top: 9px;
            margin-bottom: 0;

            color: #f4dca6;

            font-size: 14px;

            line-height: 1.5;
        }


        /* =========================================================
           CUERPO
           ========================================================= */

        .password-body {
            padding: 45px 42px 35px;
        }


        /* =========================================================
           DECORACION
           ========================================================= */

        .food-decoration {
            text-align: center;

            color: #d9a441;

            font-size: 18px;

            letter-spacing: 8px;

            margin-bottom: 15px;
        }


        /* =========================================================
           MENSAJE
           ========================================================= */

        .security-message {
            text-align: center;

            color: #6f5c55;

            font-size: 14px;

            margin-bottom: 25px;
        }


        /* =========================================================
           ALERTAS
           ========================================================= */

        .alert {
            border: none;

            border-radius: 12px;

            font-size: 14px;
        }


        /* ALERTA CAMBIO OBLIGATORIO */

        .alert-warning {
            background: #fff0c9;

            color: #72541d;
        }


        /* ALERTA CAMBIO VOLUNTARIO */

        .alert-info {
            background: #e5f1f5;

            color: #285866;
        }


        /* ALERTA ERROR */

        .alert-danger {
            background: #f8dfdc;

            color: #7a211c;
        }


        /* =========================================================
           LABELS
           ========================================================= */

        .form-label {
            color: #4e342e;

            font-size: 15px;

            font-weight: 600;

            margin-bottom: 8px;
        }


        /* =========================================================
           INPUT GROUP
           ========================================================= */

        .input-group {
            border-radius: 13px;

            overflow: hidden;

            background: white;

            border: 1px solid #e2d5c9;

            transition: all 0.25s ease;
        }


        .input-group:focus-within {
            border-color: #a52a24;

            box-shadow:
                0 0 0 3px rgba(165, 42, 36, 0.12);
        }


        /* =========================================================
           ICONOS INPUT
           ========================================================= */

        .input-group-text {
            border: none;

            background: transparent;

            color: #9b6b2f;

            font-size: 17px;

            padding-left: 15px;

            padding-right: 12px;
        }


        /* =========================================================
           INPUT
           ========================================================= */

        .form-control {
            height: 50px;

            border: none !important;

            box-shadow: none !important;

            background: transparent;

            color: #3e2723;

            font-size: 15px;
        }


        .form-control::placeholder {
            color: #b5aaa4;
        }


        /* =========================================================
           BOTON MOSTRAR PASSWORD
           ========================================================= */

        .password-toggle {
            border: none;

            background: transparent;

            color: #9b6b2f;

            cursor: pointer;

            padding: 0 16px;

            transition: color 0.2s ease;
        }


        .password-toggle:hover {
            color: #671f1b;
        }


        .password-toggle:focus {
            outline: none;

            box-shadow: none;
        }


        .password-toggle i {
            font-size: 18px;
        }


        /* =========================================================
           MENSAJES VALIDACION
           ========================================================= */

        .required-message {
            display: block;

            font-size: 0.85rem;

            margin-top: 5px;
        }


        /* =========================================================
           AYUDA PASSWORD
           ========================================================= */

        .form-text {
            color: #8a7770;

            font-size: 12px;

            margin-top: 7px;
        }


        /* =========================================================
           CONTENEDOR BOTONES
           ========================================================= */

        .buttons-container {
            display: flex;

            gap: 12px;

            margin-top: 5px;
        }


        /* =========================================================
           BOTON CAMBIAR PASSWORD
           ========================================================= */

        .btn-password {
            width: 100%;

            height: 54px;

            border: none;

            border-radius: 13px;

            background: #8f2923;

            color: white;

            font-size: 16px;

            font-weight: 700;

            letter-spacing: 0.3px;

            transition: all 0.25s ease;

            box-shadow:
                0 5px 15px rgba(143, 41, 35, 0.25);
        }


        .btn-password:hover {
            background: #6f1e1a;

            color: white;

            transform: translateY(-2px);

            box-shadow:
                0 8px 20px rgba(143, 41, 35, 0.35);
        }


        .btn-password:active {
            transform: translateY(0);
        }


        /* =========================================================
           BOTON CANCELAR
           ========================================================= */

        .btn-cancel {
            width: 100%;

            height: 54px;

            border: 2px solid #d8c8bd;

            border-radius: 13px;

            background: transparent;

            color: #6f5c55;

            font-size: 15px;

            font-weight: 600;

            transition: all 0.25s ease;
        }


        .btn-cancel:hover {
            background: #f4ebe4;

            border-color: #b9a69b;

            color: #4e342e;

            transform: translateY(-2px);
        }


        .btn-cancel:active {
            transform: translateY(0);
        }


        .btn-cancel:focus {
            outline: none;

            box-shadow:
                0 0 0 3px rgba(143, 41, 35, 0.12);
        }


        /* =========================================================
           PIE
           ========================================================= */

        .footer-text {
            text-align: center;

            margin-top: 22px;

            color: #9a8981;

            font-size: 12px;
        }


        .footer-text span {
            color: #9b6b2f;
        }


        /* =========================================================
           RESPONSIVE
           ========================================================= */

        @@media (max-width: 480px) {

            body {
                background-attachment: scroll;

                padding: 15px;
            }


            .password-header {
                padding: 35px 20px 32px;
            }


            .password-header h2 {
                font-size: 27px;
            }


            .password-icon {
                width: 72px;
                height: 72px;

                font-size: 31px;
            }


            .password-body {
                padding: 40px 24px 30px;
            }


            .buttons-container {
                flex-direction: column;
            }

        }

    </style>

</head>


<body>


    <div class="password-container">


        <div class="card password-card">


            <!-- =====================================================
                 ENCABEZADO
                 ===================================================== -->

            <div class="password-header">


                <div class="password-icon">

                    @if (debeCambiarPassword)
                    {
                        <i class="bi bi-shield-lock-fill"></i>
                    }
                    else
                    {
                        <i class="bi bi-key-fill"></i>
                    }

                </div>


                <h2>
                    Cambiar Contraseña
                </h2>


                <p>
                    Protege tu cuenta estableciendo una nueva contraseña
                </p>


            </div>


            <!-- =====================================================
                 CUERPO
                 ===================================================== -->

            <div class="password-body">


                <!-- =================================================
                     DECORACION
                     ================================================= -->

                <div class="food-decoration">
                    • • •
                </div>


                <!-- =================================================
                     MENSAJE DINAMICO
                     ================================================= -->

                @if (debeCambiarPassword)
                {

                    <!-- CAMBIO OBLIGATORIO -->

                    <div class="security-message">

                        <i class="bi bi-shield-exclamation me-1"></i>

                        Por seguridad, debe establecer una nueva
                        contraseña antes de continuar.

                    </div>


                    <div class="alert alert-warning mb-4"
                         role="alert">

                        <i class="bi bi-exclamation-triangle-fill me-2"></i>

                        <strong>Acción requerida.</strong>

                        Su contraseña actual es una contraseña inicial.
                        Debe cambiarla para continuar utilizando
                        el sistema.

                    </div>

                }
                else
                {

                    <!-- CAMBIO VOLUNTARIO -->

                    <div class="security-message">

                        <i class="bi bi-shield-check me-1"></i>

                        Puede cambiar su contraseña cuando lo desee
                        para mantener segura su cuenta.

                    </div>


                    <div class="alert alert-info mb-4"
                         role="alert">

                        <i class="bi bi-info-circle-fill me-2"></i>

                        Está cambiando su contraseña actual.
                        Recuerde utilizar una contraseña segura y
                        diferente a la anterior.

                    </div>

                }


                <!-- =================================================
                     ERRORES DE VALIDACION
                     ================================================= -->

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert">
                </div>


                <!-- =================================================
                     FORMULARIO
                     ================================================= -->

                <form asp-controller="Account"
                      asp-action="CambiarPassword"
                      method="post">


                    @Html.AntiForgeryToken()


                    <!-- =================================================
                         CONTRASEÑA ACTUAL
                         ================================================= -->

                    <div class="mb-3">


                        <label asp-for="PasswordActual"
                               class="form-label">

                            Contraseña actual

                        </label>


                        <div class="input-group">


                            <span class="input-group-text">

                                <i class="bi bi-lock-fill"></i>

                            </span>


                            <input asp-for="PasswordActual"
                                   id="PasswordActual"
                                   class="form-control"
                                   type="password"
                                   autocomplete="current-password"
                                   placeholder="Ingrese su contraseña actual" />


                            <button type="button"
                                    class="input-group-text password-toggle"
                                    data-target="PasswordActual"
                                    aria-label="Mostrar contraseña"
                                    title="Mostrar contraseña">

                                <i class="bi bi-eye-fill"></i>

                            </button>


                        </div>


                        <span asp-validation-for="PasswordActual"
                              class="text-danger required-message">
                        </span>


                    </div>


                    <!-- =================================================
                         NUEVA CONTRASEÑA
                         ================================================= -->

                    <div class="mb-3">


                        <label asp-for="NuevaPassword"
                               class="form-label">

                            Nueva contraseña

                        </label>


                        <div class="input-group">


                            <span class="input-group-text">

                                <i class="bi bi-key-fill"></i>

                            </span>


                            <input asp-for="NuevaPassword"
                                   id="NuevaPassword"
                                   class="form-control"
                                   type="password"
                                   autocomplete="new-password"
                                   placeholder="Ingrese su nueva contraseña" />


                            <button type="button"
                                    class="input-group-text password-toggle"
                                    data-target="NuevaPassword"
                                    aria-label="Mostrar contraseña"
                                    title="Mostrar contraseña">

                                <i class="bi bi-eye-fill"></i>

                            </button>


                        </div>


                        <span asp-validation-for="NuevaPassword"
                              class="text-danger required-message">
                        </span>


                        <div class="form-text">

                            <i class="bi bi-info-circle me-1"></i>

                            La nueva contraseña debe tener al menos
                            8 caracteres.

                        </div>


                    </div>


                    <!-- =================================================
                         CONFIRMAR CONTRASEÑA
                         ================================================= -->

                    <div class="mb-4">


                        <label asp-for="ConfirmarPassword"
                               class="form-label">

                            Confirmar nueva contraseña

                        </label>


                        <div class="input-group">


                            <span class="input-group-text">

                                <i class="bi bi-shield-check"></i>

                            </span>


                            <input asp-for="ConfirmarPassword"
                                   id="ConfirmarPassword"
                                   class="form-control"
                                   type="password"
                                   autocomplete="new-password"
                                   placeholder="Repita su nueva contraseña" />


                            <button type="button"
                                    class="input-group-text password-toggle"
                                    data-target="ConfirmarPassword"
                                    aria-label="Mostrar contraseña"
                                    title="Mostrar contraseña">

                                <i class="bi bi-eye-fill"></i>

                            </button>


                        </div>


                        <span asp-validation-for="ConfirmarPassword"
                              class="text-danger required-message">
                        </span>


                    </div>


                    <!-- =================================================
                         BOTON CAMBIAR
                         ================================================= -->

                    <div class="buttons-container">


                        <button type="submit"
                                class="btn btn-password">

                            <i class="bi bi-check-circle-fill me-2"></i>

                            Cambiar contraseña

                        </button>


                    </div>


                </form>


                <!-- =====================================================
                     CANCELAR / CERRAR SESION

                     IMPORTANTE:
                     Logout en el controlador es [HttpPost].

                     Por eso NO usamos:

                     <a asp-action="Logout">

                     porque eso genera GET /Account/Logout y produce
                     el error 404/405.

                     Utilizamos un FORM POST.
                     ===================================================== -->

                <div class="buttons-container mt-3">


                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="w-100">


                        @Html.AntiForgeryToken()


                        <button type="submit"
                                class="btn btn-cancel">

                            <i class="bi bi-x-circle me-2"></i>

                            Cancelar

                        </button>


                    </form>


                </div>


                <!-- =================================================
                     TEXTO INFORMATIVO DEL CANCELAR
                     ================================================= -->

                @if (debeCambiarPassword)
                {

                    <div class="text-center mt-2">

                        <small class="text-muted">

                            Al cancelar, se cerrará su sesión.

                        </small>

                    </div>

                }
                else
                {

                    <div class="text-center mt-2">

                        <small class="text-muted">

                            Al cancelar, se cerrará su sesión.

                        </small>

                    </div>

                }


                <!-- =================================================
                     PIE
                     ================================================= -->

                <div class="footer-text">

                    <span>✦</span>

                    Panel administrativo del restaurante

                    <span>✦</span>

                </div>


            </div>


        </div>


    </div>


    <!-- =============================================================
         BOOTSTRAP JS
         ============================================================= -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


    <!-- =============================================================
         MOSTRAR / OCULTAR CONTRASEÑAS
         ============================================================= -->

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const toggleButtons =
                    document.querySelectorAll(
                        ".password-toggle"
                    );


                toggleButtons.forEach(
                    function (button) {

                        button.addEventListener(
                            "click",
                            function () {

                                // =====================================
                                // OBTENER ID DEL INPUT
                                // =====================================

                                const targetId =
                                    this.getAttribute(
                                        "data-target"
                                    );


                                // =====================================
                                // OBTENER INPUT
                                // =====================================

                                const passwordInput =
                                    document.getElementById(
                                        targetId
                                    );


                                // =====================================
                                // OBTENER ICONO
                                // =====================================

                                const icon =
                                    this.querySelector("i");


                                // =====================================
                                // DETERMINAR ESTADO
                                // =====================================

                                const isPassword =
                                    passwordInput.type ===
                                    "password";


                                // =====================================
                                // CAMBIAR TIPO
                                // =====================================

                                passwordInput.type =
                                    isPassword
                                        ? "text"
                                        : "password";


                                // =====================================
                                // CAMBIAR ICONO
                                // =====================================

                                if (isPassword) {

                                    icon.classList.remove(
                                        "bi-eye-fill"
                                    );

                                    icon.classList.add(
                                        "bi-eye-slash-fill"
                                    );


                                    this.setAttribute(
                                        "aria-label",
                                        "Ocultar contraseña"
                                    );


                                    this.setAttribute(
                                        "title",
                                        "Ocultar contraseña"
                                    );

                                }
                                else {

                                    icon.classList.remove(
                                        "bi-eye-slash-fill"
                                    );

                                    icon.classList.add(
                                        "bi-eye-fill"
                                    );


                                    this.setAttribute(
                                        "aria-label",
                                        "Mostrar contraseña"
                                    );


                                    this.setAttribute(
                                        "title",
                                        "Mostrar contraseña"
                                    );

                                }

                            }
                        );

                    }
                );

            }
        );

    </script>


</body>

</html>
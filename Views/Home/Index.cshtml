@{
    ViewData["Title"] = "Dashboard";

    var nombreCompleto = ViewBag.NombreCompleto as string
        ?? "Usuario";

    var usuario = ViewBag.Usuario as string
        ?? "";

    var rol = ViewBag.Rol as string
        ?? "Usuario";

    var correo = ViewBag.Correo as string
        ?? "";
}

<div class="container-fluid">

    <!-- ENCABEZADO -->

    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            Bienvenido, @nombreCompleto
        </h2>

        <p class="text-muted mb-0">
            Este es el panel principal del sistema de gestión del restaurante.
        </p>

    </div>


    <!-- INFORMACIÓN DEL USUARIO -->

    <div class="row g-4 mb-4">

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="rounded-circle bg-primary text-white
                            d-flex align-items-center justify-content-center"
                             style="width:50px;height:50px;">

                            <i class="bi bi-person fs-4"></i>

                        </div>

                        <div class="ms-3">

                            <small class="text-muted">
                                Usuario
                            </small>

                            <div class="fw-bold">
                                @usuario
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="rounded-circle bg-success text-white
                            d-flex align-items-center justify-content-center"
                             style="width:50px;height:50px;">

                            <i class="bi bi-shield-check fs-4"></i>

                        </div>

                        <div class="ms-3">

                            <small class="text-muted">
                                Rol
                            </small>

                            <div class="fw-bold">
                                @rol
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="rounded-circle bg-info text-white
                            d-flex align-items-center justify-content-center"
                             style="width:50px;height:50px;">

                            <i class="bi bi-envelope fs-4"></i>

                        </div>

                        <div class="ms-3">

                            <small class="text-muted">
                                Correo
                            </small>

                            <div class="fw-bold text-break">
                                @correo
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- PANEL PRINCIPAL -->

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <h5 class="fw-bold mb-1">
                        Panel principal
                    </h5>

                    <p class="text-muted mb-0">
                        Acceso rápido a las funciones disponibles.
                    </p>

                </div>

                <div class="card-body p-4">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <div class="p-3 border rounded-3 h-100">

                                <div class="d-flex">

                                    <div class="text-primary fs-3">
                                        <i class="bi bi-speedometer2"></i>
                                    </div>

                                    <div class="ms-3">

                                        <h6 class="fw-bold">
                                            Dashboard
                                        </h6>

                                        <p class="text-muted small mb-0">
                                            Resumen general del sistema.
                                        </p>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="p-3 border rounded-3 h-100">

                                <div class="d-flex">

                                    <div class="text-success fs-3">
                                        <i class="bi bi-shield-check"></i>
                                    </div>

                                    <div class="ms-3">

                                        <h6 class="fw-bold">
                                            Seguridad
                                        </h6>

                                        <p class="text-muted small mb-0">
                                            Su acceso está protegido mediante autenticación.
                                        </p>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- INFORMACIÓN DE SESIÓN -->

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <h5 class="fw-bold mb-0">
                        Mi sesión
                    </h5>

                </div>

                <div class="card-body p-4">

                    <div class="mb-3">

                        <small class="text-muted">
                            Nombre
                        </small>

                        <div class="fw-semibold">
                            @nombreCompleto
                        </div>

                    </div>


                    <div class="mb-3">

                        <small class="text-muted">
                            Usuario
                        </small>

                        <div class="fw-semibold">
                            @usuario
                        </div>

                    </div>


                    <div class="mb-3">

                        <small class="text-muted">
                            Rol
                        </small>

                        <div>

                            <span class="badge bg-primary">
                                @rol
                            </span>

                        </div>

                    </div>


                    <div>

                        <small class="text-muted">
                            Correo
                        </small>

                        <div class="fw-semibold text-break">
                            @correo
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
@model IEnumerable<WebApplication1.Models.Pedido>

@{
    ViewData["Title"] = "Pedidos";

    var pedidos = Model?.ToList()
        ?? new List<WebApplication1.Models.Pedido>();

    // =========================================================
    // ESTADOS
    // =========================================================

    const int ESTADO_PENDIENTE = 1;
    const int ESTADO_EN_COCINA = 2;
    const int ESTADO_PREPARANDOSE = 3;
    const int ESTADO_LISTO = 4;
    const int ESTADO_ENTREGADO = 5;
    const int ESTADO_FACTURADO = 6;
    const int ESTADO_CANCELADO = 7;

    // =========================================================
    // FILTRO DE MES
    // =========================================================

    int mesSeleccionado =
        ViewBag.MesSeleccionado != null
            ? (int)ViewBag.MesSeleccionado
            : DateTime.Today.Month;

    int anioSeleccionado =
        ViewBag.AnioSeleccionado != null
            ? (int)ViewBag.AnioSeleccionado
            : DateTime.Today.Year;

    // =========================================================
    // DASHBOARD
    // =========================================================

    decimal totalVendidoMes =
        ViewBag.TotalVendidoMes != null
            ? (decimal)ViewBag.TotalVendidoMes
            : 0m;

    decimal totalVendidoHoy =
        ViewBag.TotalVendidoHoy != null
            ? (decimal)ViewBag.TotalVendidoHoy
            : 0m;

    int cantidadPedidosMes =
        ViewBag.CantidadPedidosMes != null
            ? (int)ViewBag.CantidadPedidosMes
            : 0;

    int cantidadPedidosHoy =
        ViewBag.CantidadPedidosHoy != null
            ? (int)ViewBag.CantidadPedidosHoy
            : 0;

    int pedidosCanceladosMes =
        ViewBag.PedidosCanceladosMes != null
            ? (int)ViewBag.PedidosCanceladosMes
            : 0;

    int pedidosCanceladosHoy =
        ViewBag.PedidosCanceladosHoy != null
            ? (int)ViewBag.PedidosCanceladosHoy
            : 0;

    decimal ticketPromedioMes =
        ViewBag.TicketPromedioMes != null
            ? (decimal)ViewBag.TicketPromedioMes
            : 0m;

    decimal ticketPromedioHoy =
        ViewBag.TicketPromedioHoy != null
            ? (decimal)ViewBag.TicketPromedioHoy
            : 0m;

    // =========================================================
    // ESTADOS
    // =========================================================

    int pedidosPendientes =
        ViewBag.PedidosPendientes != null
            ? (int)ViewBag.PedidosPendientes
            : 0;

    int pedidosEnCocina =
        ViewBag.PedidosEnCocina != null
            ? (int)ViewBag.PedidosEnCocina
            : 0;

    int pedidosPreparandose =
        ViewBag.PedidosPreparandose != null
            ? (int)ViewBag.PedidosPreparandose
            : 0;

    int pedidosListos =
        ViewBag.PedidosListos != null
            ? (int)ViewBag.PedidosListos
            : 0;

    int pedidosEntregados =
        ViewBag.PedidosEntregados != null
            ? (int)ViewBag.PedidosEntregados
            : 0;

    int pedidosFacturados =
        ViewBag.PedidosFacturados != null
            ? (int)ViewBag.PedidosFacturados
            : 0;

    // =========================================================
    // BÚSQUEDA
    // =========================================================

    string buscar =
        ViewBag.Buscar as string ?? "";

    // =========================================================
    // NOMBRES DE MESES
    // =========================================================

    var nombreMes = new[]
    {
        "",
        "Enero",
        "Febrero",
        "Marzo",
        "Abril",
        "Mayo",
        "Junio",
        "Julio",
        "Agosto",
        "Septiembre",
        "Octubre",
        "Noviembre",
        "Diciembre"
    };

    string mesTexto =
        mesSeleccionado >= 1 &&
        mesSeleccionado <= 12
            ? nombreMes[mesSeleccionado]
            : "Mes seleccionado";

    // =========================================================
    // PERMISOS
    // =========================================================

    var puedeCrear =
        User.IsInRole("Administrador") ||
        User.IsInRole("Gerente") ||
        User.IsInRole("Mesero");

    var puedeEditar =
        User.IsInRole("Administrador") ||
        User.IsInRole("Gerente") ||
        User.IsInRole("Mesero");

    var puedeEntregar =
        User.IsInRole("Administrador") ||
        User.IsInRole("Gerente") ||
        User.IsInRole("Mesero");
}

<div class="container-fluid py-4">

    <!-- ========================================================= -->
    <!-- ENCABEZADO -->
    <!-- ========================================================= -->

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-receipt-cutoff me-2"></i>
                Pedidos
            </h2>

            <p class="text-muted mb-0">
                Administración y seguimiento de pedidos.
            </p>
        </div>

        <div class="d-flex gap-2 mt-3 mt-md-0">

            @if (puedeCrear)
            {
                <a asp-action="Create"
                   class="btn btn-primary">

                    <i class="bi bi-plus-circle me-1"></i>
                    Nuevo pedido

                </a>
            }

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- MENSAJES -->
    <!-- ========================================================= -->

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["Mensaje"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-exclamation-triangle me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ========================================================= -->
    <!-- FILTROS -->
    <!-- ========================================================= -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white py-3">

            <h5 class="mb-0 fw-semibold">

                <i class="bi bi-funnel me-2"></i>

                Filtros y estadísticas

            </h5>

        </div>

        <div class="card-body">

            <form asp-action="Index"
                  method="get"
                  class="row g-3 align-items-end">

                <!-- MES -->

                <div class="col-lg-4 col-md-6">

                    <label class="form-label fw-semibold">

                        <i class="bi bi-calendar-month me-1"></i>

                        Mes

                    </label>

                    <select name="mes"
                            class="form-select">

                        @for (int i = 1; i <= 12; i++)
                        {
                            if (i == mesSeleccionado)
                            {
                                <option value="@i" selected>
                                    @nombreMes[i]
                                </option>
                            }
                            else
                            {
                                <option value="@i">
                                    @nombreMes[i]
                                </option>
                            }
                        }

                    </select>

                </div>


                <!-- AÑO -->

                <div class="col-lg-3 col-md-6">

                    <label class="form-label fw-semibold">

                        <i class="bi bi-calendar3 me-1"></i>

                        Año

                    </label>

                    <select name="anio"
                            class="form-select">

                        @{
                            int anioActual = DateTime.Today.Year;

                            var anios =
                                ViewBag.AniosDisponibles
                                as IEnumerable<int>
                                ??
                                Enumerable
                                    .Range(
                                        anioActual - 5,
                                        7)
                                    .OrderByDescending(x => x);
                        }

                        @foreach (var anio in anios)
                        {
                            if (anio == anioSeleccionado)
                            {
                                <option value="@anio" selected>
                                    @anio
                                </option>
                            }
                            else
                            {
                                <option value="@anio">
                                    @anio
                                </option>
                            }
                        }

                    </select>

                </div>


                <!-- APLICAR -->

                <div class="col-lg-3 col-md-6">

                    <button type="submit"
                            class="btn btn-primary w-100">

                        <i class="bi bi-bar-chart me-1"></i>

                        Ver estadísticas

                    </button>

                </div>


                <!-- ACTUAL -->

                <div class="col-lg-2 col-md-6">

                    <a asp-action="Index"
                       asp-route-mes="@DateTime.Today.Month"
                       asp-route-anio="@DateTime.Today.Year"
                       class="btn btn-outline-secondary w-100">

                        <i class="bi bi-calendar-check me-1"></i>

                        Actual

                    </a>

                </div>

            </form>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- PERIODO -->
    <!-- ========================================================= -->

    <div class="alert alert-light border shadow-sm mb-4">

        <div class="d-flex align-items-center">

            <div class="me-3">

                <i class="bi bi-calendar3 text-primary fs-3"></i>

            </div>

            <div>

                <div class="fw-bold">

                    Estadísticas de
                    @mesTexto
                    @anioSeleccionado

                </div>

                <small class="text-muted">

                    Los indicadores corresponden al período seleccionado.

                </small>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- DASHBOARD PRINCIPAL -->
    <!-- ========================================================= -->

    <div class="row g-3 mb-4">

        <!-- VENDIDO MES -->

        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <small class="text-muted">
                                Vendido en @mesTexto
                            </small>

                            <h4 class="fw-bold text-success mb-0 mt-1">

                                C$ @totalVendidoMes.ToString("N2")

                            </h4>

                        </div>

                        <div class="text-success fs-2">

                            <i class="bi bi-cash-stack"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- VENDIDO HOY -->

        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <small class="text-muted">
                                Vendido hoy
                            </small>

                            <h4 class="fw-bold mb-0 mt-1">

                                C$ @totalVendidoHoy.ToString("N2")

                            </h4>

                        </div>

                        <div class="text-primary fs-2">

                            <i class="bi bi-calendar-day"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- PEDIDOS MES -->

        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <small class="text-muted">
                                Pedidos de @mesTexto
                            </small>

                            <h4 class="fw-bold mb-0 mt-1">

                                @cantidadPedidosMes

                            </h4>

                        </div>

                        <div class="text-info fs-2">

                            <i class="bi bi-receipt"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- CANCELADOS -->

        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <small class="text-muted">
                                Cancelados de @mesTexto
                            </small>

                            <h4 class="fw-bold text-danger mb-0 mt-1">

                                @pedidosCanceladosMes

                            </h4>

                        </div>

                        <div class="text-danger fs-2">

                            <i class="bi bi-x-circle"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- ESTADOS -->
    <!-- ========================================================= -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="mb-0 fw-semibold">

                        <i class="bi bi-diagram-3 me-2"></i>

                        Estados de pedidos

                    </h5>

                    <small class="text-muted">

                        @mesTexto @anioSeleccionado

                    </small>

                </div>

            </div>

        </div>

        <div class="card-body">

            <div class="row g-3">


                <!-- PENDIENTES -->

                <div class="col-xl-2 col-lg-4 col-md-4 col-6">

                    <div class="border rounded-3 p-3 text-center h-100">

                        <div class="text-warning fs-3 mb-1">

                            <i class="bi bi-clock"></i>

                        </div>

                        <div class="fw-bold fs-4">

                            @pedidosPendientes

                        </div>

                        <small class="text-muted">

                            Pendientes

                        </small>

                    </div>

                </div>


                <!-- EN COCINA -->

                <div class="col-xl-2 col-lg-4 col-md-4 col-6">

                    <div class="border rounded-3 p-3 text-center h-100">

                        <div class="text-info fs-3 mb-1">

                            <i class="bi bi-fire"></i>

                        </div>

                        <div class="fw-bold fs-4">

                            @pedidosEnCocina

                        </div>

                        <small class="text-muted">

                            En cocina

                        </small>

                    </div>

                </div>


                <!-- PREPARÁNDOSE -->

                <div class="col-xl-2 col-lg-4 col-md-4 col-6">

                    <div class="border rounded-3 p-3 text-center h-100">

                        <div class="text-primary fs-3 mb-1">

                            <i class="bi bi-gear"></i>

                        </div>

                        <div class="fw-bold fs-4">

                            @pedidosPreparandose

                        </div>

                        <small class="text-muted">

                            Preparándose

                        </small>

                    </div>

                </div>


                <!-- LISTOS -->

                <div class="col-xl-2 col-lg-4 col-md-4 col-6">

                    <div class="border rounded-3 p-3 text-center h-100">

                        <div class="text-success fs-3 mb-1">

                            <i class="bi bi-check2-circle"></i>

                        </div>

                        <div class="fw-bold fs-4">

                            @pedidosListos

                        </div>

                        <small class="text-muted">

                            Listos

                        </small>

                    </div>

                </div>


                <!-- ENTREGADOS -->

                <div class="col-xl-2 col-lg-4 col-md-4 col-6">

                    <div class="border rounded-3 p-3 text-center h-100">

                        <div class="text-secondary fs-3 mb-1">

                            <i class="bi bi-box-seam"></i>

                        </div>

                        <div class="fw-bold fs-4">

                            @pedidosEntregados

                        </div>

                        <small class="text-muted">

                            Entregados

                        </small>

                    </div>

                </div>


                <!-- FACTURADOS -->

                <div class="col-xl-2 col-lg-4 col-md-4 col-6">

                    <div class="border rounded-3 p-3 text-center h-100">

                        <div class="text-dark fs-3 mb-1">

                            <i class="bi bi-cash-coin"></i>

                        </div>

                        <div class="fw-bold fs-4">

                            @pedidosFacturados

                        </div>

                        <small class="text-muted">

                            Facturados

                        </small>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- INFORMACIÓN ADICIONAL -->
    <!-- ========================================================= -->

    <div class="row g-3 mb-4">


        <!-- TICKET PROMEDIO -->

        <div class="col-lg-4 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="text-primary fs-1 me-3">

                            <i class="bi bi-receipt-cutoff"></i>

                        </div>

                        <div>

                            <small class="text-muted">
                                Ticket promedio
                            </small>

                            <h4 class="fw-bold mb-0">

                                C$ @ticketPromedioMes.ToString("N2")

                            </h4>

                            <small class="text-muted">

                                @mesTexto @anioSeleccionado

                            </small>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- PEDIDOS HOY -->

        <div class="col-lg-4 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="text-info fs-1 me-3">

                            <i class="bi bi-calendar-day"></i>

                        </div>

                        <div>

                            <small class="text-muted">
                                Pedidos realizados hoy
                            </small>

                            <h4 class="fw-bold mb-0">

                                @cantidadPedidosHoy

                            </h4>

                            <small class="text-muted">

                                Total correspondiente al día actual

                            </small>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- CANCELADOS HOY -->

        <div class="col-lg-4 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="text-danger fs-1 me-3">

                            <i class="bi bi-x-circle"></i>

                        </div>

                        <div>

                            <small class="text-muted">
                                Cancelados hoy
                            </small>

                            <h4 class="fw-bold mb-0 text-danger">

                                @pedidosCanceladosHoy

                            </h4>

                            <small class="text-muted">

                                No depende del mes seleccionado

                            </small>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- BÚSQUEDA -->
    <!-- ========================================================= -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white py-3">

            <h5 class="mb-0 fw-semibold">

                <i class="bi bi-search me-2"></i>

                Buscar pedidos

            </h5>

        </div>

        <div class="card-body">

            <form asp-action="Index"
                  method="get"
                  class="row g-3 align-items-end">

                <input type="hidden"
                       name="mes"
                       value="@mesSeleccionado" />

                <input type="hidden"
                       name="anio"
                       value="@anioSeleccionado" />


                <div class="col-lg-10">

                    <label class="form-label fw-semibold">

                        Buscar

                    </label>

                    <input type="text"
                           name="buscar"
                           value="@buscar"
                           class="form-control"
                           autocomplete="off"
                           placeholder="Número, cliente, usuario, estado, tipo, mesa o fecha..." />

                </div>


                <div class="col-lg-2">

                    <button type="submit"
                            class="btn btn-primary w-100">

                        <i class="bi bi-search me-1"></i>

                        Buscar

                    </button>

                </div>

            </form>


            @if (!string.IsNullOrWhiteSpace(buscar))
            {
                <div class="mt-3">

                    <span class="text-muted small">

                        Resultados para:

                    </span>

                    <span class="badge bg-primary">

                        @buscar

                    </span>

                    <a asp-action="Index"
                       asp-route-mes="@mesSeleccionado"
                       asp-route-anio="@anioSeleccionado"
                       class="btn btn-sm btn-link text-decoration-none">

                        Limpiar búsqueda

                    </a>

                </div>
            }

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- LISTA DE PEDIDOS -->
    <!-- ========================================================= -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">

                <div>

                    <h5 class="mb-0 fw-semibold">

                        <i class="bi bi-list-ul me-2"></i>

                        Lista de pedidos

                    </h5>

                    <small class="text-muted">

                        Pedidos encontrados con los filtros actuales.

                    </small>

                </div>

                <span class="badge bg-light text-dark border">

                    @pedidos.Count pedido(s)

                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (!pedidos.Any())
            {
                <div class="text-center py-5 px-3">

                    <i class="bi bi-receipt display-4 text-muted"></i>

                    <h5 class="mt-3 mb-1">

                        No se encontraron pedidos

                    </h5>

                    <p class="text-muted mb-0">

                        Prueba cambiando los filtros o realizando
                        una nueva búsqueda.

                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-3">
                                    Pedido
                                </th>

                                <th>
                                    Fecha
                                </th>

                                <th>
                                    Cliente
                                </th>

                                <th>
                                    Mesa
                                </th>

                                <th>
                                    Tipo
                                </th>

                                <th>
                                    Estado
                                </th>

                                <th class="text-end">
                                    Total
                                </th>

                                <th class="text-center pe-3">
                                    Acciones
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var pedido in pedidos)
                            {
                                var estado =
                                    pedido.IdEstadoPedido;

                                var estadoPedido =
                                    pedido.IdEstadoPedidoNavigation?.Nombre
                                    ?? "Sin estado";

                                var estaCancelado =
                                    estado == ESTADO_CANCELADO;

                                var estaFacturado =
                                    estado == ESTADO_FACTURADO;

                                var estaEntregado =
                                    estado == ESTADO_ENTREGADO;


                                // =================================================
                                // EDITAR
                                // Solo pedidos pendientes
                                // =================================================

                                var puedeEditarPedido =
                                    puedeEditar &&
                                    estado == ESTADO_PENDIENTE;


                                // =================================================
                                // ENTREGAR
                                //
                                // ÚNICA TRANSICIÓN DESDE ESTE INDEX:
                                //
                                // LISTO -> ENTREGADO
                                // =================================================

                                var puedeEntregarPedido =
                                    puedeEntregar &&
                                    estado == ESTADO_LISTO;


                                <tr>


                                    <!-- ================================================= -->
                                    <!-- PEDIDO -->
                                    <!-- ================================================= -->

                                    <td class="ps-3">

                                        <div class="fw-bold">

                                            @(pedido.NumeroPedido
                                                ?? $"#{pedido.IdPedido}")

                                        </div>

                                        <small class="text-muted">

                                            ID @pedido.IdPedido

                                        </small>

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- FECHA -->
                                    <!-- ================================================= -->

                                    <td>

                                        <div class="fw-semibold">

                                            @pedido.FechaPedido.ToString(
                                                "dd/MM/yyyy")

                                        </div>

                                        <small class="text-muted">

                                            @pedido.FechaPedido.ToString(
                                                "HH:mm")

                                        </small>

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- CLIENTE -->
                                    <!-- ================================================= -->

                                    <td>

                                        @if (pedido.IdClienteNavigation != null)
                                        {
                                            <div class="fw-semibold">

                                                @pedido.IdClienteNavigation.Nombres
                                                @pedido.IdClienteNavigation.Apellidos

                                            </div>


                                            @if (!string.IsNullOrWhiteSpace(
                                                pedido.IdClienteNavigation.Telefono))
                                            {
                                                <small class="text-muted">

                                                    <i class="bi bi-telephone me-1"></i>

                                                    @pedido.IdClienteNavigation.Telefono

                                                </small>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">

                                                Sin cliente

                                            </span>
                                        }

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- MESA -->
                                    <!-- ================================================= -->

                                    <td>

                                        @if (pedido.IdMesaNavigation != null)
                                        {
                                            <span class="badge bg-light text-dark border">

                                                <i class="bi bi-grid-3x3-gap me-1"></i>

                                                Mesa
                                                @pedido.IdMesaNavigation.NumeroMesa

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">

                                                —

                                            </span>
                                        }

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- TIPO -->
                                    <!-- ================================================= -->

                                    <td>

                                        @if (pedido.IdTipoPedidoNavigation != null)
                                        {
                                            <span>

                                                @pedido.IdTipoPedidoNavigation.Nombre

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- ESTADO -->
                                    <!-- ================================================= -->

                                    <td>

                                        @switch (estado)
                                        {
                                            case ESTADO_PENDIENTE:

                                                <span class="badge bg-warning text-dark">

                                                    <i class="bi bi-clock me-1"></i>

                                                    Pendiente

                                                </span>

                                                break;


                                            case ESTADO_EN_COCINA:

                                                <span class="badge bg-info text-dark">

                                                    <i class="bi bi-fire me-1"></i>

                                                    En cocina

                                                </span>

                                                break;


                                            case ESTADO_PREPARANDOSE:

                                                <span class="badge bg-primary">

                                                    <i class="bi bi-gear me-1"></i>

                                                    Preparándose

                                                </span>

                                                break;


                                            case ESTADO_LISTO:

                                                <span class="badge bg-success">

                                                    <i class="bi bi-check2-circle me-1"></i>

                                                    Listo

                                                </span>

                                                break;


                                            case ESTADO_ENTREGADO:

                                                <span class="badge bg-secondary">

                                                    <i class="bi bi-box-seam me-1"></i>

                                                    Entregado

                                                </span>

                                                break;


                                            case ESTADO_FACTURADO:

                                                <span class="badge bg-dark">

                                                    <i class="bi bi-cash-coin me-1"></i>

                                                    Facturado

                                                </span>

                                                break;


                                            case ESTADO_CANCELADO:

                                                <span class="badge bg-danger">

                                                    <i class="bi bi-x-circle me-1"></i>

                                                    Cancelado

                                                </span>

                                                break;


                                            default:

                                                <span class="badge bg-secondary">

                                                    @estadoPedido

                                                </span>

                                                break;
                                        }

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- TOTAL -->
                                    <!-- ================================================= -->

                                    <td class="text-end">

                                        <span class="fw-bold
                                            @(estaCancelado
                                                ? "text-muted text-decoration-line-through"
                                                : "text-success")">

                                            C$ @pedido.Total.ToString("N2")

                                        </span>

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- ACCIONES -->
                                    <!-- ================================================= -->

                                    <td class="text-center pe-3">

                                        <div class="d-flex justify-content-center gap-1">


                                            <!-- VER -->

                                            <a asp-action="Details"
                                               asp-route-id="@pedido.IdPedido"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Ver detalle">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            <!-- EDITAR -->

                                            @if (puedeEditarPedido)
                                            {
                                                <a asp-action="Edit"
                                                   asp-route-id="@pedido.IdPedido"
                                                   class="btn btn-sm btn-outline-warning"
                                                   title="Editar pedido">

                                                    <i class="bi bi-pencil"></i>

                                                </a>
                                            }


                                            <!-- ENTREGAR -->

                                            @if (puedeEntregarPedido)
                                            {
                                                <form asp-action="CambiarEstado"
                                                      method="post"
                                                      class="d-inline formulario-entregar">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@pedido.IdPedido" />

                                                    <input type="hidden"
                                                           name="idEstado"
                                                           value="@ESTADO_ENTREGADO" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success"
                                                            title="Marcar como entregado">

                                                        <i class="bi bi-box-seam"></i>

                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- FLUJO DEL PEDIDO -->
    <!-- ========================================================= -->

    <div class="card shadow-sm border-0 mt-4">

        <div class="card-header bg-white py-3">

            <div class="d-flex align-items-center">

                <i class="bi bi-diagram-3 fs-4 me-2 text-primary"></i>

                <div>

                    <h5 class="mb-0 fw-bold">

                        Flujo del pedido

                    </h5>

                    <small class="text-muted">

                        Cada área controla su propia etapa.

                    </small>

                </div>

            </div>

        </div>


        <div class="card-body">

            <div class="row g-3 text-center">


                <!-- PENDIENTE -->

                <div class="col-xl-2 col-lg-4 col-md-4 col-6">

                    <div class="p-3 rounded bg-warning-subtle h-100">

                        <div class="text-warning fs-2 mb-2">

                            <i class="bi bi-clock"></i>

                        </div>

                        <strong>
                            Pendiente
                        </strong>

                        <div class="small text-muted mt-1">

                            Pedido creado.

                        </div>

                    </div>

                </div>


                <!-- EN COCINA -->

                <div class="col-xl-2 col-lg-4 col-md-4 col-6">

                    <div class="p-3 rounded bg-info-subtle h-100">

                        <div class="text-info fs-2 mb-2">

                            <i class="bi bi-fire"></i>

                        </div>

                        <strong>
                            En cocina
                        </strong>

                        <div class="small text-muted mt-1">

                            Cocina recibió el pedido.

                        </div>

                    </div>

                </div>


                <!-- PREPARÁNDOSE -->

                <div class="col-xl-2 col-lg-4 col-md-4 col-6">

                    <div class="p-3 rounded bg-primary-subtle h-100">

                        <div class="text-primary fs-2 mb-2">

                            <i class="bi bi-gear"></i>

                        </div>

                        <strong>
                            Preparándose
                        </strong>

                        <div class="small text-muted mt-1">

                            Cocina está preparando.

                        </div>

                    </div>

                </div>


                <!-- LISTO -->

                <div class="col-xl-2 col-lg-4 col-md-4 col-6">

                    <div class="p-3 rounded bg-success-subtle h-100">

                        <div class="text-success fs-2 mb-2">

                            <i class="bi bi-check2-circle"></i>

                        </div>

                        <strong>
                            Listo
                        </strong>

                        <div class="small text-muted mt-1">

                            Esperando al mesero.

                        </div>

                    </div>

                </div>


                <!-- ENTREGADO -->

                <div class="col-xl-2 col-lg-4 col-md-4 col-6">

                    <div class="p-3 rounded bg-secondary-subtle h-100">

                        <div class="text-secondary fs-2 mb-2">

                            <i class="bi bi-box-seam"></i>

                        </div>

                        <strong>
                            Entregado
                        </strong>

                        <div class="small text-muted mt-1">

                            Mesero entregó el pedido.

                        </div>

                    </div>

                </div>


                <!-- FACTURADO -->

                <div class="col-xl-2 col-lg-4 col-md-4 col-6">

                    <div class="p-3 rounded bg-dark-subtle h-100">

                        <div class="text-dark fs-2 mb-2">

                            <i class="bi bi-cash-coin"></i>

                        </div>

                        <strong>
                            Facturado
                        </strong>

                        <div class="small text-muted mt-1">

                            Caja completó la venta.

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- INFORMACIÓN DE REGLAS -->
    <!-- ========================================================= -->

    <div class="alert alert-info border-0 shadow-sm mt-4 mb-0">

        <div class="d-flex align-items-start">

            <i class="bi bi-info-circle-fill fs-4 me-3"></i>

            <div>

                <div class="fw-bold mb-1">

                    Flujo controlado por módulos

                </div>

                <div class="small">

                    Los pedidos nuevos comienzan en
                    <strong>Pendiente</strong>.

                    Cocina controla las transiciones
                    <strong>
                        Pendiente → En cocina → Preparándose → Listo
                    </strong>.

                    Desde Pedidos solamente se permite
                    <strong>
                        Listo → Entregado
                    </strong>.

                    Finalmente, el módulo de facturación controla
                    <strong>
                        Entregado → Facturado
                    </strong>.

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const formularios =
                    document.querySelectorAll(
                        ".formulario-entregar"
                    );

                formularios.forEach(
                    function (formulario) {

                        formulario.addEventListener(
                            "submit",
                            function (evento) {

                                const confirmar =
                                    window.confirm(
                                        "¿Desea marcar este pedido como ENTREGADO?"
                                    );

                                if (!confirmar) {

                                    evento.preventDefault();

                                    return;
                                }


                                const boton =
                                    formulario.querySelector(
                                        "button"
                                    );

                                if (!boton) {
                                    return;
                                }


                                if (
                                    boton.dataset.enviando ===
                                    "true"
                                ) {

                                    evento.preventDefault();

                                    return;
                                }


                                boton.dataset.enviando =
                                    "true";

                                boton.disabled =
                                    true;


                                boton.innerHTML =
                                    '<span class="spinner-border spinner-border-sm me-1"></span>' +
                                    'Entregando...';

                            }
                        );

                    }
                );

            }
        );

    </script>

}
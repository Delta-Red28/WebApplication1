@model IEnumerable<WebApplication1.Models.Pedido>

@{
    ViewData["Title"] = "Pedidos";

    var pedidos = Model?.ToList()
        ?? new List<WebApplication1.Models.Pedido>();

    decimal totalVendidoMes =
        ViewBag.TotalVendidoMes != null
            ? (decimal)ViewBag.TotalVendidoMes
            : 0m;

    decimal totalVendidoHoy =
        ViewBag.TotalVendidoHoy != null
            ? (decimal)ViewBag.TotalVendidoHoy
            : 0m;

    int cantidadPedidosMes =
        ViewBag.CantidadPedidosMes != null
            ? (int)ViewBag.CantidadPedidosMes
            : 0;

    int cantidadPedidosHoy =
        ViewBag.CantidadPedidosHoy != null
            ? (int)ViewBag.CantidadPedidosHoy
            : 0;

    int pedidosCanceladosMes =
        ViewBag.PedidosCanceladosMes != null
            ? (int)ViewBag.PedidosCanceladosMes
            : 0;

    int pedidosCanceladosHoy =
        ViewBag.PedidosCanceladosHoy != null
            ? (int)ViewBag.PedidosCanceladosHoy
            : 0;

    decimal ticketPromedioMes =
        ViewBag.TicketPromedioMes != null
            ? (decimal)ViewBag.TicketPromedioMes
            : 0m;

    decimal ticketPromedioHoy =
        ViewBag.TicketPromedioHoy != null
            ? (decimal)ViewBag.TicketPromedioHoy
            : 0m;

    int pedidosPendientes =
        ViewBag.PedidosPendientes != null
            ? (int)ViewBag.PedidosPendientes
            : 0;

    int pedidosEnCocina =
        ViewBag.PedidosEnCocina != null
            ? (int)ViewBag.PedidosEnCocina
            : 0;

    int pedidosPreparandose =
        ViewBag.PedidosPreparandose != null
            ? (int)ViewBag.PedidosPreparandose
            : 0;

    int pedidosListos =
        ViewBag.PedidosListos != null
            ? (int)ViewBag.PedidosListos
            : 0;

    int pedidosEntregados =
        ViewBag.PedidosEntregados != null
            ? (int)ViewBag.PedidosEntregados
            : 0;

    int pedidosFacturados =
        ViewBag.PedidosFacturados != null
            ? (int)ViewBag.PedidosFacturados
            : 0;

    string buscar =
        ViewBag.Buscar as string ?? "";
}

<div class="container-fluid py-4">

    <!-- ========================================================= -->
    <!-- ENCABEZADO -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-receipt me-2"></i>

                Pedidos

            </h2>

            <p class="text-muted mb-0">

                Administración y seguimiento de pedidos.

            </p>

        </div>


        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-circle me-1"></i>

            Nuevo pedido

        </a>

    </div>


    <!-- ========================================================= -->
    <!-- DASHBOARD -->
    <!-- ========================================================= -->

    <div class="row g-3 mb-4">

        <!-- VENTAS MES -->

        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">
                                Vendido este mes
                            </small>

                            <h4 class="fw-bold text-success mb-0">

                                C$ @totalVendidoMes.ToString("N2")

                            </h4>

                        </div>

                        <div class="text-success fs-2">

                            <i class="bi bi-cash-stack"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- VENTAS HOY -->

        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">
                                Vendido hoy
                            </small>

                            <h4 class="fw-bold mb-0">

                                C$ @totalVendidoHoy.ToString("N2")

                            </h4>

                        </div>

                        <div class="text-primary fs-2">

                            <i class="bi bi-calendar-day"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- PEDIDOS MES -->

        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">
                                Pedidos del mes
                            </small>

                            <h4 class="fw-bold mb-0">

                                @cantidadPedidosMes

                            </h4>

                        </div>

                        <div class="text-info fs-2">

                            <i class="bi bi-receipt"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- CANCELADOS -->

        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">
                                Cancelados del mes
                            </small>

                            <h4 class="fw-bold text-danger mb-0">

                                @pedidosCanceladosMes

                            </h4>

                        </div>

                        <div class="text-danger fs-2">

                            <i class="bi bi-x-circle"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- ESTADOS -->
    <!-- ========================================================= -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white py-3">

            <h5 class="mb-0 fw-semibold">

                <i class="bi bi-bar-chart me-2"></i>

                Estados de pedidos este mes

            </h5>

        </div>


        <div class="card-body">

            <div class="row g-3">

                <div class="col-lg-2 col-md-4 col-6">

                    <div class="border rounded p-3 text-center">

                        <div class="text-warning fs-3">

                            <i class="bi bi-clock"></i>

                        </div>

                        <div class="fw-bold fs-4">
                            @pedidosPendientes
                        </div>

                        <small class="text-muted">
                            Pendientes
                        </small>

                    </div>

                </div>


                <div class="col-lg-2 col-md-4 col-6">

                    <div class="border rounded p-3 text-center">

                        <div class="text-info fs-3">

                            <i class="bi bi-fire"></i>

                        </div>

                        <div class="fw-bold fs-4">
                            @pedidosEnCocina
                        </div>

                        <small class="text-muted">
                            En cocina
                        </small>

                    </div>

                </div>


                <div class="col-lg-2 col-md-4 col-6">

                    <div class="border rounded p-3 text-center">

                        <div class="text-primary fs-3">

                            <i class="bi bi-gear"></i>

                        </div>

                        <div class="fw-bold fs-4">
                            @pedidosPreparandose
                        </div>

                        <small class="text-muted">
                            Preparándose
                        </small>

                    </div>

                </div>


                <div class="col-lg-2 col-md-4 col-6">

                    <div class="border rounded p-3 text-center">

                        <div class="text-primary fs-3">

                            <i class="bi bi-check2-circle"></i>

                        </div>

                        <div class="fw-bold fs-4">
                            @pedidosListos
                        </div>

                        <small class="text-muted">
                            Listos
                        </small>

                    </div>

                </div>


                <div class="col-lg-2 col-md-4 col-6">

                    <div class="border rounded p-3 text-center">

                        <div class="text-success fs-3">

                            <i class="bi bi-box-seam"></i>

                        </div>

                        <div class="fw-bold fs-4">
                            @pedidosEntregados
                        </div>

                        <small class="text-muted">
                            Entregados
                        </small>

                    </div>

                </div>


                <div class="col-lg-2 col-md-4 col-6">

                    <div class="border rounded p-3 text-center">

                        <div class="text-success fs-3">

                            <i class="bi bi-cash-coin"></i>

                        </div>

                        <div class="fw-bold fs-4">
                            @pedidosFacturados
                        </div>

                        <small class="text-muted">
                            Facturados
                        </small>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- BÚSQUEDA -->
    <!-- ========================================================= -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form asp-action="Index"
                  method="get"
                  class="row g-3">

                <div class="col-md-10">

                    <label class="form-label">
                        Buscar pedido
                    </label>

                    <input type="text"
                           name="buscar"
                           value="@buscar"
                           class="form-control"
                           placeholder="Número, cliente, usuario, estado, mesa o fecha..." />

                </div>


                <div class="col-md-2 d-flex align-items-end">

                    <button type="submit"
                            class="btn btn-primary w-100">

                        <i class="bi bi-search me-1"></i>

                        Buscar

                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- TABLA -->
    <!-- ========================================================= -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0 fw-semibold">

                    <i class="bi bi-list-ul me-2"></i>

                    Lista de pedidos

                </h5>

                <span class="text-muted">

                    @pedidos.Count pedido(s)

                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (!pedidos.Any())
            {
                <div class="text-center py-5">

                    <i class="bi bi-receipt display-5 text-muted"></i>

                    <p class="text-muted mt-3 mb-0">

                        No se encontraron pedidos.

                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Pedido
                                </th>

                                <th>
                                    Fecha
                                </th>

                                <th>
                                    Cliente
                                </th>

                                <th>
                                    Mesa
                                </th>

                                <th>
                                    Tipo
                                </th>

                                <th>
                                    Estado
                                </th>

                                <th class="text-end">
                                    Total
                                </th>

                                <th class="text-center">
                                    Acciones
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var pedido in pedidos)
                            {
                                var estadoPedido =
                                    pedido.IdEstadoPedidoNavigation?.Nombre
                                    ?? "Sin estado";

                                var cancelado =
                                    estadoPedido.Trim().Equals(
                                        "Cancelado",
                                        StringComparison.OrdinalIgnoreCase);

                                <tr>

                                    <td>

                                        <div class="fw-bold">

                                            @(pedido.NumeroPedido
                                                ?? $"#{pedido.IdPedido}")

                                        </div>

                                    </td>


                                    <td>

                                        <div>

                                            @pedido.FechaPedido.ToString(
                                                "dd/MM/yyyy")

                                        </div>

                                        <small class="text-muted">

                                            @pedido.FechaPedido.ToString(
                                                "HH:mm")

                                        </small>

                                    </td>


                                    <td>

                                        @if (pedido.IdClienteNavigation != null)
                                        {
                                            <div class="fw-semibold">

                                                @pedido.IdClienteNavigation.Nombres
                                                @pedido.IdClienteNavigation.Apellidos

                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(
                                                pedido.IdClienteNavigation.Telefono))
                                            {
                                                <small class="text-muted">

                                                    @pedido.IdClienteNavigation.Telefono

                                                </small>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Sin cliente
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @if (pedido.IdMesaNavigation != null)
                                        {
                                            <span class="badge bg-light text-dark border">

                                                Mesa
                                                @pedido.IdMesaNavigation.NumeroMesa

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @(pedido.IdTipoPedidoNavigation?.Nombre
                                            ?? "—")

                                    </td>


                                    <td>

                                        @if (cancelado)
                                        {
                                            <span class="badge bg-danger">

                                                <i class="bi bi-x-circle me-1"></i>

                                                Cancelado

                                            </span>
                                        }
                                        else if (estadoPedido.Equals(
                                            "Pendiente",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-warning text-dark">

                                                <i class="bi bi-clock me-1"></i>

                                                Pendiente

                                            </span>
                                        }
                                        else if (estadoPedido.Equals(
                                            "En cocina",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-info text-dark">

                                                <i class="bi bi-fire me-1"></i>

                                                En cocina

                                            </span>
                                        }
                                        else if (estadoPedido.Equals(
                                            "Preparándose",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-primary">

                                                Preparándose

                                            </span>
                                        }
                                        else if (estadoPedido.Equals(
                                            "Listo",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-primary">

                                                <i class="bi bi-check2-circle me-1"></i>

                                                Listo

                                            </span>
                                        }
                                        else if (estadoPedido.Equals(
                                            "Entregado",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-success">

                                                <i class="bi bi-box-seam me-1"></i>

                                                Entregado

                                            </span>
                                        }
                                        else if (estadoPedido.Equals(
                                            "Facturado",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-success">

                                                <i class="bi bi-cash-coin me-1"></i>

                                                Facturado

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">

                                                @estadoPedido

                                            </span>
                                        }

                                    </td>


                                    <td class="text-end">

                                        <span class="fw-bold
                                            @(cancelado
                                                ? "text-muted"
                                                : "text-success")">

                                            C$
                                            @pedido.Total.ToString("N2")

                                        </span>

                                    </td>


                                    <td class="text-center">

                                        <div class="btn-group">

                                            <a asp-action="Details"
                                               asp-route-id="@pedido.IdPedido"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Ver detalle">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            @if (!cancelado &&
                                                 !estadoPedido.Equals(
                                                     "Facturado",
                                                     StringComparison.OrdinalIgnoreCase))
                                            {
                                                <a asp-action="Edit"
                                                   asp-route-id="@pedido.IdPedido"
                                                   class="btn btn-sm btn-outline-warning"
                                                   title="Editar">

                                                    <i class="bi bi-pencil"></i>

                                                </a>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>
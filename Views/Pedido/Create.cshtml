@model WebApplication1.ViewModels.PedidoViewModel

@{
    ViewData["Title"] = "Nuevo pedido";

    var detalles = Model.Detalles
        ?? new List<WebApplication1.ViewModels.DetallePedidoViewModel>();
}

<div class="container-fluid py-4">

    <!-- ========================================================= -->
    <!-- ENCABEZADO -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-plus-circle me-2"></i>

                Nuevo pedido

            </h2>

            <p class="text-muted mb-0">

                Registre un nuevo pedido.

            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>

            Regresar a pedidos

        </a>

    </div>


    <!-- ========================================================= -->
    <!-- VALIDACIONES -->
    <!-- ========================================================= -->

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">

            <div class="fw-bold mb-2">

                <i class="bi bi-exclamation-triangle me-2"></i>

                Revise los siguientes errores:

            </div>

            <div asp-validation-summary="All"
                 class="mb-0">
            </div>

        </div>
    }


    <!-- ========================================================= -->
    <!-- FORMULARIO -->
    <!-- ========================================================= -->

    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="FechaPedido" />


        <!-- ===================================================== -->
        <!-- INFORMACIÓN -->
        <!-- ===================================================== -->

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-white py-3">

                <h5 class="mb-0 fw-semibold">

                    <i class="bi bi-info-circle me-2"></i>

                    Información del pedido

                </h5>

            </div>


            <div class="card-body">

                <div class="row g-4">

                    <!-- CLIENTE -->

                    <div class="col-md-6">

                        <label asp-for="IdCliente"
                               class="form-label">

                            Cliente

                        </label>

                        <select asp-for="IdCliente"
                                asp-items="Model.Clientes"
                                class="form-select"
                                required>

                            <option value="">
                                -- Seleccione un cliente --
                            </option>

                        </select>

                        <span asp-validation-for="IdCliente"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- MESA -->

                    <div class="col-md-3">

                        <label asp-for="IdMesa"
                               class="form-label">

                            Mesa

                        </label>

                        <select asp-for="IdMesa"
                                asp-items="Model.Mesas"
                                class="form-select">

                            <option value="">
                                -- Sin mesa --
                            </option>

                        </select>

                        <span asp-validation-for="IdMesa"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- TIPO -->

                    <div class="col-md-3">

                        <label asp-for="IdTipoPedido"
                               class="form-label">

                            Tipo de pedido

                        </label>

                        <select asp-for="IdTipoPedido"
                                asp-items="Model.TiposPedido"
                                class="form-select"
                                required>

                            <option value="">
                                -- Seleccione --
                            </option>

                        </select>

                        <span asp-validation-for="IdTipoPedido"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- OBSERVACIÓN -->

                    <div class="col-12">

                        <label asp-for="Observacion"
                               class="form-label">

                            Observación

                        </label>

                        <textarea asp-for="Observacion"
                                  class="form-control"
                                  rows="3"
                                  maxlength="400"
                                  placeholder="Escriba una observación si es necesario...">
                        </textarea>

                        <div class="form-text">
                            Máximo 400 caracteres.
                        </div>

                        <span asp-validation-for="Observacion"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- PRODUCTOS -->
        <!-- ===================================================== -->

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-white py-3">

                <div class="d-flex justify-content-between align-items-center">

                    <h5 class="mb-0 fw-semibold">

                        <i class="bi bi-basket me-2"></i>

                        Productos

                    </h5>

                    <button type="button"
                            class="btn btn-primary btn-sm"
                            id="btnAgregarProducto">

                        <i class="bi bi-plus-circle me-1"></i>

                        Agregar producto

                    </button>

                </div>

            </div>


            <div class="card-body">

                <div id="detallesContainer">

                    @for (int i = 0; i < detalles.Count; i++)
                    {
                        <div class="detalle-producto border rounded p-3 mb-3">

                            <div class="row g-3 align-items-end">

                                <!-- PRODUCTO -->

                                <div class="col-lg-4">

                                    <label class="form-label">
                                        Producto
                                    </label>

                                    <select name="Detalles[@i].IdProducto"
                                            class="form-select producto-select"
                                            required>

                                        <option value="">
                                            -- Seleccione un producto --
                                        </option>

                                        @foreach (var producto in
                                            detalles[i].Productos
                                            ?? Enumerable.Empty<SelectListItem>())
                                        {
                                            <option value="@producto.Value">

                                                @producto.Text

                                            </option>
                                        }

                                    </select>

                                </div>


                                <!-- CANTIDAD -->

                                <div class="col-lg-2">

                                    <label class="form-label">
                                        Cantidad
                                    </label>

                                    <input name="Detalles[@i].Cantidad"
                                           type="number"
                                           class="form-control cantidad"
                                           min="1"
                                           step="1"
                                           value="@(detalles[i].Cantidad > 0
                                               ? detalles[i].Cantidad.ToString("0")
                                               : "1")"
                                           required />

                                </div>


                                <!-- DESCUENTO -->

                                <div class="col-lg-2">

                                    <label class="form-label">
                                        Descuento
                                    </label>

                                    <div class="input-group">

                                        <span class="input-group-text">
                                            C$
                                        </span>

                                        <input name="Detalles[@i].Descuento"
                                               type="number"
                                               class="form-control descuento"
                                               min="0"
                                               step="0.01"
                                               value="0" />

                                    </div>

                                </div>


                                <!-- OBSERVACIÓN -->

                                <div class="col-lg-3">

                                    <label class="form-label">
                                        Observación
                                    </label>

                                    <input name="Detalles[@i].Observacion"
                                           type="text"
                                           class="form-control"
                                           maxlength="400" />

                                </div>


                                <!-- ELIMINAR -->

                                <div class="col-lg-1">

                                    <button type="button"
                                            class="btn btn-outline-danger btnEliminarProducto w-100">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </div>

                            </div>

                        </div>
                    }

                </div>


                <div id="sinProductos"
                     class="text-center text-muted py-4"
                     style="display:none;">

                    <i class="bi bi-basket display-6"></i>

                    <p class="mb-0 mt-2">

                        Agregue al menos un producto.

                    </p>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- RESUMEN -->
        <!-- ===================================================== -->

        <div class="row justify-content-end mb-4">

            <div class="col-lg-5">

                <div class="card shadow-sm border-0">

                    <div class="card-header bg-white py-3">

                        <h5 class="mb-0 fw-semibold">

                            <i class="bi bi-calculator me-2"></i>

                            Resumen

                        </h5>

                    </div>

                    <div class="card-body">

                        <div class="d-flex justify-content-between mb-3">

                            <span class="text-muted">
                                Subtotal
                            </span>

                            <span id="resumenSubtotal">
                                C$ 0.00
                            </span>

                        </div>


                        <div class="d-flex justify-content-between mb-3">

                            <span class="text-muted">
                                Descuento
                            </span>

                            <span class="text-danger"
                                  id="resumenDescuento">

                                C$ 0.00

                            </span>

                        </div>


                        <hr />


                        <div class="d-flex justify-content-between align-items-center">

                            <span class="fw-bold">
                                Total
                            </span>

                            <span class="fs-4 fw-bold text-success"
                                  id="resumenTotal">

                                C$ 0.00

                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- BOTONES -->
        <!-- ===================================================== -->

        <div class="d-flex justify-content-between">

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-x-circle me-1"></i>

                Cancelar

            </a>


            <button type="submit"
                    class="btn btn-success btn-lg">

                <i class="bi bi-check-circle me-1"></i>

                Crear pedido

            </button>

        </div>

    </form>

</div>


<!-- ============================================================= -->
<!-- TEMPLATE -->
<!-- ============================================================= -->

<template id="detalleTemplate">

    <div class="detalle-producto border rounded p-3 mb-3">

        <div class="row g-3 align-items-end">

            <div class="col-lg-4">

                <label class="form-label">
                    Producto
                </label>

                <select name="Detalles[__INDEX__].IdProducto"
                        class="form-select producto-select"
                        required>

                    <option value="">
                        -- Seleccione un producto --
                    </option>

                    @foreach (var producto in
                        detalles.FirstOrDefault()?.Productos
                        ?? Enumerable.Empty<SelectListItem>())
                    {
                        <option value="@producto.Value">

                            @producto.Text

                        </option>
                    }

                </select>

            </div>


            <div class="col-lg-2">

                <label class="form-label">
                    Cantidad
                </label>

                <input name="Detalles[__INDEX__].Cantidad"
                       type="number"
                       class="form-control cantidad"
                       min="1"
                       step="1"
                       value="1"
                       required />

            </div>


            <div class="col-lg-2">

                <label class="form-label">
                    Descuento
                </label>

                <div class="input-group">

                    <span class="input-group-text">
                        C$
                    </span>

                    <input name="Detalles[__INDEX__].Descuento"
                           type="number"
                           class="form-control descuento"
                           min="0"
                           step="0.01"
                           value="0" />

                </div>

            </div>


            <div class="col-lg-3">

                <label class="form-label">
                    Observación
                </label>

                <input name="Detalles[__INDEX__].Observacion"
                       type="text"
                       class="form-control"
                       maxlength="400" />

            </div>


            <div class="col-lg-1">

                <button type="button"
                        class="btn btn-outline-danger btnEliminarProducto w-100">

                    <i class="bi bi-trash"></i>

                </button>

            </div>

        </div>

    </div>

</template>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const container =
                document.getElementById("detallesContainer");

            const template =
                document.getElementById("detalleTemplate");

            const btnAgregar =
                document.getElementById("btnAgregarProducto");

            const sinProductos =
                document.getElementById("sinProductos");


            function obtenerSiguienteIndice() {

                const elementos =
                    container.querySelectorAll("[name]");

                let maximo = -1;

                elementos.forEach(function (elemento) {

                    const match =
                        elemento.name.match(
                            /Detalles\[(\d+)\]/
                        );

                    if (match) {

                        const indice =
                            parseInt(match[1]);

                        maximo =
                            Math.max(
                                maximo,
                                indice
                            );

                    }

                });

                return maximo + 1;
            }


            function actualizarEstado() {

                const cantidad =
                    container.querySelectorAll(
                        ".detalle-producto"
                    ).length;

                sinProductos.style.display =
                    cantidad === 0
                        ? "block"
                        : "none";

            }


            function renumerar() {

                const detalles =
                    container.querySelectorAll(
                        ".detalle-producto"
                    );

                detalles.forEach(function (
                    detalle,
                    index
                ) {

                    detalle
                        .querySelectorAll("[name]")
                        .forEach(function (elemento) {

                            elemento.name =
                                elemento.name.replace(
                                    /Detalles\[\d+\]/,
                                    "Detalles[" +
                                    index +
                                    "]"
                                );

                        });

                });

            }


            btnAgregar.addEventListener(
                "click",
                function () {

                    const indice =
                        obtenerSiguienteIndice();

                    const html =
                        template.innerHTML.replace(
                            /__INDEX__/g,
                            indice
                        );

                    container.insertAdjacentHTML(
                        "beforeend",
                        html
                    );

                    actualizarEstado();

                });


            container.addEventListener(
                "click",
                function (event) {

                    const boton =
                        event.target.closest(
                            ".btnEliminarProducto"
                        );

                    if (!boton)
                        return;

                    const detalle =
                        boton.closest(
                            ".detalle-producto"
                        );

                    if (detalle) {

                        detalle.remove();

                        renumerar();

                        actualizarEstado();

                        calcularTotales();

                    }

                });


            function calcularTotales() {

                let subtotal = 0;
                let descuento = 0;

                const detalles =
                    container.querySelectorAll(
                        ".detalle-producto"
                    );

                detalles.forEach(function (detalle) {

                    const cantidad =
                        parseFloat(
                            detalle.querySelector(
                                ".cantidad"
                            )?.value
                        ) || 0;

                    const descuentoLinea =
                        parseFloat(
                            detalle.querySelector(
                                ".descuento"
                            )?.value
                        ) || 0;

                    const select =
                        detalle.querySelector(
                            ".producto-select"
                        );

                    if (!select)
                        return;

                    const texto =
                        select.options[
                            select.selectedIndex
                        ]?.text || "";

                    const match =
                        texto.match(
                            /C\$\s*([\d,]+(?:\.\d{1,2})?)/
                        );

                    if (!match)
                        return;

                    const precio =
                        parseFloat(
                            match[1].replace(
                                /,/g,
                                ""
                            )
                        ) || 0;

                    const subtotalLinea =
                        precio * cantidad;

                    const descuentoAplicado =
                        Math.min(
                            Math.max(
                                descuentoLinea,
                                0
                            ),
                            subtotalLinea
                        );

                    subtotal +=
                        subtotalLinea;

                    descuento +=
                        descuentoAplicado;

                });


                const total =
                    subtotal - descuento;


                document.getElementById(
                    "resumenSubtotal"
                ).textContent =
                    "C$ " +
                    subtotal.toLocaleString(
                        "es-NI",
                        {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        }
                    );


                document.getElementById(
                    "resumenDescuento"
                ).textContent =
                    "C$ " +
                    descuento.toLocaleString(
                        "es-NI",
                        {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        }
                    );


                document.getElementById(
                    "resumenTotal"
                ).textContent =
                    "C$ " +
                    total.toLocaleString(
                        "es-NI",
                        {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        }
                    );

            }


            container.addEventListener(
                "input",
                function (event) {

                    if (
                        event.target.classList.contains(
                            "cantidad"
                        ) ||
                        event.target.classList.contains(
                            "descuento"
                        )
                    ) {

                        calcularTotales();

                    }

                });


            container.addEventListener(
                "change",
                function (event) {

                    if (
                        event.target.classList.contains(
                            "producto-select"
                        )
                    ) {

                        calcularTotales();

                    }

                });


            actualizarEstado();

            calcularTotales();

        });

    </script>
}
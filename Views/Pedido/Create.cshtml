@model WebApplication1.ViewModels.PedidoViewModel

@{
    ViewData["Title"] = "Nuevo pedido";
}

<div class="container-fluid py-4">

    <!-- ========================================================= -->
    <!-- ENCABEZADO -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-receipt-cutoff me-2"></i>
                Nuevo pedido
            </h2>

            <p class="text-muted mb-0">
                Registra un nuevo pedido del restaurante.
            </p>
        </div>

        <div>
            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Volver a pedidos

            </a>
        </div>

    </div>


    <!-- ========================================================= -->
    <!-- ERRORES GENERALES -->
    <!-- ========================================================= -->

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert"
         style="@(ViewData.ModelState.IsValid ? "display:none;" : "")">

        <i class="bi bi-exclamation-triangle me-2"></i>
        Revise los datos ingresados.

    </div>


    <!-- ========================================================= -->
    <!-- FORMULARIO -->
    <!-- ========================================================= -->

    <form asp-action="Create"
          method="post"
          id="pedidoForm">

        @Html.AntiForgeryToken()


        <!-- ===================================================== -->
        <!-- INFORMACIÓN GENERAL -->
        <!-- ===================================================== -->

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-white py-3">

                <h5 class="mb-0 fw-semibold">
                    <i class="bi bi-info-circle me-2"></i>
                    Información del pedido
                </h5>

            </div>

            <div class="card-body">

                <div class="row g-3">

                    <!-- CLIENTE -->

                    <div class="col-md-4">

                        <label asp-for="IdCliente"
                               class="form-label fw-semibold">

                            Cliente
                            <span class="text-danger">*</span>

                        </label>

                        <select asp-for="IdCliente"
                                asp-items="Model.Clientes"
                                class="form-select">

                            <option value="">
                                -- Seleccione un cliente --
                            </option>

                        </select>

                        <span asp-validation-for="IdCliente"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- MESA -->

                    <div class="col-md-4">

                        <label asp-for="IdMesa"
                               class="form-label fw-semibold">

                            Mesa

                        </label>

                        <select asp-for="IdMesa"
                                asp-items="Model.Mesas"
                                class="form-select">

                            <option value="">
                                -- Sin mesa --
                            </option>

                        </select>

                        <span asp-validation-for="IdMesa"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- TIPO PEDIDO -->

                    <div class="col-md-4">

                        <label asp-for="IdTipoPedido"
                               class="form-label fw-semibold">

                            Tipo de pedido
                            <span class="text-danger">*</span>

                        </label>

                        <select asp-for="IdTipoPedido"
                                asp-items="Model.TiposPedido"
                                class="form-select">

                            <option value="">
                                -- Seleccione un tipo --
                            </option>

                        </select>

                        <span asp-validation-for="IdTipoPedido"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- FECHA -->

                    <div class="col-md-4">

                        <label asp-for="FechaPedido"
                               class="form-label fw-semibold">

                            Fecha del pedido

                        </label>

                        <input asp-for="FechaPedido"
                               class="form-control"
                               type="datetime-local" />

                        <span asp-validation-for="FechaPedido"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- OBSERVACIÓN -->

                    <div class="col-md-8">

                        <label asp-for="Observacion"
                               class="form-label fw-semibold">

                            Observación

                        </label>

                        <textarea asp-for="Observacion"
                                  class="form-control"
                                  rows="2"
                                  placeholder="Observaciones generales del pedido...">
                        </textarea>

                        <span asp-validation-for="Observacion"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- PRODUCTOS -->
        <!-- ===================================================== -->

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-white py-3">

                <div class="d-flex justify-content-between align-items-center">

                    <h5 class="mb-0 fw-semibold">

                        <i class="bi bi-basket2 me-2"></i>

                        Productos del pedido

                    </h5>

                    <button type="button"
                            class="btn btn-sm btn-outline-primary"
                            id="btnAgregarProducto">

                        <i class="bi bi-plus-circle me-1"></i>

                        Agregar producto

                    </button>

                </div>

            </div>


            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-bordered align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th style="min-width:280px;">
                                    Producto
                                </th>

                                <th style="width:120px;"
                                    class="text-center">

                                    Cantidad

                                </th>

                                <th style="width:150px;"
                                    class="text-end">

                                    Precio

                                </th>

                                <th style="width:150px;"
                                    class="text-end">

                                    Descuento

                                </th>

                                <th style="width:160px;"
                                    class="text-end">

                                    Total

                                </th>

                                <th style="width:70px;"
                                    class="text-center">

                                    Acción

                                </th>

                            </tr>

                        </thead>


                        <tbody id="detallesContainer">

                            @if (Model.Detalles != null &&
                                 Model.Detalles.Any())
                            {
                                for (int i = 0;
                                     i < Model.Detalles.Count;
                                     i++)
                                {
                                    <tr class="detalle-row">

                                        <!-- ================================= -->
                                        <!-- PRODUCTO -->
                                        <!-- ================================= -->

                                        <td>

                                            <select asp-for="Detalles[i].IdProducto"
                                                    asp-items="Model.Detalles[i].Productos"
                                                    class="form-select producto-select">

                                                <option value="">
                                                    -- Seleccione producto --
                                                </option>

                                            </select>

                                            <span asp-validation-for="Detalles[i].IdProducto"
                                                  class="text-danger small">
                                            </span>

                                        </td>


                                        <!-- ================================= -->
                                        <!-- CANTIDAD -->
                                        <!-- ================================= -->

                                        <td>

                                            <input asp-for="Detalles[i].Cantidad"
                                                   class="form-control text-center cantidad-input"
                                                   type="number"
                                                   min="0"
                                                   step="1" />

                                            <span asp-validation-for="Detalles[i].Cantidad"
                                                  class="text-danger small">
                                            </span>

                                        </td>


                                        <!-- ================================= -->
                                        <!-- PRECIO -->
                                        <!-- ================================= -->

                                        <td class="text-end">

                                            <span class="precio-text">
                                                C$ 0.00
                                            </span>

                                            <input asp-for="Detalles[i].PrecioUnitario"
                                                   type="hidden"
                                                   class="precio-input" />

                                        </td>


                                        <!-- ================================= -->
                                        <!-- DESCUENTO -->
                                        <!-- ================================= -->

                                        <td>

                                            <input asp-for="Detalles[i].Descuento"
                                                   class="form-control text-end descuento-input"
                                                   type="number"
                                                   min="0"
                                                   step="0.01"
                                                   value="0" />

                                            <span asp-validation-for="Detalles[i].Descuento"
                                                  class="text-danger small">
                                            </span>

                                        </td>


                                        <!-- ================================= -->
                                        <!-- TOTAL -->
                                        <!-- ================================= -->

                                        <td class="text-end">

                                            <strong class="total-linea">
                                                C$ 0.00
                                            </strong>

                                        </td>


                                        <!-- ================================= -->
                                        <!-- ELIMINAR -->
                                        <!-- ================================= -->

                                        <td class="text-center">

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger btn-eliminar"
                                                    title="Eliminar producto">

                                                <i class="bi bi-trash"></i>

                                            </button>

                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>

                                    <td colspan="6"
                                        class="text-center text-muted py-4">

                                        <i class="bi bi-basket display-6 d-block mb-2"></i>

                                        No hay productos agregados.

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>


                <!-- ================================================= -->
                <!-- OBSERVACIÓN POR PRODUCTO -->
                <!-- ================================================= -->

                <div class="mt-3">

                    <small class="text-muted">

                        <i class="bi bi-info-circle me-1"></i>

                        Puedes agregar observaciones específicas desde cada
                        producto si deseas ampliar posteriormente el formulario.

                    </small>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- RESUMEN -->
        <!-- ===================================================== -->

        <div class="row justify-content-end">

            <div class="col-md-5 col-lg-4">

                <div class="card shadow-sm border-0">

                    <div class="card-header bg-white">

                        <h5 class="mb-0 fw-semibold">

                            <i class="bi bi-calculator me-2"></i>

                            Resumen del pedido

                        </h5>

                    </div>


                    <div class="card-body">

                        <div class="d-flex justify-content-between mb-2">

                            <span>
                                Subtotal
                            </span>

                            <strong id="subtotalDisplay">
                                C$ 0.00
                            </strong>

                        </div>


                        <div class="d-flex justify-content-between mb-2">

                            <span>
                                Descuento
                            </span>

                            <strong class="text-danger"
                                    id="descuentoDisplay">

                                - C$ 0.00

                            </strong>

                        </div>


                        <hr />


                        <div class="d-flex justify-content-between">

                            <span class="fw-bold">
                                Total
                            </span>

                            <strong class="text-success fs-5"
                                    id="totalDisplay">

                                C$ 0.00

                            </strong>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- BOTONES -->
        <!-- ===================================================== -->

        <div class="d-flex justify-content-end gap-2 mt-4">

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-x-circle me-1"></i>

                Cancelar

            </a>


            <button type="submit"
                    class="btn btn-primary"
                    id="btnGuardar">

                <i class="bi bi-check-circle me-1"></i>

                Guardar pedido

            </button>

        </div>

    </form>

</div>


<!-- ============================================================= -->
<!-- JAVASCRIPT -->
<!-- ============================================================= -->

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const container =
                document.getElementById("detallesContainer");

            const btnAgregar =
                document.getElementById("btnAgregarProducto");

            const form =
                document.getElementById("pedidoForm");


            // =====================================================
            // FORMATEAR MONEDA
            // =====================================================

            function moneda(valor) {

                return "C$ " +
                    Number(valor || 0).toLocaleString(
                        "es-NI",
                        {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        });

            }


            // =====================================================
            // CALCULAR TOTALES
            // =====================================================

            function calcularTotales() {

                let subtotal = 0;
                let descuento = 0;

                const filas =
                    container.querySelectorAll(".detalle-row");


                filas.forEach(function (fila) {

                    const cantidadInput =
                        fila.querySelector(".cantidad-input");

                    const precioInput =
                        fila.querySelector(".precio-input");

                    const descuentoInput =
                        fila.querySelector(".descuento-input");

                    const totalLinea =
                        fila.querySelector(".total-linea");


                    const cantidad =
                        parseFloat(
                            cantidadInput?.value) || 0;

                    const precio =
                        parseFloat(
                            precioInput?.value) || 0;

                    let descuentoLinea =
                        parseFloat(
                            descuentoInput?.value) || 0;


                    const subtotalLinea =
                        cantidad * precio;


                    if (descuentoLinea < 0) {
                        descuentoLinea = 0;
                    }


                    if (descuentoLinea >
                        subtotalLinea) {

                        descuentoLinea =
                            subtotalLinea;
                    }


                    const total =
                        subtotalLinea -
                        descuentoLinea;


                    subtotal +=
                        subtotalLinea;

                    descuento +=
                        descuentoLinea;


                    if (totalLinea) {

                        totalLinea.textContent =
                            moneda(total);

                    }

                });


                const total =
                    subtotal -
                    descuento;


                document.getElementById(
                    "subtotalDisplay")
                    .textContent =
                    moneda(subtotal);


                document.getElementById(
                    "descuentoDisplay")
                    .textContent =
                    "- " +
                    moneda(descuento);


                document.getElementById(
                    "totalDisplay")
                    .textContent =
                    moneda(total);

            }


            // =====================================================
            // EVENTOS DE CÁLCULO
            // =====================================================

            function registrarEventosFila(fila) {

                const inputs =
                    fila.querySelectorAll(
                        ".cantidad-input, .descuento-input");

                inputs.forEach(function (input) {

                    input.addEventListener(
                        "input",
                        calcularTotales);

                });

            }


            container
                .querySelectorAll(".detalle-row")
                .forEach(registrarEventosFila);


            // =====================================================
            // ELIMINAR FILA
            // =====================================================

            function registrarEliminar(fila) {

                const boton =
                    fila.querySelector(".btn-eliminar");

                if (!boton)
                    return;


                boton.addEventListener(
                    "click",
                    function () {

                        const filas =
                            container.querySelectorAll(
                                ".detalle-row");


                        if (filas.length <= 1) {

                            const cantidad =
                                fila.querySelector(
                                    ".cantidad-input");

                            const producto =
                                fila.querySelector(
                                    ".producto-select");

                            const descuento =
                                fila.querySelector(
                                    ".descuento-input");


                            if (producto)
                                producto.value = "";


                            if (cantidad)
                                cantidad.value = "0";


                            if (descuento)
                                descuento.value = "0";


                            calcularTotales();

                            return;
                        }


                        fila.remove();

                        renumerarDetalles();

                        calcularTotales();

                    });

            }


            container
                .querySelectorAll(".detalle-row")
                .forEach(registrarEliminar);


            // =====================================================
            // AGREGAR PRODUCTO
            // =====================================================

            btnAgregar.addEventListener(
                "click",
                function () {

                    const filas =
                        container.querySelectorAll(
                            ".detalle-row");


                    let indice =
                        filas.length;


                    const primeraFila =
                        filas.length > 0
                            ? filas[0]
                            : null;


                    if (!primeraFila) {

                        return;

                    }


                    const nuevaFila =
                        primeraFila.cloneNode(true);


                    // =============================================
                    // LIMPIAR VALORES
                    // =============================================

                    const producto =
                        nuevaFila.querySelector(
                            ".producto-select");

                    const cantidad =
                        nuevaFila.querySelector(
                            ".cantidad-input");

                    const precio =
                        nuevaFila.querySelector(
                            ".precio-input");

                    const descuento =
                        nuevaFila.querySelector(
                            ".descuento-input");

                    const precioTexto =
                        nuevaFila.querySelector(
                            ".precio-text");

                    const totalLinea =
                        nuevaFila.querySelector(
                            ".total-linea");


                    if (producto)
                        producto.selectedIndex = 0;


                    if (cantidad)
                        cantidad.value = "1";


                    if (precio)
                        precio.value = "0";


                    if (descuento)
                        descuento.value = "0";


                    if (precioTexto)
                        precioTexto.textContent =
                            "C$ 0.00";


                    if (totalLinea)
                        totalLinea.textContent =
                            "C$ 0.00";


                    container.appendChild(
                        nuevaFila);


                    renumerarDetalles();


                    registrarEventosFila(
                        nuevaFila);

                    registrarEliminar(
                        nuevaFila);


                    calcularTotales();

                });


            // =====================================================
            // RENUMERAR DETALLES
            // =====================================================

            function renumerarDetalles() {

                const filas =
                    container.querySelectorAll(
                        ".detalle-row");


                filas.forEach(function (fila, index) {

                    fila.querySelectorAll(
                        "[name]").forEach(
                            function (elemento) {

                                const name =
                                    elemento.getAttribute(
                                        "name");

                                if (!name)
                                    return;


                                const nuevoNombre =
                                    name.replace(
                                        /Detalles\[\d+\]/,
                                        "Detalles[" +
                                        index +
                                        "]");


                                elemento.setAttribute(
                                    "name",
                                    nuevoNombre);

                            });


                    fila.querySelectorAll(
                        "[id]").forEach(
                            function (elemento) {

                                const id =
                                    elemento.getAttribute(
                                        "id");

                                if (!id)
                                    return;


                                const nuevoId =
                                    id.replace(
                                        /Detalles_\d+__/,
                                        "Detalles_" +
                                        index +
                                        "__");


                                elemento.setAttribute(
                                    "id",
                                    nuevoId);

                            });

                });

            }


            // =====================================================
            // CAMBIAR PRECIO AL SELECCIONAR PRODUCTO
            // =====================================================

            container.addEventListener(
                "change",
                function (event) {

                    if (!event.target.classList.contains(
                        "producto-select")) {

                        return;

                    }


                    /*
                     * El precio real se vuelve a consultar
                     * y validar en el controlador.
                     *
                     * Aquí solamente dejamos el valor visual.
                     */

                    const fila =
                        event.target.closest(
                            ".detalle-row");


                    if (!fila)
                        return;


                    const precioInput =
                        fila.querySelector(
                            ".precio-input");


                    const precioTexto =
                        fila.querySelector(
                            ".precio-text");


                    /*
                     * Como el select solamente contiene
                     * el nombre y precio en el texto,
                     * intentamos obtener el precio desde
                     * el texto de la opción.
                     */

                    const opcion =
                        event.target.options[
                            event.target.selectedIndex];


                    if (!opcion ||
                        !opcion.value) {

                        if (precioInput)
                            precioInput.value = "0";


                        if (precioTexto)
                            precioTexto.textContent =
                                "C$ 0.00";


                        calcularTotales();

                        return;

                    }


                    const texto =
                        opcion.textContent || "";


                    const coincidencia =
                        texto.match(
                            /C\$\s*([\d,.]+)/);


                    if (coincidencia) {

                        let precio =
                            coincidencia[1]
                                .replace(/,/g, "");


                        precio =
                            parseFloat(precio) || 0;


                        if (precioInput)
                            precioInput.value =
                                precio;


                        if (precioTexto)
                            precioTexto.textContent =
                                moneda(precio);

                    }


                    calcularTotales();

                });


            // =====================================================
            // EVITAR DOBLE ENVÍO
            // =====================================================

            form.addEventListener(
                "submit",
                function () {

                    const boton =
                        document.getElementById(
                            "btnGuardar");


                    if (boton) {

                        boton.disabled = true;

                        boton.innerHTML =
                            '<span class="spinner-border spinner-border-sm me-1"></span>' +
                            'Guardando...';

                    }

                });


            // =====================================================
            // CÁLCULO INICIAL
            // =====================================================

            calcularTotales();

        });

    </script>

}
@model WebApplication1.ViewModels.PedidoViewModel

@{
ViewData["Title"] = "Editar pedido";

var detalles = Model.Detalles
    ?? new List<WebApplication1.ViewModels.DetallePedidoViewModel>();

var productosDisponibles =
    detalles.FirstOrDefault()?.Productos
    ?? Enumerable.Empty<SelectListItem>();

var estadoActual = Model.EstadosPedido?
    .FirstOrDefault(x =>
        x.Value == Model.IdEstadoPedido.ToString())
    ?.Text ?? "Sin estado";

var estadoNormalizado = estadoActual.Trim();

/*
 * REGLA DEL FLUJO:
 *
 * 1 = Pendiente
 * 2 = En cocina
 * 3 = Preparándose
 * 4 = Listo
 * 5 = Entregado
 * 6 = Facturado
 * 7 = Cancelado
 *
 * Un pedido solamente puede modificarse
 * mientras esté pendiente.
 */

var puedeEditar = Model.IdEstadoPedido == 1;

var claseEstado = Model.IdEstadoPedido switch
{
    1 => "bg-warning text-dark",
    2 => "bg-info text-dark",
    3 => "bg-warning text-dark",
    4 => "bg-success",
    5 => "bg-secondary",
    6 => "bg-dark",
    7 => "bg-danger",
    _ => "bg-secondary"
};

var iconoEstado = Model.IdEstadoPedido switch
{
    1 => "bi-clock",
    2 => "bi-fire",
    3 => "bi-gear",
    4 => "bi-check2-circle",
    5 => "bi-box-seam",
    6 => "bi-cash-coin",
    7 => "bi-x-circle",
    _ => "bi-question-circle"
};

}

<div class="container-fluid py-4">
<!-- ========================================================= -->
<!-- ENCABEZADO -->
<!-- ========================================================= -->

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

    <div>

        <div class="d-flex align-items-center gap-2 mb-1">

            <h2 class="fw-bold mb-0">

                <i class="bi bi-pencil-square me-2"></i>

                Editar pedido

            </h2>

            <span class="badge @claseEstado">

                <i class="bi @iconoEstado me-1"></i>

                @estadoNormalizado

            </span>

        </div>

        <p class="text-muted mb-0">

            Modifique la información del pedido
            <strong>#@Model.IdPedido</strong>.

        </p>

    </div>

    <div class="mt-3 mt-md-0">

        <a asp-action="Details"
           asp-route-id="@Model.IdPedido"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>

            Regresar al detalle

        </a>

    </div>

</div>

<!-- ========================================================= -->
<!-- MENSAJES -->
<!-- ========================================================= -->

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm"
         role="alert">

        <i class="bi bi-check-circle me-2"></i>

        @TempData["Mensaje"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm"
         role="alert">

        <i class="bi bi-exclamation-triangle me-2"></i>

        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

<!-- ========================================================= -->
<!-- VALIDACIONES -->
<!-- ========================================================= -->

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger shadow-sm">

        <div class="fw-bold mb-2">

            <i class="bi bi-exclamation-triangle me-2"></i>

            Revise los siguientes errores:

        </div>

        <div asp-validation-summary="All"
             class="mb-0">
        </div>

    </div>
}

<!-- ========================================================= -->
<!-- PEDIDO NO EDITABLE -->
<!-- ========================================================= -->

@if (!puedeEditar)
{
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <div class="d-flex align-items-start">

                <div class="fs-2 text-warning me-3">

                    <i class="bi bi-lock-fill"></i>

                </div>

                <div>

                    <h5 class="fw-bold mb-1">

                        Este pedido no puede modificarse

                    </h5>

                    <p class="text-muted mb-3">

                        El pedido se encuentra actualmente en estado:

                        <span class="badge @claseEstado">

                            <i class="bi @iconoEstado me-1"></i>

                            @estadoNormalizado

                        </span>

                    </p>

                    <p class="mb-0">

                        Los pedidos solamente pueden editarse
                        mientras se encuentran en estado
                        <strong>Pendiente</strong>.

                        Una vez enviados a cocina, el pedido
                        queda bloqueado para mantener la integridad
                        del proceso.

                    </p>

                </div>

            </div>

        </div>

    </div>

    <!-- ===================================================== -->
    <!-- RESUMEN DEL PEDIDO BLOQUEADO -->
    <!-- ===================================================== -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">

            <h5 class="mb-0 fw-semibold">

                <i class="bi bi-info-circle me-2"></i>

                Información del pedido

            </h5>

        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-3">

                    <small class="text-muted d-block">
                        Pedido
                    </small>

                    <strong>
                        #@Model.IdPedido
                    </strong>

                </div>

                <div class="col-md-3">

                    <small class="text-muted d-block">
                        Fecha
                    </small>

                    <strong>
                        @Model.FechaPedido.ToString("dd/MM/yyyy HH:mm")
                    </strong>

                </div>

                <div class="col-md-3">

                    <small class="text-muted d-block">
                        Cliente
                    </small>

                    <strong>
                        @{
                            var clienteSeleccionado =
                                Model.Clientes?
                                    .FirstOrDefault(x =>
                                        x.Value ==
                                        Model.IdCliente.ToString());
                        }

                        @(clienteSeleccionado?.Text ?? "Sin cliente")
                    </strong>

                </div>

                <div class="col-md-3">

                    <small class="text-muted d-block">
                        Estado
                    </small>

                    <span class="badge @claseEstado">

                        <i class="bi @iconoEstado me-1"></i>

                        @estadoNormalizado

                    </span>

                </div>

            </div>

        </div>

    </div>
}
else
{
    <!-- ========================================================= -->
    <!-- FORMULARIO -->
    <!-- ========================================================= -->

    <form asp-action="Edit"
          asp-route-id="@Model.IdPedido"
          method="post"
          id="formPedido">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="IdPedido" />

        <input type="hidden"
               asp-for="IdEstadoPedido" />

        <input type="hidden"
               asp-for="FechaPedido" />

        <!-- ===================================================== -->
        <!-- INFORMACIÓN DEL PEDIDO -->
        <!-- ===================================================== -->

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-white py-3">

                <div class="d-flex align-items-center">

                    <div class="bg-primary-subtle rounded p-2 me-3">

                        <i class="bi bi-info-circle text-primary fs-5"></i>

                    </div>

                    <div>

                        <h5 class="mb-0 fw-semibold">

                            Información del pedido

                        </h5>

                        <small class="text-muted">

                            Datos generales del pedido.

                        </small>

                    </div>

                </div>

            </div>

            <div class="card-body">

                <div class="row g-4">

                    <!-- PEDIDO -->

                    <div class="col-md-4">

                        <label class="form-label text-muted">

                            Número de pedido

                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                #
                            </span>

                            <input type="text"
                                   class="form-control"
                                   value="@Model.IdPedido"
                                   readonly />

                        </div>

                    </div>

                    <!-- FECHA -->

                    <div class="col-md-4">

                        <label class="form-label text-muted">

                            Fecha del pedido

                        </label>

                        <input type="text"
                               class="form-control"
                               value="@Model.FechaPedido.ToString("dd/MM/yyyy HH:mm:ss")"
                               readonly />

                    </div>

                    <!-- ESTADO -->

                    <div class="col-md-4">

                        <label class="form-label text-muted">

                            Estado actual

                        </label>

                        <div class="form-control bg-light">

                            <span class="badge @claseEstado">

                                <i class="bi @iconoEstado me-1"></i>

                                @estadoNormalizado

                            </span>

                        </div>

                    </div>

                    <!-- CLIENTE -->

                    <div class="col-md-6">

                        <label asp-for="IdCliente"
                               class="form-label fw-semibold">

                            Cliente

                        </label>

                        <select asp-for="IdCliente"
                                asp-items="Model.Clientes"
                                class="form-select"
                                required>

                            <option value="">
                                -- Seleccione un cliente --
                            </option>

                        </select>

                        <span asp-validation-for="IdCliente"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- MESA -->

                    <div class="col-md-3">

                        <label asp-for="IdMesa"
                               class="form-label fw-semibold">

                            Mesa

                        </label>

                        <select asp-for="IdMesa"
                                asp-items="Model.Mesas"
                                class="form-select">

                            <option value="">
                                -- Sin mesa --
                            </option>

                        </select>

                        <span asp-validation-for="IdMesa"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- TIPO -->

                    <div class="col-md-3">

                        <label asp-for="IdTipoPedido"
                               class="form-label fw-semibold">

                            Tipo de pedido

                        </label>

                        <select asp-for="IdTipoPedido"
                                asp-items="Model.TiposPedido"
                                class="form-select"
                                required>

                            <option value="">
                                -- Seleccione --
                            </option>

                        </select>

                        <span asp-validation-for="IdTipoPedido"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- OBSERVACIÓN -->

                    <div class="col-12">

                        <label asp-for="Observacion"
                               class="form-label fw-semibold">

                            Observación general

                        </label>

                        <textarea asp-for="Observacion"
                                  class="form-control"
                                  rows="3"
                                  maxlength="400"
                                  placeholder="Escriba una observación si es necesario..."></textarea>

                        <div class="form-text">

                            Máximo 400 caracteres.

                        </div>

                        <span asp-validation-for="Observacion"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>

        </div>

        <!-- ===================================================== -->
        <!-- PRODUCTOS -->
        <!-- ===================================================== -->

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-white py-3">

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">

                    <div>

                        <h5 class="mb-0 fw-semibold">

                            <i class="bi bi-basket me-2"></i>

                            Productos del pedido

                        </h5>

                        <small class="text-muted">

                            Agregue, quite o modifique los productos.

                        </small>

                    </div>

                    <button type="button"
                            class="btn btn-primary"
                            id="btnAgregarProducto">

                        <i class="bi bi-plus-circle me-1"></i>

                        Agregar producto

                    </button>

                </div>

            </div>

            <div class="card-body">

                <div id="detallesContainer">

                    @for (int i = 0; i < detalles.Count; i++)
                    {
                        <div class="detalle-producto border rounded-3 p-3 mb-3 bg-light-subtle">

                            <div class="row g-3 align-items-end">

                                <!-- PRODUCTO -->

                                <div class="col-lg-4">

                                    <label class="form-label fw-semibold">

                                        Producto

                                    </label>

                                    <select name="Detalles[@i].IdProducto"
                                            class="form-select producto-select"
                                            required>

                                        <option value="">
                                            -- Seleccione un producto --
                                        </option>

                                        @foreach (var producto in
                                            detalles[i].Productos
                                            ?? Enumerable.Empty<SelectListItem>())
                                        {
                                            if (producto.Value ==
                                                detalles[i].IdProducto.ToString())
                                            {
                                                <option value="@producto.Value"
                                                        data-precio="@producto.Text"
                                                        selected>

                                                    @producto.Text

                                                </option>
                                            }
                                            else
                                            {
                                                <option value="@producto.Value"
                                                        data-precio="@producto.Text">

                                                    @producto.Text

                                                </option>
                                            }
                                        }

                                    </select>

                                    <div class="text-danger small validation-producto"></div>

                                </div>

                                <!-- CANTIDAD -->

                                <div class="col-lg-2">

                                    <label class="form-label fw-semibold">

                                        Cantidad

                                    </label>

                                    <input name="Detalles[@i].Cantidad"
                                           type="number"
                                           class="form-control cantidad"
                                           min="1"
                                           step="1"
                                           value="@(detalles[i].Cantidad > 0
                                               ? detalles[i].Cantidad.ToString("0")
                                               : "1")"
                                           required />

                                </div>

                                <!-- DESCUENTO -->

                                <div class="col-lg-2">

                                    <label class="form-label fw-semibold">

                                        Descuento

                                    </label>

                                    <div class="input-group">

                                        <span class="input-group-text">
                                            C$
                                        </span>

                                        <input name="Detalles[@i].Descuento"
                                               type="number"
                                               class="form-control descuento"
                                               min="0"
                                               step="0.01"
                                               value="@detalles[i].Descuento.ToString(
                                                   "0.00",
                                                   System.Globalization.CultureInfo.InvariantCulture)" />

                                    </div>

                                </div>

                                <!-- OBSERVACIÓN -->

                                <div class="col-lg-3">

                                    <label class="form-label fw-semibold">

                                        Observación

                                    </label>

                                    <input name="Detalles[@i].Observacion"
                                           type="text"
                                           class="form-control"
                                           maxlength="400"
                                           value="@detalles[i].Observacion" />

                                </div>

                                <!-- ELIMINAR -->

                                <div class="col-lg-1">

                                    <button type="button"
                                            class="btn btn-outline-danger btnEliminarProducto w-100"
                                            title="Eliminar producto">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </div>

                            </div>

                        </div>
                    }

                </div>

                <div id="sinProductos"
                     class="text-center text-muted py-5"
                     style="display:none;">

                    <i class="bi bi-basket display-5"></i>

                    <p class="mb-1 mt-3 fw-semibold">

                        No hay productos agregados.

                    </p>

                    <small>

                        Utilice el botón
                        <strong>Agregar producto</strong>
                        para comenzar.

                    </small>

                </div>

            </div>

        </div>

        <!-- ===================================================== -->
        <!-- RESUMEN -->
        <!-- ===================================================== -->

        <div class="row justify-content-end mb-4">

            <div class="col-lg-5 col-xl-4">

                <div class="card shadow-sm border-0">

                    <div class="card-header bg-white py-3">

                        <h5 class="mb-0 fw-semibold">

                            <i class="bi bi-calculator me-2"></i>

                            Resumen

                        </h5>

                    </div>

                    <div class="card-body">

                        <div class="d-flex justify-content-between mb-3">

                            <span class="text-muted">

                                Subtotal

                            </span>

                            <span class="fw-semibold"
                                  id="resumenSubtotal">

                                C$ @Model.Subtotal.ToString("N2")

                            </span>

                        </div>

                        <div class="d-flex justify-content-between mb-3">

                            <span class="text-muted">

                                Descuento

                            </span>

                            <span class="text-danger fw-semibold"
                                  id="resumenDescuento">

                                C$ @Model.Descuento.ToString("N2")

                            </span>

                        </div>

                        <hr />

                        <div class="d-flex justify-content-between align-items-center">

                            <span class="fw-bold fs-5">

                                Total

                            </span>

                            <span class="fs-3 fw-bold text-success"
                                  id="resumenTotal">

                                C$ @Model.Total.ToString("N2")

                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- ===================================================== -->
        <!-- BOTONES -->
        <!-- ===================================================== -->

        <div class="card shadow-sm border-0">

            <div class="card-body">

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">

                    <a asp-action="Details"
                       asp-route-id="@Model.IdPedido"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-x-circle me-1"></i>

                        Cancelar

                    </a>

                    <button type="submit"
                            class="btn btn-success btn-lg px-4"
                            id="btnGuardarPedido">

                        <i class="bi bi-check-circle me-1"></i>

                        Guardar cambios

                    </button>

                </div>

            </div>

        </div>

    </form>
}

</div> <!-- ============================================================= --> <!-- TEMPLATE PRODUCTO --> <!-- ============================================================= -->
@if (puedeEditar)
{
<template id="detalleTemplate">

    <div class="detalle-producto border rounded-3 p-3 mb-3 bg-light-subtle">

        <div class="row g-3 align-items-end">

            <!-- PRODUCTO -->

            <div class="col-lg-4">

                <label class="form-label fw-semibold">

                    Producto

                </label>

                <select name="Detalles[__INDEX__].IdProducto"
                        class="form-select producto-select"
                        required>

                    <option value="">
                        -- Seleccione un producto --
                    </option>

                    @foreach (var producto in productosDisponibles)
                    {
                        <option value="@producto.Value"
                                data-precio="@producto.Text">

                            @producto.Text

                        </option>
                    }

                </select>

                <div class="text-danger small validation-producto"></div>

            </div>

            <!-- CANTIDAD -->

            <div class="col-lg-2">

                <label class="form-label fw-semibold">

                    Cantidad

                </label>

                <input name="Detalles[__INDEX__].Cantidad"
                       type="number"
                       class="form-control cantidad"
                       min="1"
                       step="1"
                       value="1"
                       required />

            </div>

            <!-- DESCUENTO -->

            <div class="col-lg-2">

                <label class="form-label fw-semibold">

                    Descuento

                </label>

                <div class="input-group">

                    <span class="input-group-text">
                        C$
                    </span>

                    <input name="Detalles[__INDEX__].Descuento"
                           type="number"
                           class="form-control descuento"
                           min="0"
                           step="0.01"
                           value="0.00" />

                </div>

            </div>

            <!-- OBSERVACIÓN -->

            <div class="col-lg-3">

                <label class="form-label fw-semibold">

                    Observación

                </label>

                <input name="Detalles[__INDEX__].Observacion"
                       type="text"
                       class="form-control"
                       maxlength="400" />

            </div>

            <!-- ELIMINAR -->

            <div class="col-lg-1">

                <button type="button"
                        class="btn btn-outline-danger btnEliminarProducto w-100"
                        title="Eliminar producto">

                    <i class="bi bi-trash"></i>

                </button>

            </div>

        </div>

    </div>

</template>

}

@section Scripts {

<partial name="_ValidationScriptsPartial" />

@if (puedeEditar)
{
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const container =
                document.getElementById("detallesContainer");

            const template =
                document.getElementById("detalleTemplate");

            const btnAgregar =
                document.getElementById("btnAgregarProducto");

            const sinProductos =
                document.getElementById("sinProductos");

            const form =
                document.getElementById("formPedido");

            // =====================================================
            // FORMATO MONEDA
            // =====================================================

            function formatoMoneda(valor) {

                return "C$ " +
                    Number(valor || 0).toLocaleString(
                        "es-NI",
                        {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        }
                    );

            }

            // =====================================================
            // OBTENER PRECIO
            // =====================================================

            function obtenerPrecio(select) {

                if (!select ||
                    select.selectedIndex < 0) {

                    return 0;

                }

                const option =
                    select.options[select.selectedIndex];

                if (!option) {

                    return 0;

                }

                /*
                 * Primero intenta obtener el precio
                 * desde data-precio.
                 */

                const precioData =
                    option.dataset.precio || "";

                const matchData =
                    precioData.match(
                        /C\$\s*([\d,]+(?:\.\d{1,2})?)/
                    );

                if (matchData) {

                    return parseFloat(
                        matchData[1].replace(/,/g, "")
                    ) || 0;

                }

                /*
                 * Compatibilidad con el formato
                 * anterior del texto.
                 */

                const texto =
                    option.textContent || "";

                const matchTexto =
                    texto.match(
                        /C\$\s*([\d,]+(?:\.\d{1,2})?)/
                    );

                if (!matchTexto) {

                    return 0;

                }

                return parseFloat(
                    matchTexto[1].replace(/,/g, "")
                ) || 0;

            }

            // =====================================================
            // ACTUALIZAR ESTADO
            // =====================================================

            function actualizarEstadoProductos() {

                const cantidad =
                    container.querySelectorAll(
                        ".detalle-producto"
                    ).length;

                if (sinProductos) {

                    sinProductos.style.display =
                        cantidad === 0
                            ? "block"
                            : "none";

                }

            }

            // =====================================================
            // SIGUIENTE ÍNDICE
            // =====================================================

            function obtenerSiguienteIndice() {

                const elementos =
                    container.querySelectorAll(
                        "[name^='Detalles[']"
                    );

                let max = -1;

                elementos.forEach(function (elemento) {

                    const match =
                        elemento.name.match(
                            /Detalles\[(\d+)\]/
                        );

                    if (match) {

                        const indice =
                            parseInt(
                                match[1],
                                10
                            );

                        if (indice > max) {

                            max = indice;

                        }

                    }

                });

                return max + 1;

            }

            // =====================================================
            // RENUMERAR
            // =====================================================

            function renumerarDetalles() {

                const detalles =
                    container.querySelectorAll(
                        ".detalle-producto"
                    );

                detalles.forEach(function (detalle, index) {

                    detalle
                        .querySelectorAll("[name]")
                        .forEach(function (elemento) {

                            elemento.name =
                                elemento.name.replace(
                                    /Detalles\[\d+\]/,
                                    "Detalles[" +
                                    index +
                                    "]"
                                );

                        });

                });

            }

            // =====================================================
            // CALCULAR TOTALES
            // =====================================================

            function calcularTotales() {

                let subtotal = 0;

                let descuento = 0;

                const detalles =
                    container.querySelectorAll(
                        ".detalle-producto"
                    );

                detalles.forEach(function (detalle) {

                    const select =
                        detalle.querySelector(
                            ".producto-select"
                        );

                    const cantidadInput =
                        detalle.querySelector(
                            ".cantidad"
                        );

                    const descuentoInput =
                        detalle.querySelector(
                            ".descuento"
                        );

                    const cantidad =
                        parseFloat(
                            cantidadInput?.value
                        ) || 0;

                    const descuentoLinea =
                        parseFloat(
                            descuentoInput?.value
                        ) || 0;

                    const precio =
                        obtenerPrecio(select);

                    if (
                        precio <= 0 ||
                        cantidad <= 0
                    ) {

                        return;

                    }

                    const subtotalLinea =
                        precio * cantidad;

                    const descuentoAplicado =
                        Math.min(
                            Math.max(
                                descuentoLinea,
                                0
                            ),
                            subtotalLinea
                        );

                    subtotal +=
                        subtotalLinea;

                    descuento +=
                        descuentoAplicado;

                });

                const total =
                    Math.max(
                        subtotal - descuento,
                        0
                    );

                const elementoSubtotal =
                    document.getElementById(
                        "resumenSubtotal"
                    );

                const elementoDescuento =
                    document.getElementById(
                        "resumenDescuento"
                    );

                const elementoTotal =
                    document.getElementById(
                        "resumenTotal"
                    );

                if (elementoSubtotal) {

                    elementoSubtotal.textContent =
                        formatoMoneda(subtotal);

                }

                if (elementoDescuento) {

                    elementoDescuento.textContent =
                        formatoMoneda(descuento);

                }

                if (elementoTotal) {

                    elementoTotal.textContent =
                        formatoMoneda(total);

                }

            }

            // =====================================================
            // AGREGAR PRODUCTO
            // =====================================================

            if (btnAgregar) {

                btnAgregar.addEventListener(
                    "click",
                    function () {

                        const indice =
                            obtenerSiguienteIndice();

                        const html =
                            template.innerHTML.replace(
                                /__INDEX__/g,
                                indice
                            );

                        container.insertAdjacentHTML(
                            "beforeend",
                            html
                        );

                        actualizarEstadoProductos();

                        calcularTotales();

                        const detalles =
                            container.querySelectorAll(
                                ".detalle-producto"
                            );

                        const ultimo =
                            detalles[
                                detalles.length - 1
                            ];

                        ultimo
                            ?.querySelector(
                                ".producto-select"
                            )
                            ?.focus();

                    }
                );

            }

            // =====================================================
            // ELIMINAR PRODUCTO
            // =====================================================

            container.addEventListener(
                "click",
                function (event) {

                    const boton =
                        event.target.closest(
                            ".btnEliminarProducto"
                        );

                    if (!boton) {

                        return;

                    }

                    const detalle =
                        boton.closest(
                            ".detalle-producto"
                        );

                    if (!detalle) {

                        return;

                    }

                    detalle.remove();

                    renumerarDetalles();

                    actualizarEstadoProductos();

                    calcularTotales();

                }
            );

            // =====================================================
            // CAMBIOS
            // =====================================================

            container.addEventListener(
                "input",
                function (event) {

                    if (
                        event.target.classList.contains(
                            "cantidad"
                        ) ||
                        event.target.classList.contains(
                            "descuento"
                        )
                    ) {

                        calcularTotales();

                    }

                }
            );

            container.addEventListener(
                "change",
                function (event) {

                    if (
                        event.target.classList.contains(
                            "producto-select"
                        )
                    ) {

                        calcularTotales();

                    }

                }
            );

            // =====================================================
            // VALIDACIÓN
            // =====================================================

            if (form) {

                form.addEventListener(
                    "submit",
                    function (event) {

                        const detalles =
                            container.querySelectorAll(
                                ".detalle-producto"
                            );

                        if (detalles.length === 0) {

                            event.preventDefault();

                            alert(
                                "Debe agregar al menos un producto al pedido."
                            );

                            return;

                        }

                        let formularioInvalido =
                            false;

                        detalles.forEach(
                            function (detalle) {

                                const producto =
                                    detalle.querySelector(
                                        ".producto-select"
                                    );

                                const cantidad =
                                    detalle.querySelector(
                                        ".cantidad"
                                    );

                                const descuento =
                                    detalle.querySelector(
                                        ".descuento"
                                    );

                                // -----------------------------
                                // PRODUCTO
                                // -----------------------------

                                if (
                                    !producto ||
                                    !producto.value
                                ) {

                                    formularioInvalido =
                                        true;

                                    producto?.classList.add(
                                        "is-invalid"
                                    );

                                }
                                else {

                                    producto.classList.remove(
                                        "is-invalid"
                                    );

                                }

                                // -----------------------------
                                // CANTIDAD
                                // -----------------------------

                                const cantidadValor =
                                    parseInt(
                                        cantidad?.value,
                                        10
                                    );

                                if (
                                    !cantidad ||
                                    isNaN(cantidadValor) ||
                                    cantidadValor < 1
                                ) {

                                    formularioInvalido =
                                        true;

                                    cantidad?.classList.add(
                                        "is-invalid"
                                    );

                                }
                                else {

                                    cantidad.classList.remove(
                                        "is-invalid"
                                    );

                                }

                                // -----------------------------
                                // DESCUENTO
                                // -----------------------------

                                const descuentoValor =
                                    parseFloat(
                                        descuento?.value
                                    );

                                if (
                                    descuento &&
                                    (
                                        isNaN(descuentoValor) ||
                                        descuentoValor < 0
                                    )
                                ) {

                                    formularioInvalido =
                                        true;

                                    descuento.classList.add(
                                        "is-invalid"
                                    );

                                }
                                else {

                                    descuento?.classList.remove(
                                        "is-invalid"
                                    );

                                }

                            }
                        );

                        if (formularioInvalido) {

                            event.preventDefault();

                            alert(
                                "Revise los productos, cantidades y descuentos antes de guardar los cambios."
                            );

                            return;

                        }

                        // -----------------------------
                        // EVITAR DOBLE ENVÍO
                        // -----------------------------

                        const boton =
                            document.getElementById(
                                "btnGuardarPedido"
                            );

                        if (boton) {

                            boton.disabled =
                                true;

                            boton.innerHTML =
                                '<span class="spinner-border spinner-border-sm me-2"></span>' +
                                'Guardando cambios...';

                        }

                    }
                );

            }

            // =====================================================
            // INICIALIZACIÓN
            // =====================================================

            actualizarEstadoProductos();

            calcularTotales();

        });

    </script>
}

}
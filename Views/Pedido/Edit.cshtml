@model WebApplication1.ViewModels.PedidoViewModel

@{
    ViewData["Title"] = "Editar pedido";

    var estados = Model.EstadosPedido ?? new List<SelectListItem>();
}

<div class="container-fluid py-4">

    <!-- ========================================================= -->
    <!-- ENCABEZADO -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-pencil-square me-2"></i>
                Editar pedido
            </h2>

            <p class="text-muted mb-0">
                Modifique la información y los productos del pedido.
            </p>
        </div>

        <div>

            <a asp-action="Details"
               asp-route-id="@Model.IdPedido"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Volver

            </a>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- MENSAJES DE VALIDACIÓN -->
    <!-- ========================================================= -->

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert"
         style="@(ViewData.ModelState.IsValid ? "display:none;" : "")">
    </div>


    <!-- ========================================================= -->
    <!-- FORMULARIO -->
    <!-- ========================================================= -->

    <form asp-action="Edit"
          asp-route-id="@Model.IdPedido"
          method="post"
          id="pedidoForm">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="IdPedido" />

        <div class="row g-4">

            <!-- ================================================= -->
            <!-- INFORMACIÓN GENERAL -->
            <!-- ================================================= -->

            <div class="col-12">

                <div class="card shadow-sm border-0">

                    <div class="card-header bg-white py-3">

                        <h5 class="mb-0 fw-semibold">
                            <i class="bi bi-receipt me-2"></i>
                            Información del pedido
                        </h5>

                    </div>

                    <div class="card-body">

                        <div class="row g-3">

                            <!-- NÚMERO -->

                            <div class="col-md-3">

                                <label class="form-label fw-semibold">
                                    Número de pedido
                                </label>

                                <input type="text"
                                       class="form-control"
                                       value="@(Model.IdPedido > 0 ? $"PED-{Model.IdPedido:000000}" : "")"
                                       readonly />

                            </div>


                            <!-- FECHA -->

                            <div class="col-md-3">

                                <label asp-for="FechaPedido"
                                       class="form-label fw-semibold">
                                    Fecha
                                </label>

                                <input asp-for="FechaPedido"
                                       type="datetime-local"
                                       class="form-control" />

                                <span asp-validation-for="FechaPedido"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- CLIENTE -->

                            <div class="col-md-3">

                                <label asp-for="IdCliente"
                                       class="form-label fw-semibold">

                                    Cliente
                                    <span class="text-danger">*</span>

                                </label>

                                <select asp-for="IdCliente"
                                        asp-items="Model.Clientes"
                                        class="form-select">

                                    <option value="">
                                        -- Seleccione un cliente --
                                    </option>

                                </select>

                                <span asp-validation-for="IdCliente"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- TIPO -->

                            <div class="col-md-3">

                                <label asp-for="IdTipoPedido"
                                       class="form-label fw-semibold">

                                    Tipo de pedido
                                    <span class="text-danger">*</span>

                                </label>

                                <select asp-for="IdTipoPedido"
                                        asp-items="Model.TiposPedido"
                                        class="form-select">

                                    <option value="">
                                        -- Seleccione --
                                    </option>

                                </select>

                                <span asp-validation-for="IdTipoPedido"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- MESA -->

                            <div class="col-md-4">

                                <label asp-for="IdMesa"
                                       class="form-label fw-semibold">

                                    Mesa

                                </label>

                                <select asp-for="IdMesa"
                                        asp-items="Model.Mesas"
                                        class="form-select">

                                    <option value="">
                                        -- Sin mesa --
                                    </option>

                                </select>

                                <span asp-validation-for="IdMesa"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- ESTADO -->

                            <div class="col-md-4">

                                <label class="form-label fw-semibold">
                                    Estado actual
                                </label>

                                <input type="text"
                                       class="form-control"
                                       value="@(Model.EstadosPedido?
                                           .FirstOrDefault(e =>
                                               e.Value == Model.IdEstadoPedido.ToString())?.Text
                                           ?? "Sin estado")"
                                       readonly />

                                <small class="text-muted">
                                    El estado se modifica desde la pantalla
                                    de detalles.
                                </small>

                            </div>


                            <!-- OBSERVACIÓN -->

                            <div class="col-md-4">

                                <label asp-for="Observacion"
                                       class="form-label fw-semibold">

                                    Observación

                                </label>

                                <textarea asp-for="Observacion"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Observaciones del pedido...">
                                </textarea>

                                <span asp-validation-for="Observacion"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- PRODUCTOS -->
            <!-- ================================================= -->

            <div class="col-12">

                <div class="card shadow-sm border-0">

                    <div class="card-header bg-white py-3">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <h5 class="mb-0 fw-semibold">

                                    <i class="bi bi-basket me-2"></i>

                                    Productos

                                </h5>

                                <small class="text-muted">
                                    Agregue o modifique los productos del pedido.
                                </small>

                            </div>

                            <button type="button"
                                    class="btn btn-sm btn-primary"
                                    id="btnAgregarProducto">

                                <i class="bi bi-plus-circle me-1"></i>
                                Agregar producto

                            </button>

                        </div>

                    </div>


                    <div class="card-body">

                        <div id="detallesContainer">

                            @if (Model.Detalles != null &&
                                 Model.Detalles.Any())
                            {
                                @for (int i = 0;
                                     i < Model.Detalles.Count;
                                     i++)
                                {
                                    <div class="detalle-producto border rounded p-3 mb-3">

                                        <!-- CAMPOS OCULTOS -->

                                        <input type="hidden"
                                               name="Detalles[@i].IdDetallePedido"
                                               value="@Model.Detalles[i].IdDetallePedido" />

                                        <input type="hidden"
                                               name="Detalles[@i].IdPedido"
                                               value="@Model.IdPedido" />


                                        <div class="row g-3 align-items-end">

                                            <!-- PRODUCTO -->

                                            <div class="col-md-4">

                                                <label class="form-label fw-semibold">
                                                    Producto
                                                </label>

                                                <select name="Detalles[@i].IdProducto"
                                                        class="form-select producto-select">

                                                    <option value="">
                                                        -- Seleccione producto --
                                                    </option>

                                                    @foreach (var producto in
                                                             Model.Detalles[i].Productos
                                                             ?? new List<SelectListItem>())
                                                    {
                                                        <option value="@producto.Value"
                                                                selected="@(producto.Value == Model.Detalles[i].IdProducto.ToString())">

                                                            @producto.Text

                                                        </option>
                                                    }

                                                </select>

                                            </div>


                                            <!-- CANTIDAD -->

                                            <div class="col-md-2">

                                                <label class="form-label fw-semibold">
                                                    Cantidad
                                                </label>

                                                <input name="Detalles[@i].Cantidad"
                                                       type="number"
                                                       class="form-control cantidad"
                                                       min="0"
                                                       step="1"
                                                       value="@Model.Detalles[i].Cantidad" />

                                            </div>


                                            <!-- PRECIO -->

                                            <div class="col-md-2">

                                                <label class="form-label fw-semibold">
                                                    Precio unitario
                                                </label>

                                                <input type="text"
                                                       class="form-control precio"
                                                       value="C$ @Model.Detalles[i].PrecioUnitario.ToString("N2")"
                                                       readonly />

                                            </div>


                                            <!-- DESCUENTO -->

                                            <div class="col-md-2">

                                                <label class="form-label fw-semibold">
                                                    Descuento
                                                </label>

                                                <input name="Detalles[@i].Descuento"
                                                       type="number"
                                                       class="form-control descuento"
                                                       min="0"
                                                       step="0.01"
                                                       value="@Model.Detalles[i].Descuento" />

                                            </div>


                                            <!-- ELIMINAR -->

                                            <div class="col-md-2">

                                                <button type="button"
                                                        class="btn btn-outline-danger w-100 btnEliminarProducto">

                                                    <i class="bi bi-trash me-1"></i>
                                                    Eliminar

                                                </button>

                                            </div>


                                            <!-- OBSERVACIÓN -->

                                            <div class="col-12">

                                                <label class="form-label">
                                                    Observación del producto
                                                </label>

                                                <input name="Detalles[@i].Observacion"
                                                       type="text"
                                                       class="form-control"
                                                       value="@Model.Detalles[i].Observacion"
                                                       placeholder="Observación..." />

                                            </div>

                                        </div>

                                    </div>
                                }
                            }
                            else
                            {
                                <div id="sinProductos"
                                     class="text-center py-4 text-muted">

                                    <i class="bi bi-basket display-6"></i>

                                    <p class="mt-2 mb-0">
                                        No hay productos agregados.
                                    </p>

                                </div>
                            }

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- TOTALES -->
            <!-- ================================================= -->

            <div class="col-md-5 ms-auto">

                <div class="card shadow-sm border-0">

                    <div class="card-header bg-white py-3">

                        <h5 class="mb-0 fw-semibold">
                            <i class="bi bi-calculator me-2"></i>
                            Resumen
                        </h5>

                    </div>

                    <div class="card-body">

                        <div class="d-flex justify-content-between mb-2">

                            <span>
                                Subtotal
                            </span>

                            <strong id="subtotalVisual">
                                C$ @Model.Subtotal.ToString("N2")
                            </strong>

                        </div>


                        <div class="d-flex justify-content-between mb-2">

                            <span>
                                Descuento
                            </span>

                            <strong class="text-danger"
                                    id="descuentoVisual">

                                - C$ @Model.Descuento.ToString("N2")

                            </strong>

                        </div>


                        <div class="d-flex justify-content-between mb-2">

                            <span>
                                Impuesto
                            </span>

                            <strong id="impuestoVisual">
                                C$ @Model.Impuesto.ToString("N2")
                            </strong>

                        </div>


                        <hr />


                        <div class="d-flex justify-content-between">

                            <span class="fw-bold fs-5">
                                Total
                            </span>

                            <strong class="text-success fs-5"
                                    id="totalVisual">

                                C$ @Model.Total.ToString("N2")

                            </strong>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- BOTONES -->
            <!-- ================================================= -->

            <div class="col-12">

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Details"
                       asp-route-id="@Model.IdPedido"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-x-circle me-1"></i>
                        Cancelar

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-save me-1"></i>
                        Guardar cambios

                    </button>

                </div>

            </div>

        </div>

    </form>

</div>


<!-- ============================================================= -->
<!-- TEMPLATE PRODUCTO -->
<!-- ============================================================= -->

<template id="detalleTemplate">

    <div class="detalle-producto border rounded p-3 mb-3">

        <input type="hidden"
               name="Detalles[INDEX].IdDetallePedido"
               value="0" />

        <input type="hidden"
               name="Detalles[INDEX].IdPedido"
               value="@Model.IdPedido" />

        <div class="row g-3 align-items-end">

            <div class="col-md-4">

                <label class="form-label fw-semibold">
                    Producto
                </label>

                <select name="Detalles[INDEX].IdProducto"
                        class="form-select producto-select">

                    <option value="">
                        -- Seleccione producto --
                    </option>

                    @foreach (var producto in
                             Model.Detalles?
                                 .FirstOrDefault()?
                                 .Productos
                             ?? new List<SelectListItem>())
                    {
                        <option value="@producto.Value">
                            @producto.Text
                        </option>
                    }

                </select>

            </div>


            <div class="col-md-2">

                <label class="form-label fw-semibold">
                    Cantidad
                </label>

                <input name="Detalles[INDEX].Cantidad"
                       type="number"
                       class="form-control cantidad"
                       min="0"
                       step="1"
                       value="1" />

            </div>


            <div class="col-md-2">

                <label class="form-label fw-semibold">
                    Precio unitario
                </label>

                <input type="text"
                       class="form-control precio"
                       value="C$ 0.00"
                       readonly />

            </div>


            <div class="col-md-2">

                <label class="form-label fw-semibold">
                    Descuento
                </label>

                <input name="Detalles[INDEX].Descuento"
                       type="number"
                       class="form-control descuento"
                       min="0"
                       step="0.01"
                       value="0" />

            </div>


            <div class="col-md-2">

                <button type="button"
                        class="btn btn-outline-danger w-100 btnEliminarProducto">

                    <i class="bi bi-trash me-1"></i>
                    Eliminar

                </button>

            </div>


            <div class="col-12">

                <label class="form-label">
                    Observación del producto
                </label>

                <input name="Detalles[INDEX].Observacion"
                       type="text"
                       class="form-control"
                       placeholder="Observación..." />

            </div>

        </div>

    </div>

</template>


<!-- ============================================================= -->
<!-- SCRIPTS -->
<!-- ============================================================= -->

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const container =
                document.getElementById("detallesContainer");

            const template =
                document.getElementById("detalleTemplate");

            const btnAgregar =
                document.getElementById("btnAgregarProducto");


            // =====================================================
            // AGREGAR PRODUCTO
            // =====================================================

            btnAgregar.addEventListener("click", function () {

                const index =
                    container.querySelectorAll(".detalle-producto").length;

                const html =
                    template.innerHTML.replaceAll(
                        "INDEX",
                        index
                    );

                const sinProductos =
                    document.getElementById("sinProductos");

                if (sinProductos) {
                    sinProductos.remove();
                }

                container.insertAdjacentHTML(
                    "beforeend",
                    html
                );

                actualizarEventos();

            });


            // =====================================================
            // ELIMINAR PRODUCTO
            // =====================================================

            function actualizarEventos() {

                document
                    .querySelectorAll(".btnEliminarProducto")
                    .forEach(function (button) {

                        button.onclick = function () {

                            const detalle =
                                button.closest(".detalle-producto");

                            if (detalle) {

                                detalle.remove();

                                recalcularTotales();

                            }

                            if (
                                container.querySelectorAll(
                                    ".detalle-producto"
                                ).length === 0
                            ) {

                                container.innerHTML = `
                                    <div id="sinProductos"
                                         class="text-center py-4 text-muted">

                                        <i class="bi bi-basket display-6"></i>

                                        <p class="mt-2 mb-0">
                                            No hay productos agregados.
                                        </p>

                                    </div>
                                `;

                            }

                        };

                    });


                document
                    .querySelectorAll(".cantidad, .descuento")
                    .forEach(function (input) {

                        input.addEventListener(
                            "input",
                            recalcularTotales
                        );

                    });

            }


            // =====================================================
            // RECALCULAR TOTALES VISUALES
            // =====================================================

            function recalcularTotales() {

                let subtotal = 0;
                let descuento = 0;

                document
                    .querySelectorAll(".detalle-producto")
                    .forEach(function (detalle) {

                        const cantidadInput =
                            detalle.querySelector(".cantidad");

                        const precioInput =
                            detalle.querySelector(".precio");

                        const descuentoInput =
                            detalle.querySelector(".descuento");


                        const cantidad =
                            parseFloat(
                                cantidadInput?.value
                            ) || 0;


                        let precioTexto =
                            precioInput?.value || "0";

                        precioTexto =
                            precioTexto
                                .replace("C$", "")
                                .replace(/\s/g, "")
                                .replace(/,/g, "");


                        const precio =
                            parseFloat(precioTexto) || 0;


                        const descuentoLinea =
                            parseFloat(
                                descuentoInput?.value
                            ) || 0;


                        const subtotalLinea =
                            cantidad * precio;


                        subtotal +=
                            subtotalLinea;


                        descuento +=
                            Math.min(
                                Math.max(
                                    descuentoLinea,
                                    0
                                ),
                                subtotalLinea
                            );

                    });


                const impuesto = 0;

                const total =
                    subtotal -
                    descuento +
                    impuesto;


                document.getElementById(
                    "subtotalVisual"
                ).textContent =
                    "C$ " +
                    subtotal.toLocaleString(
                        "es-NI",
                        {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        }
                    );


                document.getElementById(
                    "descuentoVisual"
                ).textContent =
                    "- C$ " +
                    descuento.toLocaleString(
                        "es-NI",
                        {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        }
                    );


                document.getElementById(
                    "impuestoVisual"
                ).textContent =
                    "C$ " +
                    impuesto.toLocaleString(
                        "es-NI",
                        {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        }
                    );


                document.getElementById(
                    "totalVisual"
                ).textContent =
                    "C$ " +
                    total.toLocaleString(
                        "es-NI",
                        {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        }
                    );

            }


            // =====================================================
            // INICIALIZAR
            // =====================================================

            actualizarEventos();

        });

    </script>
}
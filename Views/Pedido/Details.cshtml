@model WebApplication1.Models.Pedido

@{
ViewData["Title"] = "Detalle del pedido";

var estado = Model.IdEstadoPedidoNavigation?.Nombre ?? "Sin estado";
var estadoNormalizado = estado.Trim();

// =========================================================
// ESTADOS
// =========================================================

var estaPendiente =
    estadoNormalizado.Equals(
        "Pendiente",
        StringComparison.OrdinalIgnoreCase);

var estaEnCocina =
    estadoNormalizado.Equals(
        "En cocina",
        StringComparison.OrdinalIgnoreCase);

var estaPreparandose =
    estadoNormalizado.Equals(
        "Preparándose",
        StringComparison.OrdinalIgnoreCase);

var estaListo =
    estadoNormalizado.Equals(
        "Listo",
        StringComparison.OrdinalIgnoreCase);

var estaEntregado =
    estadoNormalizado.Equals(
        "Entregado",
        StringComparison.OrdinalIgnoreCase);

var estaFacturado =
    estadoNormalizado.Equals(
        "Facturado",
        StringComparison.OrdinalIgnoreCase);

var estaCancelado =
    estadoNormalizado.Equals(
        "Cancelado",
        StringComparison.OrdinalIgnoreCase);

// =========================================================
// PERMISOS
// =========================================================

var puedeCancelar =
    (User.IsInRole("Administrador") ||
     User.IsInRole("Gerente"))
    &&
    !estaCancelado
    &&
    !estaFacturado;

var puedeEditar =
    (User.IsInRole("Administrador") ||
     User.IsInRole("Gerente") ||
     User.IsInRole("Mesero"))
    &&
    estaPendiente
    &&
    !estaFacturado;

// =========================================================
// SIGUIENTE ESTADO
// =========================================================

bool puedeAvanzarEstado =
    ViewBag.PuedeAvanzarEstado != null &&
    Convert.ToBoolean(ViewBag.PuedeAvanzarEstado);

string siguienteEstadoNombre =
    ViewBag.SiguienteEstadoNombre as string ?? "";

int? siguienteEstadoId =
    ViewBag.SiguienteEstadoId != null
        ? Convert.ToInt32(ViewBag.SiguienteEstadoId)
        : null;

// =========================================================
// FACTURA
// =========================================================

bool tieneFactura =
    ViewBag.TieneFactura != null &&
    Convert.ToBoolean(ViewBag.TieneFactura);

// =========================================================
// PUEDE FACTURAR
// =========================================================

bool puedeFacturar =
    ViewBag.PuedeFacturar != null &&
    Convert.ToBoolean(ViewBag.PuedeFacturar);

}

<div class="container-fluid py-4">
<!-- ========================================================= -->
<!-- ENCABEZADO -->
<!-- ========================================================= -->

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            <i class="bi bi-receipt-cutoff me-2"></i>
            Detalle del pedido
        </h2>

        <p class="text-muted mb-0">
            Información detallada del pedido
            <strong>
                @(Model.NumeroPedido ?? $"#{Model.IdPedido}")
            </strong>.
        </p>

    </div>

    <div class="d-flex gap-2">

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Regresar a pedidos

        </a>

        @if (puedeEditar)
        {
            <a asp-action="Edit"
               asp-route-id="@Model.IdPedido"
               class="btn btn-warning">

                <i class="bi bi-pencil me-1"></i>
                Editar

            </a>
        }

    </div>

</div>

<!-- ========================================================= -->
<!-- MENSAJES -->
<!-- ========================================================= -->

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        <i class="bi bi-check-circle me-2"></i>
        @TempData["Mensaje"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">

        <i class="bi bi-exclamation-triangle me-2"></i>
        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

<!-- ========================================================= -->
<!-- INFORMACIÓN PRINCIPAL -->
<!-- ========================================================= -->

<div class="row g-4 mb-4">

    <!-- INFORMACIÓN DEL PEDIDO -->

    <div class="col-lg-8">

        <div class="card shadow-sm border-0 h-100">

            <div class="card-header bg-white py-3">

                <h5 class="mb-0 fw-semibold">
                    <i class="bi bi-info-circle me-2"></i>
                    Información del pedido
                </h5>

            </div>

            <div class="card-body">

                <div class="row g-4">

                    <!-- NÚMERO -->

                    <div class="col-md-4">

                        <label class="text-muted small d-block">
                            Número de pedido
                        </label>

                        <div class="fw-bold fs-5">
                            @(Model.NumeroPedido ?? $"#{Model.IdPedido}")
                        </div>

                    </div>

                    <!-- FECHA -->

                    <div class="col-md-4">

                        <label class="text-muted small d-block">
                            Fecha
                        </label>

                        <div>
                            @Model.FechaPedido.ToString("dd/MM/yyyy")
                        </div>

                        <small class="text-muted">
                            @Model.FechaPedido.ToString("HH:mm:ss")
                        </small>

                    </div>

                    <!-- ESTADO -->

                    <div class="col-md-4">

                        <label class="text-muted small d-block">
                            Estado
                        </label>

                        @if (estaCancelado)
                        {
                            <span class="badge bg-danger">
                                <i class="bi bi-x-circle me-1"></i>
                                Cancelado
                            </span>
                        }
                        else if (estaFacturado)
                        {
                            <span class="badge bg-success">
                                <i class="bi bi-cash-coin me-1"></i>
                                Facturado
                            </span>
                        }
                        else if (estaPendiente)
                        {
                            <span class="badge bg-warning text-dark">
                                <i class="bi bi-clock me-1"></i>
                                Pendiente
                            </span>
                        }
                        else if (estaEnCocina)
                        {
                            <span class="badge bg-info text-dark">
                                <i class="bi bi-fire me-1"></i>
                                En cocina
                            </span>
                        }
                        else if (estaPreparandose)
                        {
                            <span class="badge bg-primary">
                                <i class="bi bi-gear me-1"></i>
                                Preparándose
                            </span>
                        }
                        else if (estaListo)
                        {
                            <span class="badge bg-primary">
                                <i class="bi bi-check2-circle me-1"></i>
                                Listo
                            </span>
                        }
                        else if (estaEntregado)
                        {
                            <span class="badge bg-success">
                                <i class="bi bi-box-seam me-1"></i>
                                Entregado
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                @estado
                            </span>
                        }

                    </div>

                    <!-- CLIENTE -->

                    <div class="col-md-6">

                        <label class="text-muted small d-block">
                            Cliente
                        </label>

                        @if (Model.IdClienteNavigation != null)
                        {
                            <div class="fw-semibold">

                                @Model.IdClienteNavigation.Nombres
                                @Model.IdClienteNavigation.Apellidos

                            </div>

                            @if (!string.IsNullOrWhiteSpace(
                                Model.IdClienteNavigation.Telefono))
                            {
                                <small class="text-muted">

                                    <i class="bi bi-telephone me-1"></i>
                                    @Model.IdClienteNavigation.Telefono

                                </small>
                            }
                        }
                        else
                        {
                            <div class="text-muted">
                                Sin cliente
                            </div>
                        }

                    </div>

                    <!-- MESA -->

                    <div class="col-md-3">

                        <label class="text-muted small d-block">
                            Mesa
                        </label>

                        @if (Model.IdMesaNavigation != null)
                        {
                            <span class="badge bg-light text-dark border">

                                <i class="bi bi-grid-3x3-gap me-1"></i>
                                Mesa @Model.IdMesaNavigation.NumeroMesa

                            </span>
                        }
                        else
                        {
                            <div class="text-muted">
                                Sin mesa
                            </div>
                        }

                    </div>

                    <!-- TIPO -->

                    <div class="col-md-3">

                        <label class="text-muted small d-block">
                            Tipo de pedido
                        </label>

                        <div>
                            @(Model.IdTipoPedidoNavigation?.Nombre
                                ?? "Sin especificar")
                        </div>

                    </div>

                    <!-- USUARIO -->

                    <div class="col-md-6">

                        <label class="text-muted small d-block">
                            Atendido por
                        </label>

                        @if (Model.IdUsuarioNavigation != null)
                        {
                            <div class="fw-semibold">

                                @Model.IdUsuarioNavigation.Nombres
                                @Model.IdUsuarioNavigation.Apellidos

                            </div>

                            <small class="text-muted">

                                <i class="bi bi-person me-1"></i>
                                @Model.IdUsuarioNavigation.Usuario1

                            </small>
                        }
                        else
                        {
                            <div class="text-muted">
                                Usuario no disponible
                            </div>
                        }

                    </div>

                    <!-- OBSERVACIÓN -->

                    <div class="col-12">

                        <label class="text-muted small d-block">
                            Observación
                        </label>

                        @if (!string.IsNullOrWhiteSpace(Model.Observacion))
                        {
                            <div class="bg-light rounded p-3">

                                <i class="bi bi-chat-left-text me-2"></i>
                                @Model.Observacion

                            </div>
                        }
                        else
                        {
                            <div class="text-muted">
                                Sin observaciones.
                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- RESUMEN -->

    <div class="col-lg-4">

        <div class="card shadow-sm border-0 h-100">

            <div class="card-header bg-white py-3">

                <h5 class="mb-0 fw-semibold">
                    <i class="bi bi-calculator me-2"></i>
                    Resumen
                </h5>

            </div>

            <div class="card-body">

                <div class="d-flex justify-content-between mb-3">

                    <span class="text-muted">
                        Subtotal
                    </span>

                    <span>
                        C$ @Model.Subtotal.ToString("N2")
                    </span>

                </div>

                <div class="d-flex justify-content-between mb-3">

                    <span class="text-muted">
                        Descuento
                    </span>

                    @if (Model.Descuento > 0)
                    {
                        <span class="text-danger">
                            - C$ @Model.Descuento.ToString("N2")
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">
                            C$ 0.00
                        </span>
                    }

                </div>

                <div class="d-flex justify-content-between mb-3">

                    <span class="text-muted">
                        Impuesto
                    </span>

                    <span>
                        C$ @Model.Impuesto.ToString("N2")
                    </span>

                </div>

                <hr />

                <div class="d-flex justify-content-between align-items-center">

                    <span class="fw-bold">
                        Total
                    </span>

                    <span class="fs-4 fw-bold
                        @(estaCancelado
                            ? "text-muted text-decoration-line-through"
                            : "text-success")">

                        C$ @Model.Total.ToString("N2")

                    </span>

                </div>

                @if (estaCancelado)
                {
                    <div class="alert alert-danger mt-4 mb-0">

                        <i class="bi bi-x-circle me-2"></i>

                        Este pedido está cancelado y no se
                        considera una venta activa.

                    </div>
                }
                else if (estaFacturado)
                {
                    <div class="alert alert-success mt-4 mb-0">

                        <i class="bi bi-check-circle me-2"></i>

                        Este pedido ya fue facturado.

                    </div>
                }
                else if (estaEntregado)
                {
                    <div class="alert alert-success mt-4 mb-0">

                        <i class="bi bi-check-circle me-2"></i>

                        Este pedido fue entregado y está
                        disponible para facturación.

                    </div>
                }

            </div>

        </div>

    </div>

</div>

<!-- ========================================================= -->
<!-- FLUJO DEL PEDIDO -->
<!-- ========================================================= -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-white py-3">

        <h5 class="mb-0 fw-semibold">

            <i class="bi bi-diagram-3 me-2"></i>
            Flujo del pedido

        </h5>

    </div>

    <div class="card-body">

        <div class="row text-center g-3">

            <!-- PENDIENTE -->

            <div class="col">

                <div class="fs-4
                    @(estaPendiente ||
                      estaEnCocina ||
                      estaPreparandose ||
                      estaListo ||
                      estaEntregado ||
                      estaFacturado
                        ? "text-warning"
                        : "text-muted")">

                    <i class="bi bi-clock"></i>

                </div>

                <small>Pendiente</small>

            </div>

            <!-- EN COCINA -->

            <div class="col">

                <div class="fs-4
                    @(estaEnCocina ||
                      estaPreparandose ||
                      estaListo ||
                      estaEntregado ||
                      estaFacturado
                        ? "text-info"
                        : "text-muted")">

                    <i class="bi bi-fire"></i>

                </div>

                <small>En cocina</small>

            </div>

            <!-- PREPARÁNDOSE -->

            <div class="col">

                <div class="fs-4
                    @(estaPreparandose ||
                      estaListo ||
                      estaEntregado ||
                      estaFacturado
                        ? "text-primary"
                        : "text-muted")">

                    <i class="bi bi-gear"></i>

                </div>

                <small>Preparándose</small>

            </div>

            <!-- LISTO -->

            <div class="col">

                <div class="fs-4
                    @(estaListo ||
                      estaEntregado ||
                      estaFacturado
                        ? "text-primary"
                        : "text-muted")">

                    <i class="bi bi-check2-circle"></i>

                </div>

                <small>Listo</small>

            </div>

            <!-- ENTREGADO -->

            <div class="col">

                <div class="fs-4
                    @(estaEntregado ||
                      estaFacturado
                        ? "text-success"
                        : "text-muted")">

                    <i class="bi bi-box-seam"></i>

                </div>

                <small>Entregado</small>

            </div>

            <!-- FACTURADO -->

            <div class="col">

                <div class="fs-4
                    @(estaFacturado
                        ? "text-success"
                        : "text-muted")">

                    <i class="bi bi-cash-coin"></i>

                </div>

                <small>Facturado</small>

            </div>

        </div>

        @if (estaCancelado)
        {
            <div class="text-center mt-4">

                <span class="badge bg-danger fs-6">

                    <i class="bi bi-x-circle me-1"></i>
                    Pedido cancelado

                </span>

            </div>
        }

    </div>

</div>

<!-- ========================================================= -->
<!-- ACCIÓN DEL MÓDULO PEDIDO -->
<!-- ========================================================= -->

@if (puedeAvanzarEstado &&
     estaListo &&
     siguienteEstadoId.HasValue)
{
    // Al estar dentro de HasValue, hacemos una copia
    // no-nullable para evitar el warning de nullable.
    var idEstadoSiguiente = siguienteEstadoId.GetValueOrDefault();

    <div class="card border-success shadow-sm mb-4">

        <div class="card-header bg-white py-3">

            <h5 class="mb-0 fw-semibold">

                <i class="bi bi-arrow-right-circle me-2"></i>
                Entrega del pedido

            </h5>

        </div>

        <div class="card-body">

            <div class="row align-items-center g-3">

                <div class="col-md-8">

                    <div class="text-muted small mb-1">
                        Estado actual
                    </div>

                    <div class="fw-bold fs-5">

                        @estado

                        <i class="bi bi-arrow-right mx-2"></i>

                        <span class="text-success">
                            @siguienteEstadoNombre
                        </span>

                    </div>

                    <small class="text-muted">

                        Cocina ya marcó el pedido como listo.
                        Registre aquí la entrega al cliente.

                    </small>

                </div>

                <div class="col-md-4 text-md-end">

                    <form asp-action="CambiarEstado"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.IdPedido" />

                        <input type="hidden"
                               name="idEstado"
                               value="@idEstadoSiguiente" />

                        <button type="submit"
                                class="btn btn-success"
                                onclick="return confirmarCambioEstado();">

                            <i class="bi bi-box-seam me-1"></i>
                            Marcar como entregado

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>
}

<!-- ========================================================= -->
<!-- PEDIDO EN COCINA -->
<!-- ========================================================= -->

@if (estaPendiente ||
     estaEnCocina ||
     estaPreparandose)
{
    <div class="card border-info shadow-sm mb-4">

        <div class="card-body">

            <div class="d-flex align-items-center">

                <div class="me-3">

                    <i class="bi bi-fire text-info fs-2"></i>

                </div>

                <div>

                    <h6 class="fw-bold mb-1">
                        Pedido en proceso de cocina
                    </h6>

                    <p class="text-muted mb-0">

                        Este pedido se encuentra en proceso de
                        preparación. El avance de

                        <strong>Pendiente</strong> →
                        <strong>En cocina</strong> →
                        <strong>Preparándose</strong> →
                        <strong>Listo</strong>

                        corresponde al módulo de Cocina.

                    </p>

                </div>

            </div>

        </div>

    </div>
}

<!-- ========================================================= -->
<!-- PEDIDO LISTO -->
<!-- ========================================================= -->

@if (estaListo)
{
    <div class="card border-primary shadow-sm mb-4">

        <div class="card-body">

            <div class="d-flex align-items-center">

                <div class="me-3">

                    <i class="bi bi-check2-circle text-primary fs-2"></i>

                </div>

                <div>

                    <h6 class="fw-bold mb-1">
                        Pedido listo para entregar
                    </h6>

                    <p class="text-muted mb-0">

                        El pedido ya fue preparado por Cocina.
                        Utilice el botón

                        <strong>Marcar como entregado</strong>

                        para continuar el flujo.

                    </p>

                </div>

            </div>

        </div>

    </div>
}

<!-- ========================================================= -->
<!-- PEDIDO ENTREGADO -->
<!-- ========================================================= -->

@if (estaEntregado)
{
    <div class="card border-success shadow-sm mb-4">

        <div class="card-body">

            <div class="row align-items-center">

                <div class="col-md-8">

                    <div class="d-flex align-items-center">

                        <div class="me-3">

                            <i class="bi bi-check-circle-fill text-success fs-2"></i>

                        </div>

                        <div>

                            <h6 class="fw-bold mb-1">
                                Pedido entregado
                            </h6>

                            <p class="text-muted mb-0">

                                El pedido ya fue entregado al cliente.

                                @if (puedeFacturar)
                                {
                                    <span>
                                        Ahora puede continuar con la
                                        facturación.
                                    </span>
                                }

                            </p>

                        </div>

                    </div>

                </div>

                <div class="col-md-4 text-md-end mt-3 mt-md-0">

                    @if (puedeFacturar)
                    {
                        <a asp-controller="Factura"
                           asp-action="Create"
                           asp-route-idPedido="@Model.IdPedido"
                           class="btn btn-primary">

                            <i class="bi bi-receipt me-1"></i>
                            Facturar pedido

                        </a>
                    }
                    else if (tieneFactura)
                    {
                        <span class="badge bg-success fs-6">

                            <i class="bi bi-check-circle me-1"></i>
                            Facturado

                        </span>
                    }

                </div>

            </div>

        </div>

    </div>
}

<!-- ========================================================= -->
<!-- FACTURADO -->
<!-- ========================================================= -->

@if (estaFacturado)
{
    <div class="card border-success shadow-sm mb-4">

        <div class="card-body">

            <div class="d-flex align-items-center">

                <div class="me-3">

                    <i class="bi bi-receipt text-success fs-2"></i>

                </div>

                <div>

                    <h6 class="fw-bold mb-1">
                        Pedido facturado
                    </h6>

                    <p class="text-muted mb-0">

                        El pedido fue entregado y posteriormente
                        procesado mediante facturación.

                        Este pedido ya no puede modificarse ni
                        cambiar de estado.

                    </p>

                </div>

            </div>

        </div>

    </div>
}

<!-- ========================================================= -->
<!-- PRODUCTOS -->
<!-- ========================================================= -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-white py-3">

        <div class="d-flex justify-content-between align-items-center">

            <h5 class="mb-0 fw-semibold">

                <i class="bi bi-basket me-2"></i>
                Productos del pedido

            </h5>

            <span class="text-muted small">

                @(Model.DetallePedidos?.Count ?? 0)
                producto(s)

            </span>

        </div>

    </div>

    <div class="card-body p-0">

        @if (Model.DetallePedidos == null ||
             !Model.DetallePedidos.Any())
        {
            <div class="text-center py-5">

                <i class="bi bi-basket display-5 text-muted"></i>

                <p class="text-muted mt-3 mb-0">
                    Este pedido no contiene productos.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>Producto</th>

                            <th class="text-center">
                                Cantidad
                            </th>

                            <th class="text-end">
                                Precio unitario
                            </th>

                            <th class="text-end">
                                Descuento
                            </th>

                            <th class="text-end">
                                Subtotal
                            </th>

                            <th class="text-end">
                                Total
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var detalle in Model.DetallePedidos)
                        {
                            <tr>

                                <td>

                                    @if (detalle.IdProductoNavigation != null)
                                    {
                                        <div class="fw-semibold">
                                            @detalle.IdProductoNavigation.Nombre
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Producto no disponible
                                        </span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(
                                        detalle.Observacion))
                                    {
                                        <small class="text-muted d-block mt-1">

                                            <i class="bi bi-chat-left-text me-1"></i>
                                            @detalle.Observacion

                                        </small>
                                    }

                                </td>

                                <td class="text-center">

                                    <span class="badge bg-light text-dark border">

                                        @detalle.Cantidad.ToString("N0")

                                    </span>

                                </td>

                                <td class="text-end">

                                    C$ @detalle.PrecioUnitario.ToString("N2")

                                </td>

                                <td class="text-end">

                                    @if (detalle.Descuento > 0)
                                    {
                                        <span class="text-danger">

                                            - C$
                                            @detalle.Descuento.ToString("N2")

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            C$ 0.00
                                        </span>
                                    }

                                </td>

                                <td class="text-end">

                                    C$ @detalle.Subtotal.ToString("N2")

                                </td>

                                <td class="text-end fw-semibold">

                                    C$ @detalle.TotalLinea.ToString("N2")

                                </td>

                            </tr>
                        }

                    </tbody>

                    <tfoot class="table-light">

                        <tr>

                            <td colspan="5"
                                class="text-end fw-bold">

                                Total del pedido:

                            </td>

                            <td class="text-end fw-bold text-success">

                                C$ @Model.Total.ToString("N2")

                            </td>

                        </tr>

                    </tfoot>

                </table>

            </div>
        }

    </div>

</div>

<!-- ========================================================= -->
<!-- CANCELAR PEDIDO -->
<!-- ========================================================= -->

@if (puedeCancelar &&
     !tieneFactura)
{
    <div class="card border-danger shadow-sm mb-4">

        <div class="card-header bg-danger text-white">

            <h5 class="mb-0">

                <i class="bi bi-exclamation-triangle me-2"></i>
                Zona de cancelación

            </h5>

        </div>

        <div class="card-body">

            <div class="row align-items-center">

                <div class="col-md-8">

                    <h6 class="fw-bold">
                        Cancelar este pedido
                    </h6>

                    <p class="text-muted mb-md-0">

                        Esta acción cambiará el estado del pedido
                        a <strong>Cancelado</strong>.

                        El total histórico se conservará.

                    </p>

                </div>

                <div class="col-md-4 text-md-end">

                    <form asp-action="Anular"
                          asp-route-id="@Model.IdPedido"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-danger"
                                onclick="return confirmarCancelacion();">

                            <i class="bi bi-x-circle me-1"></i>
                            Cancelar pedido

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>
}

<!-- ========================================================= -->
<!-- PEDIDO CANCELADO -->
<!-- ========================================================= -->

@if (estaCancelado)
{
    <div class="card border-danger shadow-sm mb-4">

        <div class="card-body">

            <div class="d-flex align-items-center">

                <div class="me-3">

                    <i class="bi bi-x-circle-fill text-danger fs-2"></i>

                </div>

                <div>

                    <h6 class="fw-bold mb-1">
                        Pedido cancelado
                    </h6>

                    <p class="text-muted mb-0">

                        Este pedido fue cancelado.
                        El total histórico permanece registrado,
                        pero no se considera una venta activa.

                    </p>

                </div>

            </div>

        </div>

    </div>
}

<!-- ========================================================= -->
<!-- PIE -->
<!-- ========================================================= -->

<div class="d-flex justify-content-between align-items-center">

    <small class="text-muted">

        <i class="bi bi-info-circle me-1"></i>

        El total histórico del pedido se conserva incluso
        si el pedido es cancelado.

    </small>

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>
        Regresar a pedidos

    </a>

</div>

</div>
@section Scripts {

<script>

    function confirmarCancelacion() {

        return confirm(
            "¿Está seguro de cancelar este pedido?\n\n" +
            "El pedido pasará al estado Cancelado y " +
            "dejará de considerarse una venta activa."
        );

    }

    function confirmarCambioEstado() {

        return confirm(
            "¿Desea marcar este pedido como Entregado?\n\n" +
            "Esta acción indica que el cliente ya recibió el pedido."
        );

    }

</script>

}
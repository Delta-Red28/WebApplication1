@model WebApplication1.Models.Usuario

@{
    ViewData["Title"] = "Crear usuario";
    var roles = ViewBag.Roles as List<WebApplication1.Models.Rol>;
}

<div class="container-fluid px-4 py-3">

    <!-- ENCABEZADO -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div class="d-flex align-items-center gap-3">

            <div class="rounded-3 d-flex align-items-center justify-content-center shadow-sm"
                 style="
                width: 58px;
                height: 58px;
                background: #e8f0fe;
                color: #0d6efd;
                font-size: 1.4rem;
                ">
                <i class="bi bi-person-plus-fill"></i>
            </div>

            <div>
                <h2 class="fw-bold mb-1">
                    Nuevo usuario
                </h2>

                <p class="text-muted mb-0">
                    Registra un nuevo trabajador o usuario del sistema.
                </p>
            </div>

        </div>

        <a asp-action="Index"
           class="btn btn-light border px-4">

            <i class="bi bi-arrow-left me-1"></i>
            Volver

        </a>

    </div>


    <!-- FORMULARIO -->
    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <!-- VALIDACIONES -->
        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger border-0 shadow-sm"
             role="alert">
        </div>


        <div class="row g-4">

            <!-- =====================================================
                 INFORMACIÓN PERSONAL
                 ===================================================== -->

            <div class="col-lg-7">

                <div class="card border-0 shadow-sm">

                    <div class="card-header bg-white border-0 pt-4 px-4">

                        <div class="d-flex align-items-center">

                            <div class="rounded-3 d-flex align-items-center justify-content-center me-3"
                                 style="
                                width: 42px;
                                height: 42px;
                                background: #e8f0fe;
                                color: #0d6efd;
                                ">

                                <i class="bi bi-person-fill"></i>

                            </div>

                            <div>

                                <h5 class="fw-bold mb-0">
                                    Información personal
                                </h5>

                                <small class="text-muted">
                                    Datos del trabajador o usuario
                                </small>

                            </div>

                        </div>

                    </div>


                    <div class="card-body px-4 pb-4">

                        <div class="row g-3">

                            <!-- NOMBRES -->
                            <div class="col-md-6">

                                <label asp-for="Nombres"
                                       class="form-label fw-semibold">
                                    Nombres
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-person text-muted"></i>
                                    </span>

                                    <input asp-for="Nombres"
                                           class="form-control"
                                           placeholder="Ingrese los nombres" />

                                </div>

                                <span asp-validation-for="Nombres"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- APELLIDOS -->
                            <div class="col-md-6">

                                <label asp-for="Apellidos"
                                       class="form-label fw-semibold">
                                    Apellidos
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-person text-muted"></i>
                                    </span>

                                    <input asp-for="Apellidos"
                                           class="form-control"
                                           placeholder="Ingrese los apellidos" />

                                </div>

                                <span asp-validation-for="Apellidos"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- CORREO -->
                            <div class="col-md-6">

                                <label asp-for="Correo"
                                       class="form-label fw-semibold">
                                    Correo electrónico
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-envelope text-muted"></i>
                                    </span>

                                    <input asp-for="Correo"
                                           type="email"
                                           class="form-control"
                                           placeholder="correo@ejemplo.com" />

                                </div>

                                <span asp-validation-for="Correo"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- TELÉFONO -->
                            <div class="col-md-6">

                                <label asp-for="Telefono"
                                       class="form-label fw-semibold">
                                    Teléfono
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-telephone text-muted"></i>
                                    </span>

                                    <input asp-for="Telefono"
                                           class="form-control"
                                           placeholder="Número de teléfono" />

                                </div>

                                <span asp-validation-for="Telefono"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =====================================================
                     DATOS DE ACCESO
                     ===================================================== -->

                <div class="card border-0 shadow-sm mt-4">

                    <div class="card-header bg-white border-0 pt-4 px-4">

                        <div class="d-flex align-items-center">

                            <div class="rounded-3 d-flex align-items-center justify-content-center me-3"
                                 style="
                                width: 42px;
                                height: 42px;
                                background: #fff4e5;
                                color: #fd7e14;
                                ">

                                <i class="bi bi-shield-lock-fill"></i>

                            </div>

                            <div>

                                <h5 class="fw-bold mb-0">
                                    Datos de acceso
                                </h5>

                                <small class="text-muted">
                                    Credenciales para ingresar al sistema
                                </small>

                            </div>

                        </div>

                    </div>


                    <div class="card-body px-4 pb-4">

                        <div class="row g-3">

                            <!-- USUARIO -->
                            <div class="col-md-6">

                                <label asp-for="Usuario1"
                                       class="form-label fw-semibold">
                                    Nombre de usuario
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-person-badge text-muted"></i>
                                    </span>

                                    <input asp-for="Usuario1"
                                           class="form-control"
                                           autocomplete="off"
                                           placeholder="Ej. jperez" />

                                </div>

                                <span asp-validation-for="Usuario1"
                                      class="text-danger small">
                                </span>

                                <small class="text-muted">
                                    Nombre que utilizará para iniciar sesión.
                                </small>

                            </div>


                            <!-- CONTRASEÑA -->
                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Contraseña
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-key text-muted"></i>
                                    </span>

                                    <input type="password"
                                           name="password"
                                           class="form-control"
                                           autocomplete="new-password"
                                           placeholder="Contraseña inicial" />

                                </div>

                                <span class="text-danger small">
                                    @Html.ValidationMessage("Password")
                                </span>

                                <small class="text-muted">
                                    El usuario deberá cambiarla en su primer inicio de sesión.
                                </small>

                            </div>

                        </div>


                        <!-- SEGURIDAD -->
                        <div class="alert alert-warning border-0 mt-4 mb-0">

                            <i class="bi bi-shield-check me-2"></i>

                            <strong>Seguridad:</strong>
                            utilice una contraseña segura y no la comparta con otros usuarios.

                        </div>

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 CONFIGURACIÓN DEL USUARIO
                 ===================================================== -->

            <div class="col-lg-5">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-header bg-white border-0 pt-4 px-4">

                        <div class="d-flex align-items-center">

                            <div class="rounded-3 d-flex align-items-center justify-content-center me-3"
                                 style="
                                width: 42px;
                                height: 42px;
                                background: #eef2ff;
                                color: #4f46e5;
                                ">

                                <i class="bi bi-person-gear"></i>

                            </div>

                            <div>

                                <h5 class="fw-bold mb-0">
                                    Configuración del usuario
                                </h5>

                                <small class="text-muted">
                                    Acceso y permisos
                                </small>

                            </div>

                        </div>

                    </div>


                    <div class="card-body px-4">

                        <div class="text-center py-3">

                            <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3"
                                 style="
                                width: 80px;
                                height: 80px;
                                background: #e8f0fe;
                                color: #0d6efd;
                                ">

                                <i class="bi bi-person-plus-fill fs-2"></i>

                            </div>

                            <h5 class="fw-bold mb-1">
                                Crear usuario
                            </h5>

                            <p class="text-muted mb-0">
                                Configure los datos de acceso y el nivel de permisos.
                            </p>

                        </div>


                        <hr />


                        <!-- =================================================
                             ÚNICO SELECTOR DE ROL
                             ================================================= -->

                        <div class="mb-4">

                            <label asp-for="IdRol"
                                   class="form-label fw-semibold">

                                <i class="bi bi-shield-check me-1"></i>

                                Rol del usuario

                            </label>

                            <select asp-for="IdRol"
                                    class="form-select">

                                <option value="">
                                    -- Seleccione un rol --
                                </option>

                                @if (roles != null)
                                {
                                    foreach (var rol in roles)
                                    {
                                        <option value="@rol.IdRol">
                                            @rol.Nombre
                                        </option>
                                    }
                                }

                            </select>

                            <span asp-validation-for="IdRol"
                                  class="text-danger small">
                            </span>

                            <small class="text-muted d-block mt-2">
                                El rol determina las funciones que podrá utilizar.
                            </small>

                        </div>


                        <!-- INFORMACIÓN -->
                        <div class="p-3 rounded-3"
                             style="background:#f8f9fa;">

                            <div class="d-flex align-items-start gap-3">

                                <i class="bi bi-info-circle text-primary fs-5"></i>

                                <div>

                                    <div class="fw-semibold mb-1">
                                        Permisos del sistema
                                    </div>

                                    <small class="text-muted">
                                        Los permisos del usuario estarán determinados
                                        por el rol que seleccione.
                                    </small>

                                </div>

                            </div>

                        </div>


                        <!-- PASOS -->
                        <div class="mt-4">

                            <div class="d-flex align-items-start gap-3 mb-3">

                                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="
                                    width:32px;
                                    height:32px;
                                    background:#e8f0fe;
                                    color:#0d6efd;
                                    ">
                                    <strong>1</strong>
                                </div>

                                <div>

                                    <div class="fw-semibold">
                                        Información personal
                                    </div>

                                    <small class="text-muted">
                                        Registre los datos del trabajador.
                                    </small>

                                </div>

                            </div>


                            <div class="d-flex align-items-start gap-3 mb-3">

                                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="
                                    width:32px;
                                    height:32px;
                                    background:#fff4e5;
                                    color:#fd7e14;
                                    ">
                                    <strong>2</strong>
                                </div>

                                <div>

                                    <div class="fw-semibold">
                                        Credenciales
                                    </div>

                                    <small class="text-muted">
                                        Configure usuario y contraseña.
                                    </small>

                                </div>

                            </div>


                            <div class="d-flex align-items-start gap-3">

                                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="
                                    width:32px;
                                    height:32px;
                                    background:#f3eefe;
                                    color:#6f42c1;
                                    ">
                                    <strong>3</strong>
                                </div>

                                <div>

                                    <div class="fw-semibold">
                                        Asignación de rol
                                    </div>

                                    <small class="text-muted">
                                        Determine el nivel de acceso.
                                    </small>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 ACCIONES
                 ===================================================== -->

            <div class="col-12">

                <div class="card border-0 shadow-sm">

                    <div class="card-body px-4 py-3">

                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">

                            <div>

                                <small class="text-muted">

                                    <i class="bi bi-shield-check me-1"></i>

                                    Revise los datos y permisos antes de crear el usuario.

                                </small>

                            </div>


                            <div class="d-flex gap-2">

                                <a asp-action="Index"
                                   class="btn btn-light border px-4">

                                    <i class="bi bi-x-lg me-1"></i>
                                    Cancelar

                                </a>


                                <button type="submit"
                                        class="btn btn-primary px-4">

                                    <i class="bi bi-person-plus-fill me-1"></i>

                                    Crear usuario

                                </button>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
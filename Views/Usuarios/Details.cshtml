@model WebApplication1.Models.Usuario

@{
    ViewData["Title"] = "Detalles del usuario";

    var idUsuarioActual =
        ViewBag.IdUsuarioActual?.ToString();

    bool esUsuarioActual =
        idUsuarioActual == Model.IdUsuario.ToString();

    var nombreCompleto =
        $"{Model.Nombres} {Model.Apellidos}".Trim();

    var nombreRol =
        Model.IdRolNavigation?.Nombre ?? "Sin rol";
}

<div class="container-fluid px-4 py-3">

    <!-- =========================================================
         ENCABEZADO
         ========================================================= -->

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div class="d-flex align-items-center gap-3">

            <div class="rounded-3 d-flex align-items-center justify-content-center shadow-sm"
                 style="
                width: 58px;
                height: 58px;
                background: #e8f0fe;
                color: #0d6efd;
                font-size: 1.4rem;
                ">

                <i class="bi bi-person-vcard-fill"></i>

            </div>

            <div>

                <h2 class="fw-bold mb-1">
                    Detalles del usuario
                </h2>

                <p class="text-muted mb-0">
                    Consulte la información y configuración de la cuenta.
                </p>

            </div>

        </div>


        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.IdUsuario"
               class="btn btn-primary px-4">

                <i class="bi bi-pencil me-1"></i>

                Editar

            </a>

            <a asp-action="Index"
               class="btn btn-light border px-4">

                <i class="bi bi-arrow-left me-1"></i>

                Volver

            </a>

        </div>

    </div>


    <!-- =========================================================
         IDENTIFICACIÓN DEL USUARIO
         ========================================================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <div class="d-flex flex-column flex-md-row align-items-md-center gap-4">

                <!-- AVATAR -->

                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                     style="
                    width: 86px;
                    height: 86px;
                    background: #e8f0fe;
                    color: #0d6efd;
                    ">

                    <i class="bi bi-person-fill fs-1"></i>

                </div>


                <!-- INFORMACIÓN PRINCIPAL -->

                <div class="flex-grow-1">

                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">

                        <h3 class="fw-bold mb-0">
                            @nombreCompleto
                        </h3>

                        @if (esUsuarioActual)
                        {
                            <span class="badge rounded-pill bg-primary">

                                <i class="bi bi-person-check me-1"></i>

                                Tu usuario

                            </span>
                        }

                    </div>

                    <p class="text-muted mb-2">

                        <i class="bi bi-person-badge me-1"></i>

                        @Model.Usuario1

                    </p>


                    <div class="d-flex flex-wrap gap-2">

                        @if (Model.Estado)
                        {
                            <span class="badge rounded-pill bg-success">

                                <i class="bi bi-check-circle me-1"></i>

                                Usuario activo

                            </span>
                        }
                        else
                        {
                            <span class="badge rounded-pill bg-secondary">

                                <i class="bi bi-pause-circle me-1"></i>

                                Usuario inactivo

                            </span>
                        }


                        <span class="badge rounded-pill"
                              style="
                            background: #f3eefe;
                            color: #6f42c1;
                            ">

                            <i class="bi bi-shield-check me-1"></i>

                            @nombreRol

                        </span>

                    </div>

                </div>


                <!-- ID -->

                <div class="text-md-end">

                    <small class="text-muted d-block">
                        ID de usuario
                    </small>

                    <strong>
                        #@Model.IdUsuario
                    </strong>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         CONTENIDO
         ========================================================= -->

    <div class="row g-4">


        <!-- =====================================================
             INFORMACIÓN PERSONAL
             ===================================================== -->

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex align-items-center">

                        <div class="rounded-3 d-flex align-items-center justify-content-center me-3"
                             style="
                            width: 42px;
                            height: 42px;
                            background: #e8f0fe;
                            color: #0d6efd;
                            ">

                            <i class="bi bi-person-fill"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-0">
                                Información personal
                            </h5>

                            <small class="text-muted">
                                Datos registrados del usuario
                            </small>

                        </div>

                    </div>

                </div>


                <div class="card-body px-4 pb-4">

                    <div class="row g-3">


                        <!-- NOMBRE -->

                        <div class="col-md-6">

                            <div class="p-3 rounded-3 bg-light h-100">

                                <small class="text-muted d-block mb-1">

                                    <i class="bi bi-person me-1"></i>

                                    Nombre completo

                                </small>

                                <div class="fw-semibold">

                                    @nombreCompleto

                                </div>

                            </div>

                        </div>


                        <!-- USUARIO -->

                        <div class="col-md-6">

                            <div class="p-3 rounded-3 bg-light h-100">

                                <small class="text-muted d-block mb-1">

                                    <i class="bi bi-person-badge me-1"></i>

                                    Nombre de usuario

                                </small>

                                <div class="fw-semibold">

                                    @Model.Usuario1

                                </div>

                            </div>

                        </div>


                        <!-- CORREO -->

                        <div class="col-md-6">

                            <div class="p-3 rounded-3 bg-light h-100">

                                <small class="text-muted d-block mb-1">

                                    <i class="bi bi-envelope me-1"></i>

                                    Correo electrónico

                                </small>

                                <div class="fw-semibold text-break">

                                    @Model.Correo

                                </div>

                            </div>

                        </div>


                        <!-- TELÉFONO -->

                        <div class="col-md-6">

                            <div class="p-3 rounded-3 bg-light h-100">

                                <small class="text-muted d-block mb-1">

                                    <i class="bi bi-telephone me-1"></i>

                                    Teléfono

                                </small>

                                <div class="fw-semibold">

                                    @(Model.Telefono ?? "No registrado")

                                </div>

                            </div>

                        </div>


                        <!-- ROL -->

                        <div class="col-md-6">

                            <div class="p-3 rounded-3 h-100"
                                 style="background: #f3eefe;">

                                <small class="d-block mb-1"
                                       style="color: #6f42c1;">

                                    <i class="bi bi-shield-check me-1"></i>

                                    Rol asignado

                                </small>

                                <div class="fw-semibold">

                                    @nombreRol

                                </div>

                            </div>

                        </div>


                        <!-- ESTADO -->

                        <div class="col-md-6">

                            <div class="p-3 rounded-3 h-100"
                                 style="
                                background: @(Model.Estado ? "#eaf7ef" : "#f1f3f5");
                                ">

                                <small class="text-muted d-block mb-1">

                                    <i class="bi bi-toggle-on me-1"></i>

                                    Estado

                                </small>

                                <div>

                                    @if (Model.Estado)
                                    {
                                        <span class="text-success fw-semibold">

                                            <i class="bi bi-check-circle-fill me-1"></i>

                                            Activo

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary fw-semibold">

                                            <i class="bi bi-x-circle-fill me-1"></i>

                                            Inactivo

                                        </span>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 ACTIVIDAD DE LA CUENTA
                 ===================================================== -->

            <div class="card border-0 shadow-sm mt-4">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex align-items-center">

                        <div class="rounded-3 d-flex align-items-center justify-content-center me-3"
                             style="
                            width: 42px;
                            height: 42px;
                            background: #f8f9fa;
                            color: #6c757d;
                            ">

                            <i class="bi bi-clock-history"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-0">
                                Actividad de la cuenta
                            </h5>

                            <small class="text-muted">
                                Información de acceso y seguridad
                            </small>

                        </div>

                    </div>

                </div>


                <div class="card-body px-4 pb-4">

                    <div class="row g-3">


                        <!-- FECHA REGISTRO -->

                        <div class="col-md-6">

                            <div class="d-flex align-items-center gap-3 p-3 rounded-3 bg-light">

                                <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="
                                    width: 42px;
                                    height: 42px;
                                    background: #e8f0fe;
                                    color: #0d6efd;
                                    ">

                                    <i class="bi bi-calendar-plus"></i>

                                </div>

                                <div>

                                    <small class="text-muted d-block">
                                        Fecha de registro
                                    </small>

                                    <strong>
                                        @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
                                    </strong>

                                </div>

                            </div>

                        </div>


                        <!-- ÚLTIMO ACCESO -->

                        <div class="col-md-6">

                            <div class="d-flex align-items-center gap-3 p-3 rounded-3 bg-light">

                                <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="
                                    width: 42px;
                                    height: 42px;
                                    background: #eaf7ef;
                                    color: #198754;
                                    ">

                                    <i class="bi bi-box-arrow-in-right"></i>

                                </div>

                                <div>

                                    <small class="text-muted d-block">
                                        Último acceso
                                    </small>

                                    <strong>
                                        @(Model.UltimoAcceso?.ToString("dd/MM/yyyy HH:mm") ?? "Nunca")
                                    </strong>

                                </div>

                            </div>

                        </div>


                        <!-- INTENTOS -->

                        <div class="col-md-6">

                            <div class="d-flex align-items-center gap-3 p-3 rounded-3 bg-light">

                                <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="
                                    width: 42px;
                                    height: 42px;
                                    background: #fff4e5;
                                    color: #fd7e14;
                                    ">

                                    <i class="bi bi-shield-exclamation"></i>

                                </div>

                                <div>

                                    <small class="text-muted d-block">
                                        Intentos fallidos
                                    </small>

                                    <strong>
                                        @Model.IntentosFallidos
                                    </strong>

                                    @if (Model.IntentosFallidos > 0)
                                    {
                                        <small class="text-warning d-block">
                                            Se han registrado intentos fallidos.
                                        </small>
                                    }

                                </div>

                            </div>

                        </div>


                        <!-- CAMBIO PASSWORD -->

                        <div class="col-md-6">

                            <div class="d-flex align-items-center gap-3 p-3 rounded-3 bg-light">

                                <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="
                                    width: 42px;
                                    height: 42px;
                                    background: #f3eefe;
                                    color: #6f42c1;
                                    ">

                                    <i class="bi bi-key"></i>

                                </div>

                                <div>

                                    <small class="text-muted d-block">
                                        Cambio de contraseña
                                    </small>

                                    <strong>
                                        @(Model.FechaCambioPassword?.ToString("dd/MM/yyyy HH:mm") ?? "No registrado")
                                    </strong>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             PANEL LATERAL
             ===================================================== -->

        <div class="col-lg-4">


            <!-- =================================================
                 ESTADO DE LA CUENTA
                 ================================================= -->

            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex align-items-center">

                        <div class="rounded-3 d-flex align-items-center justify-content-center me-3"
                             style="
                            width: 42px;
                            height: 42px;
                            background: #eef2ff;
                            color: #4f46e5;
                            ">

                            <i class="bi bi-shield-check"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-0">
                                Estado de la cuenta
                            </h5>

                            <small class="text-muted">
                                Situación actual del usuario
                            </small>

                        </div>

                    </div>

                </div>


                <div class="card-body px-4 pb-4">

                    <div class="text-center py-3">

                        @if (Model.Estado)
                        {
                            <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3"
                                 style="
                                width: 72px;
                                height: 72px;
                                background: #eaf7ef;
                                color: #198754;
                                ">

                                <i class="bi bi-check-lg fs-2"></i>

                            </div>

                            <h5 class="fw-bold text-success mb-1">
                                Cuenta activa
                            </h5>

                            <p class="text-muted mb-0">
                                El usuario puede iniciar sesión.
                            </p>
                        }
                        else
                        {
                            <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3"
                                 style="
                                width: 72px;
                                height: 72px;
                                background: #f1f3f5;
                                color: #6c757d;
                                ">

                                <i class="bi bi-pause-lg fs-2"></i>

                            </div>

                            <h5 class="fw-bold text-secondary mb-1">
                                Cuenta inactiva
                            </h5>

                            <p class="text-muted mb-0">
                                El usuario no puede iniciar sesión.
                            </p>
                        }

                    </div>

                </div>

            </div>


            <!-- =================================================
                 RESTABLECER CONTRASEÑA
                 ================================================= -->

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex align-items-center">

                        <div class="rounded-3 d-flex align-items-center justify-content-center me-3"
                             style="
                            width: 42px;
                            height: 42px;
                            background: #fff4e5;
                            color: #fd7e14;
                            ">

                            <i class="bi bi-key-fill"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-0">
                                Restablecer contraseña
                            </h5>

                            <small class="text-muted">
                                Generar una nueva contraseña
                            </small>

                        </div>

                    </div>

                </div>


                <div class="card-body px-4 pb-4">

                    <div class="alert alert-warning border-0">

                        <i class="bi bi-exclamation-triangle me-2"></i>

                        <small>

                            Al restablecer la contraseña, el usuario
                            deberá cambiarla nuevamente al iniciar sesión.

                        </small>

                    </div>


                    <form asp-action="RestablecerPassword"
                          asp-route-id="@Model.IdUsuario"
                          method="post">

                        @Html.AntiForgeryToken()


                        <div class="mb-3">

                            <label class="form-label fw-semibold">

                                Nueva contraseña

                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-light">

                                    <i class="bi bi-key text-muted"></i>

                                </span>

                                <input type="password"
                                       name="nuevaPassword"
                                       class="form-control"
                                       autocomplete="new-password"
                                       placeholder="Ingrese una nueva contraseña"
                                       required />

                            </div>

                        </div>


                        <button type="submit"
                                class="btn btn-danger w-100"
                                onclick="return confirm('¿Está seguro de restablecer la contraseña de este usuario?');">

                            <i class="bi bi-arrow-repeat me-1"></i>

                            Restablecer contraseña

                        </button>

                    </form>

                </div>

            </div>


            <!-- =================================================
                 INFORMACIÓN
                 ================================================= -->

            <div class="card border-0 shadow-sm mt-4">

                <div class="card-body">

                    <div class="d-flex align-items-start gap-3">

                        <i class="bi bi-info-circle text-primary fs-5"></i>

                        <div>

                            <div class="fw-semibold mb-1">
                                Información
                            </div>

                            <small class="text-muted">

                                Los cambios realizados en esta cuenta
                                quedarán registrados en el sistema.

                            </small>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         BOTONES INFERIORES
         ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mt-4">

        <a asp-action="Index"
           class="btn btn-light border px-4">

            <i class="bi bi-arrow-left me-1"></i>

            Volver a usuarios

        </a>

        <a asp-action="Edit"
           asp-route-id="@Model.IdUsuario"
           class="btn btn-primary px-4">

            <i class="bi bi-pencil me-1"></i>

            Editar usuario

        </a>

    </div>

</div>
@model WebApplication1.ViewModels.Reportes.ReporteDashboardViewModel

@{
    ViewData["Title"] = "Reportes";

    // =========================================================
    // DATOS PARA GRÁFICA DE VENTAS
    // =========================================================

    var ventasLabels = string.Join(",",
        Model.VentasPorFecha.Select(x =>
            $"'{x.Fecha:dd/MM}'"));

    var ventasData = string.Join(",",
        Model.VentasPorFecha.Select(x =>
            x.Total.ToString(
                System.Globalization.CultureInfo.InvariantCulture)));

    // =========================================================
    // DATOS PARA GRÁFICA DE PAGOS
    // =========================================================

    var pagosLabels = string.Join(",",
        Model.PagosPorMetodo.Select(x =>
            $"'{x.MetodoPago.Replace("'", "\\'")}'"));

    var pagosData = string.Join(",",
        Model.PagosPorMetodo.Select(x =>
            x.Total.ToString(
                System.Globalization.CultureInfo.InvariantCulture)));
}

<div class="container-fluid py-4">

    <!-- ========================================================= -->
    <!-- ENCABEZADO -->
    <!-- ========================================================= -->

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                <i class="bi bi-bar-chart-line me-2"></i>
                Reportes
            </h2>

            <p class="text-muted mb-0">
                Resumen general del restaurante
            </p>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- FILTRO DE FECHAS -->
    <!-- ========================================================= -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form asp-controller="Reportes"
                  asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">

                    <!-- FECHA INICIAL -->

                    <div class="col-md-4">

                        <label for="fechaInicio"
                               class="form-label fw-semibold">

                            Fecha inicial

                        </label>

                        <input type="date"
                               id="fechaInicio"
                               name="fechaInicio"
                               class="form-control"
                               value="@Model.FechaInicio.ToString("yyyy-MM-dd")" />

                    </div>


                    <!-- FECHA FINAL -->

                    <div class="col-md-4">

                        <label for="fechaFin"
                               class="form-label fw-semibold">

                            Fecha final

                        </label>

                        <input type="date"
                               id="fechaFin"
                               name="fechaFin"
                               class="form-control"
                               value="@Model.FechaFin.ToString("yyyy-MM-dd")" />

                    </div>


                    <!-- BOTÓN -->

                    <div class="col-md-4">

                        <button type="submit"
                                class="btn btn-primary w-100">

                            <i class="bi bi-search me-1"></i>

                            Consultar reporte

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- INDICADORES PRINCIPALES -->
    <!-- ========================================================= -->

    <div class="row g-4 mb-4">

        <!-- ===================================================== -->
        <!-- TOTAL FACTURADO -->
        <!-- ===================================================== -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <p class="text-muted mb-1">
                                Total facturado
                            </p>

                            <h3 class="fw-bold mb-0">
                                C$ @Model.TotalFacturado.ToString("N2")
                            </h3>

                        </div>

                        <div class="rounded-circle bg-primary bg-opacity-10 p-3">

                            <i class="bi bi-cash-stack text-primary fs-4"></i>

                        </div>

                    </div>

                    <hr />

                    <small class="text-muted">

                        @Model.CantidadFacturas factura(s)

                    </small>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- TOTAL PAGOS -->
        <!-- ===================================================== -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <p class="text-muted mb-1">
                                Total de pagos
                            </p>

                            <h3 class="fw-bold mb-0">
                                C$ @Model.TotalPagos.ToString("N2")
                            </h3>

                        </div>

                        <div class="rounded-circle bg-success bg-opacity-10 p-3">

                            <i class="bi bi-wallet2 text-success fs-4"></i>

                        </div>

                    </div>

                    <hr />

                    <small class="text-muted">

                        @Model.CantidadPagos pago(s)

                    </small>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- TOTAL COMPRAS -->
        <!-- ===================================================== -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <p class="text-muted mb-1">
                                Total de compras
                            </p>

                            <h3 class="fw-bold mb-0">
                                C$ @Model.TotalCompras.ToString("N2")
                            </h3>

                        </div>

                        <div class="rounded-circle bg-warning bg-opacity-10 p-3">

                            <i class="bi bi-cart-check text-warning fs-4"></i>

                        </div>

                    </div>

                    <hr />

                    <small class="text-muted">

                        @Model.CantidadCompras compra(s)

                    </small>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- SALDO PENDIENTE -->
        <!-- ===================================================== -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <p class="text-muted mb-1">
                                Saldo pendiente
                            </p>

                            <h3 class="fw-bold mb-0">
                                C$ @Model.TotalSaldoPendiente.ToString("N2")
                            </h3>

                        </div>

                        <div class="rounded-circle bg-danger bg-opacity-10 p-3">

                            <i class="bi bi-exclamation-circle text-danger fs-4"></i>

                        </div>

                    </div>

                    <hr />

                    <small class="text-muted">
                        Pendiente por cobrar
                    </small>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- SEGUNDA FILA DE INDICADORES -->
    <!-- ========================================================= -->

    <div class="row g-4 mb-4">

        <!-- CLIENTES -->

        <div class="col-xl-4 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3">

                            <i class="bi bi-people text-info fs-4"></i>

                        </div>

                        <div>

                            <p class="text-muted mb-1">
                                Clientes activos
                            </p>

                            <h4 class="fw-bold mb-0">
                                @Model.CantidadClientes
                            </h4>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- PROVEEDORES -->

        <div class="col-xl-4 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="rounded-circle bg-secondary bg-opacity-10 p-3 me-3">

                            <i class="bi bi-truck text-secondary fs-4"></i>

                        </div>

                        <div>

                            <p class="text-muted mb-1">
                                Proveedores activos
                            </p>

                            <h4 class="fw-bold mb-0">
                                @Model.CantidadProveedores
                            </h4>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- PRODUCTOS -->

        <div class="col-xl-4 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="rounded-circle bg-dark bg-opacity-10 p-3 me-3">

                            <i class="bi bi-box-seam text-dark fs-4"></i>

                        </div>

                        <div>

                            <p class="text-muted mb-1">
                                Productos activos
                            </p>

                            <h4 class="fw-bold mb-0">
                                @Model.CantidadProductos
                            </h4>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- INFORMACIÓN DEL PERÍODO -->
    <!-- ========================================================= -->

    <div class="alert alert-light border shadow-sm mb-4">

        <i class="bi bi-calendar3 me-2"></i>

        <strong>Período consultado:</strong>

        @Model.FechaInicio.ToString("dd/MM/yyyy")

        -

        @Model.FechaFin.ToString("dd/MM/yyyy")

    </div>


    <!-- ========================================================= -->
    <!-- GRÁFICAS -->
    <!-- ========================================================= -->

    <div class="row g-4">

        <!-- ===================================================== -->
        <!-- VENTAS POR FECHA -->
        <!-- ===================================================== -->

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 py-3">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h5 class="fw-bold mb-1">
                                Ventas por fecha
                            </h5>

                            <small class="text-muted">
                                Evolución de las ventas durante el período
                            </small>

                        </div>

                        <i class="bi bi-graph-up-arrow text-primary fs-4"></i>

                    </div>

                </div>


                <div class="card-body">

                    @if (Model.VentasPorFecha != null &&
                         Model.VentasPorFecha.Any())
                    {
                        <div style="height:350px;">

                            <canvas id="ventasChart"></canvas>

                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">

                            <i class="bi bi-bar-chart fs-1"></i>

                            <p class="mt-3 mb-0">

                                No hay ventas registradas en este período.

                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- PAGOS POR MÉTODO -->
        <!-- ===================================================== -->

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 py-3">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h5 class="fw-bold mb-1">
                                Métodos de pago
                            </h5>

                            <small class="text-muted">
                                Distribución de pagos
                            </small>

                        </div>

                        <i class="bi bi-credit-card text-success fs-4"></i>

                    </div>

                </div>


                <div class="card-body">

                    @if (Model.PagosPorMetodo != null &&
                         Model.PagosPorMetodo.Any())
                    {
                        <div style="height:300px;">

                            <canvas id="pagosChart"></canvas>

                        </div>


                        <div class="mt-3">

                            @foreach (var pago in Model.PagosPorMetodo)
                            {
                                <div class="d-flex justify-content-between align-items-center mb-2">

                                    <span>
                                        @pago.MetodoPago
                                    </span>

                                    <strong>
                                        C$ @pago.Total.ToString("N2")
                                    </strong>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">

                            <i class="bi bi-credit-card fs-1"></i>

                            <p class="mt-3 mb-0">

                                No hay pagos registrados.

                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- RESUMEN FINANCIERO -->
    <!-- ========================================================= -->

    <div class="card border-0 shadow-sm mt-4">

        <div class="card-header bg-white border-0 py-3">

            <h5 class="fw-bold mb-0">

                <i class="bi bi-calculator me-2"></i>

                Resumen financiero

            </h5>

        </div>


        <div class="card-body">

            <div class="row g-4">

                <!-- FACTURACIÓN -->

                <div class="col-md-4">

                    <div class="border rounded p-3 h-100">

                        <small class="text-muted d-block">
                            Facturación
                        </small>

                        <h4 class="fw-bold text-primary mb-0">

                            C$ @Model.TotalFacturado.ToString("N2")

                        </h4>

                    </div>

                </div>


                <!-- DESCUENTOS -->

                <div class="col-md-4">

                    <div class="border rounded p-3 h-100">

                        <small class="text-muted d-block">
                            Descuentos
                        </small>

                        <h4 class="fw-bold text-warning mb-0">

                            C$ @Model.TotalDescuentos.ToString("N2")

                        </h4>

                    </div>

                </div>


                <!-- IMPUESTOS -->

                <div class="col-md-4">

                    <div class="border rounded p-3 h-100">

                        <small class="text-muted d-block">
                            Impuestos
                        </small>

                        <h4 class="fw-bold text-success mb-0">

                            C$ @Model.TotalImpuestos.ToString("N2")

                        </h4>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ============================================================= -->
<!-- CHART.JS -->
<!-- ============================================================= -->

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        // =========================================================
        // GRÁFICA DE VENTAS
        // =========================================================

        const ventasCanvas =
            document.getElementById("ventasChart");

        if (ventasCanvas) {

            new Chart(ventasCanvas, {

                type: "line",

                data: {

                    labels: [
                        @Html.Raw(ventasLabels)
                    ],

                    datasets: [

                        {

                            label: "Ventas",

                            data: [
                                @Html.Raw(ventasData)
                            ],

                            borderColor: "#0d6efd",

                            backgroundColor:
                                "rgba(13, 110, 253, 0.10)",

                            borderWidth: 3,

                            fill: true,

                            tension: 0.35,

                            pointRadius: 4,

                            pointHoverRadius: 6,

                            pointBackgroundColor: "#0d6efd",

                            pointBorderColor: "#ffffff",

                            pointBorderWidth: 2

                        }

                    ]

                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    interaction: {

                        intersect: false,

                        mode: "index"

                    },

                    plugins: {

                        legend: {

                            display: false

                        },

                        tooltip: {

                            callbacks: {

                                label: function (context) {

                                    const value =
                                        Number(context.raw);

                                    return "Ventas: C$ " +
                                        value.toLocaleString(
                                            "es-NI",
                                            {
                                                minimumFractionDigits: 2,
                                                maximumFractionDigits: 2
                                            }
                                        );

                                }

                            }

                        }

                    },

                    scales: {

                        x: {

                            grid: {

                                display: false

                            }

                        },

                        y: {

                            beginAtZero: true,

                            ticks: {

                                callback: function (value) {

                                    return "C$ " +
                                        Number(value).toLocaleString(
                                            "es-NI",
                                            {
                                                minimumFractionDigits: 2,
                                                maximumFractionDigits: 2
                                            }
                                        );

                                }

                            }

                        }

                    }

                }

            });

        }


        // =========================================================
        // GRÁFICA DE PAGOS
        // =========================================================

        const pagosCanvas =
            document.getElementById("pagosChart");

        if (pagosCanvas) {

            new Chart(pagosCanvas, {

                type: "doughnut",

                data: {

                    labels: [
                        @Html.Raw(pagosLabels)
                    ],

                    datasets: [

                        {

                            data: [
                                @Html.Raw(pagosData)
                            ],

                            backgroundColor: [

                                "#0d6efd",
                                "#198754",
                                "#ffc107",
                                "#dc3545",
                                "#6f42c1",
                                "#20c997",
                                "#fd7e14",
                                "#0dcaf0",
                                "#6c757d"

                            ],

                            borderWidth: 2,

                            borderColor: "#ffffff",

                            hoverOffset: 8

                        }

                    ]

                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    cutout: "65%",

                    plugins: {

                        legend: {

                            position: "bottom",

                            labels: {

                                usePointStyle: true,

                                padding: 15

                            }

                        },

                        tooltip: {

                            callbacks: {

                                label: function (context) {

                                    const value =
                                        Number(context.raw);

                                    return " C$ " +
                                        value.toLocaleString(
                                            "es-NI",
                                            {
                                                minimumFractionDigits: 2,
                                                maximumFractionDigits: 2
                                            }
                                        );

                                }

                            }

                        }

                    }

                }

            });

        }

    });

</script>
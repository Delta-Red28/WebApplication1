            height:
                42px;

            min-width:
                42px;

            border-radius:
                50%;

            display:
                flex;

            align-items:
                center;

            justify-content:
                center;

            background:
                linear-gradient(
                    135deg,
                    #2563eb,
                    #1d4ed8
                );

            color:
                #ffffff;

            font-size:
                14px;

            font-weight:
                700;

            box-shadow:
                0 4px 10px rgba(37,99,235,0.25);

        }


        .user-info {

            text-align:

@using System.Security.Claims

@{
    var nombres = User.FindFirstValue(ClaimTypes.GivenName) ?? "";
    var apellidos = User.FindFirstValue(ClaimTypes.Surname) ?? "";
    var usuarioActual = User.FindFirstValue(ClaimTypes.Name) ?? "";
    var rolActual = User.FindFirstValue(ClaimTypes.Role) ?? "Usuario";

    var nombreCompleto = $"{nombres} {apellidos}".Trim();

    if (string.IsNullOrWhiteSpace(nombreCompleto))
    {
        nombreCompleto = usuarioActual;
    }

    var iniciales = "";

    var partesNombre = nombreCompleto
        .Split(' ', StringSplitOptions.RemoveEmptyEntries);

    if (partesNombre.Length >= 2)
    {
        iniciales =
            partesNombre[0].Substring(0, 1).ToUpper() +
            partesNombre[1].Substring(0, 1).ToUpper();
    }
    else if (partesNombre.Length == 1)
    {
        iniciales =
            partesNombre[0].Substring(0, 1).ToUpper();
    }
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Restaurante
    </title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body>

    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar">

        <!-- LOGO -->
        <div class="sidebar-brand">

            <i class="bi bi-shop"></i>

            <span>Restaurante</span>

        </div>


        <!-- USUARIO -->
        <div class="sidebar-user">

            <div class="sidebar-user-name">
                @nombreCompleto
            </div>

            <div class="sidebar-user-role">
                @rolActual
            </div>

        </div>


        <!-- MENÚ PRINCIPAL -->
        <div class="sidebar-section">
            Menú principal
        </div>

        <ul class="sidebar-menu">

            <li>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">

                    <i class="bi bi-speedometer2"></i>

                    <span>Dashboard</span>

                </a>

            </li>

        </ul>


        <!-- MÓDULOS -->
        <div class="sidebar-section">
            Módulos
        </div>

        <ul class="sidebar-menu">

            @if (User.IsInRole("Administrador"))
            {
                <li>
                    <a href="#">
                        <i class="bi bi-people"></i>
                        <span>Usuarios</span>
                    </a>
                </li>

                <li>
                    <a href="#">
                        <i class="bi bi-person-vcard"></i>
                        <span>Clientes</span>
                    </a>
                </li>

                <li>
                    <a href="#">
                        <i class="bi bi-box-seam"></i>
                        <span>Productos</span>
                    </a>
                </li>

                <li>
                    <a href="#">
                        <i class="bi bi-receipt"></i>
                        <span>Pedidos</span>
                    </a>
                </li>

                <li>
                    <a href="#">
                        <i class="bi bi-calendar-check"></i>
                        <span>Reservaciones</span>
                    </a>
                </li>

                <li>
                    <a href="#">
                        <i class="bi bi-boxes"></i>
                        <span>Inventario</span>
                    </a>
                </li>

                <li>
                    <a href="#">
                        <i class="bi bi-cart"></i>
                        <span>Compras</span>
                    </a>
                </li>

                <li>
                    <a href="#">
                        <i class="bi bi-cash-stack"></i>
                        <span>Caja</span>
                    </a>
                </li>

                <li>
                    <a href="#">
                        <i class="bi bi-file-earmark-text"></i>
                        <span>Facturación</span>
                    </a>
                </li>

                <li>
                    <a href="#">
                        <i class="bi bi-bar-chart"></i>
                        <span>Reportes</span>
                    </a>
                </li>
            }

            @if (User.IsInRole("Gerente"))
            {
                <li>
                    <a href="#">
                        <i class="bi bi-person-vcard"></i>
                        <span>Clientes</span>
                    </a>
                </li>

                <li>
                    <a href="#">
                        <i class="bi bi-box-seam"></i>
                        <span>Productos</span>
                    </a>
                </li>

                <li>
                    <a href="#">
                        <i class="bi bi-receipt"></i>
                        <span>Pedidos</span>
                    </a>
                </li>

                <li>
                    <a href="#">
                        <i class="bi bi-bar-chart"></i>
                        <span>Reportes</span>
                    </a>
                </li>
            }

            @if (User.IsInRole("Cajero"))
            {
                <li>
                    <a href="#">
                        <i class="bi bi-receipt"></i>
                        <span>Pedidos</span>
                    </a>
                </li>

                <li>
                    <a href="#">
                        <i class="bi bi-cash-stack"></i>
                        <span>Caja</span>
                    </a>
                </li>

                <li>
                    <a href="#">
                        <i class="bi bi-file-earmark-text"></i>
                        <span>Facturación</span>
                    </a>
                </li>
            }

            @if (User.IsInRole("Mesero"))
            {
                <li>
                    <a href="#">
                        <i class="bi bi-receipt"></i>
                        <span>Pedidos</span>
                    </a>
                </li>

                <li>
                    <a href="#">
                        <i class="bi bi-calendar-check"></i>
                        <span>Reservaciones</span>
                    </a>
                </li>
            }

            @if (User.IsInRole("Cocina"))
            {
                <li>
                    <a href="#">
                        <i class="bi bi-receipt"></i>
                        <span>Pedidos</span>
                    </a>
                </li>
            }

        </ul>

    </aside>


    <!-- CONTENIDO PRINCIPAL -->
    <div class="main-wrapper">


        <!-- BARRA SUPERIOR -->
        <header class="topbar">

            <div class="topbar-left">

                <button type="button"
                        class="mobile-menu-button"
                        onclick="toggleSidebar()">

                    <i class="bi bi-list"></i>

                </button>

                <div class="topbar-title">
                    @ViewData["Title"]
                </div>

            </div>


            <!-- USUARIO -->
            <div class="dropdown">

                <button class="user-button dropdown-toggle"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false">

                    <div class="user-avatar">
                        @iniciales
                    </div>

                    <div class="user-info">

                        <div class="user-name">
                            @nombreCompleto
                        </div>

                        <div class="user-role">
                            @rolActual
                        </div>

                    </div>

                </button>


                <ul class="dropdown-menu dropdown-menu-end shadow">

                    <li>

                        <h6 class="dropdown-header">

                            @nombreCompleto

                            <br />

                            <small class="text-muted">
                                @rolActual
                            </small>

                        </h6>

                    </li>


                    <li>

                        <hr class="dropdown-divider" />

                    </li>


                    <li>

                        <a class="dropdown-item"
                           href="#">

                            <i class="bi bi-person me-2"></i>

                            Mi perfil

                        </a>

                    </li>


                    <li>

                        <a class="dropdown-item text-danger"
                           asp-controller="Account"
                           asp-action="Logout">

                            <i class="bi bi-box-arrow-right me-2"></i>

                            Cerrar sesión

                        </a>

                    </li>

                </ul>

            </div>

        </header>


        <!-- CONTENIDO DE LA VISTA -->
        <main class="content">

            @RenderBody()

        </main>

    </div>


    <!-- BOOTSTRAP -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


    <!-- MENU MOVIL -->
    <script>

            function toggleSidebar() {

                const sidebar = document.getElementById("sidebar");

                sidebar.classList.toggle("show");

            }

    </script>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
            max-width:
                180px;

        }


        .user-name {

            font-size:
                15px;

            font-weight:
                600;

            color:
                #1f2937;

            white-space:
                nowrap;

            overflow:
                hidden;

            text-overflow:
                ellipsis;

        }


        .user-role {

            margin-top:
                2px;

            font-size:
                13px;

            color:
                #6b7280;

        }


        /* =========================================================
           DROPDOWN
        ========================================================= */

        .dropdown-menu {

            min-width:
                245px;

            padding:
                8px;

            border:
                1px solid var(--border-color);

            border-radius:
                12px;

        }


        .dropdown-header {

            padding:
                10px 12px;

            font-size:
                15px;

            color:
                #1f2937;

        }


        .dropdown-item {

            min-height:
                43px;

            display:
                flex;

            align-items:
                center;

            border-radius:
                8px;

            padding:
                9px 12px;

            font-size:
                15px;

        }


        .dropdown-item:hover {

            background:
                #f3f4f6;

        }


        .dropdown-item.text-danger:hover {

            background:
                #fef2f2;

        }


        /* =========================================================
           CONTENIDO
        ========================================================= */

        .content {

            flex:
                1;

            width:
                100%;

            padding:
                30px;

        }


        /* =========================================================
           OVERLAY
        ========================================================= */

        .sidebar-overlay {

            display:
                none;

            position:
                fixed;

            inset:
                0;

            background:
                rgba(0,0,0,0.45);

            z-index:
                1040;

        }


        .sidebar-overlay.show {

            display:
                block;

        }


        /* =========================================================
           TABLET
        ========================================================= */

        @@media (max-width: 1100px) {

            :root {

                --sidebar-width: 250px;

            }

            .content {

                padding:
                    25px;

            }

            .topbar {

                padding:
                    0 24px;

            }

        }


        /* =========================================================
           TABLET PEQUEÑA
        ========================================================= */

        @@media (max-width: 900px) {

            .sidebar {

                transform:
                    translateX(-100%);

                transition:
                    transform 0.25s ease;

                width:
                    280px;

            }


            .sidebar.show {

                transform:
                    translateX(0);

            }


            .main-wrapper {

                margin-left:
                    0;

            }


            .mobile-menu-button {

                display:
                    flex;

            }


            .topbar {

                padding:
                    0 20px;

            }


            .content {

                padding:
                    24px;

            }

        }


        /* =========================================================
           MOVIL
        ========================================================= */

        @@media (max-width: 600px) {

            :root {

                --topbar-height: 68px;

            }


            .topbar {

                padding:
                    0 14px;

            }


            .topbar-title {

                font-size:
                    20px;

            }


            .user-info {

                display:
                    none;

            }


            .user-button {

                padding:
                    4px;

            }


            .user-button::after {

                display:
                    none;

            }


            .user-avatar {

                width:
                    42px;

                height:
                    42px;

            }


            .content {

                padding:
                    18px 14px;

            }


            .dropdown-menu {

                min-width:
                    230px;

            }

        }


        /* =========================================================
           MOVIL MUY PEQUEÑO
        ========================================================= */

        @@media (max-width: 380px) {

            .topbar-title {

                font-size:
                    18px;

            }


            .content {

                padding:
                    16px 12px;

            }

        }

    </style>

</head>



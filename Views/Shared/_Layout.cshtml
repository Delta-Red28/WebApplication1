@using System.Security.Claims

@{
    var nombres = User.FindFirstValue(ClaimTypes.GivenName) ?? "";
    var apellidos = User.FindFirstValue(ClaimTypes.Surname) ?? "";
    var usuarioActual = User.FindFirstValue(ClaimTypes.Name) ?? "";
    var rolActual = User.FindFirstValue(ClaimTypes.Role) ?? "Usuario";

    var nombreCompleto = $"{nombres} {apellidos}".Trim();

    if (string.IsNullOrWhiteSpace(nombreCompleto))
    {
        nombreCompleto = usuarioActual;
    }

    if (string.IsNullOrWhiteSpace(nombreCompleto))
    {
        nombreCompleto = "Usuario";
    }

    var iniciales = "";

    var partesNombre = nombreCompleto
        .Split(' ', StringSplitOptions.RemoveEmptyEntries);

    if (partesNombre.Length >= 2)
    {
        iniciales =
            partesNombre[0].Substring(0, 1).ToUpper() +
            partesNombre[1].Substring(0, 1).ToUpper();
    }
    else if (partesNombre.Length == 1)
    {
        iniciales =
            partesNombre[0].Substring(0, 1).ToUpper();
    }

    var controladorActual =
        ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Restaurante
    </title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"

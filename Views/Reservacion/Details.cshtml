@model WebApplication1.Models.Reservacion

@{
    ViewData["Title"] = "Detalle de Reservación";

    const int ESTADO_PENDIENTE = 1;
    const int ESTADO_CONFIRMADA = 2;
    const int ESTADO_LLEGO = 3;
    const int ESTADO_FINALIZADA = 4;
    const int ESTADO_CANCELADA = 5;
    const int ESTADO_NO_ASISTIO = 6;

    var cliente = Model.IdClienteNavigation;
    var mesa = Model.IdMesaNavigation;
    var estado = Model.IdEstadoReservacionNavigation;

    var nombreCliente = cliente != null
        ? $"{cliente.Nombres} {cliente.Apellidos}".Trim()
        : "Cliente no disponible";

    var nombreEstado = estado?.Nombre;

    if (string.IsNullOrWhiteSpace(nombreEstado))
    {
        nombreEstado = Model.IdEstadoReservacion switch
        {
            ESTADO_PENDIENTE => "Pendiente",
            ESTADO_CONFIRMADA => "Confirmada",
            ESTADO_LLEGO => "Cliente llegó",
            ESTADO_FINALIZADA => "Finalizada",
            ESTADO_CANCELADA => "Cancelada",
            ESTADO_NO_ASISTIO => "No asistió",
            _ => "Sin estado"
        };
    }

    var iconoEstado = Model.IdEstadoReservacion switch
    {
        ESTADO_PENDIENTE => "bi-clock",
        ESTADO_CONFIRMADA => "bi-check-circle",
        ESTADO_LLEGO => "bi-person-check",
        ESTADO_FINALIZADA => "bi-flag-fill",
        ESTADO_CANCELADA => "bi-x-circle",
        ESTADO_NO_ASISTIO => "bi-person-x",
        _ => "bi-question-circle"
    };

    var claseEstado = Model.IdEstadoReservacion switch
    {
        ESTADO_PENDIENTE => "bg-warning text-dark",
        ESTADO_CONFIRMADA => "bg-success text-white",
        ESTADO_LLEGO => "bg-primary text-white",
        ESTADO_FINALIZADA => "bg-info text-dark",
        ESTADO_CANCELADA => "bg-danger text-white",
        ESTADO_NO_ASISTIO => "bg-secondary text-white",
        _ => "bg-secondary text-white"
    };

    var diaSemana = Model.FechaReserva
        .ToDateTime(TimeOnly.MinValue)
        .ToString(
            "dddd",
            new System.Globalization.CultureInfo("es-ES"));

    diaSemana = char.ToUpper(diaSemana[0]) + diaSemana.Substring(1);

    var numeroMesa = mesa != null
        ? mesa.NumeroMesa.ToString()
        : Model.IdMesa.ToString();

    var capacidadMesa = mesa != null
        ? mesa.Capacidad.ToString()
        : "—";
}

<style>

    .details-page {
        padding-bottom: 40px;
    }

    .page-title {
        font-size: 1.6rem;
        font-weight: 700;
        color: #172033;
    }

    .page-subtitle {
        color: #6c757d;
        font-size: .85rem;
    }

    .details-card {
        border: 0;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0,0,0,.07);
        background: #fff;
    }

    .details-header {
        background: #0d6efd;
        color: #fff;
        padding: 18px 22px;
    }

    .details-header-title {
        font-size: 1rem;
        font-weight: 700;
        margin: 0;
    }

    .details-header-subtitle {
        font-size: .75rem;
        opacity: .85;
        margin-top: 3px;
    }

    .detail-section {
        padding: 22px;
        border-bottom: 1px solid #edf0f3;
    }

        .detail-section:last-child {
            border-bottom: 0;
        }

    .section-title {
        font-size: .9rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 18px;
    }

        .section-title i {
            color: #0d6efd;
            margin-right: 7px;
        }

    .detail-label {
        display: block;
        color: #8a94a6;
        font-size: .68rem;
        text-transform: uppercase;
        letter-spacing: .03em;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .detail-value {
        color: #172033;
        font-size: .9rem;
        font-weight: 600;
    }

    .detail-value-muted {
        color: #6c757d;
        font-size: .85rem;
    }

    .detail-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eaf2ff;
        color: #0d6efd;
        font-size: 1.2rem;
    }

    .info-box {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 14px;
        height: 100%;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 11px;
        border-radius: 20px;
        font-size: .75rem;
        font-weight: 700;
    }

    .observation-box {
        background: #f8f9fa;
        border-left: 4px solid #0d6efd;
        padding: 13px 15px;
        border-radius: 6px;
        color: #495057;
        font-size: .85rem;
    }

    .action-bar {
        padding: 18px 22px;
        background: #f8f9fa;
    }

    .btn-action {
        min-width: 110px;
    }

</style>


<div class="container-fluid mt-4 details-page">

    <!-- ============================================================
         ENCABEZADO
         ============================================================ -->

    <div class="d-flex flex-wrap justify-content-between
        align-items-center mb-4">

        <div>

            <h2 class="page-title mb-1">

                <i class="bi bi-calendar-check text-primary me-2"></i>

                Detalle de Reservación

            </h2>

            <div class="page-subtitle">

                Información completa de la reservación

                #@Model.IdReservacion

            </div>

        </div>

        <div class="mt-3 mt-md-0">

            <a asp-controller="Reservacion"
               asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>

                Volver

            </a>

        </div>

    </div>


    <!-- ============================================================
         MENSAJES
         ============================================================ -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ============================================================
         TARJETA PRINCIPAL
         ============================================================ -->

    <div class="card details-card">

        <!-- ENCABEZADO -->

        <div class="details-header">

            <div class="d-flex justify-content-between
                align-items-center">

                <div>

                    <div class="details-header-title">

                        <i class="bi bi-calendar-event me-2"></i>

                        Reservación #@Model.IdReservacion

                    </div>

                    <div class="details-header-subtitle">

                        Registrada el
                        @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")

                    </div>

                </div>

                <div>

                    <span class="status-badge @claseEstado">

                        <i class="bi @iconoEstado"></i>

                        @nombreEstado

                    </span>

                </div>

            </div>

        </div>


        <!-- ========================================================
             INFORMACIÓN DE LA RESERVACIÓN
             ======================================================== -->

        <div class="detail-section">

            <div class="section-title">

                <i class="bi bi-calendar3"></i>

                Información de la reservación

            </div>


            <div class="row g-3">

                <!-- FECHA -->

                <div class="col-md-4">

                    <div class="info-box">

                        <div class="d-flex align-items-center gap-3">

                            <div class="detail-icon">

                                <i class="bi bi-calendar-date"></i>

                            </div>

                            <div>

                                <span class="detail-label">
                                    Fecha
                                </span>

                                <div class="detail-value">

                                    @Model.FechaReserva.ToString("dd/MM/yyyy")

                                </div>

                                <div class="detail-value-muted">

                                    @diaSemana

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- HORARIO -->

                <div class="col-md-4">

                    <div class="info-box">

                        <div class="d-flex align-items-center gap-3">

                            <div class="detail-icon">

                                <i class="bi bi-clock"></i>

                            </div>

                            <div>

                                <span class="detail-label">
                                    Horario
                                </span>

                                <div class="detail-value">

                                    @Model.HoraInicio.ToString("HH:mm")

                                    <span class="text-muted mx-1">
                                        -
                                    </span>

                                    @Model.HoraFin.ToString("HH:mm")

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- PERSONAS -->

                <div class="col-md-4">

                    <div class="info-box">

                        <div class="d-flex align-items-center gap-3">

                            <div class="detail-icon">

                                <i class="bi bi-people"></i>

                            </div>

                            <div>

                                <span class="detail-label">
                                    Personas
                                </span>

                                <div class="detail-value">

                                    @Model.CantidadPersonas

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ========================================================
             CLIENTE Y MESA
             ======================================================== -->

        <div class="detail-section">

            <div class="section-title">

                <i class="bi bi-person-vcard"></i>

                Cliente y mesa

            </div>


            <div class="row g-4">

                <!-- CLIENTE -->

                <div class="col-md-6">

                    <div class="info-box">

                        <div class="d-flex align-items-start gap-3">

                            <div class="detail-icon">

                                <i class="bi bi-person"></i>

                            </div>

                            <div class="flex-grow-1">

                                <span class="detail-label">
                                    Cliente
                                </span>

                                <div class="detail-value">

                                    @nombreCliente

                                </div>

                                @if (cliente != null &&
                                    !string.IsNullOrWhiteSpace(cliente.Cedula))
                                {
                                    <div class="detail-value-muted mt-1">

                                        <i class="bi bi-card-text me-1"></i>

                                        Cédula:
                                        @cliente.Cedula

                                    </div>
                                }

                            </div>

                        </div>

                    </div>

                </div>


                <!-- MESA -->

                <div class="col-md-6">

                    <div class="info-box">

                        <div class="d-flex align-items-start gap-3">

                            <div class="detail-icon">

                                <i class="bi bi-grid-3x3-gap"></i>

                            </div>

                            <div class="flex-grow-1">

                                <span class="detail-label">
                                    Mesa
                                </span>

                                <div class="detail-value">

                                    Mesa @numeroMesa

                                </div>

                                <div class="detail-value-muted mt-1">

                                    <i class="bi bi-people me-1"></i>

                                    Capacidad:
                                    @capacidadMesa personas

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ========================================================
             ESTADO
             ======================================================== -->

        <div class="detail-section">

            <div class="section-title">

                <i class="bi bi-info-circle"></i>

                Estado de la reservación

            </div>


            <span class="status-badge @claseEstado">

                <i class="bi @iconoEstado"></i>

                @nombreEstado

            </span>

        </div>


        <!-- ========================================================
             OBSERVACIÓN
             ======================================================== -->

        <div class="detail-section">

            <div class="section-title">

                <i class="bi bi-chat-left-text"></i>

                Observación

            </div>


            @if (!string.IsNullOrWhiteSpace(Model.Observacion))
            {
                <div class="observation-box">

                    <i class="bi bi-chat-left-text me-2"></i>

                    @Model.Observacion

                </div>
            }
            else
            {
                <span class="text-muted">

                    No se registró ninguna observación.

                </span>
            }

        </div>


        <!-- ========================================================
             ACCIONES
             ======================================================== -->

        <div class="action-bar">

            <div class="d-flex flex-wrap gap-2">

                <a asp-controller="Reservacion"
                   asp-action="Edit"
                   asp-route-id="@Model.IdReservacion"
                   class="btn btn-warning btn-action">

                    <i class="bi bi-pencil me-1"></i>

                    Editar

                </a>


                @if (Model.IdEstadoReservacion != ESTADO_CANCELADA &&
                     Model.IdEstadoReservacion != ESTADO_FINALIZADA &&
                     Model.IdEstadoReservacion != ESTADO_LLEGO &&
                     Model.IdEstadoReservacion != ESTADO_NO_ASISTIO)
                {
                    <a asp-controller="Reservacion"
                       asp-action="Delete"
                       asp-route-id="@Model.IdReservacion"
                       class="btn btn-outline-danger btn-action">

                        <i class="bi bi-x-circle me-1"></i>

                        Cancelar

                    </a>
                }


                <a asp-controller="Reservacion"
                   asp-action="Index"
                   class="btn btn-outline-secondary btn-action">

                    <i class="bi bi-list me-1"></i>

                    Reservaciones

                </a>

            </div>

        </div>

    </div>

</div>
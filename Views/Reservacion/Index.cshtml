@model IEnumerable<WebApplication1.Models.Reservacion>

@{
    ViewData["Title"] = "Reservaciones";

    var reservaciones = Model?.ToList()
        ?? new List<WebApplication1.Models.Reservacion>();

    // ============================================================
    // ESTADOS
    // ============================================================

    const int ESTADO_PENDIENTE = 1;
    const int ESTADO_CONFIRMADA = 2;
    const int ESTADO_LLEGO = 3;
    const int ESTADO_FINALIZADA = 4;
    const int ESTADO_CANCELADA = 5;
    const int ESTADO_NO_ASISTIO = 6;

    // ============================================================
    // RESUMEN
    // ============================================================

    var totalReservaciones = reservaciones.Count;

    var pendientes = reservaciones.Count(x =>
        x.IdEstadoReservacion == ESTADO_PENDIENTE);

    var confirmadas = reservaciones.Count(x =>
        x.IdEstadoReservacion == ESTADO_CONFIRMADA);

    var finalizadas = reservaciones.Count(x =>
        x.IdEstadoReservacion == ESTADO_FINALIZADA);

    var canceladas = reservaciones.Count(x =>
        x.IdEstadoReservacion == ESTADO_CANCELADA);

    var noAsistieron = reservaciones.Count(x =>
        x.IdEstadoReservacion == ESTADO_NO_ASISTIO);

    var activas = reservaciones.Count(x =>
        x.IdEstadoReservacion >= ESTADO_PENDIENTE &&
        x.IdEstadoReservacion <= ESTADO_LLEGO);
}

<style>

    /* ============================================================
       GENERAL
       ============================================================ */

    .reservaciones-page {
        padding-bottom: 40px;
    }

    .page-title {
        font-size: 1.65rem;
        font-weight: 700;
        color: #172033;
    }

    .page-subtitle {
        font-size: .85rem;
        color: #6c757d;
    }


    /* ============================================================
       BOTONES
       ============================================================ */

    .btn-action {
        width: 32px;
        height: 32px;
        padding: 0;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        border-radius: 6px;
    }


    /* ============================================================
       TARJETAS RESUMEN
       ============================================================ */

    .summary-card {
        border: 0;
        border-radius: 10px;
        background: #fff;

        box-shadow: 0 2px 10px rgba(0, 0, 0, .06);

        transition: all .2s ease;
    }

    .summary-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 18px rgba(0, 0, 0, .09);
    }

    .summary-label {
        font-size: .75rem;
        color: #6c757d;
        margin-bottom: 4px;
    }

    .summary-number {
        font-size: 1.55rem;
        font-weight: 700;
        line-height: 1;
    }

    .summary-icon {
        width: 42px;
        height: 42px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 10px;

        font-size: 1.25rem;
    }

    .summary-primary .summary-icon {
        background: #eaf2ff;
        color: #0d6efd;
    }

    .summary-warning .summary-icon {
        background: #fff5d9;
        color: #f0ad00;
    }

    .summary-success .summary-icon {
        background: #e8f7ef;
        color: #198754;
    }

    .summary-info .summary-icon {
        background: #e5f8fc;
        color: #0dcaf0;
    }


    /* ============================================================
       TABLA
       ============================================================ */

    .reservation-card {
        border: 0;
        border-radius: 10px;
        overflow: hidden;

        box-shadow: 0 2px 12px rgba(0, 0, 0, .06);
    }

    .reservation-header {
        background: #0d6efd;
        color: #fff;

        padding: 11px 16px;
    }

    .reservation-header-title {
        font-size: .9rem;
        font-weight: 600;
        margin: 0;
    }

    .reservation-count {
        font-size: .7rem;
        font-weight: 600;
        padding: 4px 8px;
        border-radius: 20px;
    }


    /* ============================================================
       TABLA
       ============================================================ */

    .reservation-table {
        margin: 0;
        font-size: .78rem;
        white-space: nowrap;
    }

    .reservation-table thead th {
        background: #f8f9fa;
        color: #495057;

        font-size: .68rem;
        font-weight: 700;

        text-transform: uppercase;
        letter-spacing: .02em;

        border-bottom: 1px solid #dee2e6;

        padding: 10px 9px;
    }

    .reservation-table tbody td {
        padding: 9px;
        vertical-align: middle;

        border-color: #edf0f3;
    }

    .reservation-table tbody tr {
        transition: background-color .15s ease;
    }

    .reservation-table tbody tr:hover {
        background: #f8fbff;
    }


    /* ============================================================
       COLUMNAS
       ============================================================ */

    .col-id {
        width: 40px;
        color: #8a94a6;
    }

    .col-reserva {
        min-width: 105px;
    }

    .col-fecha {
        min-width: 105px;
    }

    .col-hora {
        min-width: 105px;
    }

    .col-cliente {
        min-width: 170px;
        max-width: 210px;
    }

    .col-mesa {
        min-width: 100px;
    }

    .col-personas {
        min-width: 80px;
    }

    .col-observacion {
        min-width: 180px;
        max-width: 250px;
    }

    .col-estado {
        min-width: 120px;
    }

    .col-acciones {
        min-width: 140px;
        width: 140px;
    }


    /* ============================================================
       DATOS
       ============================================================ */

    .reservation-number {
        color: #0d6efd;
        font-weight: 700;
    }

    .reservation-label {
        display: block;
        margin-top: 2px;

        color: #8a94a6;
        font-size: .65rem;
    }

    .client-name {
        max-width: 200px;

        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;

        font-weight: 600;
    }

    .client-document {
        display: block;

        margin-top: 2px;

        color: #8a94a6;
        font-size: .65rem;
    }

    .date-main {
        font-weight: 600;
    }

    .date-weekday {
        display: block;

        margin-top: 2px;

        color: #8a94a6;
        font-size: .65rem;

        text-transform: capitalize;
    }

    .time-main {
        font-weight: 700;
        color: #172033;
    }

    .time-separator {
        color: #8a94a6;
        margin: 0 3px;
    }

    .table-number {
        font-weight: 700;
        color: #495057;
    }

    .table-capacity {
        display: block;

        margin-top: 2px;

        color: #8a94a6;
        font-size: .65rem;
    }

    .people-count {
        font-weight: 700;
        color: #495057;
    }

    .observation {
        max-width: 230px;

        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;

        color: #6c757d;
    }


    /* ============================================================
       BADGES
       ============================================================ */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;

        padding: 4px 7px;

        border-radius: 20px;

        font-size: .66rem;
        font-weight: 600;
    }


    /* ============================================================
       ACCIONES
       ============================================================ */

    .actions {
        display: flex;
        align-items: center;
        justify-content: center;

        gap: 4px;
        flex-wrap: nowrap;
    }

    .actions .btn {
        flex-shrink: 0;
    }


    /* ============================================================
       TABLA VACÍA
       ============================================================ */

    .empty-state {
        padding: 65px 20px;
        text-align: center;
    }

    .empty-icon {
        width: 70px;
        height: 70px;

        margin: 0 auto 15px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;

        background: #f1f5f9;
        color: #94a3b8;

        font-size: 2rem;
    }


    /* ============================================================
       RESPONSIVE
       ============================================================ */

    @@media (max-width: 768px) {

        .page-title {
            font-size: 1.35rem;
        }

        .page-actions {
            width: 100%;
        }

        .page-actions .btn {
            flex: 1;
        }

        .summary-number {
            font-size: 1.35rem;
        }

        .reservation-table {
            font-size: .75rem;
        }
    }

</style>


<div class="container-fluid mt-4 reservaciones-page">

    <!-- ============================================================
         ENCABEZADO
         ============================================================ -->

    <div class="d-flex flex-wrap justify-content-between
                align-items-center mb-4">

        <div>

            <h2 class="page-title mb-1">

                <i class="bi bi-calendar-check text-primary me-2"></i>

                Reservaciones

            </h2>

            <div class="page-subtitle">

                Administración y consulta de las reservaciones
                del restaurante.

            </div>

        </div>


        <div class="d-flex gap-2 mt-3 mt-md-0 page-actions">

            <a asp-controller="Reservacion"
               asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-plus-lg me-1"></i>

                Nueva reservación

            </a>

        </div>

    </div>


    <!-- ============================================================
         MENSAJES
         ============================================================ -->

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ============================================================
         ERRORES DEL MODELO
         ============================================================ -->

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">

            <div class="fw-bold mb-1">

                <i class="bi bi-exclamation-triangle-fill me-2"></i>

                Se encontraron errores

            </div>

            <div asp-validation-summary="All"></div>

        </div>
    }


    <!-- ============================================================
         RESUMEN
         ============================================================ -->

    <div class="row g-3 mb-4">

        <!-- TOTAL -->

        <div class="col-xl-3 col-md-6">

            <div class="card summary-card summary-primary h-100">

                <div class="card-body py-3">

                    <div class="d-flex justify-content-between
                                align-items-center">

                        <div>

                            <div class="summary-label">
                                Total reservaciones
                            </div>

                            <div class="summary-number">
                                @totalReservaciones
                            </div>

                        </div>

                        <div class="summary-icon">

                            <i class="bi bi-calendar3"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- PENDIENTES -->

        <div class="col-xl-3 col-md-6">

            <div class="card summary-card summary-warning h-100">

                <div class="card-body py-3">

                    <div class="d-flex justify-content-between
                                align-items-center">

                        <div>

                            <div class="summary-label">
                                Pendientes
                            </div>

                            <div class="summary-number text-warning">
                                @pendientes
                            </div>

                        </div>

                        <div class="summary-icon">

                            <i class="bi bi-clock-history"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- CONFIRMADAS -->

        <div class="col-xl-3 col-md-6">

            <div class="card summary-card summary-success h-100">

                <div class="card-body py-3">

                    <div class="d-flex justify-content-between
                                align-items-center">

                        <div>

                            <div class="summary-label">
                                Confirmadas
                            </div>

                            <div class="summary-number text-success">
                                @confirmadas
                            </div>

                        </div>

                        <div class="summary-icon">

                            <i class="bi bi-check-circle"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- FINALIZADAS -->

        <div class="col-xl-3 col-md-6">

            <div class="card summary-card summary-info h-100">

                <div class="card-body py-3">

                    <div class="d-flex justify-content-between
                                align-items-center">

                        <div>

                            <div class="summary-label">
                                Finalizadas
                            </div>

                            <div class="summary-number text-info">
                                @finalizadas
                            </div>

                        </div>

                        <div class="summary-icon">

                            <i class="bi bi-flag-fill"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ============================================================
         INFORMACIÓN ADICIONAL
         ============================================================ -->

    <div class="d-flex flex-wrap gap-2 mb-4">

        @if (activas > 0)
        {
            <span class="badge bg-primary p-2">

                <i class="bi bi-calendar-check me-1"></i>

                @activas reservación(es) activa(s)

            </span>
        }

        @if (canceladas > 0)
        {
            <span class="badge bg-danger p-2">

                <i class="bi bi-x-circle me-1"></i>

                @canceladas cancelada(s)

            </span>
        }

        @if (noAsistieron > 0)
        {
            <span class="badge bg-secondary p-2">

                <i class="bi bi-person-x me-1"></i>

                @noAsistieron no asistió

            </span>
        }

    </div>


    <!-- ============================================================
         TABLA
         ============================================================ -->

    <div class="card reservation-card">

        <div class="reservation-header">

            <div class="d-flex justify-content-between
                        align-items-center">

                <div class="reservation-header-title">

                    <i class="bi bi-list-ul me-2"></i>

                    Listado de reservaciones

                </div>

                <span class="badge bg-light text-dark reservation-count">

                    @totalReservaciones registro(s)

                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (!reservaciones.Any())
            {
                <div class="empty-state">

                    <div class="empty-icon">

                        <i class="bi bi-calendar-x"></i>

                    </div>

                    <h5 class="mb-2">
                        No hay reservaciones registradas
                    </h5>

                    <p class="text-muted mb-4">

                        Todavía no existen reservaciones
                        en el sistema.

                    </p>

                    <a asp-controller="Reservacion"
                       asp-action="Create"
                       class="btn btn-primary">

                        <i class="bi bi-plus-lg me-1"></i>

                        Crear primera reservación

                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table reservation-table">

                        <thead>

                            <tr>

                                <th class="col-id">
                                    #
                                </th>

                                <th class="col-reserva">
                                    Reservación
                                </th>

                                <th class="col-fecha">
                                    Fecha
                                </th>

                                <th class="col-hora">
                                    Horario
                                </th>

                                <th class="col-cliente">
                                    Cliente
                                </th>

                                <th class="col-mesa">
                                    Mesa
                                </th>

                                <th class="col-personas text-center">
                                    Personas
                                </th>

                                <th class="col-observacion">
                                    Observación
                                </th>

                                <th class="col-estado">
                                    Estado
                                </th>

                                <th class="col-acciones text-center">
                                    Acciones
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                        @foreach (var reservacion in reservaciones)
                        {
                            <tr>

                                <!-- ====================================================
                                     ID
                                     ==================================================== -->

                                <td class="text-center">

                                    <span class="col-id">

                                        @reservacion.IdReservacion

                                    </span>

                                </td>


                                <!-- ====================================================
                                     RESERVACIÓN
                                     ==================================================== -->

                                <td>

                                    <div class="reservation-number">

                                        Reserva #@reservacion.IdReservacion

                                    </div>

                                    <span class="reservation-label">

                                        Registrada:
                                        @reservacion.FechaRegistro.ToString(
                                            "dd/MM/yyyy HH:mm")

                                    </span>

                                </td>


                                <!-- ====================================================
                                     FECHA
                                     ==================================================== -->

                                <td>

                                    <span class="date-main">

                                        @reservacion.FechaReserva.ToString(
                                            "dd/MM/yyyy")

                                    </span>

                                    @{
                                        var fechaReserva =
                                            reservacion.FechaReserva
                                                .ToDateTime(TimeOnly.MinValue);

                                        var diaSemana =
                                            fechaReserva.ToString(
                                                "dddd",
                                                new System.Globalization.CultureInfo("es-ES"));
                                    }

                                    <span class="date-weekday">

                                        @diaSemana

                                    </span>

                                </td>


                                <!-- ====================================================
                                     HORARIO
                                     ==================================================== -->

                                <td>

                                    <span class="time-main">

                                        @reservacion.HoraInicio.ToString("HH:mm")

                                    </span>

                                    <span class="time-separator">
                                        -
                                    </span>

                                    <span class="time-main">

                                        @reservacion.HoraFin.ToString("HH:mm")

                                    </span>

                                </td>


                                <!-- ====================================================
                                     CLIENTE
                                     ==================================================== -->

                                <td>

                                    @if (reservacion.IdClienteNavigation != null)
                                    {
                                        var cliente =
                                            reservacion.IdClienteNavigation;

                                        var nombre =
                                            $"{cliente.Nombres} {cliente.Apellidos}"
                                                .Trim();

                                        if (string.IsNullOrWhiteSpace(nombre))
                                        {
                                            nombre =
                                                $"Cliente #{cliente.IdCliente}";
                                        }

                                        <div class="client-name"
                                             title="@nombre">

                                            @nombre

                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(
                                            cliente.Cedula))
                                        {
                                            <span class="client-document">

                                                Cédula:
                                                @cliente.Cedula

                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">

                                            Cliente no disponible

                                        </span>
                                    }

                                </td>


                                <!-- ====================================================
                                     MESA
                                     ==================================================== -->

                                <td>

                                    @if (reservacion.IdMesaNavigation != null)
                                    {
                                        <div class="table-number">

                                            Mesa
                                            @reservacion.IdMesaNavigation.NumeroMesa

                                        </div>

                                        <span class="table-capacity">

                                            Capacidad:
                                            @reservacion.IdMesaNavigation.Capacidad

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">

                                            Mesa #@reservacion.IdMesa

                                        </span>
                                    }

                                </td>


                                <!-- ====================================================
                                     PERSONAS
                                     ==================================================== -->

                                <td class="text-center">

                                    <span class="people-count">

                                        <i class="bi bi-people me-1"></i>

                                        @reservacion.CantidadPersonas

                                    </span>

                                </td>


                                <!-- ====================================================
                                     OBSERVACIÓN
                                     ==================================================== -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        reservacion.Observacion))
                                    {
                                        <div class="observation"
                                             title="@reservacion.Observacion">

                                            @reservacion.Observacion

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- ====================================================
                                     ESTADO
                                     ==================================================== -->

                                <td>

                                    @switch (reservacion.IdEstadoReservacion)
                                    {
                                        case ESTADO_PENDIENTE:

                                            <span class="status-badge bg-warning text-dark">

                                                <i class="bi bi-clock"></i>

                                                @(reservacion
                                                    .IdEstadoReservacionNavigation
                                                    ?.Nombre ?? "Pendiente")

                                            </span>

                                            break;


                                        case ESTADO_CONFIRMADA:

                                            <span class="status-badge bg-success text-white">

                                                <i class="bi bi-check-circle"></i>

                                                @(reservacion
                                                    .IdEstadoReservacionNavigation
                                                    ?.Nombre ?? "Confirmada")

                                            </span>

                                            break;


                                        case ESTADO_LLEGO:

                                            <span class="status-badge bg-primary text-white">

                                                <i class="bi bi-person-check"></i>

                                                @(reservacion
                                                    .IdEstadoReservacionNavigation
                                                    ?.Nombre ?? "Cliente llegó")

                                            </span>

                                            break;


                                        case ESTADO_FINALIZADA:

                                            <span class="status-badge bg-info text-dark">

                                                <i class="bi bi-flag-fill"></i>

                                                @(reservacion
                                                    .IdEstadoReservacionNavigation
                                                    ?.Nombre ?? "Finalizada")

                                            </span>

                                            break;


                                        case ESTADO_CANCELADA:

                                            <span class="status-badge bg-danger text-white">

                                                <i class="bi bi-x-circle"></i>

                                                @(reservacion
                                                    .IdEstadoReservacionNavigation
                                                    ?.Nombre ?? "Cancelada")

                                            </span>

                                            break;


                                        case ESTADO_NO_ASISTIO:

                                            <span class="status-badge bg-secondary text-white">

                                                <i class="bi bi-person-x"></i>

                                                @(reservacion
                                                    .IdEstadoReservacionNavigation
                                                    ?.Nombre ?? "No asistió")

                                            </span>

                                            break;


                                        default:

                                            <span class="status-badge bg-secondary text-white">

                                                <i class="bi bi-question-circle"></i>

                                                @(reservacion
                                                    .IdEstadoReservacionNavigation
                                                    ?.Nombre ?? "Desconocido")

                                            </span>

                                            break;
                                    }

                                </td>


                                <!-- ====================================================
                                     ACCIONES
                                     ==================================================== -->

                                <td>

                                    <div class="actions">

                                        <!-- VER -->

                                        <a asp-controller="Reservacion"
                                           asp-action="Details"
                                           asp-route-id="@reservacion.IdReservacion"
                                           class="btn btn-sm btn-outline-primary btn-action"
                                           title="Ver detalle"
                                           data-bs-toggle="tooltip">

                                            <i class="bi bi-eye"></i>

                                        </a>


                                        <!-- EDITAR -->

                                        <a asp-controller="Reservacion"
                                           asp-action="Edit"
                                           asp-route-id="@reservacion.IdReservacion"
                                           class="btn btn-sm btn-outline-warning btn-action"
                                           title="Editar"
                                           data-bs-toggle="tooltip">

                                            <i class="bi bi-pencil"></i>

                                        </a>


                                        <!-- ====================================================
                                             CANCELAR / DESACTIVAR
                                             ==================================================== -->

                                        @if (reservacion.IdEstadoReservacion == ESTADO_PENDIENTE ||
                                             reservacion.IdEstadoReservacion == ESTADO_CONFIRMADA)
                                        {
                                            <a asp-controller="Reservacion"
                                               asp-action="Delete"
                                               asp-route-id="@reservacion.IdReservacion"
                                               class="btn btn-sm btn-outline-danger btn-action"
                                               title="Cancelar reservación"
                                               data-bs-toggle="tooltip">

                                                <i class="bi bi-x-circle"></i>

                                            </a>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary btn-action"
                                                    disabled
                                                    title="No se puede cancelar"
                                                    data-bs-toggle="tooltip">

                                                <i class="bi bi-x-circle"></i>

                                            </button>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        const tooltipTriggerList =

@model WebApplication1.Models.Reservacion

@{
ViewData["Title"] = "Nueva reservación";

var clientes = ViewBag.Clientes
    as IEnumerable<WebApplication1.Models.Cliente>
    ?? Enumerable.Empty<WebApplication1.Models.Cliente>();

var mesas = ViewBag.Mesas
    as IEnumerable<WebApplication1.Models.Mesa>
    ?? Enumerable.Empty<WebApplication1.Models.Mesa>();

}

<div class="container-fluid px-0">
<!-- ========================================================= -->
<!-- ENCABEZADO -->
<!-- ========================================================= -->

<div class="d-flex flex-column flex-md-row
            justify-content-between
            align-items-md-center
            gap-3 mb-4">

    <div>

        <h1 class="h3 mb-1">

            <i class="bi bi-calendar-plus me-2 text-primary"></i>

            Nueva reservación

        </h1>

        <p class="text-muted mb-0">

            Registra una nueva reservación para el restaurante.

        </p>

    </div>

    <div>

        <a asp-action="Index"
           class="btn btn-light">

            <i class="bi bi-arrow-left me-1"></i>

            Volver

        </a>

    </div>

</div>

<!-- ========================================================= -->
<!-- ERRORES GENERALES -->
<!-- ========================================================= -->

<div asp-validation-summary="ModelOnly"
     class="alert alert-danger"
     role="alert">
</div>

<!-- ========================================================= -->
<!-- FORMULARIO -->
<!-- ========================================================= -->

<form asp-action="Create"
      method="post"
      id="formReservacion">

    @Html.AntiForgeryToken()

    <div class="row g-4">

        <!-- ================================================= -->
        <!-- INFORMACIÓN DE LA RESERVACIÓN -->
        <!-- ================================================= -->

        <div class="col-12 col-xl-8">

            <div class="card border-0">

                <div class="card-header py-3">

                    <h5 class="mb-0">

                        <i class="bi bi-calendar-check me-2 text-primary"></i>

                        Información de la reservación

                    </h5>

                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <!-- ================================= -->
                        <!-- CLIENTE -->
                        <!-- ================================= -->

                        <div class="col-12">

                            <label asp-for="IdCliente"
                                   class="form-label fw-semibold">

                                Cliente

                            </label>

                            <select asp-for="IdCliente"
                                    class="form-select"
                                    id="IdCliente">

                                <option value="">
                                    Seleccione un cliente
                                </option>

                                @foreach (var cliente in clientes)
                                {
                                    <option value="@cliente.IdCliente">

                                        #@cliente.IdCliente -
                                        @cliente.Nombres @cliente.Apellidos

                                        @if (!string.IsNullOrWhiteSpace(cliente.Telefono))
                                        {
                                            @: — @cliente.Telefono
                                        }

                                    </option>
                                }

                            </select>

                            <div class="form-text">
                                Selecciona el cliente que realizará la reservación.
                            </div>

                            <span asp-validation-for="IdCliente"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- ================================= -->
                        <!-- FECHA -->
                        <!-- ================================= -->

                        <div class="col-12 col-md-4">

                            <label asp-for="FechaReserva"
                                   class="form-label fw-semibold">

                                Fecha

                            </label>

                            <input asp-for="FechaReserva"
                                   type="date"
                                   class="form-control"
                                   id="FechaReserva"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" />

                            <span asp-validation-for="FechaReserva"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- ================================= -->
                        <!-- HORA INICIO -->
                        <!-- ================================= -->

                        <div class="col-12 col-md-4">

                            <label asp-for="HoraInicio"
                                   class="form-label fw-semibold">

                                Hora de inicio

                            </label>

                            <input asp-for="HoraInicio"
                                   type="time"
                                   class="form-control"
                                   id="HoraInicio" />

                            <span asp-validation-for="HoraInicio"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- ================================= -->
                        <!-- HORA FIN -->
                        <!-- ================================= -->

                        <div class="col-12 col-md-4">

                            <label asp-for="HoraFin"
                                   class="form-label fw-semibold">

                                Hora de finalización

                            </label>

                            <input asp-for="HoraFin"
                                   type="time"
                                   class="form-control"
                                   id="HoraFin" />

                            <span asp-validation-for="HoraFin"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- ================================= -->
                        <!-- PERSONAS -->
                        <!-- ================================= -->

                        <div class="col-12 col-md-4">

                            <label asp-for="CantidadPersonas"
                                   class="form-label fw-semibold">

                                Cantidad de personas

                            </label>

                            <input asp-for="CantidadPersonas"
                                   type="number"
                                   min="1"
                                   class="form-control"
                                   id="CantidadPersonas" />

                            <span asp-validation-for="CantidadPersonas"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- ================================= -->
                        <!-- MESA -->
                        <!-- ================================= -->

                        <div class="col-12 col-md-8">

                            <label asp-for="IdMesa"
                                   class="form-label fw-semibold">

                                Mesa

                            </label>

                            <select asp-for="IdMesa"
                                    class="form-select"
                                    id="IdMesa">

                                <option value="">
                                    Seleccione fecha, horario y personas
                                </option>

                            </select>

                            <div id="mensajeMesas"
                                 class="form-text">

                                Seleccione los datos de la reservación
                                para consultar las mesas disponibles.

                            </div>

                            <span asp-validation-for="IdMesa"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- ================================= -->
                        <!-- OBSERVACIÓN -->
                        <!-- ================================= -->

                        <div class="col-12">

                            <label asp-for="Observacion"
                                   class="form-label fw-semibold">

                                Observación

                            </label>

                            <textarea asp-for="Observacion"
                                      class="form-control"
                                      id="Observacion"
                                      rows="4"
                                      maxlength="300"
                                      placeholder="Ejemplo: cumpleaños, mesa cerca de la ventana, etc."></textarea>

                            <div class="d-flex justify-content-between">

                                <small class="text-muted">

                                    Información adicional de la reservación.

                                </small>

                                <small class="text-muted">

                                    <span id="contadorObservacion">
                                        0
                                    </span>
                                    / 300

                                </small>

                            </div>

                            <span asp-validation-for="Observacion"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- ================================================= -->
        <!-- PANEL DE DISPONIBILIDAD -->
        <!-- ================================================= -->

        <div class="col-12 col-xl-4">

            <div class="card border-0">

                <div class="card-header py-3">

                    <h5 class="mb-0">

                        <i class="bi bi-stars me-2 text-warning"></i>

                        Disponibilidad

                    </h5>

                </div>

                <div class="card-body">

                    <div id="panelDisponibilidad">

                        <div class="text-center py-4">

                            <i class="bi bi-calendar2-check text-muted"
                               style="font-size: 3rem;">
                            </i>

                            <p class="text-muted mt-3 mb-0">

                                Completa la fecha, horario y cantidad
                                de personas para consultar disponibilidad.

                            </p>

                        </div>

                    </div>

                </div>

            </div>

            <!-- ================================================= -->
            <!-- ESTADO -->
            <!-- ================================================= -->

            <div class="card border-0 mt-4">

                <div class="card-body">

                    <div class="d-flex align-items-center gap-3">

                        <div class="rounded-circle bg-warning-subtle
                                    text-warning
                                    d-flex align-items-center
                                    justify-content-center"
                             style="width:45px;height:45px;">

                            <i class="bi bi-clock-history"></i>

                        </div>

                        <div>

                            <div class="fw-semibold">
                                Estado inicial
                            </div>

                            <div class="text-muted">
                                Pendiente
                            </div>

                        </div>

                    </div>

                    <div class="small text-muted mt-3">

                        La reservación se registrará automáticamente
                        como <strong>Pendiente</strong>.

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- ========================================================= -->
    <!-- BOTONES -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-end gap-2 mt-4">

        <a asp-action="Index"
           class="btn btn-light">

            Cancelar

        </a>

        <button type="submit"
                class="btn btn-primary"
                id="btnGuardar">

            <i class="bi bi-check-lg me-1"></i>

            Guardar reservación

        </button>

    </div>

</form>

</div>
@section Scripts {

<!-- ========================================================= -->
<!-- JQUERY -->
<!-- ========================================================= -->

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<!-- ========================================================= -->
<!-- VALIDACIÓN -->
<!-- ========================================================= -->

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const fecha =
            document.getElementById("FechaReserva");

        const horaInicio =
            document.getElementById("HoraInicio");

        const horaFin =
            document.getElementById("HoraFin");

        const cantidad =
            document.getElementById("CantidadPersonas");

        const mesa =
            document.getElementById("IdMesa");

        const mensaje =
            document.getElementById("mensajeMesas");

        const panel =
            document.getElementById("panelDisponibilidad");

        const observacion =
            document.getElementById("Observacion");

        const contador =
            document.getElementById("contadorObservacion");

        const formulario =
            document.getElementById("formReservacion");

        const botonGuardar =
            document.getElementById("btnGuardar");

        // =====================================================
        // CONTADOR DE OBSERVACIÓN
        // =====================================================

        function actualizarContador() {

            if (!observacion || !contador) {
                return;
            }

            contador.textContent =
                observacion.value.length;

        }

        observacion.addEventListener(
            "input",
            actualizarContador
        );

        actualizarContador();

        // =====================================================
        // OBTENER MESAS
        // =====================================================

        let temporizador = null;

        function consultarMesas() {

            clearTimeout(temporizador);

            temporizador = setTimeout(
                cargarMesas,
                250
            );

        }

        async function cargarMesas() {

            const fechaValor =
                fecha.value;

            const horaInicioValor =
                horaInicio.value;

            const horaFinValor =
                horaFin.value;

            const cantidadValor =
                parseInt(cantidad.value);

            // =================================================
            // VALIDACIONES CLIENTE
            // =================================================

            if (!fechaValor ||
                !horaInicioValor ||
                !horaFinValor ||
                !cantidadValor ||
                cantidadValor <= 0) {

                mesa.innerHTML = `
                    <option value="">
                        Seleccione fecha, horario y personas
                    </option>
                `;

                mensaje.textContent =
                    "Seleccione los datos de la reservación para consultar las mesas disponibles.";

                panel.innerHTML = `
                    <div class="text-center py-4">

                        <i class="bi bi-calendar2-check text-muted"
                           style="font-size: 3rem;">
                        </i>

                        <p class="text-muted mt-3 mb-0">
                            Completa los datos para consultar disponibilidad.
                        </p>

                    </div>
                `;

                return;
            }

            // =================================================
            // VALIDAR HORARIO
            // =================================================

            if (horaFinValor <= horaInicioValor) {

                mesa.innerHTML = `
                    <option value="">
                        Horario inválido
                    </option>
                `;

                mensaje.innerHTML =
                    `<span class="text-danger">
                        La hora de finalización debe ser mayor que la hora de inicio.
                    </span>`;

                panel.innerHTML = `
                    <div class="alert alert-danger mb-0">

                        <i class="bi bi-exclamation-triangle me-2"></i>

                        El horario seleccionado no es válido.

                    </div>
                `;

                return;
            }

            // =================================================
            // MOSTRAR CARGANDO
            // =================================================

            mesa.disabled = true;

            mesa.innerHTML = `
                <option value="">
                    Consultando disponibilidad...
                </option>
            `;

            mensaje.innerHTML = `
                <span class="text-primary">

                    <span class="spinner-border spinner-border-sm me-1"
                          role="status">
                    </span>

                    Consultando mesas...

                </span>
            `;

            panel.innerHTML = `
                <div class="text-center py-4">

                    <div class="spinner-border text-primary"
                         role="status">
                    </div>

                    <p class="text-muted mt-3 mb-0">
                        Buscando mesas disponibles...
                    </p>

                </div>
            `;

            try {

                const url =
                    '@Url.Action("ObtenerMesasDisponibles", "Reservacion")'
                    +
                    '?fecha=' + encodeURIComponent(fechaValor)
                    +
                    '&horaInicio=' + encodeURIComponent(horaInicioValor)
                    +
                    '&horaFin=' + encodeURIComponent(horaFinValor)
                    +
                    '&cantidadPersonas=' + encodeURIComponent(cantidadValor);

                const respuesta =
                    await fetch(url, {
                        method: "GET",
                        headers: {
                            "Accept": "application/json"
                        }
                    });

                if (!respuesta.ok) {

                    throw new Error(
                        "No fue posible consultar las mesas."
                    );

                }

                const datos =
                    await respuesta.json();

                if (!datos.exito) {

                    throw new Error(
                        datos.mensaje ||
                        "No fue posible consultar la disponibilidad."
                    );

                }

                // =================================================
                // LIMPIAR SELECT
                // =================================================

                mesa.innerHTML = "";

                // =================================================
                // SIN MESAS
                // =================================================

                if (!datos.mesas ||
                    datos.mesas.length === 0) {

                    mesa.innerHTML = `
                        <option value="">
                            No hay mesas disponibles
                        </option>
                    `;

                    mensaje.innerHTML = `
                        <span class="text-danger">

                            <i class="bi bi-x-circle me-1"></i>

                            No hay mesas disponibles para este horario.

                        </span>
                    `;

                    panel.innerHTML = `
                        <div class="alert alert-warning mb-0">

                            <div class="d-flex gap-3">

                                <i class="bi bi-exclamation-circle fs-4"></i>

                                <div>

                                    <div class="fw-semibold">
                                        No hay mesas disponibles
                                    </div>

                                    <div class="small mt-1">
                                        Prueba con otro horario,
                                        otra fecha o una cantidad
                                        diferente de personas.
                                    </div>

                                </div>

                            </div>

                        </div>
                    `;

                    mesa.disabled = true;

                    return;
                }

                // =================================================
                // AGREGAR OPCIONES
                // =================================================

                const opcionInicial =
                    document.createElement("option");

                opcionInicial.value = "";

                opcionInicial.textContent =
                    "Seleccione una mesa";

                mesa.appendChild(opcionInicial);

                datos.mesas.forEach(function (item) {

                    const opcion =
                        document.createElement("option");

                    opcion.value =
                        item.idMesa;

                    opcion.textContent =
                        `Mesa ${item.numeroMesa} - Capacidad ${item.capacidad}`;

                    if (item.recomendada) {

                        opcion.textContent +=
                            " ⭐ Recomendada";

                        opcion.selected = true;

                    }

                    mesa.appendChild(opcion);

                });

                mesa.disabled = false;

                // =================================================
                // MENSAJE
                // =================================================

                mensaje.innerHTML = `
                    <span class="text-success">

                        <i class="bi bi-check-circle me-1"></i>

                        ${datos.cantidad}
                        mesa(s) disponible(s).

                    </span>
                `;

                // =================================================
                // PANEL
                // =================================================

                const recomendada =
                    datos.mesas.find(
                        x => x.recomendada
                    );

                panel.innerHTML = `

                    <div class="alert alert-success mb-3">

                        <div class="d-flex align-items-center gap-3">

                            <i class="bi bi-check-circle-fill fs-3"></i>

                            <div>

                                <div class="fw-semibold">
                                    ${datos.cantidad}
                                    mesa(s) disponible(s)
                                </div>

                                <div class="small">
                                    La mesa recomendada está seleccionada automáticamente.
                                </div>

                            </div>

                        </div>

                    </div>

                    ${
                        recomendada
                        ?
                        `
                        <div class="border rounded-3 p-3">

                            <div class="small text-muted mb-1">

                                ⭐ Mesa recomendada

                            </div>

                            <div class="fs-5 fw-bold">

                                Mesa ${recomendada.numeroMesa}

                            </div>

                            <div class="text-muted">

                                Capacidad:
                                ${recomendada.capacidad}
                                personas

                            </div>

                        </div>
                        `
                        :
                        ""
                    }

                `;

            }
            catch (error) {

                console.error(error);

                mesa.innerHTML = `
                    <option value="">
                        No fue posible consultar
                    </option>
                `;

                mesa.disabled = true;

                mensaje.innerHTML = `
                    <span class="text-danger">

                        <i class="bi bi-exclamation-triangle me-1"></i>

                        ${error.message}

                    </span>
                `;

                panel.innerHTML = `
                    <div class="alert alert-danger mb-0">

                        <i class="bi bi-exclamation-triangle me-2"></i>

                        No fue posible consultar la disponibilidad.
                        Inténtelo nuevamente.

                    </div>
                `;

            }

        }

        // =====================================================
        // EVENTOS
        // =====================================================

        fecha.addEventListener(
            "change",
            consultarMesas
        );

        horaInicio.addEventListener(
            "change",
            consultarMesas
        );

        horaFin.addEventListener(
            "change",
            consultarMesas
        );

        cantidad.addEventListener(
            "input",
            consultarMesas
        );

        // =====================================================
        // VALIDACIÓN ANTES DE ENVIAR
        // =====================================================

        formulario.addEventListener(
            "submit",
            function (event) {

                const idMesa =
                    parseInt(mesa.value);

                if (!idMesa || idMesa <= 0) {

                    event.preventDefault();

                    mensaje.innerHTML = `
                        <span class="text-danger">

                            <i class="bi bi-exclamation-triangle me-1"></i>

                            Debe seleccionar una mesa disponible.

                        </span>
                    `;

                    mesa.focus();

                    return;

                }

                // =================================================
                // EVITAR DOBLE ENVÍO
                // =================================================

                botonGuardar.disabled = true;

                botonGuardar.innerHTML = `

                    <span class="spinner-border spinner-border-sm me-1"
                          role="status">
                    </span>

                    Guardando...

                `;

            }
        );

        // =====================================================
        // CARGAR DISPONIBILIDAD INICIAL
        // =====================================================

        if (fecha.value &&
            horaInicio.value &&
            horaFin.value &&
            cantidad.value) {

            cargarMesas();

        }

    });

</script>

}
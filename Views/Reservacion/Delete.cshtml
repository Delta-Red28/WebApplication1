@model WebApplication1.Models.Reservacion

@{
    ViewData["Title"] = "Cancelar reservación";

    var nombreCliente =
        $"{Model.IdClienteNavigation?.Nombres} {Model.IdClienteNavigation?.Apellidos}".Trim();

    if (string.IsNullOrWhiteSpace(nombreCliente))
    {
        nombreCliente = "Cliente no disponible";
    }

    var nombreEstado =
        Model.IdEstadoReservacionNavigation?.Nombre ?? "Sin estado";


    // ============================================================
    // ESTADOS
    // ============================================================

    const int ESTADO_PENDIENTE = 1;
    const int ESTADO_CONFIRMADA = 2;
    const int ESTADO_LLEGO = 3;
    const int ESTADO_FINALIZADA = 4;
    const int ESTADO_CANCELADA = 5;
    const int ESTADO_NO_ASISTIO = 6;


    // ============================================================
    // VALIDAR SI PUEDE CANCELARSE
    // ============================================================

    var puedeCancelar =
        Model.IdEstadoReservacion == ESTADO_PENDIENTE ||
        Model.IdEstadoReservacion == ESTADO_CONFIRMADA;

}


<div class="container-fluid">

    <!-- ========================================================= -->
    <!-- ENCABEZADO -->
    <!-- ========================================================= -->

    <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-md-center
                gap-3 mb-4">

        <div>

            <h2 class="mb-1">

                <i class="bi bi-x-circle text-danger me-2"></i>

                Cancelar reservación

            </h2>

            <p class="text-muted mb-0">

                Verifique la información antes de cancelar
                la reservación.

            </p>

        </div>


        <div>

            <a asp-action="Index"
               class="btn btn-light">

                <i class="bi bi-arrow-left me-1"></i>

                Volver a reservaciones

            </a>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- ALERTA CUANDO NO SE PUEDE CANCELAR -->
    <!-- ========================================================= -->

    @if (!puedeCancelar)
    {
        <div class="alert alert-warning d-flex align-items-start mb-4">

            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>

            <div>

                <strong>
                    Esta reservación no puede cancelarse.
                </strong>

                <div class="mt-1">

                    @if (Model.IdEstadoReservacion == ESTADO_LLEGO)
                    {
                        <span>
                            El cliente ya fue marcado como llegado.
                        </span>
                    }
                    else if (Model.IdEstadoReservacion == ESTADO_FINALIZADA)
                    {
                        <span>
                            La reservación ya fue finalizada.
                        </span>
                    }
                    else if (Model.IdEstadoReservacion == ESTADO_CANCELADA)
                    {
                        <span>
                            La reservación ya se encuentra cancelada.
                        </span>
                    }
                    else if (Model.IdEstadoReservacion == ESTADO_NO_ASISTIO)
                    {
                        <span>
                            La reservación ya está marcada como no asistió.
                        </span>
                    }
                    else
                    {
                        <span>
                            El estado actual de la reservación no permite
                            realizar esta operación.
                        </span>
                    }

                </div>

            </div>

        </div>
    }


    <!-- ========================================================= -->
    <!-- TARJETA PRINCIPAL -->
    <!-- ========================================================= -->

    <div class="row justify-content-center">

        <div class="col-12 col-xl-9">

            <div class="card border-0 shadow-sm">


                <!-- ================================================= -->
                <!-- HEADER -->
                <!-- ================================================= -->

                <div class="card-header py-3">

                    <div class="d-flex align-items-center">

                        <div class="rounded-circle
                                    bg-danger-subtle
                                    text-danger
                                    d-flex
                                    align-items-center
                                    justify-content-center"
                             style="width:45px;height:45px;">

                            <i class="bi bi-calendar-x fs-4"></i>

                        </div>


                        <div class="ms-3">

                            <h5 class="mb-0">

                                Reservación #@Model.IdReservacion

                            </h5>

                            <small class="text-muted">

                                Información de la reservación

                            </small>

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- BODY -->
                <!-- ================================================= -->

                <div class="card-body p-4">


                    <!-- ================================================= -->
                    <!-- INFORMACIÓN DEL CLIENTE -->
                    <!-- ================================================= -->

                    <h6 class="fw-bold mb-3">

                        <i class="bi bi-person me-2"></i>

                        Cliente

                    </h6>


                    <div class="row g-3 mb-4">


                        <!-- NOMBRE -->

                        <div class="col-md-6">

                            <div class="p-3 rounded border h-100">

                                <div class="text-muted small mb-1">

                                    Nombre completo

                                </div>

                                <div class="fw-semibold">

                                    @nombreCliente

                                </div>

                            </div>

                        </div>


                        <!-- TELÉFONO -->

                        <div class="col-md-6">

                            <div class="p-3 rounded border h-100">

                                <div class="text-muted small mb-1">

                                    Teléfono

                                </div>

                                <div class="fw-semibold">

                                    @(Model.IdClienteNavigation?.Telefono
                                        ?? "No registrado")

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- INFORMACIÓN DE RESERVACIÓN -->
                    <!-- ================================================= -->

                    <h6 class="fw-bold mb-3">

                        <i class="bi bi-calendar-check me-2"></i>

                        Detalles de la reservación

                    </h6>


                    <div class="row g-3 mb-4">


                        <!-- FECHA -->

                        <div class="col-md-6 col-lg-3">

                            <div class="p-3 rounded border h-100">

                                <div class="text-muted small mb-1">

                                    Fecha

                                </div>

                                <div class="fw-semibold">

                                    @Model.FechaReserva.ToString("dd/MM/yyyy")

                                </div>

                            </div>

                        </div>


                        <!-- HORARIO -->

                        <div class="col-md-6 col-lg-3">

                            <div class="p-3 rounded border h-100">

                                <div class="text-muted small mb-1">

                                    Horario

                                </div>

                                <div class="fw-semibold">

                                    @Model.HoraInicio.ToString("HH:mm")

                                    <span class="text-muted mx-1">
                                        -
                                    </span>

                                    @Model.HoraFin.ToString("HH:mm")

                                </div>

                            </div>

                        </div>


                        <!-- MESA -->

                        <div class="col-md-6 col-lg-3">

                            <div class="p-3 rounded border h-100">

                                <div class="text-muted small mb-1">

                                    Mesa

                                </div>

                                <div class="fw-semibold">

                                    @if (Model.IdMesaNavigation != null)
                                    {
                                        @:Mesa @Model.IdMesaNavigation.NumeroMesa
                                    }
                                    else
                                    {
                                        @:Mesa #@Model.IdMesa
                                    }

                                </div>

                            </div>

                        </div>


                        <!-- PERSONAS -->

                        <div class="col-md-6 col-lg-3">

                            <div class="p-3 rounded border h-100">

                                <div class="text-muted small mb-1">

                                    Personas

                                </div>

                                <div class="fw-semibold">

                                    <i class="bi bi-people me-1"></i>

                                    @Model.CantidadPersonas

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- ESTADO ACTUAL -->
                    <!-- ================================================= -->

                    <h6 class="fw-bold mb-3">

                        <i class="bi bi-info-circle me-2"></i>

                        Estado actual

                    </h6>


                    <div class="mb-4">

                        @switch (Model.IdEstadoReservacion)
                        {

                            case ESTADO_PENDIENTE:

                                <span class="badge bg-warning text-dark fs-6 px-3 py-2">

                                    <i class="bi bi-clock me-1"></i>

                                    @nombreEstado

                                </span>

                                break;


                            case ESTADO_CONFIRMADA:

                                <span class="badge bg-success fs-6 px-3 py-2">

                                    <i class="bi bi-check-circle me-1"></i>

                                    @nombreEstado

                                </span>

                                break;


                            case ESTADO_LLEGO:

                                <span class="badge bg-primary fs-6 px-3 py-2">

                                    <i class="bi bi-person-check me-1"></i>

                                    @nombreEstado

                                </span>

                                break;


                            case ESTADO_FINALIZADA:

                                <span class="badge bg-info text-dark fs-6 px-3 py-2">

                                    <i class="bi bi-check2-all me-1"></i>

                                    @nombreEstado

                                </span>

                                break;


                            case ESTADO_CANCELADA:

                                <span class="badge bg-danger fs-6 px-3 py-2">

                                    <i class="bi bi-x-circle me-1"></i>

                                    @nombreEstado

                                </span>

                                break;


                            case ESTADO_NO_ASISTIO:

                                <span class="badge bg-secondary fs-6 px-3 py-2">

                                    <i class="bi bi-person-x me-1"></i>

                                    @nombreEstado

                                </span>

                                break;


                            default:

                                <span class="badge bg-secondary fs-6 px-3 py-2">

                                    <i class="bi bi-question-circle me-1"></i>

                                    @nombreEstado

                                </span>

                                break;
                        }

                    </div>


                    <!-- ================================================= -->
                    <!-- OBSERVACIÓN -->
                    <!-- ================================================= -->

                    @if (!string.IsNullOrWhiteSpace(Model.Observacion))
                    {

                        <h6 class="fw-bold mb-3">

                            <i class="bi bi-chat-left-text me-2"></i>

                            Observación

                        </h6>


                        <div class="alert alert-light border mb-4">

                            @Model.Observacion

                        </div>

                    }


                    <!-- ================================================= -->
                    <!-- FECHA DE REGISTRO -->
                    <!-- ================================================= -->

                    <div class="text-muted small mb-4">

                        <i class="bi bi-calendar-plus me-1"></i>

                        Registrada el

                        @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")

                    </div>


                    <!-- ================================================= -->
                    <!-- CONFIRMACIÓN -->
                    <!-- ================================================= -->

                    @if (puedeCancelar)
                    {

                        <div class="alert alert-danger">

                            <div class="d-flex align-items-start">

                                <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>


                                <div>

                                    <strong>

                                        ¿Está seguro de cancelar esta reservación?

                                    </strong>


                                    <p class="mb-0 mt-1">

                                        La reservación

                                        <strong>
                                            no será eliminada
                                        </strong>

                                        del sistema.

                                        Se marcará como

                                        <strong>
                                            cancelada
                                        </strong>

                                        y permanecerá registrada
                                        en el historial.

                                    </p>

                                </div>

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- BOTONES -->
                        <!-- ================================================= -->

                        <div class="d-flex flex-column
                                    flex-sm-row
                                    justify-content-end
                                    gap-2">


                            <!-- VOLVER -->

                            <a asp-action="Index"
                               class="btn btn-light">

                                <i class="bi bi-arrow-left me-1"></i>

                                Volver

                            </a>


                            <!-- VER DETALLES -->

                            <a asp-action="Details"
                               asp-route-id="@Model.IdReservacion"
                               class="btn btn-outline-primary">

                                <i class="bi bi-eye me-1"></i>

                                Ver detalles

                            </a>


                            <!-- CANCELAR -->

                            <form asp-action="Delete"
                                  asp-route-id="@Model.IdReservacion"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirmarCancelacion();">

                                @Html.AntiForgeryToken()


                                <button type="submit"
                                        class="btn btn-danger">

                                    <i class="bi bi-x-circle me-1"></i>

                                    Cancelar reservación

                                </button>

                            </form>


                        </div>

                    }
                    else
                    {

                        <!-- ================================================= -->
                        <!-- NO SE PUEDE CANCELAR -->
                        <!-- ================================================= -->

                        <div class="alert alert-light border">

                            <div class="d-flex align-items-start">

                                <i class="bi bi-info-circle fs-4 text-primary me-3"></i>

                                <div>

                                    <strong>
                                        No se requiere ninguna acción.
                                    </strong>

                                    <p class="mb-0 mt-1">

                                        La reservación conserva su estado
                                        actual y no puede ser cancelada
                                        desde esta pantalla.

                                    </p>

                                </div>

                            </div>

                        </div>


                        <!-- BOTÓN VOLVER -->

                        <div class="d-flex justify-content-end">

                            <a asp-action="Index"
                               class="btn btn-primary">

                                <i class="bi bi-arrow-left me-1"></i>

                                Volver a reservaciones

                            </a>

                        </div>

                    }

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        function confirmarCancelacion() {

            return confirm(
                "¿Está seguro de cancelar esta reservación?\n\n" +
                "La reservación NO será eliminada del sistema.\n" +
                "Se marcará como CANCELADA y permanecerá registrada."
            );

        }

    </script>

}
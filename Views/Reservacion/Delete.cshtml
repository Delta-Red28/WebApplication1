@model WebApplication1.Models.Reservacion

@{
    ViewData["Title"] = "Eliminar reservación";

    var nombreCliente =
        $"{Model.IdClienteNavigation?.Nombres} {Model.IdClienteNavigation?.Apellidos}".Trim();

    var nombreEstado =
        Model.IdEstadoReservacionNavigation?.Nombre ?? "Sin estado";

    var puedeEliminar =
        Model.IdEstadoReservacion != 3 &&
        Model.IdEstadoReservacion != 4;

}

<div class="container-fluid">
    <!-- ========================================================= -->
    <!-- ENCABEZADO -->
    <!-- ========================================================= -->

    <div class="d-flex flex-column flex-md-row
        justify-content-between
        align-items-md-center
        gap-3 mb-4">

        <div>

            <h2 class="mb-1">
                <i class="bi bi-trash3 text-danger me-2"></i>
                Eliminar reservación
            </h2>

            <p class="text-muted mb-0">
                Verifique la información antes de eliminar la reservación.
            </p>

        </div>

        <div>

            <a asp-action="Index"
               class="btn btn-light">

                <i class="bi bi-arrow-left me-1"></i>

                Volver a reservaciones

            </a>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- ALERTA -->
    <!-- ========================================================= -->
    @if (!puedeEliminar)
    {
        <div class="alert alert-warning d-flex align-items-start mb-4">

            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>

            <div>

                <strong>No se puede eliminar esta reservación.</strong>

                <div class="mt-1">

                    @if (Model.IdEstadoReservacion == 3)
                    {
                        <span>
                            El cliente ya fue marcado como llegado.
                        </span>
                    }
                    else if (Model.IdEstadoReservacion == 4)
                    {
                        <span>
                            La reservación ya fue finalizada.
                        </span>
                    }

                </div>

            </div>

        </div>
    }


    <!-- ========================================================= -->
    <!-- TARJETA PRINCIPAL -->
    <!-- ========================================================= -->

    <div class="row justify-content-center">

        <div class="col-12 col-xl-9">

            <div class="card border-0">

                <div class="card-header py-3">

                    <div class="d-flex align-items-center">

                        <div class="rounded-circle
                            bg-danger-subtle
                            text-danger
                            d-flex
                            align-items-center
                            justify-content-center"
                             style="width:45px;height:45px;">

                            <i class="bi bi-calendar-x fs-4"></i>

                        </div>

                        <div class="ms-3">

                            <h5 class="mb-0">
                                Reservación #@Model.IdReservacion
                            </h5>

                            <small class="text-muted">
                                Información de la reservación
                            </small>

                        </div>

                    </div>

                </div>


                <div class="card-body p-4">

                    <!-- ================================================= -->
                    <!-- INFORMACIÓN DEL CLIENTE -->
                    <!-- ================================================= -->

                    <h6 class="fw-bold mb-3">

                        <i class="bi bi-person me-2"></i>

                        Cliente

                    </h6>

                    <div class="row g-3 mb-4">

                        <div class="col-md-6">

                            <div class="p-3 rounded border">

                                <div class="text-muted small mb-1">
                                    Nombre completo
                                </div>

                                <div class="fw-semibold">

                                    @nombreCliente

                                </div>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="p-3 rounded border">

                                <div class="text-muted small mb-1">
                                    Teléfono
                                </div>

                                <div class="fw-semibold">

                                    @(Model.IdClienteNavigation?.Telefono ?? "No registrado")

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- INFORMACIÓN DE LA RESERVACIÓN -->
                    <!-- ================================================= -->

                    <h6 class="fw-bold mb-3">

                        <i class="bi bi-calendar-check me-2"></i>

                        Detalles de la reservación

                    </h6>


                    <div class="row g-3 mb-4">

                        <!-- FECHA -->

                        <div class="col-md-6 col-lg-3">

                            <div class="p-3 rounded border h-100">

                                <div class="text-muted small mb-1">

                                    Fecha

                                </div>

                                <div class="fw-semibold">

                                    @Model.FechaReserva.ToString("dd/MM/yyyy")

                                </div>

                            </div>

                        </div>


                        <!-- HORA -->

                        <div class="col-md-6 col-lg-3">

                            <div class="p-3 rounded border h-100">

                                <div class="text-muted small mb-1">

                                    Horario

                                </div>

                                <div class="fw-semibold">

                                    @Model.HoraInicio.ToString("HH:mm")
                                    -
                                    @Model.HoraFin.ToString("HH:mm")

                                </div>

                            </div>

                        </div>


                        <!-- MESA -->

                        <div class="col-md-6 col-lg-3">

                            <div class="p-3 rounded border h-100">

                                <div class="text-muted small mb-1">

                                    Mesa

                                </div>

                                <div class="fw-semibold">

                                    Mesa @Model.IdMesaNavigation?.NumeroMesa.ToString("00")

                                </div>

                            </div>

                        </div>


                        <!-- PERSONAS -->

                        <div class="col-md-6 col-lg-3">

                            <div class="p-3 rounded border h-100">

                                <div class="text-muted small mb-1">

                                    Personas

                                </div>

                                <div class="fw-semibold">

                                    @Model.CantidadPersonas

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- ESTADO -->
                    <!-- ================================================= -->

                    <h6 class="fw-bold mb-3">

                        <i class="bi bi-info-circle me-2"></i>

                        Estado

                    </h6>


                    <div class="mb-4">

                        @switch (Model.IdEstadoReservacion)
                        {
                            case 1:

                                <span class="badge bg-warning text-dark fs-6 px-3 py-2">

                                    <i class="bi bi-clock me-1"></i>

                                    @nombreEstado

                                </span>

                                break;

                            case 2:

                                <span class="badge bg-primary fs-6 px-3 py-2">

                                    <i class="bi bi-check-circle me-1"></i>

                                    @nombreEstado

                                </span>

                                break;

                            case 3:

                                <span class="badge bg-info text-dark fs-6 px-3 py-2">

                                    <i class="bi bi-person-check me-1"></i>

                                    @nombreEstado

                                </span>

                                break;

                            case 4:

                                <span class="badge bg-success fs-6 px-3 py-2">

                                    <i class="bi bi-check2-all me-1"></i>

                                    @nombreEstado

                                </span>

                                break;

                            case 5:

                                <span class="badge bg-danger fs-6 px-3 py-2">

                                    <i class="bi bi-x-circle me-1"></i>

                                    @nombreEstado

                                </span>

                                break;

                            case 6:

                                <span class="badge bg-secondary fs-6 px-3 py-2">

                                    <i class="bi bi-person-x me-1"></i>

                                    @nombreEstado

                                </span>

                                break;

                            default:

                                <span class="badge bg-secondary fs-6 px-3 py-2">

                                    @nombreEstado

                                </span>

                                break;
                        }

                    </div>


                    <!-- ================================================= -->
                    <!-- OBSERVACIÓN -->
                    <!-- ================================================= -->
                    @if (!string.IsNullOrWhiteSpace(Model.Observacion))
                    {

                        <h6 class="fw-bold mb-3">

                            <i class="bi bi-chat-left-text me-2"></i>

                            Observación

                        </h6>

                        <div class="alert alert-light border mb-4">

                            @Model.Observacion

                        </div>

                    }


                    <!-- ================================================= -->
                    <!-- FECHA DE REGISTRO -->
                    <!-- ================================================= -->

                    <div class="text-muted small mb-4">

                        <i class="bi bi-calendar-plus me-1"></i>

                        Registrada el
                        @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")

                    </div>


                    <!-- ================================================= -->
                    <!-- CONFIRMACIÓN -->
                    <!-- ================================================= -->
                    @if (puedeEliminar)
                    {

                        <div class="alert alert-danger">

                            <div class="d-flex align-items-start">

                                <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>

                                <div>

                                    <strong>
                                        ¿Está seguro de eliminar esta reservación?
                                    </strong>

                                    <p class="mb-0 mt-1">

                                        Esta acción eliminará permanentemente
                                        la reservación del sistema y no podrá
                                        deshacerse.

                                    </p>

                                </div>

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- BOTONES -->
                        <!-- ================================================= -->

                        <div class="d-flex flex-column
                            flex-sm-row
                            justify-content-end
                            gap-2">

                            <a asp-action="Index"
                               class="btn btn-light">

                                <i class="bi bi-x-lg me-1"></i>

                                Cancelar

                            </a>


                            <a asp-action="Details"
                               asp-route-id="@Model.IdReservacion"
                               class="btn btn-outline-primary">

                                <i class="bi bi-eye me-1"></i>

                                Ver detalles

                            </a>


                            <form asp-action="Delete"
                                  asp-route-id="@Model.IdReservacion"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirmarEliminacion();">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-danger">

                                    <i class="bi bi-trash3 me-1"></i>

                                    Eliminar reservación

                                </button>

                            </form>

                        </div>

                    }
                    else
                    {

                        <div class="d-flex justify-content-end">

                            <a asp-action="Index"
                               class="btn btn-primary">

                                <i class="bi bi-arrow-left me-1"></i>

                                Volver a reservaciones

                            </a>

                        </div>

                    }

                </div>

            </div>

        </div>

    </div>

</div>
@section Scripts {

    <script>

        function confirmarEliminacion() {

            return confirm(
                "¿Está seguro de eliminar esta reservación?\n\n" +
                "Esta acción no se puede deshacer."
            );

        }

    </script>

}
@model WebApplication1.Models.Cliente

@{
    ViewData["Title"] = "Nuevo cliente";
}

<div class="container-fluid px-4 py-3">

    <!-- ENCABEZADO -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div class="d-flex align-items-center gap-3">

            <!-- ICONO -->
            <div class="rounded-3 d-flex align-items-center justify-content-center shadow-sm"
                 style="
                width: 58px;
                height: 58px;
                background: #e8f0fe;
                color: #0d6efd;
                font-size: 1.4rem;
                ">

                <i class="bi bi-person-plus-fill"></i>

            </div>

            <div>

                <h2 class="fw-bold mb-1">
                    Nuevo cliente
                </h2>

                <p class="text-muted mb-0">
                    Registra un nuevo cliente en el sistema.
                </p>

            </div>

        </div>


        <a asp-action="Index"
           class="btn btn-light border px-4">

            <i class="bi bi-arrow-left me-1"></i>
            Volver

        </a>

    </div>


    <!-- FORMULARIO -->
    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()


        <!-- VALIDACIONES -->
        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger border-0 shadow-sm"
             role="alert">
        </div>


        <div class="row g-4">


            <!-- DATOS PERSONALES -->
            <div class="col-lg-7">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-header bg-white border-0 pt-4 px-4">

                        <div class="d-flex align-items-center">

                            <div class="rounded-3 d-flex align-items-center justify-content-center me-3"
                                 style="
                                width: 42px;
                                height: 42px;
                                background: #e8f0fe;
                                color: #0d6efd;
                                ">

                                <i class="bi bi-person-fill"></i>

                            </div>

                            <div>

                                <h5 class="fw-bold mb-0">
                                    Datos personales
                                </h5>

                                <small class="text-muted">
                                    Información básica del nuevo cliente
                                </small>

                            </div>

                        </div>

                    </div>


                    <div class="card-body px-4 pb-4">

                        <div class="row g-3">


                            <!-- NOMBRES -->
                            <div class="col-md-6">

                                <label asp-for="Nombres"
                                       class="form-label fw-semibold">

                                    Nombres

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-person text-muted"></i>
                                    </span>

                                    <input asp-for="Nombres"
                                           class="form-control"
                                           placeholder="Ingrese los nombres" />

                                </div>

                                <span asp-validation-for="Nombres"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- APELLIDOS -->
                            <div class="col-md-6">

                                <label asp-for="Apellidos"
                                       class="form-label fw-semibold">

                                    Apellidos

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-person text-muted"></i>
                                    </span>

                                    <input asp-for="Apellidos"
                                           class="form-control"
                                           placeholder="Ingrese los apellidos" />

                                </div>

                                <span asp-validation-for="Apellidos"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- CÉDULA -->
                            <div class="col-md-6">

                                <label asp-for="Cedula"
                                       class="form-label fw-semibold">

                                    Cédula

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-card-text text-muted"></i>
                                    </span>

                                    <input asp-for="Cedula"
                                           class="form-control"
                                           placeholder="Número de cédula" />

                                </div>

                                <span asp-validation-for="Cedula"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- FECHA NACIMIENTO -->
                            <div class="col-md-6">

                                <label asp-for="FechaNacimiento"
                                       class="form-label fw-semibold">

                                    Fecha de nacimiento

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-calendar3 text-muted"></i>
                                    </span>

                                    <input asp-for="FechaNacimiento"
                                           type="date"
                                           class="form-control" />

                                </div>

                                <span asp-validation-for="FechaNacimiento"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- SEXO -->
                            <div class="col-md-6">

                                <label asp-for="Sexo"
                                       class="form-label fw-semibold">

                                    Sexo

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-gender-ambiguous text-muted"></i>
                                    </span>

                                    <select asp-for="Sexo"
                                            class="form-select">

                                        <option value="">
                                            Seleccione una opción
                                        </option>

                                        <option value="M">
                                            Masculino
                                        </option>

                                        <option value="F">
                                            Femenino
                                        </option>

                                    </select>

                                </div>

                                <span asp-validation-for="Sexo"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- PANEL LATERAL -->
            <div class="col-lg-5">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-header bg-white border-0 pt-4 px-4">

                        <div class="d-flex align-items-center">

                            <div class="rounded-3 d-flex align-items-center justify-content-center me-3"
                                 style="
                                width: 42px;
                                height: 42px;
                                background: #eef2ff;
                                color: #4f46e5;
                                ">

                                <i class="bi bi-person-vcard-fill"></i>

                            </div>

                            <div>

                                <h5 class="fw-bold mb-0">
                                    Registro de cliente
                                </h5>

                                <small class="text-muted">
                                    Información del proceso
                                </small>

                            </div>

                        </div>

                    </div>


                    <div class="card-body px-4">

                        <div class="text-center py-3">

                            <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3"
                                 style="
                                width: 80px;
                                height: 80px;
                                background: #e8f0fe;
                                color: #0d6efd;
                                ">

                                <i class="bi bi-person-plus-fill fs-2"></i>

                            </div>

                            <h5 class="fw-bold mb-1">
                                Registrar nuevo cliente
                            </h5>

                            <p class="text-muted mb-0">
                                Complete la información solicitada
                                para crear el registro.
                            </p>

                        </div>


                        <hr />


                        <!-- PASO 1 -->
                        <div class="d-flex align-items-start gap-3 mb-3">

                            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                 style="
                                width: 32px;
                                height: 32px;
                                background: #e8f0fe;
                                color: #0d6efd;
                                ">

                                <strong>1</strong>

                            </div>

                            <div>

                                <div class="fw-semibold">
                                    Datos personales
                                </div>

                                <small class="text-muted">
                                    Nombre, cédula y fecha de nacimiento.
                                </small>

                            </div>

                        </div>


                        <!-- PASO 2 -->
                        <div class="d-flex align-items-start gap-3 mb-3">

                            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                 style="
                                width: 32px;
                                height: 32px;
                                background: #e8f7ee;
                                color: #198754;
                                ">

                                <strong>2</strong>

                            </div>

                            <div>

                                <div class="fw-semibold">
                                    Información de contacto
                                </div>

                                <small class="text-muted">
                                    Teléfono, correo y dirección.
                                </small>

                            </div>

                        </div>


                        <!-- PASO 3 -->
                        <div class="d-flex align-items-start gap-3">

                            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                 style="
                                width: 32px;
                                height: 32px;
                                background: #fff4e5;
                                color: #fd7e14;
                                ">

                                <strong>3</strong>

                            </div>

                            <div>

                                <div class="fw-semibold">
                                    Observaciones
                                </div>

                                <small class="text-muted">
                                    Agregue información adicional si es necesario.
                                </small>

                            </div>

                        </div>


                        <div class="alert alert-info border-0 mt-4 mb-0">

                            <i class="bi bi-info-circle me-2"></i>

                            Los campos obligatorios deben completarse
                            antes de guardar el cliente.

                        </div>

                    </div>

                </div>

            </div>


            <!-- INFORMACIÓN DE CONTACTO -->
            <div class="col-12">

                <div class="card border-0 shadow-sm">

                    <div class="card-header bg-white border-0 pt-4 px-4">

                        <div class="d-flex align-items-center">

                            <div class="rounded-3 d-flex align-items-center justify-content-center me-3"
                                 style="
                                width: 42px;
                                height: 42px;
                                background: #e8f7ee;
                                color: #198754;
                                ">

                                <i class="bi bi-telephone-fill"></i>

                            </div>

                            <div>

                                <h5 class="fw-bold mb-0">
                                    Información de contacto
                                </h5>

                                <small class="text-muted">
                                    Medios para comunicarse con el cliente
                                </small>

                            </div>

                        </div>

                    </div>


                    <div class="card-body px-4 pb-4">

                        <div class="row g-3">


                            <!-- TELÉFONO -->
                            <div class="col-md-4">

                                <label asp-for="Telefono"
                                       class="form-label fw-semibold">

                                    Teléfono

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-telephone text-muted"></i>
                                    </span>

                                    <input asp-for="Telefono"
                                           class="form-control"
                                           placeholder="Número de teléfono" />

                                </div>

                                <span asp-validation-for="Telefono"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- CORREO -->
                            <div class="col-md-4">

                                <label asp-for="Correo"
                                       class="form-label fw-semibold">

                                    Correo electrónico

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-envelope text-muted"></i>
                                    </span>

                                    <input asp-for="Correo"
                                           type="email"
                                           class="form-control"
                                           placeholder="correo@ejemplo.com" />

                                </div>

                                <span asp-validation-for="Correo"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- DIRECCIÓN -->
                            <div class="col-md-4">

                                <label asp-for="Direccion"
                                       class="form-label fw-semibold">

                                    Dirección

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-geo-alt text-muted"></i>
                                    </span>

                                    <textarea asp-for="Direccion"
                                              class="form-control"
                                              rows="1"
                                              placeholder="Dirección del cliente"></textarea>

                                </div>

                                <span asp-validation-for="Direccion"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- OBSERVACIONES -->
            <div class="col-12">

                <div class="card border-0 shadow-sm">

                    <div class="card-header bg-white border-0 pt-4 px-4">

                        <div class="d-flex align-items-center">

                            <div class="rounded-3 d-flex align-items-center justify-content-center me-3"
                                 style="
                                width: 42px;
                                height: 42px;
                                background: #fff4e5;
                                color: #fd7e14;
                                ">

                                <i class="bi bi-chat-left-text-fill"></i>

                            </div>

                            <div>

                                <h5 class="fw-bold mb-0">
                                    Observaciones
                                </h5>

                                <small class="text-muted">
                                    Información adicional del cliente
                                </small>

                            </div>

                        </div>

                    </div>


                    <div class="card-body px-4 pb-4">

                        <label asp-for="Observaciones"
                               class="form-label fw-semibold">

                            Comentarios

                        </label>

                        <textarea asp-for="Observaciones"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Escriba aquí cualquier información adicional..."></textarea>

                        <span asp-validation-for="Observaciones"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

            </div>


            <!-- ACCIONES -->
            <div class="col-12">

                <div class="card border-0 shadow-sm">

                    <div class="card-body px-4 py-3">

                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">

                            <div>

                                <small class="text-muted">

                                    <i class="bi bi-shield-check me-1"></i>

                                    Revise los datos antes de registrar al cliente.

                                </small>

                            </div>


                            <div class="d-flex gap-2">

                                <a asp-action="Index"
                                   class="btn btn-light border px-4">

                                    <i class="bi bi-x-lg me-1"></i>
                                    Cancelar

                                </a>


                                <button type="submit"
                                        class="btn btn-primary px-4">

                                    <i class="bi bi-person-plus-fill me-1"></i>

                                    Registrar cliente

                                </button>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
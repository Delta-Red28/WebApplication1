@model IEnumerable<WebApplication1.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<style>
         /*   ENCABEZADO DEL MÓDULO */

    .clientes-header {
        background: linear-gradient(135deg, #671f1b, #8f2923);
        border-radius: 18px;
        padding: 25px 30px;
        color: white;
        margin-bottom: 25px;
        box-shadow: 0 8px 25px rgba(103, 31, 27, 0.18);
    }

        .clientes-header h2 {
            font-family: Georgia, serif;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .clientes-header p {
            color: #f4dca6;
            margin-bottom: 0;
        }

    .clientes-header-icon {
        width: 58px;
        height: 58px;
        border-radius: 15px;
        background: #d9a441;
        color: #671f1b;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
    }


          /*  TARJETA TOTAL */
      
    .clientes-total {
        background: #fffaf3;
        border: 1px solid #eadfd5;
        border-radius: 15px;
        padding: 12px 18px;
        min-width: 145px;
        text-align: center;
    }

        .clientes-total small {
            display: block;
            color: #8a7770;
            font-size: 12px;
        }

        .clientes-total strong {
            display: block;
            color: #671f1b;
            font-size: 24px;
            line-height: 1.2;
        }


    /*BOTON NUEVO CLIENTE */

    .btn-nuevo-cliente {
        background: #d9a441;
        border: none;
        color: #671f1b;
        font-weight: 700;
        border-radius: 11px;
        padding: 10px 17px;
        transition: all 0.25s ease;
    }

        .btn-nuevo-cliente:hover {
            background: #c89332;
            color: #671f1b;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(217, 164, 65, 0.3);
        }


    /*TARJETA PRINCIPAL */

    .clientes-card {
        border: none;
        border-radius: 18px;
        background: #fffaf3;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.07);
        overflow: hidden;
    }

    .clientes-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #eadfd5;
        background: #fffaf3;
    }


    /*BUSCADOR*/

    .buscador-group {
        border: 1px solid #e2d5c9;
        border-radius: 11px;
        overflow: hidden;
        background: white;
        transition: all 0.25s ease;
    }

        .buscador-group:focus-within {
            border-color: #a52a24;
            box-shadow: 0 0 0 3px rgba(165, 42, 36, 0.10);
        }

    .buscador-icon {
        border: none;
        background: transparent;
        color: #9b6b2f;
    }

    .buscador-input {
        border: none !important;
        box-shadow: none !important;
        height: 46px;
    }

    .btn-buscar {
        height: 46px;
        border-radius: 10px;
        border-color: #8f2923;
        color: #8f2923;
        font-weight: 600;
    }

        .btn-buscar:hover {
            background: #8f2923;
            border-color: #8f2923;
            color: white;
        }

    .btn-limpiar {
        height: 46px;
        border-radius: 10px;
        font-weight: 600;
    }


    /*TABLA */

    .clientes-table {
        margin-bottom: 0;
    }

        .clientes-table thead th {
            background: #f7eee5;
            color: #5c4138;
            border-bottom: 1px solid #e2d5c9;
            font-size: 13px;
            font-weight: 700;
            padding: 15px 14px;
            white-space: nowrap;
        }

        .clientes-table tbody td {
            padding: 15px 14px;
            color: #5b4b45;
            border-color: #eee4dc;
            vertical-align: middle;
        }

        .clientes-table tbody tr {
            transition: background-color 0.2s ease;
        }

            .clientes-table tbody tr:hover {
                background: #fff8f0;
            }


    /* CLIENTE*/

    .cliente-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .cliente-avatar {
        width: 42px;
        height: 42px;
        min-width: 42px;
        border-radius: 50%;
        background: #f1dfb5;
        color: #671f1b;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .cliente-nombre {
        color: #3e2723;
        font-weight: 700;
        line-height: 1.3;
    }

    .cliente-label {
        color: #9a8981;
        font-size: 11px;
    }


    /*DATOS CLIENTE */

    .dato-cliente {
        display: flex;
        align-items: center;
        gap: 7px;
    }

        .dato-cliente i {
            color: #b18438;
            font-size: 14px;
        }


    /* ESTADOS */

    .estado-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .estado-activo {
        background: #dff3e5;
        color: #28753d;
    }

    .estado-inactivo {
        background: #f8dfdc;
        color: #8a2d27;
    }


    /*FECHA*/

    .fecha-registro {
        font-size: 13px;
        color: #74635d;
    }


    /*ACCIONES */

    .acciones .btn {
        border-radius: 8px !important;
        margin: 0 2px;
    }

    .btn-outline-info {
        color: #7a5c26;
        border-color: #d9b66b;
    }

        .btn-outline-info:hover {
            background: #d9a441;
            border-color: #d9a441;
            color: #671f1b;
        }


    /* SIN CLIENTES */

    .sin-clientes {
        padding: 60px 20px;
        text-align: center;
    }

    .sin-clientes-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 18px;
        border-radius: 50%;
        background: #f3e8df;
        color: #a98d7d;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 34px;
    }

    .sin-clientes h5 {
        color: #4e342e;
        font-weight: 700;
    }

    .sin-clientes p {
        color: #8a7770;
    }


    /* ALERTAS */

    .alert {
        border: none;
        border-radius: 12px;
    }

    .alert-success {
        background: #e2f2e7;
        color: #28643a;
    }

    .alert-danger {
        background: #f8dfdc;
        color: #7a211c;
    }


    /*RESPONSIVE */

    @@media (max-width: 768px) {

        .clientes-header {
            padding: 20px;
        }

        .clientes-header-content {
            flex-direction: column;
            align-items: flex-start !important;
            gap: 18px;
        }

        .clientes-header-actions {
            width: 100%;
        }

        .clientes-total {
            width: 100%;
        }
    }

</style>


<div class="container-fluid">


    <!--ENCABEZADO -->

    <div class="clientes-header">

        <div class="clientes-header-content d-flex justify-content-between align-items-center">


            <!-- TITULO -->

            <div class="d-flex align-items-center gap-3">

                <div class="clientes-header-icon">

                    <i class="bi bi-people-fill"></i>

                </div>


                <div>

                    <h2>
                        Clientes
                    </h2>

                    <p>
                        Conoce y administra los clientes de tu restaurante
                    </p>

                </div>

            </div>


            <!-- ACCIONES -->

            <div class="clientes-header-actions d-flex align-items-center gap-3">


                <!-- TOTAL -->

                <div class="clientes-total">

                    <small>
                        Clientes registrados
                    </small>

                    <strong>
                        @Model.Count()
                    </strong>

                </div>


                <!-- NUEVO -->
                @if (User.IsInRole("Administrador") ||
                                     User.IsInRole("Gerente"))
                {
                    <a asp-action="Create"
                       class="btn btn-nuevo-cliente">

                        <i class="bi bi-person-plus-fill me-1"></i>

                        Nuevo cliente

                    </a>
                }

            </div>

        </div>

    </div>


    <!--MENSAJE-->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Mensaje"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ERROR-->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!--TARJETA CLIENTES-->

    <div class="card clientes-card">


        <!-- BUSCADOR -->

        <div class="clientes-card-header">

            <div class="row g-2">


                <div class="col-lg-8 col-md-7">

                    <form asp-action="Index"
                          method="get">

                        <div class="input-group buscador-group">

                            <span class="input-group-text buscador-icon">

                                <i class="bi bi-search"></i>

                            </span>

                            <input type="text"
                                   name="buscar"
                                   value="@ViewBag.Buscar"
                                   class="form-control buscador-input"
                                   placeholder="Buscar cliente por nombre, cédula, teléfono o correo..." />

                        </div>

                    </form>

                </div>


                <div class="col-lg-2 col-md-2">

                    <form asp-action="Index"
                          method="get">

                        <input type="hidden"
                               name="buscar"
                               value="@ViewBag.Buscar" />

                        <button type="submit"
                                class="btn btn-outline-primary btn-buscar w-100">

                            <i class="bi bi-search me-1"></i>

                            Buscar

                        </button>

                    </form>

                </div>


                <div class="col-lg-2 col-md-3">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary btn-limpiar w-100">

                        <i class="bi bi-arrow-clockwise me-1"></i>

                        Limpiar

                    </a>

                </div>

            </div>

        </div>


        <!--CONTENIDO-->

        <div class="card-body p-0">


            @if (!Model.Any())
            {

                <!-- SIN CLIENTES -->

                <div class="sin-clientes">

                    <div class="sin-clientes-icon">

                        <i class="bi bi-person-x"></i>

                    </div>


                    <h5>
                        No se encontraron clientes
                    </h5>


                    <p class="mb-0">
                        No existen clientes que coincidan con la búsqueda.
                    </p>

                </div>

            }
            else
            {

                <!--TABLA -->

                <div class="table-responsive">

                    <table class="table clientes-table align-middle">


                        <thead>

                            <tr>

                                <th>
                                    Cliente
                                </th>

                                <th>
                                    Cédula
                                </th>

                                <th>
                                    Teléfono
                                </th>

                                <th>
                                    Correo
                                </th>

                                <th>
                                    Estado
                                </th>

                                <th>
                                    Cliente desde
                                </th>

                                <th class="text-center">
                                    Acciones
                                </th>

                            </tr>

                        </thead>


                        <tbody>


                            @foreach (var cliente in Model)
                            {

                                <tr>


                                    <!--CLIENTE -->

                                    <td>

                                        <div class="cliente-info">


                                            <div class="cliente-avatar">

                                                <i class="bi bi-person-fill"></i>

                                            </div>


                                            <div>

                                                <div class="cliente-nombre">

                                                    @cliente.Nombres
                                                    @cliente.Apellidos

                                                </div>

                                                <div class="cliente-label">
                                                    Cliente del restaurante
                                                </div>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- CEDULA-->

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(cliente.Cedula))
                                        {

                                            <div class="dato-cliente">

                                                <i class="bi bi-card-text"></i>

                                                @cliente.Cedula

                                            </div>

                                        }
                                        else
                                        {

                                            <span class="text-muted">
                                                No registrada
                                            </span>

                                        }

                                    </td>


                                    <!--TELEFONO-->

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(cliente.Telefono))
                                        {

                                            <div class="dato-cliente">

                                                <i class="bi bi-telephone-fill"></i>

                                                @cliente.Telefono

                                            </div>

                                        }
                                        else
                                        {

                                            <span class="text-muted">
                                                No registrado
                                            </span>

                                        }

                                    </td>


                                    <!-- CORREO -->

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(cliente.Correo))
                                        {

                                            <div class="dato-cliente">

                                                <i class="bi bi-envelope-fill"></i>

                                                @cliente.Correo

                                            </div>

                                        }
                                        else
                                        {

                                            <span class="text-muted">
                                                No registrado
                                            </span>

                                        }

                                    </td>


                                    <!-- ESTADO-->

                                    <td>

                                        @if (cliente.Estado)
                                        {

                                            <span class="estado-badge estado-activo">

                                                <i class="bi bi-check-circle-fill"></i>

                                                Activo

                                            </span>

                                        }
                                        else
                                        {

                                            <span class="estado-badge estado-inactivo">

                                                <i class="bi bi-x-circle-fill"></i>

                                                Inactivo

                                            </span>

                                        }

                                    </td>


                                    <!--FECHA-->

                                    <td>

                                        <span class="fecha-registro">

                                            <i class="bi bi-calendar3 me-1"></i>

                                            @cliente.FechaRegistro.ToString("dd/MM/yyyy")

                                        </span>

                                    </td>


                                    <!-- ACCIONES -->

                                    <td class="text-center acciones">


                                        <!-- VER -->

                                        <a asp-action="Details"
                                           asp-route-id="@cliente.IdCliente"
                                           class="btn btn-sm btn-outline-info"
                                           title="Ver información del cliente">

                                            <i class="bi bi-eye"></i>

                                        </a>


                                        <!-- EDITAR -->
                                        @if (User.IsInRole("Administrador") ||
                                                                                     User.IsInRole("Gerente"))
                                        {

                                            <a asp-action="Edit"
                                               asp-route-id="@cliente.IdCliente"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Editar cliente">

                                                <i class="bi bi-pencil"></i>

                                            </a>

                                        }


                                        <!-- ACTIVAR / DESACTIVAR -->
                                        @if (User.IsInRole("Administrador") ||
                                                                                     User.IsInRole("Gerente"))
                                        {

                                            @if (cliente.Estado)
                                            {

                                                <form asp-action="Desactivar"
                                                      asp-route-id="@cliente.IdCliente"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('¿Está seguro de desactivar este cliente?');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Desactivar cliente">

                                                        <i class="bi bi-person-x"></i>

                                                    </button>

                                                </form>

                                            }
                                            else
                                            {

                                                <form asp-action="Activar"
                                                      asp-route-id="@cliente.IdCliente"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('¿Desea activar este cliente?');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success"
                                                            title="Activar cliente">

                                                        <i class="bi bi-person-check"></i>

                                                    </button>

                                                </form>

                                            }

                                        }

                                    </td>


                                </tr>

                            }


                        </tbody>

                    </table>

                </div>

            }

        </div>

    </div>


</div>
@model IEnumerable<WebApplication1.Models.Pedido>

@{
    ViewData["Title"] = "Cocina";

    var pedidos =
        Model?.ToList()
        ?? new List<WebApplication1.Models.Pedido>();

    var pendientes =
        pedidos
            .Where(p =>
                p.IdEstadoPedido == 1)
            .ToList();

    var enCocina =
        pedidos
            .Where(p =>
                p.IdEstadoPedido == 2)
            .ToList();

    var preparandose =
        pedidos
            .Where(p =>
                p.IdEstadoPedido == 3)
            .ToList();

    var listos =
        pedidos
            .Where(p =>
                p.IdEstadoPedido == 4)
            .ToList();
}


<div class="container-fluid py-4">

    <!-- ========================================================= -->
    <!-- ENCABEZADO -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-fire me-2"></i>

                Cocina

            </h2>

            <p class="text-muted mb-0">

                Gestión de pedidos en preparación.

            </p>

        </div>

        <a asp-controller="Pedido"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>

            Ver pedidos

        </a>

    </div>


    <!-- ========================================================= -->
    <!-- MENSAJES -->
    <!-- ========================================================= -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["Mensaje"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="bi bi-exclamation-triangle me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ========================================================= -->
    <!-- TABLERO -->
    <!-- ========================================================= -->

    <div class="row g-3">


        <!-- ===================================================== -->
        <!-- PENDIENTES -->
        <!-- ===================================================== -->

        <div class="col-xl-3 col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-warning text-dark">

                    <div class="d-flex justify-content-between">

                        <span class="fw-bold">

                            <i class="bi bi-hourglass-split me-2"></i>

                            Pendientes

                        </span>

                        <span class="badge bg-dark">

                            @pendientes.Count

                        </span>

                    </div>

                </div>

                <div class="card-body">

                    @if (!pendientes.Any())
                    {
                        <div class="text-center text-muted py-4">

                            <i class="bi bi-check-circle display-6"></i>

                            <p class="mb-0 mt-2">
                                No hay pedidos pendientes.
                            </p>

                        </div>
                    }

                    @foreach (var pedido in pendientes)
                    {
                        <div class="card border mb-3">

                            <div class="card-body">

                                <div class="d-flex justify-content-between mb-2">

                                    <strong>
                                        @pedido.NumeroPedido
                                    </strong>

                                    <span class="badge bg-warning text-dark">
                                        Pendiente
                                    </span>

                                </div>

                                <div class="small text-muted mb-2">

                                    <i class="bi bi-person me-1"></i>

                                    @pedido.IdClienteNavigation?.Nombres
                                    @pedido.IdClienteNavigation?.Apellidos

                                </div>

                                @if (pedido.IdMesaNavigation != null)
                                {
                                    <div class="small mb-2">

                                        <i class="bi bi-grid me-1"></i>

                                        Mesa @pedido.IdMesaNavigation.NumeroMesa

                                    </div>
                                }


                                <hr />


                                <div class="small">

                                    @foreach (var detalle in pedido.DetallePedidos)
                                    {
                                        <div class="d-flex justify-content-between mb-1">

                                            <span>

                                                <strong>
                                                    @detalle.Cantidad
                                                </strong>

                                                ×

                                                @detalle.IdProductoNavigation?.Nombre

                                            </span>

                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(
                                            detalle.Observacion))
                                        {
                                            <div class="text-muted mb-2">

                                                <i class="bi bi-chat-left-text me-1"></i>

                                                @detalle.Observacion

                                            </div>
                                        }
                                    }

                                </div>


                                <form asp-action="EnviarACocina"
                                      method="post"
                                      class="mt-3">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@pedido.IdPedido" />

                                    <button type="submit"
                                            class="btn btn-primary w-100">

                                        <i class="bi bi-fire me-1"></i>

                                        Enviar a cocina

                                    </button>

                                </form>

                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- EN COCINA -->
        <!-- ===================================================== -->

        <div class="col-xl-3 col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-primary text-white">

                    <div class="d-flex justify-content-between">

                        <span class="fw-bold">

                            <i class="bi bi-fire me-2"></i>

                            En cocina

                        </span>

                        <span class="badge bg-light text-dark">

                            @enCocina.Count

                        </span>

                    </div>

                </div>

                <div class="card-body">

                    @if (!enCocina.Any())
                    {
                        <div class="text-center text-muted py-4">

                            <i class="bi bi-emoji-smile display-6"></i>

                            <p class="mb-0 mt-2">
                                No hay pedidos en cocina.
                            </p>

                        </div>
                    }

                    @foreach (var pedido in enCocina)
                    {
                        <div class="card border mb-3">

                            <div class="card-body">

                                <div class="d-flex justify-content-between mb-2">

                                    <strong>
                                        @pedido.NumeroPedido
                                    </strong>

                                    <span class="badge bg-primary">
                                        En cocina
                                    </span>

                                </div>

                                @if (pedido.IdMesaNavigation != null)
                                {
                                    <div class="small mb-2">

                                        <i class="bi bi-grid me-1"></i>

                                        Mesa @pedido.IdMesaNavigation.NumeroMesa

                                    </div>
                                }

                                <hr />

                                @foreach (var detalle in pedido.DetallePedidos)
                                {
                                    <div class="mb-2">

                                        <strong>
                                            @detalle.Cantidad ×
                                        </strong>

                                        @detalle.IdProductoNavigation?.Nombre

                                        @if (!string.IsNullOrWhiteSpace(
                                            detalle.Observacion))
                                        {
                                            <div class="small text-muted">

                                                @detalle.Observacion

                                            </div>
                                        }

                                    </div>
                                }


                                <form asp-action="ComenzarPreparacion"
                                      method="post"
                                      class="mt-3">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@pedido.IdPedido" />

                                    <button type="submit"
                                            class="btn btn-warning w-100">

                                        <i class="bi bi-play-circle me-1"></i>

                                        Comenzar preparación

                                    </button>

                                </form>

                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- PREPARÁNDOSE -->
        <!-- ===================================================== -->

        <div class="col-xl-3 col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-warning text-dark">

                    <div class="d-flex justify-content-between">

                        <span class="fw-bold">

                            <i class="bi bi-gear-wide-connected me-2"></i>

                            Preparándose

                        </span>

                        <span class="badge bg-dark">

                            @preparandose.Count

                        </span>

                    </div>

                </div>

                <div class="card-body">

                    @if (!preparandose.Any())
                    {
                        <div class="text-center text-muted py-4">

                            <i class="bi bi-cup-hot display-6"></i>

                            <p class="mb-0 mt-2">
                                No hay pedidos preparándose.
                            </p>

                        </div>
                    }

                    @foreach (var pedido in preparandose)
                    {
                        <div class="card border mb-3">

                            <div class="card-body">

                                <div class="d-flex justify-content-between mb-2">

                                    <strong>
                                        @pedido.NumeroPedido
                                    </strong>

                                    <span class="badge bg-warning text-dark">
                                        Preparándose
                                    </span>

                                </div>

                                @if (pedido.IdMesaNavigation != null)
                                {
                                    <div class="small mb-2">

                                        <i class="bi bi-grid me-1"></i>

                                        Mesa @pedido.IdMesaNavigation.NumeroMesa

                                    </div>
                                }

                                <hr />

                                @foreach (var detalle in pedido.DetallePedidos)
                                {
                                    <div class="mb-2">

                                        <strong>
                                            @detalle.Cantidad ×
                                        </strong>

                                        @detalle.IdProductoNavigation?.Nombre

                                        @if (!string.IsNullOrWhiteSpace(
                                            detalle.Observacion))
                                        {
                                            <div class="small text-muted">

                                                @detalle.Observacion

                                            </div>
                                        }

                                    </div>
                                }


                                <form asp-action="MarcarListo"
                                      method="post"
                                      class="mt-3">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@pedido.IdPedido" />

                                    <button type="submit"
                                            class="btn btn-success w-100">

                                        <i class="bi bi-check-circle me-1"></i>

                                        Marcar como listo

                                    </button>

                                </form>

                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- LISTOS -->
        <!-- ===================================================== -->

        <div class="col-xl-3 col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-success text-white">

                    <div class="d-flex justify-content-between">

                        <span class="fw-bold">

                            <i class="bi bi-check-circle me-2"></i>

                            Listos

                        </span>

                        <span class="badge bg-light text-dark">

                            @listos.Count

                        </span>

                    </div>

                </div>

                <div class="card-body">

                    @if (!listos.Any())
                    {
                        <div class="text-center text-muted py-4">

                            <i class="bi bi-check2-all display-6"></i>

                            <p class="mb-0 mt-2">
                                No hay pedidos listos.
                            </p>

                        </div>
                    }

                    @foreach (var pedido in listos)
                    {
                        <div class="card border border-success mb-3">

                            <div class="card-body">

                                <div class="d-flex justify-content-between mb-2">

                                    <strong>
                                        @pedido.NumeroPedido
                                    </strong>

                                    <span class="badge bg-success">
                                        LISTO
                                    </span>

                                </div>

                                @if (pedido.IdMesaNavigation != null)
                                {
                                    <div class="small mb-2">

                                        <i class="bi bi-grid me-1"></i>

                                        Mesa @pedido.IdMesaNavigation.NumeroMesa

                                    </div>
                                }

                                <hr />

                                @foreach (var detalle in pedido.DetallePedidos)
                                {
                                    <div class="mb-2">

                                        <strong>
                                            @detalle.Cantidad ×
                                        </strong>

                                        @detalle.IdProductoNavigation?.Nombre

                                    </div>
                                }

                                <div class="alert alert-success small mb-0 mt-3">

                                    <i class="bi bi-info-circle me-1"></i>

                                    Listo para entregar.

                                </div>

                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>
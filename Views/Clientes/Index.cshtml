@model IEnumerable<WebApplication1.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";

    var clientes = Model?.ToList()
        ?? new List<WebApplication1.Models.Cliente>();

    var activos = clientes
        .Where(c => c.Estado)
        .ToList();

    var inactivos = clientes
        .Where(c => !c.Estado)
        .ToList();

}

<div class="container-fluid py-4">
    <!-- ========================================================= -->
    <!-- ENCABEZADO -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-people me-2"></i>

                Clientes

            </h2>

            <p class="text-muted mb-0">

                Gestión y consulta de clientes registrados.

            </p>

        </div>

        @if (User.IsInRole("Administrador") || User.IsInRole("Gerente"))
        {
            <a asp-controller="Clientes"
               asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-person-plus me-1"></i>

                Nuevo cliente

            </a>
        }

    </div>

    <!-- ========================================================= -->
    <!-- MENSAJES -->
    <!-- ========================================================= -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["Mensaje"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="bi bi-exclamation-triangle me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <!-- ========================================================= -->
    <!-- BUSCADOR -->
    <!-- ========================================================= -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form asp-controller="Clientes"
                  asp-action="Index"
                  method="get">

                <div class="row g-2 align-items-end">

                    <div class="col-md-10">

                        <label for="buscar"
                               class="form-label fw-semibold">

                            Buscar cliente

                        </label>

                        <div class="input-group">

                            <span class="input-group-text">

                                <i class="bi bi-search"></i>

                            </span>

                            <input type="text"
                                   id="buscar"
                                   name="buscar"
                                   value="@ViewBag.Buscar"
                                   class="form-control"
                                   placeholder="Nombre, apellido, cédula, teléfono o correo..." />

                        </div>

                    </div>

                    <div class="col-md-2 d-grid">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-search me-1"></i>

                            Buscar

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- ========================================================= -->
    <!-- RESUMEN -->
    <!-- ========================================================= -->

    <div class="row g-3 mb-4">

        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="bg-primary bg-opacity-10
                            text-primary rounded-circle
                            p-3 me-3">

                            <i class="bi bi-people fs-4"></i>

                        </div>

                        <div>

                            <div class="text-muted small">
                                Total de clientes
                            </div>

                            <h3 class="fw-bold mb-0">
                                @clientes.Count
                            </h3>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="bg-success bg-opacity-10
                            text-success rounded-circle
                            p-3 me-3">

                            <i class="bi bi-person-check fs-4"></i>

                        </div>

                        <div>

                            <div class="text-muted small">
                                Clientes activos
                            </div>

                            <h3 class="fw-bold mb-0">
                                @activos.Count
                            </h3>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="bg-danger bg-opacity-10
                            text-danger rounded-circle
                            p-3 me-3">

                            <i class="bi bi-person-x fs-4"></i>

                        </div>

                        <div>

                            <div class="text-muted small">
                                Clientes inactivos
                            </div>

                            <h3 class="fw-bold mb-0">
                                @inactivos.Count
                            </h3>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- ========================================================= -->
    <!-- LISTA DE CLIENTES -->
    <!-- ========================================================= -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="fw-bold mb-0">

                    <i class="bi bi-person-lines-fill me-2"></i>

                    Lista de clientes

                </h5>

                <span class="badge bg-primary">

                    @clientes.Count

                </span>

            </div>

        </div>

        <div class="card-body p-0">

            @if (!clientes.Any())
            {
                <div class="text-center text-muted py-5">

                    <i class="bi bi-people display-4"></i>

                    <p class="mb-0 mt-3">

                        No se encontraron clientes.

                    </p>

                    @if (!string.IsNullOrWhiteSpace(
                        ViewBag.Buscar as string))
                    {
                        <p class="small mt-2">

                            Intenta realizar una búsqueda diferente.

                        </p>
                    }

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Cliente
                                </th>

                                <th>
                                    Cédula
                                </th>

                                <th>
                                    Teléfono
                                </th>

                                <th>
                                    Correo
                                </th>

                                <th>
                                    Sexo
                                </th>

                                <th>
                                    Estado
                                </th>

                                <th class="text-end">
                                    Acciones
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var cliente in clientes)
                            {
                                <tr>

                                    <!-- CLIENTE -->

                                    <td>

                                        <div class="d-flex align-items-center">

                                            <div class="bg-primary bg-opacity-10
                                                text-primary rounded-circle
                                                d-flex align-items-center
                                                justify-content-center
                                                me-3"
                                                 style="width: 42px; height: 42px;">

                                                <i class="bi bi-person"></i>

                                            </div>

                                            <div>

                                                <div class="fw-semibold">

                                                    @cliente.Nombres
                                                    @cliente.Apellidos

                                                </div>

                                                @if (cliente.FechaNacimiento.HasValue)
                                                {
                                                    <div class="small text-muted">

                                                        <i class="bi bi-calendar3 me-1"></i>

                                                        @cliente.FechaNacimiento.Value.ToString("dd/MM/yyyy")

                                                    </div>
                                                }

                                            </div>

                                        </div>

                                    </td>

                                    <!-- CÉDULA -->

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(cliente.Cedula))
                                        {
                                            @cliente.Cedula
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No registrada
                                            </span>
                                        }

                                    </td>

                                    <!-- TELÉFONO -->

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(cliente.Telefono))
                                        {
                                            <span>

                                                <i class="bi bi-telephone me-1"></i>

                                                @cliente.Telefono

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No registrado
                                            </span>
                                        }

                                    </td>

                                    <!-- CORREO -->

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(cliente.Correo))
                                        {
                                            <span>

                                                <i class="bi bi-envelope me-1"></i>

                                                @cliente.Correo

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No registrado
                                            </span>
                                        }

                                    </td>

                                    <!-- SEXO -->

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(cliente.Sexo))
                                        {
                                            @cliente.Sexo
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>

                                    <!-- ESTADO -->

                                    <td>

                                        @if (cliente.Estado)
                                        {
                                            <span class="badge bg-success">

                                                <i class="bi bi-check-circle me-1"></i>

                                                Activo

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">

                                                <i class="bi bi-x-circle me-1"></i>

                                                Inactivo

                                            </span>
                                        }

                                    </td>

                                    <!-- ACCIONES -->

                                    <td class="text-end">

                                        <div class="btn-group"
                                             role="group">

                                            <!-- VER -->

                                            <a asp-controller="Clientes"
                                               asp-action="Details"
                                               asp-route-id="@cliente.IdCliente"
                                               class="btn btn-sm btn-outline-info"
                                               title="Ver detalles">

                                                <i class="bi bi-eye"></i>

                                            </a>

                                            <!-- EDITAR -->
                                            @if (User.IsInRole("Administrador") ||
                                                                                         User.IsInRole("Gerente"))
                                            {
                                                <a asp-controller="Clientes"
                                                   asp-action="Edit"
                                                   asp-route-id="@cliente.IdCliente"
                                                   class="btn btn-sm btn-outline-primary"
                                                   title="Editar">

                                                    <i class="bi bi-pencil"></i>

                                                </a>

                                                <!-- ACTIVAR / DESACTIVAR -->
                                                @if (cliente.Estado)
                                                {
                                                    <form asp-controller="Clientes"
                                                          asp-action="Desactivar"
                                                          asp-route-id="@cliente.IdCliente"
                                                          method="post"
                                                          class="d-inline">

                                                        @Html.AntiForgeryToken()

                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-danger"
                                                                title="Desactivar"
                                                                onclick="return confirm('¿Deseas desactivar este cliente?');">

                                                            <i class="bi bi-person-x"></i>

                                                        </button>

                                                    </form>
                                                }
                                                else
                                                {
                                                    <form asp-controller="Clientes"
                                                          asp-action="Activar"
                                                          asp-route-id="@cliente.IdCliente"
                                                          method="post"
                                                          class="d-inline">

                                                        @Html.AntiForgeryToken()

                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-success"
                                                                title="Activar"
                                                                onclick="return confirm('¿Deseas activar este cliente?');">

                                                            <i class="bi bi-person-check"></i>

                                                        </button>

                                                    </form>
                                                }
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>
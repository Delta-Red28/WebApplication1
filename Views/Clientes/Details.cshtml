@model WebApplication1.Models.Cliente

@{
    ViewData["Title"] = "Detalles del cliente";

    string iniciales = "";

    if (!string.IsNullOrWhiteSpace(Model.Nombres))
    {
        iniciales += Model.Nombres.Substring(0, 1).ToUpper();
    }

    if (!string.IsNullOrWhiteSpace(Model.Apellidos))
    {
        iniciales += Model.Apellidos.Substring(0, 1).ToUpper();
    }

    bool puedeEditar =
        User.IsInRole("Administrador") ||
        User.IsInRole("Gerente");
}

<div class="container-fluid px-4 py-3">

    <!-- ENCABEZADO -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div class="d-flex align-items-center gap-3">

            <!-- AVATAR -->
            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm"
                 style="
                width: 58px;
                height: 58px;
                background: #e8f0fe;
                color: #0d6efd;
                font-size: 1.25rem;
                ">

                @iniciales

            </div>

            <div>

                <div class="d-flex align-items-center gap-2 flex-wrap">

                    <h2 class="fw-bold mb-0">
                        @Model.Nombres @Model.Apellidos
                    </h2>

                    @if (Model.Estado)
                    {
                        <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">

                            <i class="bi bi-circle-fill"
                               style="font-size: 7px; vertical-align: middle;">
                            </i>

                            Activo

                        </span>
                    }
                    else
                    {
                        <span class="badge rounded-pill bg-danger-subtle text-danger px-3 py-2">

                            <i class="bi bi-circle-fill"
                               style="font-size: 7px; vertical-align: middle;">
                            </i>

                            Inactivo

                        </span>
                    }

                </div>

                <p class="text-muted mb-0 mt-1">
                    <i class="bi bi-person-vcard me-1"></i>
                    Información y datos del cliente
                </p>

            </div>

        </div>


        <!-- BOTONES -->
        <div class="d-flex gap-2">

            @if (puedeEditar)
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.IdCliente"
                   class="btn btn-primary px-4">

                    <i class="bi bi-pencil me-1"></i>
                    Editar cliente

                </a>
            }

            <a asp-action="Index"
               class="btn btn-light border px-4">

                <i class="bi bi-arrow-left me-1"></i>
                Volver

            </a>

        </div>

    </div>


    <!-- INFORMACIÓN DE CONTACTO -->
    <div class="row g-3 mb-4">

        <!-- TELÉFONO -->
        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="rounded-3 d-flex align-items-center justify-content-center me-3"
                         style="
                        width: 45px;
                        height: 45px;
                        background: #e8f7ee;
                        color: #198754;
                        ">

                        <i class="bi bi-telephone-fill fs-5"></i>

                    </div>

                    <div>

                        <small class="text-muted d-block">
                            Teléfono
                        </small>

                        @if (!string.IsNullOrWhiteSpace(Model.Telefono))
                        {
                            <span class="fw-semibold">
                                @Model.Telefono
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">
                                No registrado
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>


        <!-- CORREO -->
        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="rounded-3 d-flex align-items-center justify-content-center me-3"
                         style="
                        width: 45px;
                        height: 45px;
                        background: #eef2ff;
                        color: #4f46e5;
                        ">

                        <i class="bi bi-envelope-fill fs-5"></i>

                    </div>

                    <div class="text-truncate">

                        <small class="text-muted d-block">
                            Correo electrónico
                        </small>

                        @if (!string.IsNullOrWhiteSpace(Model.Correo))
                        {
                            <span class="fw-semibold">
                                @Model.Correo
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">
                                No registrado
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>


        <!-- FECHA REGISTRO -->
        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="rounded-3 d-flex align-items-center justify-content-center me-3"
                         style="
                        width: 45px;
                        height: 45px;
                        background: #fff4e5;
                        color: #fd7e14;
                        ">

                        <i class="bi bi-calendar-check-fill fs-5"></i>

                    </div>

                    <div>

                        <small class="text-muted d-block">
                            Cliente desde
                        </small>

                        <span class="fw-semibold">
                            @Model.FechaRegistro.ToString("dd/MM/yyyy")
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- INFORMACIÓN PRINCIPAL -->
    <div class="row g-4">

        <!-- INFORMACIÓN PERSONAL -->
        <div class="col-lg-7">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex align-items-center">

                        <div class="rounded-3 d-flex align-items-center justify-content-center me-3"
                             style="
                            width: 40px;
                            height: 40px;
                            background: #e8f0fe;
                            color: #0d6efd;
                            ">

                            <i class="bi bi-person-fill"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-0">
                                Información personal
                            </h5>

                            <small class="text-muted">
                                Datos generales del cliente
                            </small>

                        </div>

                    </div>

                </div>


                <div class="card-body px-4">

                    <div class="row g-4">

                        <!-- NOMBRES -->
                        <div class="col-md-6">

                            <small class="text-muted d-block mb-1">
                                <i class="bi bi-person me-1"></i>
                                Nombres
                            </small>

                            <div class="fw-semibold">
                                @Model.Nombres
                            </div>

                        </div>


                        <!-- APELLIDOS -->
                        <div class="col-md-6">

                            <small class="text-muted d-block mb-1">
                                <i class="bi bi-person me-1"></i>
                                Apellidos
                            </small>

                            <div class="fw-semibold">
                                @Model.Apellidos
                            </div>

                        </div>


                        <!-- CÉDULA -->
                        <div class="col-md-6">

                            <small class="text-muted d-block mb-1">
                                <i class="bi bi-card-text me-1"></i>
                                Cédula
                            </small>

                            @if (!string.IsNullOrWhiteSpace(Model.Cedula))
                            {
                                <div class="fw-semibold">
                                    @Model.Cedula
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">
                                    No registrada
                                </span>
                            }

                        </div>


                        <!-- FECHA NACIMIENTO -->
                        <div class="col-md-6">

                            <small class="text-muted d-block mb-1">
                                <i class="bi bi-calendar3 me-1"></i>
                                Fecha de nacimiento
                            </small>

                            @if (Model.FechaNacimiento.HasValue)
                            {
                                <div class="fw-semibold">
                                    @Model.FechaNacimiento.Value.ToString("dd/MM/yyyy")
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">
                                    No registrada
                                </span>
                            }

                        </div>


                        <!-- SEXO -->
                        <div class="col-md-6">

                            <small class="text-muted d-block mb-1">
                                <i class="bi bi-gender-ambiguous me-1"></i>
                                Sexo
                            </small>

                            @if (Model.Sexo == "M")
                            {
                                <div class="fw-semibold">
                                    Masculino
                                </div>
                            }
                            else if (Model.Sexo == "F")
                            {
                                <div class="fw-semibold">
                                    Femenino
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">
                                    No especificado
                                </span>
                            }

                        </div>


                        <!-- DIRECCIÓN -->
                        <div class="col-md-6">

                            <small class="text-muted d-block mb-1">
                                <i class="bi bi-geo-alt me-1"></i>
                                Dirección
                            </small>

                            @if (!string.IsNullOrWhiteSpace(Model.Direccion))
                            {
                                <div class="fw-semibold">
                                    @Model.Direccion
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">
                                    No registrada
                                </span>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ESTADO Y RESUMEN -->
        <div class="col-lg-5">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex align-items-center">

                        <div class="rounded-3 d-flex align-items-center justify-content-center me-3"
                             style="
                            width: 40px;
                            height: 40px;
                            background: #f3eefe;
                            color: #6f42c1;
                            ">

                            <i class="bi bi-info-circle-fill"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-0">
                                Información del cliente
                            </h5>

                            <small class="text-muted">
                                Estado y registro
                            </small>

                        </div>

                    </div>

                </div>


                <div class="card-body px-4">

                    <!-- ESTADO -->
                    <div class="p-3 rounded-3 mb-3"
                         style="background: #f8f9fa;">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <small class="text-muted d-block">
                                    Estado de la cuenta
                                </small>

                                <span class="fw-semibold">
                                    Cliente @(Model.Estado ? "activo" : "inactivo")
                                </span>

                            </div>

                            @if (Model.Estado)
                            {
                                <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">
                                    <i class="bi bi-check-circle me-1"></i>
                                    Activo
                                </span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-danger-subtle text-danger px-3 py-2">
                                    <i class="bi bi-x-circle me-1"></i>
                                    Inactivo
                                </span>
                            }

                        </div>

                    </div>


                    <!-- ID CLIENTE -->
                    <div class="d-flex justify-content-between py-3 border-bottom">

                        <span class="text-muted">
                            ID del cliente
                        </span>

                        <span class="fw-semibold">
                            #@Model.IdCliente
                        </span>

                    </div>


                    <!-- FECHA REGISTRO -->
                    <div class="d-flex justify-content-between py-3">

                        <span class="text-muted">
                            Fecha de registro
                        </span>

                        <span class="fw-semibold">
                            @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- OBSERVACIONES -->
        <div class="col-12">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex align-items-center">

                        <div class="rounded-3 d-flex align-items-center justify-content-center me-3"
                             style="
                            width: 40px;
                            height: 40px;
                            background: #fff4e5;
                            color: #fd7e14;
                            ">

                            <i class="bi bi-chat-left-text-fill"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-0">
                                Observaciones
                            </h5>

                            <small class="text-muted">
                                Notas adicionales sobre el cliente
                            </small>

                        </div>

                    </div>

                </div>


                <div class="card-body px-4 pb-4">

                    @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
                    {
                        <div class="p-3 rounded-3"
                             style="background: #f8f9fa;">

                            <i class="bi bi-quote text-muted me-2"></i>

                            @Model.Observaciones

                        </div>
                    }
                    else
                    {
                        <div class="text-center py-3">

                            <i class="bi bi-chat-square-text text-muted fs-3"></i>

                            <p class="text-muted mb-0 mt-2">
                                No hay observaciones registradas.
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- ACCIONES ADMINISTRATIVAS -->
        @if (puedeEditar)
        {
            <div class="col-12">

                <div class="card border-0 shadow-sm">

                    <div class="card-header bg-white border-0 pt-4 px-4">

                        <div class="d-flex align-items-center">

                            <div class="rounded-3 d-flex align-items-center justify-content-center me-3"
                                 style="
                                width: 40px;
                                height: 40px;
                                background: #f8d7da;
                                color: #dc3545;
                                ">

                                <i class="bi bi-gear-fill"></i>

                            </div>

                            <div>

                                <h5 class="fw-bold mb-0">
                                    Administración
                                </h5>

                                <small class="text-muted">
                                    Acciones disponibles para este cliente
                                </small>

                            </div>

                        </div>

                    </div>


                    <div class="card-body px-4 pb-4">

                        <div class="d-flex flex-wrap gap-2">

                            @if (Model.Estado)
                            {
                                <form asp-action="Desactivar"
                                      asp-route-id="@Model.IdCliente"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-outline-danger"
                                            onclick="return confirm('¿Está seguro de desactivar este cliente?');">

                                        <i class="bi bi-person-x me-1"></i>
                                        Desactivar cliente

                                    </button>

                                </form>
                            }
                            else
                            {
                                <form asp-action="Activar"
                                      asp-route-id="@Model.IdCliente"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-outline-success"
                                            onclick="return confirm('¿Desea activar este cliente?');">

                                        <i class="bi bi-person-check me-1"></i>
                                        Activar cliente

                                    </button>

                                </form>
                            }

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>
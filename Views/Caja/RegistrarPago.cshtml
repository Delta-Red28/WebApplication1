@model WebApplication1.Models.Pago

@{
    ViewData["Title"] = "Registrar Pago en Caja";

    // ============================================================
    // DATOS
    // ============================================================

    var caja =
        ViewBag.Caja as WebApplication1.Models.Caja;

    var tiposMovimiento =
        ViewBag.TiposMovimiento
        as IEnumerable<WebApplication1.Models.TipoMovimientoCaja>
        ?? Enumerable.Empty<WebApplication1.Models.TipoMovimientoCaja>();


    // ============================================================
    // VALORES SEGUROS DEL PAGO
    // ============================================================

    var montoPago =
        Model.Monto;

    var nombreMetodoPago =
        Model.IdMetodoPagoNavigation?.Nombre
        ?? "N/A";

    var nombreMoneda =
        Model.IdMonedaNavigation?.Nombre
        ?? "N/A";

    var nombreEstadoPago =
        Model.IdEstadoPagoNavigation?.Nombre
        ?? "N/A";

    var tieneFactura =
        Model.IdFacturaNavigation != null;


    // ============================================================
    // MONEDA
    // ============================================================

    var textoMoneda =
        nombreMoneda
            .Trim()
            .ToLowerInvariant();

    var esCordoba =
        textoMoneda.Contains("cordoba") ||
        textoMoneda.Contains("córdoba") ||
        textoMoneda.Contains("nio");

    var esDolar =
        textoMoneda.Contains("dolar") ||
        textoMoneda.Contains("dólar") ||
        textoMoneda.Contains("usd");

    var simboloMoneda =
        esCordoba
            ? "C$"
            : esDolar
                ? "US$"
                : "$";

    var culturaMoneda =
        esCordoba
            ? System.Globalization.CultureInfo.GetCultureInfo("es-NI")
            : System.Globalization.CultureInfo.GetCultureInfo("en-US");

    var montoFormateado =
        montoPago.ToString(
            "N2",
            culturaMoneda);


    // ============================================================
    // DATOS DE CAJA
    // ============================================================

    var cajaAbierta =
        caja != null &&
        caja.FechaCierre == null;

    var montoInicialCaja =
        caja?.MontoInicial ?? 0m;

    var totalIngresosCaja =
        caja?.TotalIngresos ?? 0m;

    var totalEgresosCaja =
        caja?.TotalEgresos ?? 0m;

    var totalSistemaCaja =
        caja?.TotalSistema ?? 0m;


    // ============================================================
    // SALDO CALCULADO
    // ============================================================

    var saldoCaja =
        montoInicialCaja
        + totalIngresosCaja
        - totalEgresosCaja;
}


<div class="container-fluid">

    <!-- ========================================================= -->
    <!-- ENCABEZADO -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="mb-1">

                <i class="bi bi-credit-card me-2"></i>

                Registrar Pago en Caja

            </h2>

            <p class="text-muted mb-0">

                Registra un pago existente como movimiento de caja.

            </p>

        </div>


        <div class="d-flex gap-2">

            @if (caja != null)
            {
                <a asp-controller="Caja"
                   asp-action="Movimientos"
                   asp-route-id="@caja.IdCaja"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-left me-1"></i>

                    Volver a movimientos

                </a>
            }

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- MENSAJES -->
    <!-- ========================================================= -->

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ========================================================= -->
    <!-- VALIDACIÓN DE CAJA -->
    <!-- ========================================================= -->

    @if (caja == null)
    {
        <div class="alert alert-danger d-flex align-items-start mb-4"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>

            <div>

                <strong>
                    No se encontró una caja.
                </strong>

                <div class="small mt-1">

                    No es posible registrar el pago porque
                    no se encontró la caja asociada.

                </div>

            </div>

        </div>
    }
    else if (!cajaAbierta)
    {
        <div class="alert alert-warning d-flex align-items-start mb-4"
             role="alert">

            <i class="bi bi-lock-fill fs-4 me-3"></i>

            <div>

                <strong>
                    La caja está cerrada.
                </strong>

                <div class="small mt-1">

                    No puedes registrar nuevos movimientos
                    en una caja cerrada.

                </div>

            </div>

        </div>
    }


    <!-- ========================================================= -->
    <!-- INFORMACIÓN DE LA CAJA -->
    <!-- ========================================================= -->

    @if (caja != null)
    {
        <div class="card shadow-sm border-0 mb-4">

            <!-- HEADER -->

            <div class="card-header bg-white">

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                    <div>

                        <strong>

                            <i class="bi bi-safe2 me-2"></i>

                            Caja #@caja.IdCaja

                        </strong>


                        @if (cajaAbierta)
                        {
                            <span class="badge bg-success ms-2">

                                <i class="bi bi-unlock-fill me-1"></i>

                                Abierta

                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary ms-2">

                                <i class="bi bi-lock-fill me-1"></i>

                                Cerrada

                            </span>
                        }

                    </div>


                    <div class="text-muted">

                        <i class="bi bi-calendar3 me-1"></i>

                        @caja.FechaApertura.ToString(
                            "dd/MM/yyyy HH:mm")

                    </div>

                </div>

            </div>


            <!-- BODY -->

            <div class="card-body">

                <div class="row g-4">

                    <!-- ================================================= -->
                    <!-- MONTO INICIAL -->
                    <!-- ================================================= -->

                    <div class="col-md-6 col-lg-2">

                        <div class="text-muted small mb-1">

                            Monto inicial

                        </div>

                        <div class="fw-semibold">

                            C$
                            @montoInicialCaja.ToString(
                                "N2",
                                System.Globalization.CultureInfo.GetCultureInfo("es-NI"))

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- INGRESOS -->
                    <!-- ================================================= -->

                    <div class="col-md-6 col-lg-2">

                        <div class="text-muted small mb-1">

                            Total ingresos

                        </div>

                        <div class="fw-semibold text-success">

                            C$
                            @totalIngresosCaja.ToString(
                                "N2",
                                System.Globalization.CultureInfo.GetCultureInfo("es-NI"))

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- EGRESOS -->
                    <!-- ================================================= -->

                    <div class="col-md-6 col-lg-2">

                        <div class="text-muted small mb-1">

                            Total egresos

                        </div>

                        <div class="fw-semibold text-danger">

                            C$
                            @totalEgresosCaja.ToString(
                                "N2",
                                System.Globalization.CultureInfo.GetCultureInfo("es-NI"))

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- SALDO -->
                    <!-- ================================================= -->

                    <div class="col-md-6 col-lg-3">

                        <div class="text-muted small mb-1">

                            Saldo calculado

                        </div>

                        <div class="fw-bold fs-5
                            @(saldoCaja >= 0
                                ? "text-primary"
                                : "text-danger")">

                            C$
                            @saldoCaja.ToString(
                                "N2",
                                System.Globalization.CultureInfo.GetCultureInfo("es-NI"))

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- TOTAL SISTEMA -->
                    <!-- ================================================= -->

                    <div class="col-md-6 col-lg-3">

                        <div class="text-muted small mb-1">

                            Total en sistema

                        </div>

                        <div class="fw-bold text-primary fs-5">

                            C$
                            @totalSistemaCaja.ToString(
                                "N2",
                                System.Globalization.CultureInfo.GetCultureInfo("es-NI"))

                        </div>

                    </div>

                </div>

            </div>

        </div>
    }


    <!-- ========================================================= -->
    <!-- INFORMACIÓN DEL PAGO -->
    <!-- ========================================================= -->

    <div class="row g-4">

        <!-- ===================================================== -->
        <!-- DATOS DEL PAGO -->
        <!-- ===================================================== -->

        <div class="col-lg-7">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-white">

                    <h5 class="mb-0">

                        <i class="bi bi-receipt me-2"></i>

                        Información del pago

                    </h5>

                </div>


                <div class="card-body">

                    <!-- ================================================= -->
                    <!-- ID PAGO / FECHA -->
                    <!-- ================================================= -->

                    <div class="row mb-4">

                        <div class="col-md-6">

                            <div class="text-muted small mb-1">

                                Número de pago

                            </div>

                            <div class="fs-5 fw-semibold">

                                <span class="badge bg-primary">

                                    #@Model.IdPago

                                </span>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="text-muted small mb-1">

                                Fecha del pago

                            </div>

                            <div class="fw-semibold">

                                <i class="bi bi-calendar3 me-1"></i>

                                @Model.FechaPago.ToString(
                                    "dd/MM/yyyy HH:mm")

                            </div>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- MONTO -->
                    <!-- ================================================= -->

                    <div class="card bg-success bg-opacity-10 border-success mb-4">

                        <div class="card-body">

                            <div class="text-muted small mb-1">

                                Monto del pago

                            </div>

                            <div class="display-6 fw-bold text-success">

                                @simboloMoneda @montoFormateado

                            </div>

                            <div class="small text-muted mt-1">

                                <i class="bi bi-currency-exchange me-1"></i>

                                @nombreMoneda

                            </div>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- DATOS ADICIONALES -->
                    <!-- ================================================= -->

                    <div class="row g-3">

                        <!-- REFERENCIA -->

                        <div class="col-md-6">

                            <div class="text-muted small mb-1">

                                Referencia

                            </div>

                            <div class="fw-semibold">

                                @if (!string.IsNullOrWhiteSpace(Model.Referencia))
                                {
                                    @Model.Referencia
                                }
                                else
                                {
                                    <span class="text-muted">

                                        Sin referencia

                                    </span>
                                }

                            </div>

                        </div>


                        <!-- MÉTODO DE PAGO -->

                        <div class="col-md-6">

                            <div class="text-muted small mb-1">

                                Método de pago

                            </div>

                            <div class="fw-semibold">

                                <i class="bi bi-credit-card me-1"></i>

                                @nombreMetodoPago

                            </div>

                        </div>


                        <!-- MONEDA -->

                        <div class="col-md-6">

                            <div class="text-muted small mb-1">

                                Moneda

                            </div>

                            <div class="fw-semibold">

                                <span class="badge bg-light text-dark border">

                                    <i class="bi bi-currency-exchange me-1"></i>

                                    @nombreMoneda

                                </span>

                            </div>

                        </div>


                        <!-- ESTADO -->

                        <div class="col-md-6">

                            <div class="text-muted small mb-1">

                                Estado del pago

                            </div>

                            <div>

                                @if (Model.IdEstadoPagoNavigation != null)
                                {
                                    <span class="badge bg-success">

                                        <i class="bi bi-check-circle-fill me-1"></i>

                                        @nombreEstadoPago

                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">

                                        N/A

                                    </span>
                                }

                            </div>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- FACTURA -->
                    <!-- ================================================= -->

                    @if (tieneFactura)
                    {
                        <div class="alert alert-light border mt-4 mb-0">

                            <div class="d-flex align-items-center">

                                <i class="bi bi-file-earmark-text fs-4 me-3"></i>

                                <div>

                                    <div class="text-muted small">

                                        Factura asociada

                                    </div>

                                    <strong>

                                        Factura #@Model.IdFactura

                                    </strong>

                                </div>

                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- FORMULARIO -->
        <!-- ===================================================== -->

        <div class="col-lg-5">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-white">

                    <h5 class="mb-0">

                        <i class="bi bi-plus-circle me-2"></i>

                        Registrar en caja

                    </h5>

                </div>


                <div class="card-body">

                    @if (caja != null && cajaAbierta)
                    {
                        <form asp-controller="Caja"
                              asp-action="RegistrarPago"
                              method="post"
                              id="formRegistrarPago">

                            @Html.AntiForgeryToken()


                            <!-- ================================================= -->
                            <!-- ID CAJA -->
                            <!-- ================================================= -->

                            <input type="hidden"
                                   name="idCaja"
                                   value="@caja.IdCaja" />


                            <!-- ================================================= -->
                            <!-- ID PAGO -->
                            <!-- ================================================= -->

                            <input type="hidden"
                                   name="idPago"
                                   value="@Model.IdPago" />


                            <!-- ================================================= -->
                            <!-- TIPO DE MOVIMIENTO -->
                            <!-- ================================================= -->

                            <div class="mb-4">

                                <label for="idTipoMovimiento"
                                       class="form-label fw-semibold">

                                    <i class="bi bi-arrow-left-right me-1"></i>

                                    Tipo de movimiento

                                </label>


                                <select id="idTipoMovimiento"
                                        name="idTipoMovimiento"
                                        class="form-select"
                                        required>

                                    <option value="">

                                        -- Seleccione un tipo --

                                    </option>


                                    @foreach (var tipo in tiposMovimiento)
                                    {
                                        <option value="@tipo.IdTipoMovimiento">

                                            @tipo.Nombre

                                        </option>
                                    }

                                </select>


                                <div class="form-text">

                                    Selecciona el tipo que determinará
                                    si el pago se registra como ingreso
                                    o egreso.

                                </div>

                            </div>


                            <!-- ================================================= -->
                            <!-- DESCRIPCIÓN -->
                            <!-- ================================================= -->

                            <div class="mb-4">

                                <label for="descripcion"
                                       class="form-label fw-semibold">

                                    <i class="bi bi-chat-left-text me-1"></i>

                                    Descripción

                                </label>


                                <textarea id="descripcion"
                                          name="descripcion"
                                          class="form-control"
                                          rows="4"
                                          maxlength="500"
                                          placeholder="Ejemplo: Pago de factura de cliente..."
                                          autocomplete="off"></textarea>


                                <div class="form-text d-flex justify-content-between">

                                    <span>

                                        Si no ingresas una descripción,
                                        se utilizará "Pago registrado".

                                    </span>

                                    <span>

                                        <span id="contadorDescripcion">
                                            0
                                        </span>/500

                                    </span>

                                </div>

                            </div>


                            <!-- ================================================= -->
                            <!-- RESUMEN -->
                            <!-- ================================================= -->

                            <div class="card bg-light border mb-4">

                                <div class="card-body">

                                    <h6 class="fw-semibold mb-3">

                                        <i class="bi bi-calculator me-2"></i>

                                        Resumen del registro

                                    </h6>


                                    <!-- PAGO -->

                                    <div class="d-flex justify-content-between
                                                align-items-center mb-2">

                                        <span class="text-muted">

                                            Pago

                                        </span>

                                        <span class="fw-semibold">

                                            #@Model.IdPago

                                        </span>

                                    </div>


                                    <!-- CAJA -->

                                    <div class="d-flex justify-content-between
                                                align-items-center mb-2">

                                        <span class="text-muted">

                                            Caja

                                        </span>

                                        <span class="fw-semibold">

                                            #@caja.IdCaja

                                        </span>

                                    </div>


                                    <!-- TIPO -->

                                    <div class="d-flex justify-content-between
                                                align-items-center mb-2">

                                        <span class="text-muted">

                                            Tipo

                                        </span>

                                        <span class="fw-semibold"
                                              id="resumenTipo">

                                            No seleccionado

                                        </span>

                                    </div>


                                    <!-- MÉTODO -->

                                    <div class="d-flex justify-content-between
                                                align-items-center mb-2">

                                        <span class="text-muted">

                                            Método

                                        </span>

                                        <span class="fw-semibold">

                                            @nombreMetodoPago

                                        </span>

                                    </div>


                                    <!-- MONEDA -->

                                    <div class="d-flex justify-content-between
                                                align-items-center mb-2">

                                        <span class="text-muted">

                                            Moneda

                                        </span>

                                        <span class="fw-semibold">

                                            @nombreMoneda

                                        </span>

                                    </div>


                                    <hr />


                                    <!-- MONTO -->

                                    <div class="d-flex justify-content-between
                                                align-items-center">

                                        <span class="fw-semibold">

                                            Monto a registrar

                                        </span>

                                        <span class="fw-bold fs-5 text-success">

                                            @simboloMoneda @montoFormateado

                                        </span>

                                    </div>

                                </div>

                            </div>


                            <!-- ================================================= -->
                            <!-- ADVERTENCIA -->
                            <!-- ================================================= -->

                            <div class="alert alert-warning">

                                <div class="d-flex align-items-start">

                                    <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>

                                    <div>

                                        <strong>

                                            Atención

                                        </strong>

                                        <p class="mb-0 mt-1">

                                            Una vez registrado, este pago
                                            quedará asociado a esta caja
                                            y no podrá registrarse nuevamente
                                            en la misma caja.

                                        </p>

                                    </div>

                                </div>

                            </div>


                            <!-- ================================================= -->
                            <!-- BOTONES -->
                            <!-- ================================================= -->

                            <div class="d-flex justify-content-end gap-2 mt-4">

                                <a asp-controller="Caja"
                                   asp-action="Movimientos"
                                   asp-route-id="@caja.IdCaja"
                                   class="btn btn-outline-secondary">

                                    <i class="bi bi-x-circle me-1"></i>

                                    Cancelar

                                </a>


                                <button type="submit"
                                        class="btn btn-primary"
                                        id="btnRegistrarPago">

                                    <i class="bi bi-check-circle me-1"></i>

                                    Registrar pago

                                </button>

                            </div>

                        </form>
                    }
                    else
                    {
                        <!-- ================================================= -->
                        <!-- CAJA NO DISPONIBLE -->
                        <!-- ================================================= -->

                        <div class="text-center py-5">

                            @if (caja == null)
                            {
                                <i class="bi bi-safe2 text-danger display-4"></i>

                                <h5 class="mt-3">

                                    Caja no disponible

                                </h5>

                                <p class="text-muted">

                                    No se encontró la caja necesaria
                                    para registrar este pago.

                                </p>
                            }
                            else
                            {
                                <i class="bi bi-lock-fill text-secondary display-4"></i>

                                <h5 class="mt-3">

                                    Caja cerrada

                                </h5>

                                <p class="text-muted">

                                    Esta caja está cerrada y no permite
                                    registrar nuevos movimientos.

                                </p>
                            }


                            @if (caja != null)
                            {
                                <a asp-controller="Caja"
                                   asp-action="Movimientos"
                                   asp-route-id="@caja.IdCaja"
                                   class="btn btn-outline-secondary mt-2">

                                    <i class="bi bi-arrow-left me-1"></i>

                                    Volver a movimientos

                                </a>
                            }
                            else
                            {
                                <a asp-controller="Caja"
                                   asp-action="Index"
                                   class="btn btn-outline-secondary mt-2">

                                    <i class="bi bi-arrow-left me-1"></i>

                                    Volver a cajas

                                </a>
                            }

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- INFORMACIÓN FINAL -->
    <!-- ========================================================= -->

    <div class="alert alert-info mt-4">

        <div class="d-flex align-items-start">

            <i class="bi bi-info-circle-fill fs-4 me-3"></i>

            <div>

                <strong>

                    ¿Qué sucederá al registrar el pago?

                </strong>


                <ul class="mb-0 mt-2">

                    @if (caja != null)
                    {
                        <li>

                            El pago será asociado a la
                            <strong>caja #@caja.IdCaja</strong>.

                        </li>
                    }


                    <li>

                        Se creará un nuevo movimiento de caja.

                    </li>


                    <li>

                        El monto registrado será
                        <strong>
                            @simboloMoneda @montoFormateado
                        </strong>.

                    </li>


                    <li>

                        La moneda utilizada será
                        <strong>@nombreMoneda</strong>.

                    </li>


                    <li>

                        Los totales de la caja serán actualizados
                        automáticamente.

                    </li>


                    <li>

                        El pago no podrá registrarse nuevamente
                        en la misma caja.

                    </li>

                </ul>

            </div>

        </div>

    </div>

</div>


<!-- ============================================================= -->
<!-- JAVASCRIPT -->
<!-- ============================================================= -->

@section Scripts {

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                // =====================================================
                // ELEMENTOS
                // =====================================================

                const formulario =
                    document.getElementById(
                        "formRegistrarPago"
                    );

                if (!formulario) {
                    return;
                }


                const tipoMovimiento =
                    document.getElementById(
                        "idTipoMovimiento"
                    );


                const descripcion =
                    document.getElementById(
                        "descripcion"
                    );


                const contadorDescripcion =
                    document.getElementById(
                        "contadorDescripcion"
                    );


                const resumenTipo =
                    document.getElementById(
                        "resumenTipo"
                    );


                const btnRegistrar =
                    document.getElementById(
                        "btnRegistrarPago"
                    );


                // =====================================================
                // ACTUALIZAR TIPO
                // =====================================================

                function actualizarTipo() {

                    if (!tipoMovimiento ||
                        !resumenTipo) {

                        return;

                    }


                    if (!tipoMovimiento.value) {

                        resumenTipo.textContent =
                            "No seleccionado";

                        return;

                    }


                    const opcion =
                        tipoMovimiento.options[
                            tipoMovimiento.selectedIndex
                        ];


                    if (!opcion) {

                        resumenTipo.textContent =
                            "No seleccionado";

                        return;

                    }


                    resumenTipo.textContent =
                        opcion.textContent.trim();

                }


                // =====================================================
                // CONTADOR DESCRIPCIÓN
                // =====================================================

                function actualizarContador() {

                    if (!descripcion ||
                        !contadorDescripcion) {

                        return;

                    }


                    contadorDescripcion.textContent =
                        descripcion.value.length;


                    if (
                        descripcion.value.length >= 450
                    ) {

                        contadorDescripcion.classList.add(
                            "text-warning",
                            "fw-semibold"
                        );

                    }
                    else {

                        contadorDescripcion.classList.remove(
                            "text-warning",
                            "fw-semibold"
                        );

                    }


                    if (
                        descripcion.value.length >= 500
                    ) {

                        contadorDescripcion.classList.remove(
                            "text-warning"
                        );

                        contadorDescripcion.classList.add(
                            "text-danger",
                            "fw-bold"
                        );

                    }
                    else {

                        contadorDescripcion.classList.remove(
                            "text-danger",
                            "fw-bold"
                        );

                    }

                }


                // =====================================================
                // EVENTOS
                // =====================================================

                if (tipoMovimiento) {

                    tipoMovimiento.addEventListener(
                        "change",
                        actualizarTipo
                    );

                }


                if (descripcion) {

                    descripcion.addEventListener(
                        "input",
                        actualizarContador
                    );

                }


                // =====================================================
                // ENVÍO DEL FORMULARIO
                // =====================================================

                formulario.addEventListener(
                    "submit",
                    function (event) {

                        // ---------------------------------------------
                        // TIPO
                        // ---------------------------------------------

                        if (
                            !tipoMovimiento ||
                            !tipoMovimiento.value
                        ) {

                            event.preventDefault();

                            alert(
                                "Debes seleccionar el tipo de movimiento."
                            );

                            if (tipoMovimiento) {

                                tipoMovimiento.focus();

                            }

                            return;

                        }


                        // ---------------------------------------------
                        // DESCRIPCIÓN
                        // ---------------------------------------------

                        const textoDescripcion =
                            descripcion
                                ? descripcion.value.trim()
                                : "";


                        if (
                            textoDescripcion.length > 500
                        ) {

                            event.preventDefault();

                            alert(
                                "La descripción no puede superar los 500 caracteres."
                            );

                            if (descripcion) {

                                descripcion.focus();

                            }

                            return;

                        }


                        // ---------------------------------------------
                        // OBTENER TIPO
                        // ---------------------------------------------

                        const opcionTipo =
                            tipoMovimiento.options[
                                tipoMovimiento.selectedIndex
                            ];


                        const tipoSeleccionado =
                            opcionTipo
                                ? opcionTipo.textContent.trim()
                                : "No seleccionado";


                        // ---------------------------------------------
                        // CONFIRMACIÓN
                        // ---------------------------------------------

                        const mensaje =
                            "¿Estás seguro de que deseas registrar este pago en la caja?" +
                            "\n\n" +
                            "Caja: #" +
                            "@(caja?.IdCaja ?? 0)" +
                            "\n" +
                            "Pago: #" +
                            "@Model.IdPago" +
                            "\n" +
                            "Tipo: " +
                            tipoSeleccionado +
                            "\n" +
                            "Método: " +
                            "@Html.Raw(nombreMetodoPago)" +
                            "\n" +
                            "Moneda: " +
                            "@Html.Raw(nombreMoneda)" +
                            "\n" +
                            "Monto: " +
                            "@simboloMoneda @montoFormateado" +
                            "\n\n" +
                            "Esta operación afectará el saldo de la caja.";


                        const confirmar =
                            confirm(mensaje);


                        if (!confirmar) {

                            event.preventDefault();

                            return;

                        }


                        // ---------------------------------------------
                        // EVITAR DOBLE ENVÍO
                        // ---------------------------------------------

                        if (btnRegistrar) {

                            btnRegistrar.disabled = true;

                            btnRegistrar.innerHTML =
                                '<span class="spinner-border spinner-border-sm me-1"></span>' +
                                'Registrando...';

                        }

                    }
                );


                // =====================================================
                // INICIALIZAR
                // =====================================================

                actualizarTipo();

                actualizarContador();

            });

    </script>

}
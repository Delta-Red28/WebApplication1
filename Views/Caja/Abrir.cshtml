@{
    ViewData["Title"] = "Abrir caja";

    var usuarioActual = ViewBag.UsuarioActual;
    var estadosCaja = ViewBag.EstadosCaja;
}

<div class="container-fluid">

    <!-- ========================================================= -->
    <!-- ENCABEZADO -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-cash-stack text-success me-2"></i>

                Abrir caja

            </h2>

            <p class="text-muted mb-0">

                Registra los fondos iniciales disponibles en Córdobas
                y Dólares.

            </p>

        </div>


        <a asp-controller="Caja"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>

            Volver

        </a>

    </div>


    <!-- ========================================================= -->
    <!-- MENSAJE DE ERROR -->
    <!-- ========================================================= -->

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ========================================================= -->
    <!-- MENSAJE DE ÉXITO -->
    <!-- ========================================================= -->

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ========================================================= -->
    <!-- VALIDACIÓN DEL MODELO -->
    <!-- ========================================================= -->

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <div class="d-flex">

                <i class="bi bi-exclamation-triangle-fill me-2 mt-1"></i>

                <div>

                    <strong>Revisa los datos ingresados.</strong>

                    <ul class="mb-0 mt-2">

                        @foreach (var error in ViewData.ModelState.Values
                            .SelectMany(v => v.Errors))
                        {
                            if (!string.IsNullOrWhiteSpace(error.ErrorMessage))
                            {
                                <li>
                                    @error.ErrorMessage
                                </li>
                            }
                        }

                    </ul>

                </div>

            </div>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ========================================================= -->
    <!-- FORMULARIO -->
    <!-- ========================================================= -->

    <div class="row justify-content-center">

        <div class="col-lg-8 col-xl-7">

            <div class="card shadow-sm border-0">

                <!-- ================================================= -->
                <!-- CABECERA -->
                <!-- ================================================= -->

                <div class="card-header bg-success text-white py-3">

                    <h5 class="mb-0">

                        <i class="bi bi-wallet2 me-2"></i>

                        Datos de apertura

                    </h5>

                </div>


                <!-- ================================================= -->
                <!-- CUERPO -->
                <!-- ================================================= -->

                <div class="card-body p-4">

                    <form asp-controller="Caja"
                          asp-action="Abrir"
                          method="post"
                          autocomplete="off"
                          id="formAbrirCaja">

                        @Html.AntiForgeryToken()


                        <!-- ================================================= -->
                        <!-- USUARIO RESPONSABLE -->
                        <!-- ================================================= -->

                        <div class="alert alert-light border mb-4">

                            <div class="d-flex align-items-center">

                                <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3">

                                    <i class="bi bi-person text-primary fs-4"></i>

                                </div>

                                <div class="flex-grow-1">

                                    <div class="text-muted small">

                                        Usuario responsable

                                    </div>

                                    <div class="fw-semibold">

                                        @if (usuarioActual != null)
                                        {
                                            @usuarioActual
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Usuario autenticado
                                            </span>
                                        }

                                    </div>

                                    <div class="small text-muted mt-1">

                                        La caja será asociada automáticamente
                                        al usuario que inició sesión.

                                    </div>

                                </div>

                                <div>

                                    <span class="badge bg-primary">

                                        <i class="bi bi-shield-check me-1"></i>

                                        Sesión actual

                                    </span>

                                </div>

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- REGLAS DE APERTURA -->
                        <!-- ================================================= -->

                        <div class="alert alert-warning mb-4">

                            <div class="d-flex">

                                <i class="bi bi-info-circle-fill me-2 mt-1"></i>

                                <div>

                                    <strong>Reglas de apertura</strong>

                                    <div class="small mt-1">

                                        Un usuario solamente puede tener
                                        <strong>una caja abierta</strong>
                                        al mismo tiempo.

                                    </div>

                                    <div class="small mt-1">

                                        El sistema permite hasta
                                        <strong>3 cajas abiertas</strong>
                                        simultáneamente.

                                    </div>

                                    <div class="small mt-1">

                                        Estas reglas también serán verificadas
                                        por el servidor.

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- FONDOS INICIALES -->
                        <!-- ================================================= -->

                        <div class="mb-4">

                            <label class="form-label fw-semibold">

                                <i class="bi bi-cash-stack me-1"></i>

                                Fondos iniciales

                            </label>

                            <div class="form-text mb-3">

                                Indica cuánto efectivo existe al momento
                                de abrir la caja en cada moneda.

                            </div>


                            <div class="row g-3">


                                <!-- ========================================= -->
                                <!-- CÓRDOBAS -->
                                <!-- ========================================= -->

                                <div class="col-md-6">

                                    <div class="card border-primary h-100">

                                        <div class="card-header bg-primary bg-opacity-10">

                                            <div class="d-flex align-items-center">

                                                <span class="badge bg-primary me-2">
                                                    C$
                                                </span>

                                                <span class="fw-semibold">
                                                    Córdobas
                                                </span>

                                            </div>

                                        </div>


                                        <div class="card-body">

                                            <label for="montoInicialCordobas"
                                                   class="form-label">

                                                Monto inicial en Córdobas

                                            </label>

                                            <div class="input-group">

                                                <span class="input-group-text">
                                                    C$
                                                </span>

                                                <input type="number"
                                                       class="form-control"
                                                       id="montoInicialCordobas"
                                                       name="montoInicialCordobas"
                                                       min="0"
                                                       max="999999999999"
                                                       step="0.01"
                                                       value="0.00"
                                                       inputmode="decimal"
                                                       required />

                                            </div>

                                            <div class="form-text">

                                                Fondo inicial disponible
                                                en moneda nacional.

                                            </div>

                                        </div>

                                    </div>

                                </div>


                                <!-- ========================================= -->
                                <!-- DÓLARES -->
                                <!-- ========================================= -->

                                <div class="col-md-6">

                                    <div class="card border-success h-100">

                                        <div class="card-header bg-success bg-opacity-10">

                                            <div class="d-flex align-items-center">

                                                <span class="badge bg-success me-2">
                                                    US$
                                                </span>

                                                <span class="fw-semibold">
                                                    Dólares
                                                </span>

                                            </div>

                                        </div>


                                        <div class="card-body">

                                            <label for="montoInicialDolares"
                                                   class="form-label">

                                                Monto inicial en Dólares

                                            </label>

                                            <div class="input-group">

                                                <span class="input-group-text">
                                                    US$
                                                </span>

                                                <input type="number"
                                                       class="form-control"
                                                       id="montoInicialDolares"
                                                       name="montoInicialDolares"
                                                       min="0"
                                                       max="999999999999"
                                                       step="0.01"
                                                       value="0.00"
                                                       inputmode="decimal"
                                                       required />

                                            </div>

                                            <div class="form-text">

                                                Fondo inicial disponible
                                                en dólares estadounidenses.

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- RESUMEN INICIAL -->
                        <!-- ================================================= -->

                        <div class="card bg-light border-0 mb-4">

                            <div class="card-body">

                                <div class="d-flex align-items-center mb-3">

                                    <i class="bi bi-calculator text-primary fs-4 me-2"></i>

                                    <h6 class="mb-0 fw-semibold">

                                        Resumen de apertura

                                    </h6>

                                </div>


                                <div class="row g-3">


                                    <!-- CÓRDOBAS -->

                                    <div class="col-md-6">

                                        <div class="border rounded bg-white p-3">

                                            <div class="small text-muted">

                                                Fondo inicial C$

                                            </div>

                                            <div class="fs-5 fw-bold text-primary">

                                                C$

                                                <span id="resumenCordobas">
                                                    0.00
                                                </span>

                                            </div>

                                        </div>

                                    </div>


                                    <!-- DÓLARES -->

                                    <div class="col-md-6">

                                        <div class="border rounded bg-white p-3">

                                            <div class="small text-muted">

                                                Fondo inicial US$

                                            </div>

                                            <div class="fs-5 fw-bold text-success">

                                                US$

                                                <span id="resumenDolares">
                                                    0.00
                                                </span>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- ESTADO DE CAJA -->
                        <!-- ================================================= -->

                        <div class="mb-4">

                            <label for="idEstadoCaja"
                                   class="form-label fw-semibold">

                                <i class="bi bi-activity me-1"></i>

                                Estado de la caja

                            </label>


                            <select class="form-select"
                                    id="idEstadoCaja"
                                    name="idEstadoCaja"
                                    required>

                                <option value="">
                                    -- Seleccione un estado --
                                </option>


                                @if (estadosCaja != null)
                                {
                                    foreach (var estado in estadosCaja)
                                    {
                                        <option value="@estado.IdEstadoCaja">

                                            @estado.Nombre

                                        </option>
                                    }
                                }

                            </select>


                            <div class="form-text">

                                Selecciona el estado correspondiente
                                para la apertura de la caja.

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- OBSERVACIÓN -->
                        <!-- ================================================= -->

                        <div class="mb-4">

                            <label for="observacion"
                                   class="form-label fw-semibold">

                                <i class="bi bi-chat-left-text me-1"></i>

                                Observación

                            </label>


                            <textarea class="form-control"
                                      id="observacion"
                                      name="observacion"
                                      rows="4"
                                      maxlength="1000"
                                      placeholder="Observaciones de la apertura..."></textarea>


                            <div class="form-text">

                                Máximo 1000 caracteres.

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- BOTONES -->
                        <!-- ================================================= -->

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-controller="Caja"
                               asp-action="Index"
                               class="btn btn-outline-secondary">

                                <i class="bi bi-x-circle me-1"></i>

                                Cancelar

                            </a>


                            <button type="submit"
                                    class="btn btn-success"
                                    id="btnAbrirCaja">

                                <i class="bi bi-unlock me-1"></i>

                                Abrir caja

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ============================================================= -->
<!-- ACTUALIZAR RESUMEN Y CONTROLAR ENVÍO -->
<!-- ============================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const cordobas =
            document.getElementById("montoInicialCordobas");

        const dolares =
            document.getElementById("montoInicialDolares");

        const resumenCordobas =
            document.getElementById("resumenCordobas");

        const resumenDolares =
            document.getElementById("resumenDolares");

        const formulario =
            document.getElementById("formAbrirCaja");

        const botonAbrir =
            document.getElementById("btnAbrirCaja");


        // =========================================================
        // OBTENER NÚMERO
        // =========================================================

        function obtenerNumero(elemento) {

            if (!elemento) {
                return 0;
            }

            const valor = parseFloat(elemento.value);

            if (isNaN(valor) || valor < 0) {
                return 0;
            }

            return valor;
        }


        // =========================================================
        // FORMATEAR MONEDA
        // =========================================================

        function formatearMoneda(valor) {

            return valor.toLocaleString(
                "en-US",
                {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }
            );

        }


        // =========================================================
        // ACTUALIZAR RESUMEN
        // =========================================================

        function actualizarResumen() {

            const valorCordobas =
                obtenerNumero(cordobas);

            const valorDolares =
                obtenerNumero(dolares);


            if (resumenCordobas) {

                resumenCordobas.textContent =
                    formatearMoneda(valorCordobas);

            }


            if (resumenDolares) {

                resumenDolares.textContent =
                    formatearMoneda(valorDolares);

            }

        }


        // =========================================================
        // EVENTOS
        // =========================================================

        if (cordobas) {

            cordobas.addEventListener(
                "input",
                actualizarResumen
            );

        }


        if (dolares) {

            dolares.addEventListener(
                "input",
                actualizarResumen
            );

        }


        // =========================================================
        // EVITAR DOBLE ENVÍO
        // =========================================================

        if (formulario && botonAbrir) {

            formulario.addEventListener(
                "submit",
                function (event) {

                
                    if (!formulario.checkValidity()) {

                        return;

                    }


                    /*
                     * Evita doble clic y doble envío.
                     */

                    if (botonAbrir.disabled) {

                        event.preventDefault();

                        return;

                    }


                    botonAbrir.disabled = true;

                    botonAbrir.innerHTML =
                        '<span class="spinner-border spinner-border-sm me-1" ' +
                        'role="status" aria-hidden="true"></span>' +
                        'Abriendo caja...';

                }
            );

        }


        // =========================================================
        // CARGA INICIAL
        // =========================================================

        actualizarResumen();

    });

</script>
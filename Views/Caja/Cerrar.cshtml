@model WebApplication1.Models.Caja

@{
    ViewData["Title"] = "Cerrar caja";

    // ============================================================
    // USUARIO RESPONSABLE
    // ============================================================

    var nombreUsuario =
        Model.IdUsuarioNavigation?.Nombres ?? "";

    var apellidosUsuario =
        Model.IdUsuarioNavigation?.Apellidos ?? "";

    var usuarioResponsable =
        $"{nombreUsuario} {apellidosUsuario}".Trim();

    if (string.IsNullOrWhiteSpace(usuarioResponsable))
    {
        usuarioResponsable =
            Model.IdUsuarioNavigation?.Usuario1
            ?? $"Usuario #{Model.IdUsuario}";
    }

    // ============================================================
    // CULTURAS
    // ============================================================

    var culturaCordobas =
        System.Globalization.CultureInfo.GetCultureInfo("es-NI");

    var culturaDolares =
        System.Globalization.CultureInfo.GetCultureInfo("en-US");

    // ============================================================
    // TOTALES DE LA CAJA
    // ============================================================

    var totalSistemaCordobas =
        Model.TotalSistemaCordobas;

    var totalSistemaDolares =
        Model.TotalSistemaDolares;

    var totalIngresosCordobas =
        Model.TotalIngresosCordobas;

    var totalIngresosDolares =
        Model.TotalIngresosDolares;

    var totalEgresosCordobas =
        Model.TotalEgresosCordobas;

    var totalEgresosDolares =
        Model.TotalEgresosDolares;

    var montoInicialCordobas =
        Model.MontoInicialCordobas;

    var montoInicialDolares =
        Model.MontoInicialDolares;
}


<div class="container-fluid">

    <!-- ========================================================= -->
    <!-- ENCABEZADO -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="mb-1">

                <i class="bi bi-lock-fill me-2"></i>

                Cerrar caja

            </h2>

            <p class="text-muted mb-0">

                Realiza el arqueo y cierre de la caja
                #@Model.IdCaja.

            </p>

        </div>


        <div>

            <a asp-controller="Caja"
               asp-action="Details"
               asp-route-id="@Model.IdCaja"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>

                Volver

            </a>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- MENSAJE ERROR -->
    <!-- ========================================================= -->

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ========================================================= -->
    <!-- MENSAJE SUCCESS -->
    <!-- ========================================================= -->

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ========================================================= -->
    <!-- ADVERTENCIA -->
    <!-- ========================================================= -->

    <div class="alert alert-warning d-flex align-items-start mb-4"
         role="alert">

        <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>

        <div>

            <h6 class="alert-heading fw-bold">
                Atención
            </h6>

            <p class="mb-0">

                Una vez cerrada la caja no podrás registrar nuevos
                movimientos. Verifica que el efectivo contado sea
                correcto antes de confirmar el cierre.

            </p>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- INFORMACIÓN DE LA CAJA -->
    <!-- ========================================================= -->

    <div class="row g-4">


        <!-- ===================================================== -->
        <!-- COLUMNA IZQUIERDA -->
        <!-- ===================================================== -->

        <div class="col-lg-5">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-white">

                    <h5 class="mb-0">

                        <i class="bi bi-info-circle me-2"></i>

                        Información de la caja

                    </h5>

                </div>


                <div class="card-body">


                    <!-- CAJA -->

                    <div class="mb-4">

                        <div class="text-muted small">
                            Número de caja
                        </div>

                        <div class="fs-4 fw-bold">
                            #@Model.IdCaja
                        </div>

                    </div>


                    <!-- USUARIO -->

                    <div class="mb-4">

                        <div class="text-muted small">
                            Usuario responsable
                        </div>

                        <div class="fw-semibold">

                            <i class="bi bi-person me-1"></i>

                            @usuarioResponsable

                        </div>

                        <div class="small text-muted mt-1">

                            ID usuario:
                            @Model.IdUsuario

                        </div>

                    </div>


                    <!-- FECHA APERTURA -->

                    <div class="mb-4">

                        <div class="text-muted small">
                            Fecha de apertura
                        </div>

                        <div class="fw-semibold">

                            @Model.FechaApertura.ToString(
                                "dd/MM/yyyy HH:mm"
                            )

                        </div>

                    </div>


                    <!-- ESTADO -->

                    <div class="mb-4">

                        <div class="text-muted small">
                            Estado actual
                        </div>

                        <div>

                            @if (Model.FechaCierre == null)
                            {
                                <span class="badge bg-success">

                                    <i class="bi bi-unlock-fill me-1"></i>

                                    Abierta

                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">

                                    <i class="bi bi-lock-fill me-1"></i>

                                    Cerrada

                                </span>
                            }

                        </div>

                    </div>


                    <hr />


                    <!-- ================================================= -->
                    <!-- CÓRDOBAS -->
                    <!-- ================================================= -->

                    <div class="card border-primary mb-3">

                        <div class="card-header bg-primary bg-opacity-10">

                            <div class="d-flex justify-content-between">

                                <span class="fw-semibold">

                                    <span class="badge bg-primary me-1">
                                        C$
                                    </span>

                                    Córdobas

                                </span>

                                <span class="text-primary fw-bold">

                                    Sistema

                                </span>

                            </div>

                        </div>


                        <div class="card-body">

                            <div class="d-flex justify-content-between mb-2">

                                <span class="text-muted">
                                    Monto inicial
                                </span>

                                <strong>
                                    @montoInicialCordobas.ToString(
                                        "C2",
                                        culturaCordobas)
                                </strong>

                            </div>


                            <div class="d-flex justify-content-between mb-2">

                                <span class="text-muted">

                                    <i class="bi bi-arrow-down-circle text-success me-1"></i>

                                    Ingresos

                                </span>

                                <strong class="text-success">

                                    @totalIngresosCordobas.ToString(
                                        "C2",
                                        culturaCordobas)

                                </strong>

                            </div>


                            <div class="d-flex justify-content-between mb-3">

                                <span class="text-muted">

                                    <i class="bi bi-arrow-up-circle text-danger me-1"></i>

                                    Egresos

                                </span>

                                <strong class="text-danger">

                                    @totalEgresosCordobas.ToString(
                                        "C2",
                                        culturaCordobas)

                                </strong>

                            </div>


                            <hr />


                            <div class="d-flex justify-content-between align-items-center">

                                <span class="fw-semibold">

                                    Total esperado

                                </span>

                                <span class="fs-5 fw-bold text-primary">

                                    @totalSistemaCordobas.ToString(
                                        "C2",
                                        culturaCordobas)

                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- DÓLARES -->
                    <!-- ================================================= -->

                    <div class="card border-success">

                        <div class="card-header bg-success bg-opacity-10">

                            <div class="d-flex justify-content-between">

                                <span class="fw-semibold">

                                    <span class="badge bg-success me-1">
                                        US$
                                    </span>

                                    Dólares

                                </span>

                                <span class="text-success fw-bold">

                                    Sistema

                                </span>

                            </div>

                        </div>


                        <div class="card-body">

                            <div class="d-flex justify-content-between mb-2">

                                <span class="text-muted">
                                    Monto inicial
                                </span>

                                <strong>
                                    @montoInicialDolares.ToString(
                                        "C2",
                                        culturaDolares)
                                </strong>

                            </div>


                            <div class="d-flex justify-content-between mb-2">

                                <span class="text-muted">

                                    <i class="bi bi-arrow-down-circle text-success me-1"></i>

                                    Ingresos

                                </span>

                                <strong class="text-success">

                                    @totalIngresosDolares.ToString(
                                        "C2",
                                        culturaDolares)

                                </strong>

                            </div>


                            <div class="d-flex justify-content-between mb-3">

                                <span class="text-muted">

                                    <i class="bi bi-arrow-up-circle text-danger me-1"></i>

                                    Egresos

                                </span>

                                <strong class="text-danger">

                                    @totalEgresosDolares.ToString(
                                        "C2",
                                        culturaDolares)

                                </strong>

                            </div>


                            <hr />


                            <div class="d-flex justify-content-between align-items-center">

                                <span class="fw-semibold">

                                    Total esperado

                                </span>

                                <span class="fs-5 fw-bold text-success">

                                    @totalSistemaDolares.ToString(
                                        "C2",
                                        culturaDolares)

                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- FORMULARIO DE CIERRE -->
        <!-- ===================================================== -->

        <div class="col-lg-7">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-danger text-white">

                    <h5 class="mb-0">

                        <i class="bi bi-lock-fill me-2"></i>

                        Arqueo de caja

                    </h5>

                </div>


                <div class="card-body p-4">

                    <form asp-controller="Caja"
                          asp-action="Cerrar"
                          method="post"
                          id="formCerrarCaja">

                        @Html.AntiForgeryToken()


                        <!-- ================================================= -->
                        <!-- ID CAJA -->
                        <!-- ================================================= -->

                        <input type="hidden"
                               name="idCaja"
                               value="@Model.IdCaja" />


                        <!-- ================================================= -->
                        <!-- EXPLICACIÓN -->
                        <!-- ================================================= -->

                        <div class="alert alert-info mb-4">

                            <div class="d-flex">

                                <i class="bi bi-info-circle-fill me-2 mt-1"></i>

                                <div>

                                    <strong>Arqueo de caja</strong>

                                    <div class="small mt-1">

                                        Ingresa por separado el efectivo
                                        contado físicamente en Córdobas
                                        y Dólares.

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- CÓRDOBAS -->
                        <!-- ================================================= -->

                        <div class="card border-primary mb-4">

                            <div class="card-header bg-primary bg-opacity-10">

                                <div class="d-flex align-items-center">

                                    <span class="badge bg-primary me-2">
                                        C$
                                    </span>

                                    <strong>
                                        Arqueo en Córdobas
                                    </strong>

                                </div>

                            </div>


                            <div class="card-body">

                                <label for="totalContadoCordobas"
                                       class="form-label fw-semibold">

                                    Total contado físicamente

                                </label>


                                <div class="input-group input-group-lg">

                                    <span class="input-group-text">
                                        C$
                                    </span>

                                    <input type="number"
                                           class="form-control"
                                           id="totalContadoCordobas"
                                           name="totalContadoCordobas"
                                           min="0"
                                           step="0.01"
                                           required
                                           placeholder="0.00"
                                           autocomplete="off" />

                                </div>


                                <div class="form-text">

                                    Efectivo en Córdobas encontrado
                                    físicamente en la caja.

                                </div>


                                <!-- RESUMEN CÓRDOBAS -->

                                <div class="card bg-light border mt-3">

                                    <div class="card-body py-3">

                                        <div class="d-flex justify-content-between mb-2">

                                            <span class="text-muted">
                                                Total sistema
                                            </span>

                                            <strong>

                                                @totalSistemaCordobas.ToString(
                                                    "C2",
                                                    culturaCordobas)

                                            </strong>

                                        </div>


                                        <div class="d-flex justify-content-between mb-2">

                                            <span class="text-muted">
                                                Total contado
                                            </span>

                                            <strong id="totalContadoCordobasTexto">

                                                C$ 0.00

                                            </strong>

                                        </div>


                                        <hr />


                                        <div class="d-flex justify-content-between">

                                            <span class="fw-semibold">
                                                Diferencia
                                            </span>

                                            <strong id="diferenciaCordobas"
                                                    class="text-secondary">

                                                C$ 0.00

                                            </strong>

                                        </div>


                                        <div id="resultadoCordobas"
                                             class="text-center mt-2">

                                            <span class="badge bg-secondary">

                                                Ingresa el total contado

                                            </span>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- DÓLARES -->
                        <!-- ================================================= -->

                        <div class="card border-success mb-4">

                            <div class="card-header bg-success bg-opacity-10">

                                <div class="d-flex align-items-center">

                                    <span class="badge bg-success me-2">
                                        US$
                                    </span>

                                    <strong>
                                        Arqueo en Dólares
                                    </strong>

                                </div>

                            </div>


                            <div class="card-body">

                                <label for="totalContadoDolares"
                                       class="form-label fw-semibold">

                                    Total contado físicamente

                                </label>


                                <div class="input-group input-group-lg">

                                    <span class="input-group-text">
                                        US$
                                    </span>

                                    <input type="number"
                                           class="form-control"
                                           id="totalContadoDolares"
                                           name="totalContadoDolares"
                                           min="0"
                                           step="0.01"
                                           required
                                           placeholder="0.00"
                                           autocomplete="off" />

                                </div>


                                <div class="form-text">

                                    Efectivo en Dólares encontrado
                                    físicamente en la caja.

                                </div>


                                <!-- RESUMEN DÓLARES -->

                                <div class="card bg-light border mt-3">

                                    <div class="card-body py-3">

                                        <div class="d-flex justify-content-between mb-2">

                                            <span class="text-muted">
                                                Total sistema
                                            </span>

                                            <strong>

                                                @totalSistemaDolares.ToString(
                                                    "C2",
                                                    culturaDolares)

                                            </strong>

                                        </div>


                                        <div class="d-flex justify-content-between mb-2">

                                            <span class="text-muted">
                                                Total contado
                                            </span>

                                            <strong id="totalContadoDolaresTexto">

                                                US$ 0.00

                                            </strong>

                                        </div>


                                        <hr />


                                        <div class="d-flex justify-content-between">

                                            <span class="fw-semibold">
                                                Diferencia
                                            </span>

                                            <strong id="diferenciaDolares"
                                                    class="text-secondary">

                                                US$ 0.00

                                            </strong>

                                        </div>


                                        <div id="resultadoDolares"
                                             class="text-center mt-2">

                                            <span class="badge bg-secondary">

                                                Ingresa el total contado

                                            </span>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- RESUMEN GENERAL -->
                        <!-- ================================================= -->

                        <div class="card border-dark mb-4">

                            <div class="card-header bg-dark text-white">

                                <h6 class="mb-0">

                                    <i class="bi bi-calculator me-2"></i>

                                    Resumen del arqueo

                                </h6>

                            </div>


                            <div class="card-body">

                                <div class="row g-3">

                                    <!-- CÓRDOBAS -->

                                    <div class="col-md-6">

                                        <div class="border rounded p-3">

                                            <div class="text-muted small">
                                                Diferencia C$
                                            </div>

                                            <div id="resumenDiferenciaCordobas"
                                                 class="fs-5 fw-bold text-secondary">

                                                C$ 0.00

                                            </div>

                                        </div>

                                    </div>


                                    <!-- DÓLARES -->

                                    <div class="col-md-6">

                                        <div class="border rounded p-3">

                                            <div class="text-muted small">
                                                Diferencia US$
                                            </div>

                                            <div id="resumenDiferenciaDolares"
                                                 class="fs-5 fw-bold text-secondary">

                                                US$ 0.00

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- OBSERVACIÓN -->
                        <!-- ================================================= -->

                        <div class="mb-4">

                            <label for="observacion"
                                   class="form-label fw-semibold">

                                <i class="bi bi-chat-left-text me-1"></i>

                                Observación del cierre

                            </label>


                            <textarea class="form-control"
                                      id="observacion"
                                      name="observacion"
                                      rows="4"
                                      maxlength="500"
                                      placeholder="Indica alguna observación sobre el cierre, faltante o sobrante..."></textarea>


                            <div class="form-text">

                                Este campo es opcional.

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- CONFIRMACIÓN -->
                        <!-- ================================================= -->

                        <div class="alert alert-light border mb-4">

                            <div class="form-check">

                                <input class="form-check-input"
                                       type="checkbox"
                                       id="confirmarCierre"
                                       required />

                                <label class="form-check-label"
                                       for="confirmarCierre">

                                    <strong>

                                        Confirmo que he contado físicamente
                                        el efectivo.

                                    </strong>

                                    <br />

                                    <span class="small text-muted">

                                        Confirmo que deseo cerrar la caja
                                        y registrar el arqueo indicado.

                                    </span>

                                </label>

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- BOTONES -->
                        <!-- ================================================= -->

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-controller="Caja"
                               asp-action="Details"
                               asp-route-id="@Model.IdCaja"
                               class="btn btn-outline-secondary">

                                <i class="bi bi-x-circle me-1"></i>

                                Cancelar

                            </a>


                            <button type="submit"
                                    class="btn btn-danger"
                                    id="btnCerrarCaja">

                                <i class="bi bi-lock-fill me-1"></i>

                                Cerrar caja

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- INFORMACIÓN FINAL -->
    <!-- ========================================================= -->

    <div class="text-muted small mt-4 mb-4">

        <i class="bi bi-info-circle me-1"></i>

        Caja #@Model.IdCaja

        ·

        Usuario #@Model.IdUsuario

        ·

        Apertura:
        @Model.FechaApertura.ToString("dd/MM/yyyy HH:mm")

    </div>

</div>


<!-- ============================================================= -->
<!-- JAVASCRIPT -->
<!-- ============================================================= -->

@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            // =========================================================
            // ELEMENTOS
            // =========================================================

            const totalContadoCordobas =
                document.getElementById("totalContadoCordobas");

            const totalContadoDolares =
                document.getElementById("totalContadoDolares");

            const totalContadoCordobasTexto =
                document.getElementById("totalContadoCordobasTexto");

            const totalContadoDolaresTexto =
                document.getElementById("totalContadoDolaresTexto");

            const diferenciaCordobas =
                document.getElementById("diferenciaCordobas");

            const diferenciaDolares =
                document.getElementById("diferenciaDolares");

            const resultadoCordobas =
                document.getElementById("resultadoCordobas");

            const resultadoDolares =
                document.getElementById("resultadoDolares");

            const resumenDiferenciaCordobas =
                document.getElementById("resumenDiferenciaCordobas");

            const resumenDiferenciaDolares =
                document.getElementById("resumenDiferenciaDolares");

            const formulario =
                document.getElementById("formCerrarCaja");

            const confirmarCierre =
                document.getElementById("confirmarCierre");

            const btnCerrarCaja =
                document.getElementById("btnCerrarCaja");


            // =========================================================
            // TOTALES DEL SISTEMA
            // =========================================================

            const totalSistemaCordobas =
                @totalSistemaCordobas.ToString(
                    System.Globalization.CultureInfo.InvariantCulture
                );

            const totalSistemaDolares =
                @totalSistemaDolares.ToString(
                    System.Globalization.CultureInfo.InvariantCulture
                );


            // =========================================================
            // FORMATO CÓRDOBAS
            // =========================================================

            function formatoCordobas(valor) {

                return "C$ " +
                    new Intl.NumberFormat("es-NI", {

                        minimumFractionDigits: 2,

                        maximumFractionDigits: 2

                    }).format(valor);

            }


            // =========================================================
            // FORMATO DÓLARES
            // =========================================================

            function formatoDolares(valor) {

                return "US$ " +
                    new Intl.NumberFormat("en-US", {

                        minimumFractionDigits: 2,

                        maximumFractionDigits: 2

                    }).format(valor);

            }


            // =========================================================
            // ACTUALIZAR CÓRDOBAS
            // =========================================================

            function actualizarCordobas() {

                const contado =
                    parseFloat(
                        totalContadoCordobas.value
                    ) || 0;


                const diferencia =
                    contado -
                    totalSistemaCordobas;


                totalContadoCordobasTexto.textContent =
                    formatoCordobas(contado);


                diferenciaCordobas.textContent =
                    formatoCordobas(diferencia);


                resumenDiferenciaCordobas.textContent =
                    formatoCordobas(diferencia);


                if (diferencia > 0) {

                    diferenciaCordobas.className =
                        "fs-4 text-success fw-bold";

                    resumenDiferenciaCordobas.className =
                        "fs-5 fw-bold text-success";

                    resultadoCordobas.innerHTML =
                        '<span class="badge bg-success">' +
                        '<i class="bi bi-plus-circle me-1"></i>' +
                        'Sobrante' +
                        '</span>';

                }
                else if (diferencia < 0) {

                    diferenciaCordobas.className =
                        "fs-4 text-danger fw-bold";

                    resumenDiferenciaCordobas.className =
                        "fs-5 fw-bold text-danger";

                    resultadoCordobas.innerHTML =
                        '<span class="badge bg-danger">' +
                        '<i class="bi bi-dash-circle me-1"></i>' +
                        'Faltante' +
                        '</span>';

                }
                else {

                    diferenciaCordobas.className =
                        "fs-4 text-secondary fw-bold";

                    resumenDiferenciaCordobas.className =
                        "fs-5 fw-bold text-secondary";

                    resultadoCordobas.innerHTML =
                        '<span class="badge bg-secondary">' +
                        '<i class="bi bi-check-circle me-1"></i>' +
                        'Caja cuadrada' +
                        '</span>';

                }

            }


            // =========================================================
            // ACTUALIZAR DÓLARES
            // =========================================================

            function actualizarDolares() {

                const contado =
                    parseFloat(
                        totalContadoDolares.value
                    ) || 0;


                const diferencia =
                    contado -
                    totalSistemaDolares;


                totalContadoDolaresTexto.textContent =
                    formatoDolares(contado);


                diferenciaDolares.textContent =
                    formatoDolares(diferencia);


                resumenDiferenciaDolares.textContent =
                    formatoDolares(diferencia);


                if (diferencia > 0) {

                    diferenciaDolares.className =
                        "fs-4 text-success fw-bold";

                    resumenDiferenciaDolares.className =
                        "fs-5 fw-bold text-success";

                    resultadoDolares.innerHTML =
                        '<span class="badge bg-success">' +
                        '<i class="bi bi-plus-circle me-1"></i>' +
                        'Sobrante' +
                        '</span>';

                }
                else if (diferencia < 0) {

                    diferenciaDolares.className =
                        "fs-4 text-danger fw-bold";

                    resumenDiferenciaDolares.className =
                        "fs-5 fw-bold text-danger";

                    resultadoDolares.innerHTML =
                        '<span class="badge bg-danger">' +
                        '<i class="bi bi-dash-circle me-1"></i>' +
                        'Faltante' +
                        '</span>';

                }
                else {

                    diferenciaDolares.className =
                        "fs-4 text-secondary fw-bold";

                    resumenDiferenciaDolares.className =
                        "fs-5 fw-bold text-secondary";

                    resultadoDolares.innerHTML =
                        '<span class="badge bg-secondary">' +
                        '<i class="bi bi-check-circle me-1"></i>' +
                        'Caja cuadrada' +
                        '</span>';

                }

            }


            // =========================================================
            // EVENTOS
            // =========================================================

            if (totalContadoCordobas) {

                totalContadoCordobas.addEventListener(
                    "input",
                    actualizarCordobas
                );

            }


            if (totalContadoDolares) {

                totalContadoDolares.addEventListener(
                    "input",
                    actualizarDolares
                );

            }


            // =========================================================
            // SUBMIT
            // =========================================================

            if (formulario) {

                formulario.addEventListener(
                    "submit",
                    function (event) {

                        const contadoCordobas =
                            parseFloat(
                                totalContadoCordobas.value
                            );

                        const contadoDolares =
                            parseFloat(
                                totalContadoDolares.value
                            );


                        // -------------------------------------------------
                        // VALIDAR CÓRDOBAS
                        // -------------------------------------------------

                        if (
                            isNaN(contadoCordobas) ||
                            contadoCordobas < 0
                        ) {

                            event.preventDefault();

                            alert(
                                "El total contado en Córdobas debe ser un valor válido mayor o igual a cero."
                            );

                            totalContadoCordobas.focus();

                            return;

                        }


                        // -------------------------------------------------
                        // VALIDAR DÓLARES
                        // -------------------------------------------------

                        if (
                            isNaN(contadoDolares) ||
                            contadoDolares < 0
                        ) {

                            event.preventDefault();

                            alert(
                                "El total contado en Dólares debe ser un valor válido mayor o igual a cero."
                            );

                            totalContadoDolares.focus();

                            return;

                        }


                        // -------------------------------------------------
                        // VALIDAR CONFIRMACIÓN
                        // -------------------------------------------------

                        if (!confirmarCierre.checked) {

                            event.preventDefault();

                            alert(
                                "Debes confirmar que has contado físicamente el efectivo."
                            );

                            confirmarCierre.focus();

                            return;

                        }


                        // -------------------------------------------------
                        // DIFERENCIAS
                        // -------------------------------------------------

                        const diferenciaCordobasCalculada =
                            contadoCordobas -
                            totalSistemaCordobas;

                        const diferenciaDolaresCalculada =
                            contadoDolares -
                            totalSistemaDolares;


                        // -------------------------------------------------
                        // MENSAJE
                        // -------------------------------------------------

                        let mensaje =
                            "¿Estás seguro de que deseas cerrar esta caja?";


                        // -------------------------------------------------
                        // CÓRDOBAS
                        // -------------------------------------------------

                        if (diferenciaCordobasCalculada > 0) {

                            mensaje +=
                                "\n\nCórdobas: existe un sobrante de " +
                                formatoCordobas(
                                    diferenciaCordobasCalculada
                                ) +
                                ".";

                        }
                        else if (diferenciaCordobasCalculada < 0) {

                            mensaje +=
                                "\n\nCórdobas: existe un faltante de " +
                                formatoCordobas(
                                    Math.abs(
                                        diferenciaCordobasCalculada
                                    )
                                ) +
                                ".";

                        }
                        else {

                            mensaje +=
                                "\n\nCórdobas: caja cuadrada.";

                        }


                        // -------------------------------------------------
                        // DÓLARES
                        // -------------------------------------------------

                        if (diferenciaDolaresCalculada > 0) {

                            mensaje +=
                                "\nDólares: existe un sobrante de " +
                                formatoDolares(
                                    diferenciaDolaresCalculada
                                ) +
                                ".";

                        }
                        else if (diferenciaDolaresCalculada < 0) {

                            mensaje +=
                                "\nDólares: existe un faltante de " +
                                formatoDolares(
                                    Math.abs(
                                        diferenciaDolaresCalculada
                                    )
                                ) +
                                ".";

                        }
                        else {

                            mensaje +=
                                "\nDólares: caja cuadrada.";

                        }


                        // -------------------------------------------------
                        // CONFIRMACIÓN FINAL
                        // -------------------------------------------------

                        if (!confirm(mensaje)) {

                            event.preventDefault();

                            return;

                        }


                        // -------------------------------------------------
                        // EVITAR DOBLE ENVÍO
                        // -------------------------------------------------

                        if (btnCerrarCaja) {

                            btnCerrarCaja.disabled = true;

                            btnCerrarCaja.innerHTML =
                                '<span class="spinner-border spinner-border-sm me-1"></span>' +
                                'Cerrando caja...';

                        }

                    }
                );

            }


            // =========================================================
            // INICIALIZAR
            // =========================================================

            actualizarCordobas();

            actualizarDolares();

        });

    </script>

}
@model WebApplication1.Models.Caja

@{
    ViewData["Title"] = "Registrar movimiento";

    // ============================================================
    // LISTAS
    // ============================================================

    var tiposMovimiento =
        ViewBag.TiposMovimiento
        as IEnumerable<WebApplication1.Models.TipoMovimientoCaja>
        ?? Enumerable.Empty<WebApplication1.Models.TipoMovimientoCaja>();

    var monedas =
        ViewBag.Monedas
        as IEnumerable<WebApplication1.Models.Monedum>
        ?? Enumerable.Empty<WebApplication1.Models.Monedum>();


    // ============================================================
    // ESTADO DE CAJA
    // ============================================================

    var cajaAbierta =
        Model.FechaCierre == null;


    // ============================================================
    // USUARIO RESPONSABLE
    // ============================================================

    var usuarioResponsable =
        $"{Model.IdUsuarioNavigation?.Nombres?.Trim() ?? ""} " +
        $"{Model.IdUsuarioNavigation?.Apellidos?.Trim() ?? ""}"
        .Trim();

    if (string.IsNullOrWhiteSpace(usuarioResponsable))
    {
        usuarioResponsable =
            Model.IdUsuarioNavigation?.Usuario1
            ?? $"Usuario #{Model.IdUsuario}";
    }


    // ============================================================
    // ESTADO
    // ============================================================

    var estadoCaja =
        Model.IdEstadoCajaNavigation?.Nombre
        ?? (cajaAbierta ? "Abierta" : "Cerrada");


    // ============================================================
    // SALDOS
    // ============================================================

    var saldoCordobas =
        Model.MontoInicialCordobas
        + Model.TotalIngresosCordobas
        - Model.TotalEgresosCordobas;

    var saldoDolares =
        Model.MontoInicialDolares
        + Model.TotalIngresosDolares
        - Model.TotalEgresosDolares;


    // ============================================================
    // CULTURAS
    // ============================================================

    var culturaNicaragua =
        System.Globalization.CultureInfo.GetCultureInfo("es-NI");

    var culturaDolares =
        System.Globalization.CultureInfo.GetCultureInfo("en-US");
}


<div class="container-fluid">

    <!-- ========================================================= -->
    <!-- ENCABEZADO -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

        <div>

            <h2 class="mb-1">

                <i class="bi bi-plus-circle text-primary me-2"></i>

                Registrar movimiento

            </h2>

            <p class="text-muted mb-0">

                Registra un ingreso o egreso en la
                <strong>caja #@Model.IdCaja</strong>.

            </p>

        </div>


        <div>

            <a asp-controller="Caja"
               asp-action="Movimientos"
               asp-route-id="@Model.IdCaja"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>

                Volver a movimientos

            </a>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- MENSAJES -->
    <!-- ========================================================= -->

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ========================================================= -->
    <!-- CAJA CERRADA -->
    <!-- ========================================================= -->

    @if (!cajaAbierta)
    {
        <div class="alert alert-warning d-flex align-items-start mb-4"
             role="alert">

            <i class="bi bi-lock-fill fs-4 me-3"></i>

            <div>

                <strong>Esta caja está cerrada.</strong>

                <div class="small mt-1">

                    No se pueden registrar nuevos movimientos
                    en una caja cerrada.

                </div>

            </div>

        </div>
    }


    <!-- ========================================================= -->
    <!-- INFORMACIÓN DE LA CAJA -->
    <!-- ========================================================= -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                <div>

                    <strong>

                        <i class="bi bi-cash-stack me-2"></i>

                        Caja #@Model.IdCaja

                    </strong>


                    @if (cajaAbierta)
                    {
                        <span class="badge bg-success ms-2">

                            <i class="bi bi-unlock-fill me-1"></i>

                            Abierta

                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary ms-2">

                            <i class="bi bi-lock-fill me-1"></i>

                            Cerrada

                        </span>
                    }

                </div>


                <div class="text-muted">

                    <i class="bi bi-calendar3 me-1"></i>

                    @Model.FechaApertura.ToString("dd/MM/yyyy HH:mm")

                </div>

            </div>

        </div>


        <div class="card-body">

            <div class="row g-4">

                <!-- USUARIO -->

                <div class="col-lg-3 col-md-6">

                    <div class="text-muted small mb-1">

                        Usuario responsable

                    </div>

                    <div class="fw-semibold">

                        <i class="bi bi-person me-1"></i>

                        @usuarioResponsable

                    </div>

                    <small class="text-muted">

                        ID usuario: @Model.IdUsuario

                    </small>

                </div>


                <!-- ESTADO -->

                <div class="col-lg-3 col-md-6">

                    <div class="text-muted small mb-1">

                        Estado

                    </div>

                    <div class="fw-semibold">

                        @if (cajaAbierta)
                        {
                            <span class="text-success">

                                <i class="bi bi-unlock-fill me-1"></i>

                                @estadoCaja

                            </span>
                        }
                        else
                        {
                            <span class="text-secondary">

                                <i class="bi bi-lock-fill me-1"></i>

                                @estadoCaja

                            </span>
                        }

                    </div>

                </div>


                <!-- CÓRDOBAS -->

                <div class="col-lg-3 col-md-6">

                    <div class="text-muted small mb-1">

                        Saldo disponible C$

                    </div>

                    <div class="fs-5 fw-bold text-primary">

                        C$
                        @saldoCordobas.ToString(
                            "N2",
                            culturaNicaragua)

                    </div>

                    <small class="text-muted">

                        Córdobas

                    </small>

                </div>


                <!-- DÓLARES -->

                <div class="col-lg-3 col-md-6">

                    <div class="text-muted small mb-1">

                        Saldo disponible US$

                    </div>

                    <div class="fs-5 fw-bold text-success">

                        US$
                        @saldoDolares.ToString(
                            "N2",
                            culturaDolares)

                    </div>

                    <small class="text-muted">

                        Dólares

                    </small>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- FORMULARIO -->
    <!-- ========================================================= -->

    @if (cajaAbierta)
    {
        <div class="row justify-content-center">

            <div class="col-lg-8 col-xl-7">

                <div class="card shadow-sm border-0">

                    <div class="card-header bg-primary text-white py-3">

                        <h5 class="mb-0">

                            <i class="bi bi-cash-stack me-2"></i>

                            Datos del movimiento

                        </h5>

                    </div>


                    <div class="card-body p-4">

                        <form asp-controller="Caja"
                              asp-action="RegistrarMovimiento"
                              method="post"
                              id="formRegistrarMovimiento">

                            @Html.AntiForgeryToken()


                            <input type="hidden"
                                   name="idCaja"
                                   value="@Model.IdCaja" />


                            <!-- ================================================= -->
                            <!-- TIPO -->
                            <!-- ================================================= -->

                            <div class="mb-4">

                                <label for="idTipoMovimiento"
                                       class="form-label fw-semibold">

                                    <i class="bi bi-arrow-left-right me-1"></i>

                                    Tipo de movimiento

                                </label>


                                <select id="idTipoMovimiento"
                                        name="idTipoMovimiento"
                                        class="form-select"
                                        required>

                                    <option value="">

                                        -- Seleccione un tipo --

                                    </option>


                                    @foreach (var tipo in tiposMovimiento)
                                    {
                                        <option value="@tipo.IdTipoMovimiento">

                                            @tipo.Nombre

                                        </option>
                                    }

                                </select>

                                <div class="form-text">

                                    Selecciona si se trata de un ingreso
                                    o un egreso.

                                </div>

                            </div>


                            <!-- ================================================= -->
                            <!-- MONEDA -->
                            <!-- ================================================= -->

                            <div class="mb-4">

                                <label for="idMoneda"
                                       class="form-label fw-semibold">

                                    <i class="bi bi-currency-exchange me-1"></i>

                                    Moneda

                                </label>


                                <select id="idMoneda"
                                        name="idMoneda"
                                        class="form-select"
                                        required>

                                    <option value="">

                                        -- Seleccione una moneda --

                                    </option>


                                    @foreach (var moneda in monedas)
                                    {
                                        <option value="@moneda.IdMoneda">

                                            @moneda.Nombre

                                        </option>
                                    }

                                </select>

                                <div class="form-text">

                                    El movimiento afectará únicamente
                                    el saldo de la moneda seleccionada.

                                </div>

                            </div>


                            <!-- ================================================= -->
                            <!-- INFORMACIÓN MONEDA -->
                            <!-- ================================================= -->

                            <div id="monedaInfo"
                                 class="alert alert-light border d-none mb-4">

                                <div class="d-flex align-items-center">

                                    <div class="rounded-circle bg-primary bg-opacity-10 p-2 me-3">

                                        <i id="monedaIcono"
                                           class="bi bi-currency-exchange fs-4 text-primary">
                                        </i>

                                    </div>

                                    <div>

                                        <div class="small text-muted">

                                            Moneda seleccionada

                                        </div>

                                        <strong id="monedaTexto"></strong>

                                    </div>

                                </div>

                            </div>


                            <!-- ================================================= -->
                            <!-- MONTO -->
                            <!-- ================================================= -->

                            <div class="mb-4">

                                <label for="monto"
                                       class="form-label fw-semibold">

                                    <i class="bi bi-cash-coin me-1"></i>

                                    Monto

                                </label>


                                <div class="input-group input-group-lg">

                                    <span class="input-group-text"
                                          id="simboloMoneda">

                                        C$

                                    </span>


                                    <input type="number"
                                           id="monto"
                                           name="monto"
                                           class="form-control"
                                           min="0.01"
                                           step="0.01"
                                           inputmode="decimal"
                                           placeholder="0.00"
                                           autocomplete="off"
                                           required />

                                </div>


                                <div id="saldoDisponibleTexto"
                                     class="form-text">

                                    Selecciona una moneda para consultar
                                    el saldo disponible.

                                </div>

                            </div>


                            <!-- ================================================= -->
                            <!-- DESCRIPCIÓN -->
                            <!-- ================================================= -->

                            <div class="mb-4">

                                <label for="descripcion"
                                       class="form-label fw-semibold">

                                    <i class="bi bi-chat-left-text me-1"></i>

                                    Descripción

                                </label>


                                <textarea id="descripcion"
                                          name="descripcion"
                                          class="form-control"
                                          rows="4"
                                          maxlength="250"
                                          placeholder="Describa el motivo del movimiento..."
                                          required></textarea>


                                <div class="form-text d-flex justify-content-between">

                                    <span>

                                        Describe el motivo del ingreso
                                        o egreso.

                                    </span>

                                    <span>

                                        <span id="contadorDescripcion">0</span>/250

                                    </span>

                                </div>

                            </div>


                            <!-- ================================================= -->
                            <!-- RESUMEN -->
                            <!-- ================================================= -->

                            <div class="card bg-light border mb-4">

                                <div class="card-body">

                                    <h6 class="fw-semibold mb-3">

                                        <i class="bi bi-calculator me-2"></i>

                                        Resumen del movimiento

                                    </h6>


                                    <div class="d-flex justify-content-between mb-2">

                                        <span class="text-muted">

                                            Caja

                                        </span>

                                        <strong>

                                            #@Model.IdCaja

                                        </strong>

                                    </div>


                                    <div class="d-flex justify-content-between mb-2">

                                        <span class="text-muted">

                                            Tipo

                                        </span>

                                        <strong id="resumenTipo">

                                            No seleccionado

                                        </strong>

                                    </div>


                                    <div class="d-flex justify-content-between mb-2">

                                        <span class="text-muted">

                                            Moneda

                                        </span>

                                        <strong id="resumenMoneda">

                                            No seleccionada

                                        </strong>

                                    </div>


                                    <hr />


                                    <div class="d-flex justify-content-between align-items-center">

                                        <span class="fw-semibold">

                                            Monto

                                        </span>

                                        <strong id="resumenMonto"
                                                class="fs-5">

                                            C$ 0.00

                                        </strong>

                                    </div>

                                </div>

                            </div>


                            <!-- ================================================= -->
                            <!-- ADVERTENCIA -->
                            <!-- ================================================= -->

                            <div class="alert alert-warning">

                                <div class="d-flex align-items-start">

                                    <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>

                                    <div>

                                        <strong>

                                            Verifica los datos

                                        </strong>

                                        <p class="mb-0 mt-1">

                                            Antes de registrar el movimiento,
                                            verifica tipo, moneda, monto
                                            y descripción.

                                        </p>

                                    </div>

                                </div>

                            </div>


                            <!-- ================================================= -->
                            <!-- BOTONES -->
                            <!-- ================================================= -->

                            <div class="d-flex justify-content-end gap-2 mt-4">

                                <a asp-controller="Caja"
                                   asp-action="Movimientos"
                                   asp-route-id="@Model.IdCaja"
                                   class="btn btn-outline-secondary">

                                    <i class="bi bi-x-circle me-1"></i>

                                    Cancelar

                                </a>


                                <button type="submit"
                                        class="btn btn-primary"
                                        id="btnRegistrarMovimiento">

                                    <i class="bi bi-check-circle me-1"></i>

                                    Registrar movimiento

                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>
    }
    else
    {
        <!-- ========================================================= -->
        <!-- CAJA CERRADA -->
        <!-- ========================================================= -->

        <div class="card shadow-sm border-0">

            <div class="card-body text-center py-5">

                <i class="bi bi-lock-fill display-4 text-secondary"></i>

                <h4 class="mt-3">

                    Caja cerrada

                </h4>

                <p class="text-muted mb-4">

                    La caja #@Model.IdCaja ya fue cerrada.
                    No es posible registrar nuevos movimientos.

                </p>


                <div class="d-flex justify-content-center gap-2 flex-wrap">

                    <a asp-controller="Caja"
                       asp-action="Details"
                       asp-route-id="@Model.IdCaja"
                       class="btn btn-outline-primary">

                        <i class="bi bi-eye me-1"></i>

                        Ver caja

                    </a>


                    <a asp-controller="Caja"
                       asp-action="Movimientos"
                       asp-route-id="@Model.IdCaja"
                       class="btn btn-secondary">

                        <i class="bi bi-list-ul me-1"></i>

                        Ver movimientos

                    </a>

                </div>

            </div>

        </div>
    }


    <!-- ========================================================= -->
    <!-- INFORMACIÓN -->
    <!-- ========================================================= -->

    <div class="alert alert-info mt-4">

        <div class="d-flex align-items-start">

            <i class="bi bi-info-circle-fill fs-4 me-3"></i>

            <div>

                <strong>Información</strong>

                <ul class="mb-0 mt-2">

                    <li>
                        El movimiento se registrará en la
                        <strong>caja #@Model.IdCaja</strong>.
                    </li>

                    <li>
                        Cada movimiento queda asociado
                        a una moneda.
                    </li>

                    <li>
                        Los ingresos aumentan el saldo
                        de la moneda seleccionada.
                    </li>

                    <li>
                        Los egresos disminuyen el saldo
                        de la moneda seleccionada.
                    </li>

                    <li>
                        El movimiento quedará almacenado
                        en el historial de la caja.
                    </li>

                </ul>

            </div>

        </div>

    </div>

</div>


<!-- ============================================================= -->
<!-- JAVASCRIPT -->
<!-- ============================================================= -->

@section Scripts {

<script>

document.addEventListener("DOMContentLoaded", function () {

    const tipoMovimiento =
        document.getElementById("idTipoMovimiento");

    const moneda =
        document.getElementById("idMoneda");

    const monto =
        document.getElementById("monto");

    const descripcion =
        document.getElementById("descripcion");

    const resumenTipo =
        document.getElementById("resumenTipo");

    const resumenMoneda =
        document.getElementById("resumenMoneda");

    const resumenMonto =
        document.getElementById("resumenMonto");

    const simboloMoneda =
        document.getElementById("simboloMoneda");

    const monedaInfo =
        document.getElementById("monedaInfo");

    const monedaTexto =
        document.getElementById("monedaTexto");

    const monedaIcono =
        document.getElementById("monedaIcono");

    const contadorDescripcion =
        document.getElementById("contadorDescripcion");

    const saldoDisponibleTexto =
        document.getElementById("saldoDisponibleTexto");

    const formulario =
        document.getElementById("formRegistrarMovimiento");

    const btnRegistrar =
        document.getElementById("btnRegistrarMovimiento");


    // =========================================================
    // SALDOS DE LA CAJA
    // =========================================================

    const saldoCordobas =
        @saldoCordobas.ToString(
            System.Globalization.CultureInfo.InvariantCulture);

    const saldoDolares =
        @saldoDolares.ToString(
            System.Globalization.CultureInfo.InvariantCulture);


    // =========================================================
    // OBTENER NOMBRE MONEDA
    // =========================================================

    function obtenerNombreMoneda() {

        if (!moneda || !moneda.value)
            return "";

        const opcion =
            moneda.options[moneda.selectedIndex];

        return opcion
            ? opcion.textContent.trim()
            : "";
    }


    // =========================================================
    // OBTENER SÍMBOLO
    // =========================================================

    function obtenerSimboloMoneda(nombre) {

        const texto =
            (nombre || "").toLowerCase();

        if (
            texto.includes("dolar") ||
            texto.includes("dólar") ||
            texto.includes("usd")
        ) {
            return "US$";
        }

        if (
            texto.includes("cordoba") ||
            texto.includes("córdoba") ||
            texto.includes("nio")
        ) {
            return "C$";
        }

        return "$";
    }


    // =========================================================
    // SALDO SEGÚN MONEDA
    // =========================================================

    function obtenerSaldoMoneda(nombre) {

        const simbolo =
            obtenerSimboloMoneda(nombre);

        if (simbolo === "C$")
            return Number(saldoCordobas);

        if (simbolo === "US$")
            return Number(saldoDolares);

        return 0;
    }


    // =========================================================
    // FORMATO
    // =========================================================

    function formatoMoneda(valor) {

        if (!Number.isFinite(valor))
            valor = 0;

        const nombre =
            obtenerNombreMoneda();

        const simbolo =
            obtenerSimboloMoneda(nombre);

        const idioma =
            simbolo === "C$"
                ? "es-NI"
                : "en-US";

        return simbolo + " " +
            new Intl.NumberFormat(
                idioma,
                {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }
            ).format(valor);
    }


    // =========================================================
    // ACTUALIZAR TIPO
    // =========================================================

    function actualizarTipo() {

        if (!tipoMovimiento || !resumenTipo)
            return;

        if (!tipoMovimiento.value) {

            resumenTipo.textContent =
                "No seleccionado";

            return;
        }

        const opcion =
            tipoMovimiento.options[
                tipoMovimiento.selectedIndex
            ];

        resumenTipo.textContent =
            opcion
                ? opcion.textContent.trim()
                : "No seleccionado";
    }


    // =========================================================
    // ACTUALIZAR MONEDA
    // =========================================================

    function actualizarMoneda() {

        if (!moneda)
            return;

        const nombre =
            obtenerNombreMoneda();

        if (!nombre) {

            resumenMoneda.textContent =
                "No seleccionada";

            simboloMoneda.textContent =
                "C$";

            monedaInfo.classList.add("d-none");

            saldoDisponibleTexto.textContent =
                "Selecciona una moneda para consultar el saldo disponible.";

            actualizarMonto();

            return;
        }


        const simbolo =
            obtenerSimboloMoneda(nombre);

        const saldo =
            obtenerSaldoMoneda(nombre);


        simboloMoneda.textContent =
            simbolo;

        resumenMoneda.textContent =
            nombre;

        monedaTexto.textContent =
            nombre;


        if (simbolo === "US$") {

            monedaIcono.className =
                "bi bi-currency-dollar fs-4 text-success";

        }
        else if (simbolo === "C$") {

            monedaIcono.className =
                "bi bi-currency-exchange fs-4 text-primary";

        }
        else {

            monedaIcono.className =
                "bi bi-currency-exchange fs-4 text-primary";
        }


        monedaInfo.classList.remove("d-none");


        saldoDisponibleTexto.innerHTML =
            "Saldo disponible: <strong>" +
            formatoMoneda(saldo) +
            "</strong>";


        actualizarMonto();
    }


    // =========================================================
    // ACTUALIZAR MONTO
    // =========================================================

    function actualizarMonto() {

        if (!monto || !resumenMonto)
            return;

        const valor =
            parseFloat(monto.value);

        resumenMonto.textContent =
            formatoMoneda(
                Number.isFinite(valor)
                    ? valor
                    : 0
            );
    }


    // =========================================================
    // CONTADOR
    // =========================================================

    function actualizarContador() {

        if (!descripcion || !contadorDescripcion)
            return;

        contadorDescripcion.textContent =
            descripcion.value.length;
    }


    // =========================================================
    // EVENTOS
    // =========================================================

    if (tipoMovimiento) {

        tipoMovimiento.addEventListener(
            "change",
            actualizarTipo
        );
    }


    if (moneda) {

        moneda.addEventListener(
            "change",
            actualizarMoneda
        );
    }


    if (monto) {

        monto.addEventListener(
            "input",
            actualizarMonto
        );
    }


    if (descripcion) {

        descripcion.addEventListener(
            "input",
            actualizarContador
        );
    }


    // =========================================================
    // VALIDACIÓN
    // =========================================================

    if (formulario) {

        formulario.addEventListener(
            "submit",
            function (event) {

                const idTipo =
                    tipoMovimiento
                        ? tipoMovimiento.value
                        : "";

                if (!idTipo) {

                    event.preventDefault();

                    alert(
                        "Debes seleccionar un tipo de movimiento."
                    );

                    tipoMovimiento?.focus();

                    return;
                }


                const idMoneda =
                    moneda
                        ? moneda.value
                        : "";

                if (!idMoneda) {

                    event.preventDefault();

                    alert(
                        "Debes seleccionar una moneda."
                    );

                    moneda?.focus();

                    return;
                }


                const valorMonto =
                    monto
                        ? parseFloat(monto.value)
                        : NaN;

                if (
                    !Number.isFinite(valorMonto) ||
                    valorMonto <= 0
                ) {

                    event.preventDefault();

                    alert(
                        "El monto debe ser mayor que cero."
                    );

                    monto?.focus();

                    return;
                }


                const textoDescripcion =
                    descripcion
                        ? descripcion.value.trim()
                        : "";

                if (!textoDescripcion) {

                    event.preventDefault();

                    alert(
                        "Debes ingresar una descripción."
                    );

                    descripcion?.focus();

                    return;
                }


                if (textoDescripcion.length > 250) {

                    event.preventDefault();

                    alert(
                        "La descripción no puede superar los 250 caracteres."
                    );

                    descripcion?.focus();

                    return;
                }


                // =================================================
                // DETERMINAR TIPO
                // =================================================

                const opcionTipo =
                    tipoMovimiento.options[
                        tipoMovimiento.selectedIndex
                    ];

                const tipoSeleccionado =
                    opcionTipo
                        ? opcionTipo.textContent.trim()
                        : "";


                const tipoNormalizado =
                    tipoSeleccionado
                        .toLowerCase();


                const esEgreso =
                    tipoNormalizado.includes("egreso") ||
                    tipoNormalizado.includes("salida") ||
                    tipoNormalizado.includes("retiro") ||
                    tipoNormalizado.includes("gasto") ||
                    tipoNormalizado.includes("compra") ||
                    tipoNormalizado.includes("pago proveedor");


                // =================================================
                // VALIDAR SALDO
                // =================================================

                if (esEgreso) {

                    const nombreMoneda =
                        obtenerNombreMoneda();

                    const saldo =
                        obtenerSaldoMoneda(
                            nombreMoneda
                        );

                    if (valorMonto > saldo) {

                        event.preventDefault();

                        alert(
                            "El monto del egreso (" +
                            formatoMoneda(valorMonto) +
                            ") supera el saldo disponible (" +
                            formatoMoneda(saldo) +
                            ")."
                        );

                        monto?.focus();

                        return;
                    }
                }


                // =================================================
                // CONFIRMACIÓN
                // =================================================

                const monedaSeleccionada =
                    obtenerNombreMoneda();

                const mensaje =
                    "¿Estás seguro de que deseas registrar este movimiento?" +
                    "\n\n" +
                    "Caja: #" +
                    "@Model.IdCaja" +
                    "\n" +
                    "Tipo: " +
                    tipoSeleccionado +
                    "\n" +
                    "Moneda: " +
                    monedaSeleccionada +
                    "\n" +
                    "Monto: " +
                    formatoMoneda(valorMonto) +
                    "\n" +
                    "Descripción: " +
                    textoDescripcion;


                if (!confirm(mensaje)) {

                    event.preventDefault();

                    return;
                }


                // =================================================
                // EVITAR DOBLE ENVÍO
                // =================================================

                if (btnRegistrar) {

                    btnRegistrar.disabled = true;

                    btnRegistrar.innerHTML =
                        '<span class="spinner-border spinner-border-sm me-1"></span>' +
                        'Registrando...';
                }

            }
        );
    }


    // =========================================================
    // INICIALIZAR
    // =========================================================

    actualizarTipo();

    actualizarMoneda();

    actualizarMonto();

    actualizarContador();

});

</script>
}
@model WebApplication1.Models.Pago

@{
    ViewData["Title"] = "Editar Pago";

    var factura = Model.IdFacturaNavigation;
}

<div class="container mt-4">

    <!-- ============================================================
         ENCABEZADO
    ============================================================ -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                <i class="bi bi-pencil-square"></i>
                Editar Pago
            </h2>

            <p class="text-muted mb-0">
                Modifique la información del pago registrado.
            </p>
        </div>

        <a asp-controller="Pago"
           asp-action="Details"
           asp-route-id="@Model.IdPago"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>
            Volver al detalle

        </a>

    </div>


    <!-- ============================================================
         MENSAJES
    ============================================================ -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">

            <i class="bi bi-exclamation-triangle-fill"></i>

            @TempData["Error"]

        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">

            <i class="bi bi-check-circle-fill"></i>

            @TempData["Success"]

        </div>
    }


    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">

            <i class="bi bi-exclamation-triangle-fill"></i>

            <strong>No se pudo actualizar el pago.</strong>

            <div asp-validation-summary="ModelOnly"
                 class="mt-2">
            </div>

        </div>
    }


    <!-- ============================================================
         INFORMACIÓN DEL PAGO
    ============================================================ -->

    <div class="card shadow-sm mb-4">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">

                <i class="bi bi-receipt-cutoff"></i>

                Pago #@Model.IdPago

            </h5>

        </div>

        <div class="card-body">

            <div class="row">

                <!-- PAGO -->

                <div class="col-md-4 mb-3">

                    <label class="text-muted">
                        Número de pago
                    </label>

                    <div class="fw-bold fs-5">
                        #@Model.IdPago
                    </div>

                </div>


                <!-- FACTURA -->

                <div class="col-md-4 mb-3">

                    <label class="text-muted">
                        Factura
                    </label>

                    <div class="fw-bold fs-5">
                        #@Model.IdFactura
                    </div>

                </div>


                <!-- ESTADO -->

                <div class="col-md-4 mb-3">

                    <label class="text-muted">
                        Estado
                    </label>

                    <div>

                        @if (Model.IdEstadoPago == 4)
                        {
                            <span class="badge bg-danger">
                                <i class="bi bi-x-circle"></i>
                                Anulado
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">
                                <i class="bi bi-check-circle"></i>
                                Confirmado
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ============================================================
         INFORMACIÓN DE FACTURA
    ============================================================ -->
    @if (factura != null)
    {
        <div class="card shadow-sm mb-4">

            <div class="card-header">

                <h5 class="mb-0">

                    <i class="bi bi-receipt"></i>

                    Información de la factura

                </h5>

            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-4 mb-3">

                        <label class="text-muted">
                            Factura
                        </label>

                        <div class="fw-bold">
                            #@factura.IdFactura
                        </div>

                    </div>


                    <div class="col-md-4 mb-3">

                        <label class="text-muted">
                            Total
                        </label>

                        <div class="fw-bold">
                            @factura.Total.ToString("N2")
                        </div>

                    </div>


                    <div class="col-md-4 mb-3">

                        <label class="text-muted">
                            Saldo pendiente actual
                        </label>

                        <div class="fw-bold text-danger">
                            @factura.SaldoPendiente.ToString("N2")
                        </div>

                    </div>

                </div>

                <div class="alert alert-info mb-0">

                    <i class="bi bi-info-circle"></i>

                    La factura asociada a un pago existente
                    <strong>no puede cambiarse</strong>.

                    Si necesita registrar el pago para otra factura,
                    debe anular este pago y registrar uno nuevo.

                </div>

            </div>

        </div>
    }


    <!-- ============================================================
         FORMULARIO
    ============================================================ -->

    <form asp-controller="Pago"
          asp-action="Edit"
          asp-route-id="@Model.IdPago"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="IdPago" />

        <input type="hidden"
               asp-for="IdFactura" />


        <div class="card shadow-sm mb-4">

            <div class="card-header bg-light">

                <h5 class="mb-0">

                    <i class="bi bi-credit-card"></i>

                    Datos del pago

                </h5>

            </div>

            <div class="card-body">

                <div class="row">

                    <!-- =================================================
                         FACTURA
                    ================================================== -->

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Factura
                        </label>

                        <input type="text"
                               class="form-control"
                               value="Factura #@Model.IdFactura"
                               readonly />

                        <small class="text-muted">
                            La factura no puede modificarse.
                        </small>

                        <span asp-validation-for="IdFactura"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- =================================================
                         MONTO
                    ================================================== -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="Monto"
                               class="form-label">

                            Monto del pago

                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-cash"></i>
                            </span>

                            <input asp-for="Monto"
                                   class="form-control"
                                   type="number"
                                   step="0.01"
                                   min="0.01" />

                        </div>

                        <span asp-validation-for="Monto"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- =================================================
                         MÉTODO DE PAGO
                    ================================================== -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="IdMetodoPago"
                               class="form-label">

                            Método de pago

                        </label>

                        <select asp-for="IdMetodoPago"
                                class="form-select">

                            <option value="">
                                -- Seleccione método de pago --
                            </option>

                            @if (ViewBag.MetodosPago != null)
                            {
                                foreach (var item in ViewBag.MetodosPago)
                                {
                                    <option value="@item.IdMetodoPago">
                                        @item.Nombre
                                    </option>
                                }
                            }

                        </select>

                        <span asp-validation-for="IdMetodoPago"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- =================================================
                         MONEDA
                    ================================================== -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="IdMoneda"
                               class="form-label">

                            Moneda

                        </label>

                        <select asp-for="IdMoneda"
                                class="form-select">

                            <option value="">
                                -- Seleccione moneda --
                            </option>

                            @if (ViewBag.Monedas != null)
                            {
                                foreach (var item in ViewBag.Monedas)
                                {
                                    <option value="@item.IdMoneda">

                                        @item.Nombre
                                        (@item.CodigoIso)

                                    </option>
                                }
                            }

                        </select>

                        <span asp-validation-for="IdMoneda"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- =================================================
                         BANCO
                    ================================================== -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="IdBanco"
                               class="form-label">

                            Banco

                        </label>

                        <select asp-for="IdBanco"
                                class="form-select">

                            <option value="">
                                -- No aplica --
                            </option>

                            @if (ViewBag.Bancos != null)
                            {
                                foreach (var item in ViewBag.Bancos)
                                {
                                    <option value="@item.IdBanco">

                                        @item.Nombre

                                    </option>
                                }
                            }

                        </select>

                        <span asp-validation-for="IdBanco"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- =================================================
                         TIPO TARJETA
                    ================================================== -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="IdTipoTarjeta"
                               class="form-label">

                            Tipo de tarjeta

                        </label>

                        <select asp-for="IdTipoTarjeta"
                                class="form-select">

                            <option value="">
                                -- No aplica --
                            </option>

                            @if (ViewBag.TiposTarjeta != null)
                            {
                                foreach (var item in ViewBag.TiposTarjeta)
                                {
                                    <option value="@item.IdTipoTarjeta">

                                        @item.Nombre

                                    </option>
                                }
                            }

                        </select>

                        <span asp-validation-for="IdTipoTarjeta"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- =================================================
                         REFERENCIA
                    ================================================== -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="Referencia"
                               class="form-label">

                            Referencia

                        </label>

                        <input asp-for="Referencia"
                               class="form-control"
                               placeholder="Número de referencia" />

                        <span asp-validation-for="Referencia"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- =================================================
                         AUTORIZACIÓN
                    ================================================== -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="NumeroAutorizacion"
                               class="form-label">

                            Número de autorización

                        </label>

                        <input asp-for="NumeroAutorizacion"
                               class="form-control"
                               placeholder="Número de autorización" />

                        <span asp-validation-for="NumeroAutorizacion"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- =================================================
                         MONTO RECIBIDO
                    ================================================== -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="MontoRecibido"
                               class="form-label">

                            Monto recibido

                        </label>

                        <input asp-for="MontoRecibido"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0" />

                        <span asp-validation-for="MontoRecibido"
                              class="text-danger">
                        </span>

                        <small class="text-muted">
                            Opcional. Utilizado cuando se recibe efectivo.
                        </small>

                    </div>


                    <!-- =================================================
                         FECHA
                    ================================================== -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="FechaPago"
                               class="form-label">

                            Fecha del pago

                        </label>

                        <input asp-for="FechaPago"
                               class="form-control"
                               type="datetime-local" />

                        <span asp-validation-for="FechaPago"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- =================================================
                         ESTADO
                    ================================================== -->

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Estado del pago
                        </label>

                        <input type="text"
                               class="form-control"
                               value="Confirmado"
                               readonly />

                        <small class="text-muted">
                            Para anular el pago utilice la opción
                            "Anular pago".
                        </small>

                    </div>


                    <!-- =================================================
                         OBSERVACIÓN
                    ================================================== -->

                    <div class="col-12 mb-3">

                        <label asp-for="Observacion"
                               class="form-label">

                            Observación

                        </label>

                        <textarea asp-for="Observacion"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Observaciones del pago"></textarea>

                        <span asp-validation-for="Observacion"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>


            <!-- ========================================================
                 FOOTER
            ========================================================= -->

            <div class="card-footer">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <a asp-controller="Pago"
                           asp-action="Delete"
                           asp-route-id="@Model.IdPago"
                           class="btn btn-outline-danger">

                            <i class="bi bi-x-circle"></i>

                            Anular pago

                        </a>

                    </div>


                    <div class="d-flex gap-2">

                        <a asp-controller="Pago"
                           asp-action="Details"
                           asp-route-id="@Model.IdPago"
                           class="btn btn-secondary">

                            <i class="bi bi-x-circle"></i>

                            Cancelar

                        </a>

                        <button type="submit"
                                class="btn btn-success">

                            <i class="bi bi-check-circle"></i>

                            Guardar cambios

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            const monto =
                document.getElementById("Monto");

            const montoRecibido =
                document.getElementById("MontoRecibido");

            if (monto && montoRecibido) {

                function validarMontoRecibido() {

                    const valor =
                        parseFloat(monto.value || 0);

                    const recibido =
                        parseFloat(montoRecibido.value || 0);

                    if (recibido > 0 && recibido < valor) {

                        montoRecibido.classList.add("is-invalid");

                    } else {

                        montoRecibido.classList.remove("is-invalid");

                    }
                }

                monto.addEventListener(
                    "input",
                    validarMontoRecibido
                );

                montoRecibido.addEventListener(
                    "input",
                    validarMontoRecibido
                );

            }

        });

    </script>
}
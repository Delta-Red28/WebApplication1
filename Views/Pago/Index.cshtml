@model IEnumerable<WebApplication1.Models.Pago>

@{
    ViewData["Title"] = "Pagos";
}

<div class="container-fluid mt-4">

    <!-- ============================================================
         ENCABEZADO
         ============================================================ -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                <i class="bi bi-cash-coin"></i>
                Pagos
            </h2>

            <p class="text-muted mb-0">
                Gestión y consulta de los pagos registrados.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-controller="Pago"
               asp-action="BuscarPago"
               class="btn btn-outline-primary">

                <i class="bi bi-search"></i>
                Buscar pago

            </a>

            <a asp-controller="Pago"
               asp-action="Create"
               class="btn btn-success">

                <i class="bi bi-plus-circle"></i>
                Registrar pago

            </a>

        </div>

    </div>


    <!-- ============================================================
         MENSAJES
         ============================================================ -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ============================================================
         RESUMEN
         ============================================================ -->
    @{
        var listaPagos = Model?.ToList()
                        ?? new List<WebApplication1.Models.Pago>();

        var totalPagos = listaPagos.Count;

        var pagosConfirmados = listaPagos
            .Count(p => p.IdEstadoPago == 2);

        var pagosAnulados = listaPagos
            .Count(p => p.IdEstadoPago == 4);

        var montoTotal = listaPagos
            .Where(p => p.IdEstadoPago == 2)
            .Sum(p => p.Monto);
    }

    <div class="row mb-4">

        <!-- TOTAL PAGOS -->

        <div class="col-md-3 mb-3">

            <div class="card shadow-sm h-100 border-0">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Total de pagos
                            </p>

                            <h3 class="mb-0">
                                @totalPagos
                            </h3>

                        </div>

                        <div class="bg-primary bg-opacity-10
                            text-primary rounded-circle
                            p-3">

                            <i class="bi bi-receipt fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- CONFIRMADOS -->

        <div class="col-md-3 mb-3">

            <div class="card shadow-sm h-100 border-0">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Confirmados
                            </p>

                            <h3 class="mb-0 text-success">
                                @pagosConfirmados
                            </h3>

                        </div>

                        <div class="bg-success bg-opacity-10
                            text-success rounded-circle
                            p-3">

                            <i class="bi bi-check-circle fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ANULADOS -->

        <div class="col-md-3 mb-3">

            <div class="card shadow-sm h-100 border-0">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Anulados
                            </p>

                            <h3 class="mb-0 text-danger">
                                @pagosAnulados
                            </h3>

                        </div>

                        <div class="bg-danger bg-opacity-10
                            text-danger rounded-circle
                            p-3">

                            <i class="bi bi-x-circle fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- MONTO TOTAL -->

        <div class="col-md-3 mb-3">

            <div class="card shadow-sm h-100 border-0">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Monto confirmado
                            </p>

                            <h3 class="mb-0 text-success">

                                @montoTotal.ToString("N2")

                            </h3>

                        </div>

                        <div class="bg-warning bg-opacity-10
                            text-warning rounded-circle
                            p-3">

                            <i class="bi bi-currency-dollar fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ============================================================
         TABLA
         ============================================================ -->

    <div class="card shadow-sm">

        <div class="card-header bg-white">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0">

                    <i class="bi bi-list-ul"></i>
                    Pagos registrados

                </h5>

                <span class="badge bg-secondary">

                    @totalPagos registros

                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (listaPagos.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover table-striped
                        align-middle mb-0">

                        <thead class="table-dark">

                            <tr>

                                <th class="text-center">
                                    #
                                </th>

                                <th>
                                    Factura
                                </th>

                                <th>
                                    Fecha
                                </th>

                                <th>
                                    Método
                                </th>

                                <th>
                                    Moneda
                                </th>

                                <th class="text-end">
                                    Monto
                                </th>

                                <th>
                                    Referencia
                                </th>

                                <th class="text-center">
                                    Estado
                                </th>

                                <th class="text-center"
                                    style="min-width: 190px;">
                                    Acciones
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var pago in listaPagos)
                            {
                                <tr>

                                    <!-- ID PAGO -->

                                    <td class="text-center">

                                        <span class="fw-bold">
                                            @pago.IdPago
                                        </span>

                                    </td>


                                    <!-- FACTURA -->

                                    <td>

                                        @if (pago.IdFacturaNavigation != null)
                                        {
                                            <span class="fw-bold">

                                                #@pago.IdFactura

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                #@pago.IdFactura
                                            </span>
                                        }

                                    </td>


                                    <!-- FECHA -->

                                    <td>

                                        <div class="fw-semibold">

                                            @pago.FechaPago.ToString("dd/MM/yyyy")

                                        </div>

                                        <small class="text-muted">

                                            @pago.FechaPago.ToString("hh:mm tt")

                                        </small>

                                    </td>


                                    <!-- MÉTODO -->

                                    <td>

                                        @if (pago.IdMetodoPagoNavigation != null)
                                        {
                                            <span>

                                                @pago.IdMetodoPagoNavigation.Nombre

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No especificado
                                            </span>
                                        }

                                    </td>


                                    <!-- MONEDA -->

                                    <td>

                                        @if (pago.IdMonedaNavigation != null)
                                        {
                                            <span>

                                                @pago.IdMonedaNavigation.Nombre

                                            </span>

                                            @if (!string.IsNullOrWhiteSpace(
                                                pago.IdMonedaNavigation.CodigoIso))
                                            {
                                                <small class="text-muted">

                                                    (@pago.IdMonedaNavigation.CodigoIso)

                                                </small>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No especificada
                                            </span>
                                        }

                                    </td>


                                    <!-- MONTO -->

                                    <td class="text-end">

                                        <span class="fw-bold">

                                            @pago.Monto.ToString("N2")

                                        </span>

                                    </td>


                                    <!-- REFERENCIA -->

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(
                                            pago.Referencia))
                                        {
                                            <span>
                                                @pago.Referencia
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <!-- ESTADO -->

                                    <td class="text-center">

                                        @if (pago.IdEstadoPago == 2)
                                        {
                                            <span class="badge bg-success">

                                                <i class="bi bi-check-circle"></i>
                                                Confirmado

                                            </span>
                                        }
                                        else if (pago.IdEstadoPago == 4)
                                        {
                                            <span class="badge bg-danger">

                                                <i class="bi bi-x-circle"></i>
                                                Anulado

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">

                                                @if (pago.IdEstadoPagoNavigation != null)
                                                {
                                                    @pago.IdEstadoPagoNavigation.Nombre
                                                }
                                                else
                                                {
                                                    <text>Estado</text>
                                                }

                                            </span>
                                        }

                                    </td>


                                    <!-- ACCIONES -->

                                    <td>

                                        <div class="d-flex justify-content-center
                                            gap-1">

                                            <!-- VER -->

                                            <a asp-controller="Pago"
                                               asp-action="Details"
                                               asp-route-id="@pago.IdPago"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Ver pago">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            <!-- EDITAR -->
                                            @if (pago.IdEstadoPago != 4)
                                            {
                                                <a asp-controller="Pago"
                                                   asp-action="Edit"
                                                   asp-route-id="@pago.IdPago"
                                                   class="btn btn-sm btn-outline-warning"
                                                   title="Editar pago">

                                                    <i class="bi bi-pencil"></i>

                                                </a>
                                            }


                                            <!-- PAGOS DE LA FACTURA -->

                                            <a asp-controller="Pago"
                                               asp-action="PorFactura"
                                               asp-route-id="@pago.IdFactura"
                                               class="btn btn-sm btn-outline-info"
                                               title="Ver pagos de la factura">

                                                <i class="bi bi-list-check"></i>

                                            </a>


                                            <!-- ANULAR -->
                                            @if (pago.IdEstadoPago != 4)
                                            {
                                                <a asp-controller="Pago"
                                                   asp-action="Delete"
                                                   asp-route-id="@pago.IdPago"
                                                   class="btn btn-sm btn-outline-danger"
                                                   title="Anular pago">

                                                    <i class="bi bi-x-circle"></i>

                                                </a>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- ====================================================
                     SIN REGISTROS
                     ==================================================== -->

                <div class="text-center py-5">

                    <div class="mb-3">

                        <i class="bi bi-cash-stack text-muted"
                           style="font-size: 4rem;">
                        </i>

                    </div>

                    <h5 class="text-muted">
                        No hay pagos registrados
                    </h5>

                    <p class="text-muted mb-4">
                        Todavía no se ha registrado ningún pago.
                    </p>

                    <a asp-controller="Pago"
                       asp-action="Create"
                       class="btn btn-success">

                        <i class="bi bi-plus-circle"></i>
                        Registrar primer pago

                    </a>

                </div>
            }

        </div>

    </div>

</div>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            /*
             * Inicialización de tooltips de Bootstrap.
             */

            const tooltipTriggerList =
                document.querySelectorAll(
                    '[title]'
                );

            tooltipTriggerList.forEach(function(element) {

                if (typeof bootstrap !== "undefined") {

                    new bootstrap.Tooltip(element);

                }

            });

        });

    </script>

}
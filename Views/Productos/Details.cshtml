@model WebApplication1.Models.Producto

@{
    ViewData["Title"] = "Detalle del platillo";
}

<div class="container-fluid">

    <!-- ============================================================
         ENCABEZADO
         ============================================================ -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-egg-fried text-primary me-2"></i>

                @Model.Nombre

            </h2>

            <p class="text-muted mb-0">

                Información del platillo

            </p>

        </div>


        <div class="d-flex gap-2">

            <!-- EDITAR -->

            <a asp-action="Edit"
               asp-route-id="@Model.IdProducto"
               class="btn btn-primary">

                <i class="bi bi-pencil me-1"></i>

                Editar

            </a>


            <!-- VOLVER A CATEGORÍA -->

            <a asp-controller="Categorias"
               asp-action="Details"
               asp-route-id="@Model.IdCategoria"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>

                Volver a categoría

            </a>

        </div>

    </div>


    <!-- ============================================================
         MENSAJES
         ============================================================ -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Mensaje"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ============================================================
         CONTENIDO PRINCIPAL
         ============================================================ -->

    <div class="row g-4">


        <!-- ========================================================
             IMAGEN
             ======================================================== -->

        <div class="col-lg-5">

            <div class="card border-0 shadow-sm overflow-hidden h-100">

                @if (!string.IsNullOrWhiteSpace(Model.Imagen))
                {
                    <img src="@Model.Imagen"
                         alt="@Model.Nombre"
                         class="detail-image" />
                }
                else
                {
                    <div class="detail-placeholder">

                        <i class="bi bi-image fs-1"></i>

                        <span>
                            Este platillo no tiene imagen
                        </span>

                    </div>
                }

            </div>

        </div>


        <!-- ========================================================
             INFORMACIÓN
             ======================================================== -->

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">


                    <!-- =================================================
                         ESTADOS
                         ================================================= -->

                    <div class="d-flex gap-2 mb-3">

                        @if (Model.Estado)
                        {
                            <span class="badge
                                rounded-pill
                                bg-success-subtle
                                text-success">

                                <i class="bi bi-check-circle me-1"></i>

                                Activo

                            </span>
                        }
                        else
                        {
                            <span class="badge
                                rounded-pill
                                bg-secondary-subtle
                                text-secondary">

                                <i class="bi bi-pause-circle me-1"></i>

                                Inactivo

                            </span>
                        }


                        <!-- ESTADO DEL PRODUCTO -->
                        @if (Model.IdEstadoProductoNavigation != null)
                        {
                            <span class="badge
                                rounded-pill
                                bg-primary-subtle
                                text-primary">

                                <i class="bi bi-info-circle me-1"></i>

                                @Model.IdEstadoProductoNavigation.Nombre

                            </span>
                        }

                    </div>


                    <!-- =================================================
                         NOMBRE
                         ================================================= -->

                    <h2 class="fw-bold">

                        @Model.Nombre

                    </h2>


                    <!-- =================================================
                         CATEGORÍA
                         ================================================= -->

                    <div class="mb-4">

                        <span class="text-muted">

                            Categoría:

                        </span>

                        @if (Model.IdCategoriaNavigation != null)
                        {
                            <a asp-controller="Categorias"
                               asp-action="Details"
                               asp-route-id="@Model.IdCategoria"
                               class="fw-semibold text-decoration-none">

                                @Model.IdCategoriaNavigation.Nombre

                            </a>
                        }
                        else
                        {
                            <span class="text-muted">

                                Categoría no disponible

                            </span>
                        }

                    </div>


                    <!-- =================================================
                         DESCRIPCIÓN
                         ================================================= -->

                    <div class="mb-4">

                        <h6 class="fw-bold">

                            Descripción

                        </h6>

                        @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
                        {
                            <p class="text-muted mb-0">

                                @Model.Descripcion

                            </p>
                        }
                        else
                        {
                            <p class="text-muted fst-italic mb-0">

                                Sin descripción.

                            </p>
                        }

                    </div>


                    <!-- =================================================
                         PRECIO
                         ================================================= -->

                    <div class="border rounded p-3 mb-4">

                        <div class="text-muted small">

                            Precio de venta

                        </div>

                        <div class="fs-2 fw-bold text-primary">

                            C$ @Model.PrecioVenta.ToString("N2")

                        </div>

                    </div>


                    <!-- =================================================
                         DATOS DEL PRODUCTO
                         ================================================= -->

                    <div class="row g-3">


                        <!-- CÓDIGO -->

                        <div class="col-md-6">

                            <div class="border rounded p-3 h-100">

                                <div class="text-muted small">

                                    Código

                                </div>

                                <div class="fw-bold">

                                    @Model.CodigoProducto

                                </div>

                            </div>

                        </div>


                        <!-- COSTO -->

                        <div class="col-md-6">

                            <div class="border rounded p-3 h-100">

                                <div class="text-muted small">

                                    Costo

                                </div>

                                <div class="fw-bold">

                                    @if (Model.Costo.HasValue)
                                    {
                                        <span>

                                            C$ @Model.Costo.Value.ToString("N2")

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">

                                            No registrado

                                        </span>
                                    }

                                </div>

                            </div>

                        </div>


                        <!-- TIEMPO DE PREPARACIÓN -->

                        <div class="col-md-6">

                            <div class="border rounded p-3 h-100">

                                <div class="text-muted small">

                                    Preparación

                                </div>

                                <div class="fw-bold">

                                    @if (Model.TiempoPreparacion.HasValue)
                                    {
                                        <span>

                                            <i class="bi bi-clock me-1"></i>

                                            @Model.TiempoPreparacion minutos

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">

                                            No especificado

                                        </span>
                                    }

                                </div>

                            </div>

                        </div>


                        <!-- CONTROL DE INVENTARIO -->

                        <div class="col-md-6">

                            <div class="border rounded p-3 h-100">

                                <div class="text-muted small">

                                    Control de Inventario

                                </div>

                                <div class="fw-bold">

                                    @if (Model.ControlaInventario)
                                    {
                                        <span class="text-success">

                                            <i class="bi bi-check-circle me-1"></i>

                                            Controlado

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">

                                            <i class="bi bi-x-circle me-1"></i>

                                            No controlado

                                        </span>
                                    }

                                </div>

                            </div>

                        </div>



                        <!-- ID PRODUCTO -->

                        <div class="col-md-6">

                            <div class="border rounded p-3 h-100">

                                <div class="text-muted small">

                                    ID del platillo

                                </div>

                                <div class="fw-bold">

                                    #@Model.IdProducto

                                </div>

                            </div>

                        </div>


                        <!-- FECHA DE REGISTRO -->

                        <div class="col-md-6">

                            <div class="border rounded p-3 h-100">

                                <div class="text-muted small">

                                    Fecha de registro

                                </div>

                                <div class="fw-bold">

                                    @(
                                        Model.FechaRegistro?.ToString("dd/MM/yyyy HH:mm")
                                        ?? "Sin fecha"
                                    )

                                </div>

                            </div>

                        </div>

                    </div>


                    <hr class="my-4" />


                    <!-- =================================================
                         ACTIVAR / DESACTIVAR
                         ================================================= -->
                    @if (Model.Estado)
                    {
                        <form asp-action="Desactivar"
                              asp-route-id="@Model.IdProducto"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-danger w-100"
                                    onclick="return confirm('¿Deseas desactivar este platillo?');">

                                <i class="bi bi-pause-circle me-1"></i>

                                Desactivar platillo

                            </button>

                        </form>
                    }
                    else
                    {
                        <form asp-action="Activar"
                              asp-route-id="@Model.IdProducto"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-success w-100">

                                <i class="bi bi-check-circle me-1"></i>

                                Activar platillo

                            </button>

                        </form>
                    }

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ================================================================
     ESTILOS
     ================================================================ -->

<style>

    .detail-image {
        width: 100%;
        height: 500px;
        object-fit: cover;
    }

    .detail-placeholder {
        width: 100%;
        height: 500px;
        background: #f8f9fa;
        color: #adb5bd;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

</style>
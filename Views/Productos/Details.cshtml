@model WebApplication1.Models.Producto

@using WebApplication1.Models

@{
    ViewData["Title"] = "Detalle del platillo";

    var existencias =
        ViewBag.Existencias as Dictionary<int, List<Existencium>>
        ?? new Dictionary<int, List<Existencium>>();

    decimal? unidadesPreparables =
        ViewBag.UnidadesPreparables as decimal?;
}

<div class="container-fluid">

    <!-- ============================================================
         ENCABEZADO
         ============================================================ -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-egg-fried text-primary me-2"></i>

                @Model.Nombre

            </h2>

            <p class="text-muted mb-0">

                Información del platillo

            </p>

        </div>


        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.IdProducto"
               class="btn btn-primary">

                <i class="bi bi-pencil me-1"></i>

                Editar

            </a>


            <a asp-controller="Categorias"
               asp-action="Details"
               asp-route-id="@Model.IdCategoria"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>

                Volver a categoría

            </a>

        </div>

    </div>


    <!-- ============================================================
         MENSAJE
         ============================================================ -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Mensaje"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ============================================================
         INFORMACIÓN PRINCIPAL
         ============================================================ -->

    <div class="row g-4">


        <!-- ========================================================
             IMAGEN
             ======================================================== -->

        <div class="col-lg-5">

            <div class="card border-0 shadow-sm overflow-hidden">

                @if (!string.IsNullOrWhiteSpace(Model.Imagen))
                {
                    <img src="@Model.Imagen"
                         alt="@Model.Nombre"
                         class="detail-image" />
                }
                else
                {
                    <div class="detail-placeholder">

                        <i class="bi bi-image fs-1"></i>

                        <span>
                            Este platillo no tiene imagen
                        </span>

                    </div>
                }

            </div>


            <!-- ====================================================
                 DISPONIBILIDAD
                 ==================================================== -->
            @if (Model.ControlaInventario)
            {
                <div class="card border-0 shadow-sm mt-4">

                    <div class="card-body p-4">

                        <div class="d-flex align-items-center mb-3">

                            <div class="availability-icon me-3">

                                <i class="bi bi-box-seam"></i>

                            </div>

                            <div>

                                <h5 class="fw-bold mb-0">

                                    Disponibilidad

                                </h5>

                                <small class="text-muted">

                                    Según el inventario actual

                                </small>

                            </div>

                        </div>


                        @if (Model.Recetum != null &&
                             Model.Recetum.DetalleReceta.Any())
                        {
                            @if (unidadesPreparables.HasValue)
                            {
                                if (unidadesPreparables.Value > 0)
                                {
                                    <div class="availability-success">

                                        <div class="fs-1 fw-bold text-success">

                                            @unidadesPreparables.Value.ToString("N0")

                                        </div>

                                        <div class="text-muted">

                                            platillos disponibles para preparar

                                        </div>

                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-danger mb-0">

                                        <i class="bi bi-exclamation-circle me-2"></i>

                                        No hay inventario suficiente para
                                        preparar este platillo.

                                    </div>
                                }
                            }
                            else
                            {
                                <div class="alert alert-warning mb-0">

                                    <i class="bi bi-exclamation-triangle me-2"></i>

                                    No se pudo determinar la disponibilidad.

                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-secondary mb-0">

                                <i class="bi bi-info-circle me-2"></i>

                                Este platillo todavía no tiene una receta
                                registrada.

                            </div>
                        }

                    </div>

                </div>
            }

        </div>


        <!-- ========================================================
             INFORMACIÓN DEL PRODUCTO
             ======================================================== -->

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">


                    <!-- =================================================
                         ESTADOS
                         ================================================= -->

                    <div class="d-flex gap-2 mb-3 flex-wrap">

                        @if (Model.Estado)
                        {
                            <span class="badge rounded-pill
                                bg-success-subtle
                                text-success">

                                <i class="bi bi-check-circle me-1"></i>

                                Activo

                            </span>
                        }
                        else
                        {
                            <span class="badge rounded-pill
                                bg-secondary-subtle
                                text-secondary">

                                <i class="bi bi-pause-circle me-1"></i>

                                Inactivo

                            </span>
                        }


                        @if (Model.IdEstadoProductoNavigation != null)
                        {
                            <span class="badge rounded-pill
                                bg-primary-subtle
                                text-primary">

                                <i class="bi bi-info-circle me-1"></i>

                                @Model.IdEstadoProductoNavigation.Nombre

                            </span>
                        }


                        @if (Model.ControlaInventario)
                        {
                            <span class="badge rounded-pill
                                bg-warning-subtle
                                text-warning-emphasis">

                                <i class="bi bi-box-seam me-1"></i>

                                Controla inventario

                            </span>
                        }

                    </div>


                    <!-- =================================================
                         NOMBRE
                         ================================================= -->

                    <h2 class="fw-bold">

                        @Model.Nombre

                    </h2>


                    <!-- =================================================
                         CATEGORÍA
                         ================================================= -->

                    <div class="mb-4">

                        <span class="text-muted">

                            Categoría:

                        </span>

                        @if (Model.IdCategoriaNavigation != null)
                        {
                            <a asp-controller="Categorias"
                               asp-action="Details"
                               asp-route-id="@Model.IdCategoria"
                               class="fw-semibold text-decoration-none">

                                @Model.IdCategoriaNavigation.Nombre

                            </a>
                        }
                        else
                        {
                            <span class="text-muted">

                                Categoría no disponible

                            </span>
                        }

                    </div>


                    <!-- =================================================
                         DESCRIPCIÓN
                         ================================================= -->

                    <div class="mb-4">

                        <h6 class="fw-bold">

                            Descripción

                        </h6>

                        @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
                        {
                            <p class="text-muted mb-0">

                                @Model.Descripcion

                            </p>
                        }
                        else
                        {
                            <p class="text-muted fst-italic mb-0">

                                Sin descripción.

                            </p>
                        }

                    </div>


                    <!-- =================================================
                         PRECIO
                         ================================================= -->

                    <div class="border rounded p-3 mb-4">

                        <div class="text-muted small">

                            Precio de venta

                        </div>

                        <div class="fs-2 fw-bold text-primary">

                            C$ @Model.PrecioVenta.ToString("N2")

                        </div>

                    </div>


                    <!-- =================================================
                         DATOS
                         ================================================= -->

                    <div class="row g-3">


                        <!-- CÓDIGO -->

                        <div class="col-md-6">

                            <div class="border rounded p-3 h-100">

                                <div class="text-muted small">

                                    Código

                                </div>

                                <div class="fw-bold">

                                    @Model.CodigoProducto

                                </div>

                            </div>

                        </div>


                        <!-- COSTO -->

                        <div class="col-md-6">

                            <div class="border rounded p-3 h-100">

                                <div class="text-muted small">

                                    Costo

                                </div>

                                <div class="fw-bold">

                                    @if (Model.Costo.HasValue)
                                    {
                                        <span>

                                            C$ @Model.Costo.Value.ToString("N2")

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">

                                            No registrado

                                        </span>
                                    }

                                </div>

                            </div>

                        </div>


                        <!-- TIEMPO -->

                        <div class="col-md-6">

                            <div class="border rounded p-3 h-100">

                                <div class="text-muted small">

                                    Preparación

                                </div>

                                <div class="fw-bold">

                                    @if (Model.TiempoPreparacion.HasValue)
                                    {
                                        <span>

                                            <i class="bi bi-clock me-1"></i>

                                            @Model.TiempoPreparacion minutos

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">

                                            No especificado

                                        </span>
                                    }

                                </div>

                            </div>

                        </div>


                        <!-- CONTROL INVENTARIO -->

                        <div class="col-md-6">

                            <div class="border rounded p-3 h-100">

                                <div class="text-muted small">

                                    Control de inventario

                                </div>

                                <div class="fw-bold">

                                    @if (Model.ControlaInventario)
                                    {
                                        <span class="text-success">

                                            <i class="bi bi-check-circle me-1"></i>

                                            Controlado

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">

                                            <i class="bi bi-x-circle me-1"></i>

                                            No controlado

                                        </span>
                                    }

                                </div>

                            </div>

                        </div>


                        <!-- ID -->

                        <div class="col-md-6">

                            <div class="border rounded p-3 h-100">

                                <div class="text-muted small">

                                    ID del platillo

                                </div>

                                <div class="fw-bold">

                                    #@Model.IdProducto

                                </div>

                            </div>

                        </div>


                        <!-- FECHA -->

                        <div class="col-md-6">

                            <div class="border rounded p-3 h-100">

                                <div class="text-muted small">

                                    Fecha de registro

                                </div>

                                <div class="fw-bold">

                                    @(
                                        Model.FechaRegistro?.ToString(
                                            "dd/MM/yyyy HH:mm")
                                        ?? "Sin fecha"
                                    )

                                </div>

                            </div>

                        </div>

                    </div>


                    <hr class="my-4" />


                    <!-- =================================================
                         ACTIVAR / DESACTIVAR
                         ================================================= -->
                    @if (Model.Estado)
                    {
                        <form asp-action="Desactivar"
                              asp-route-id="@Model.IdProducto"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-danger w-100"
                                    onclick="return confirm('¿Deseas desactivar este platillo?');">

                                <i class="bi bi-pause-circle me-1"></i>

                                Desactivar platillo

                            </button>

                        </form>
                    }
                    else
                    {
                        <form asp-action="Activar"
                              asp-route-id="@Model.IdProducto"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-success w-100">

                                <i class="bi bi-check-circle me-1"></i>

                                Activar platillo

                            </button>

                        </form>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- ============================================================
         RECETA
         ============================================================ -->
    @if (Model.Recetum != null)
    {
        <div class="card border-0 shadow-sm mt-4">

            <div class="card-body p-4">


                <!-- ENCABEZADO -->

                <div class="d-flex justify-content-between
                    align-items-center mb-4">

                    <div>

                        <h4 class="fw-bold mb-1">

                            <i class="bi bi-journal-text text-primary me-2"></i>

                            Receta

                        </h4>

                        <p class="text-muted mb-0">

                            Ingredientes necesarios para preparar
                            @Model.Nombre

                        </p>

                    </div>


                    <div class="text-end">

                        <span class="badge bg-primary-subtle text-primary">

                            Versión @Model.Recetum.Version

                        </span>

                    </div>

                </div>


                <!-- INFORMACIÓN DE RECETA -->

                <div class="row g-3 mb-4">


                    <div class="col-md-4">

                        <div class="border rounded p-3 h-100">

                            <div class="text-muted small">

                                Estado de receta

                            </div>

                            <div class="fw-bold">

                                @if (Model.Recetum.IdEstadoRecetaNavigation != null)
                                {
                                    @Model.Recetum.IdEstadoRecetaNavigation.Nombre
                                }
                                else
                                {
                                    <span class="text-muted">

                                        No disponible

                                    </span>
                                }

                            </div>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="border rounded p-3 h-100">

                            <div class="text-muted small">

                                Rendimiento

                            </div>

                            <div class="fw-bold">

                                @Model.Recetum.Rendimiento.ToString("N2")

                                porciones

                            </div>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="border rounded p-3 h-100">

                            <div class="text-muted small">

                                Ingredientes

                            </div>

                            <div class="fw-bold">

                                @Model.Recetum.DetalleReceta.Count

                            </div>

                        </div>

                    </div>

                </div>


                @if (Model.Recetum.DetalleReceta.Any())
                {
                    <!-- =================================================
                         TABLA DE INGREDIENTES
                         ================================================= -->

                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead class="table-light">

                                <tr>

                                    <th>
                                        Ingrediente
                                    </th>

                                    <th>
                                        Cantidad
                                    </th>

                                    <th>
                                        Existencia
                                    </th>

                                    <th>
                                        Ubicación
                                    </th>

                                    <th>
                                        Estado
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var detalle
                                    in Model.Recetum.DetalleReceta)
                                {
                                    var tieneExistencia =
                                        existencias.TryGetValue(
                                            detalle.IdInsumo,
                                            out var listaExistencias);


                                    var stockTotal =
                                        tieneExistencia &&
                                        listaExistencias != null
                                            ? listaExistencias.Sum(
                                                e => e.StockActual)
                                            : 0;


                                    var necesita =
                                        detalle.Cantidad;


                                    var suficiente =
                                        stockTotal >= necesita;


                                    <tr>


                                        <!-- INGREDIENTE -->

                                        <td>

                                            <div class="fw-semibold">

                                                @detalle.IdInsumoNavigation.Nombre

                                            </div>

                                            <small class="text-muted">

                                                @detalle.IdInsumoNavigation.CodigoInsumo

                                            </small>

                                        </td>


                                        <!-- CANTIDAD -->

                                        <td>

                                            <span class="fw-bold">

                                                @detalle.Cantidad.ToString("N3")

                                            </span>

                                            <span class="text-muted">

                                                @detalle.IdUnidadMedidaNavigation.Nombre

                                            </span>

                                        </td>


                                        <!-- EXISTENCIA -->

                                        <td>

                                            @if (tieneExistencia &&
                                                 listaExistencias != null &&
                                                 listaExistencias.Any())
                                            {
                                                <div class="fw-bold">

                                                    @stockTotal.ToString("N2")

                                                </div>

                                                <small class="text-muted">

                                                    total disponible

                                                </small>
                                            }
                                            else
                                            {
                                                <span class="text-danger">

                                                    Sin existencia

                                                </span>
                                            }

                                        </td>


                                        <!-- UBICACIONES -->

                                        <td>

                                            @if (tieneExistencia &&
                                                 listaExistencias != null &&
                                                 listaExistencias.Any())
                                            {
                                                foreach (var existencia
                                                    in listaExistencias)
                                                {
                                                    <div class="mb-1">

                                                        <span>

                                                            @existencia
                                                            .IdUbicacionNavigation
                                                            .Nombre

                                                        </span>

                                                        <span class="text-muted">

                                                            (
                                                            @existencia.StockActual.ToString("N2")
                                                            )

                                                        </span>

                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">

                                                    No disponible

                                                </span>
                                            }

                                        </td>


                                        <!-- ESTADO -->

                                        <td>

                                            @if (suficiente)
                                            {
                                                <span class="badge
                                                    rounded-pill
                                                    bg-success-subtle
                                                    text-success">

                                                    <i class="bi bi-check-circle me-1"></i>

                                                    Suficiente

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge
                                                    rounded-pill
                                                    bg-danger-subtle
                                                    text-danger">

                                                    <i class="bi bi-exclamation-circle me-1"></i>

                                                    Insuficiente

                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="alert alert-warning mb-0">

                        <i class="bi bi-exclamation-triangle me-2"></i>

                        La receta no tiene ingredientes registrados.

                    </div>
                }


                <!-- OBSERVACIÓN -->
                @if (!string.IsNullOrWhiteSpace(
                                    Model.Recetum.Observacion))
                {
                    <div class="alert alert-light border mt-4 mb-0">

                        <strong>

                            Observación:

                        </strong>

                        @Model.Recetum.Observacion

                    </div>
                }

            </div>

        </div>
    }
    else
    {
        <!-- =========================================================
             SIN RECETA
             ========================================================= -->

        <div class="card border-0 shadow-sm mt-4">

            <div class="card-body p-4 text-center">

                <div class="empty-recipe-icon mb-3">

                    <i class="bi bi-journal-x"></i>

                </div>

                <h5 class="fw-bold">

                    Este platillo no tiene receta

                </h5>

                <p class="text-muted mb-0">

                    Todavía no se han registrado ingredientes
                    para este platillo.

                </p>

            </div>

        </div>
    }

</div>


<!-- ================================================================
     ESTILOS
     ================================================================ -->

<style>

    .detail-image {
        width: 100%;
        height: 500px;
        object-fit: cover;
    }


    .detail-placeholder {
        width: 100%;
        height: 500px;
        background: #f8f9fa;
        color: #adb5bd;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }


    .availability-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        background: #e7f1ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
    }


    .availability-success {
        background: #f0fff4;
        border: 1px solid #d1e7dd;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
    }


    .empty-recipe-icon {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        background: #f8f9fa;
        color: #adb5bd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
    }


    .table th {
        white-space: nowrap;
    }

</style>
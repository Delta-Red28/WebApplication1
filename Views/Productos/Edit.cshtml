@model WebApplication1.Models.Producto

@{
    ViewData["Title"] = "Editar platillo";
}

<div class="container-fluid">

    <!-- ============================================================
         ENCABEZADO
         ============================================================ -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-pencil-square text-primary me-2"></i>

                Editar platillo

            </h2>

            <p class="text-muted mb-0">

                Modifica la información del producto.

            </p>

        </div>


        <a asp-action="Details"
           asp-route-id="@Model.IdProducto"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>

            Volver

        </a>

    </div>


    <!-- ============================================================
         FORMULARIO
         ============================================================ -->

    <div class="row justify-content-center">

        <div class="col-xl-9 col-lg-11">

            <div class="card border-0 shadow-sm">


                <!-- =================================================
                     CABECERA
                     ================================================= -->

                <div class="card-header bg-white border-0 py-3">

                    <div class="d-flex align-items-center">

                        <div class="rounded-3
                            bg-primary
                            bg-opacity-10
                            text-primary
                            p-3
                            me-3">

                            <i class="bi bi-egg-fried fs-4"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-1">

                                @Model.Nombre

                            </h5>

                            <small class="text-muted">

                                Producto #@Model.IdProducto

                            </small>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     CUERPO
                     ================================================= -->

                <div class="card-body p-4">

                    <form asp-action="Edit"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- ID -->

                        <input type="hidden"
                               asp-for="IdProducto" />


                        <!-- ERRORES -->

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>


                        <div class="row g-4">


                            <!-- =================================================
                                 NOMBRE
                                 ================================================= -->

                            <div class="col-md-8">

                                <label asp-for="Nombre"
                                       class="form-label fw-semibold">

                                    Nombre del platillo

                                </label>

                                <input asp-for="Nombre"
                                       class="form-control"
                                       placeholder="Ej. Hamburguesa clásica" />

                                <span asp-validation-for="Nombre"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- =================================================
                                 CÓDIGO
                                 ================================================= -->

                            <div class="col-md-4">

                                <label asp-for="CodigoProducto"
                                       class="form-label fw-semibold">

                                    Código

                                </label>

                                <input asp-for="CodigoProducto"
                                       class="form-control"
                                       placeholder="Ej. HAM-001" />

                                <span asp-validation-for="CodigoProducto"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- =================================================
                                 CATEGORÍA
                                 ================================================= -->

                            <div class="col-md-6">

                                <label asp-for="IdCategoria"
                                       class="form-label fw-semibold">

                                    Categoría

                                </label>

                                <select asp-for="IdCategoria"
                                        asp-items="ViewBag.Categorias"
                                        class="form-select">

                                    <option value="">
                                        -- Selecciona una categoría --
                                    </option>

                                </select>

                                <span asp-validation-for="IdCategoria"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- =================================================
                                 ESTADO DEL PRODUCTO
                                 ================================================= -->

                            <div class="col-md-6">

                                <label asp-for="IdEstadoProducto"
                                       class="form-label fw-semibold">

                                    Estado del producto

                                </label>

                                <select asp-for="IdEstadoProducto"
                                        asp-items="ViewBag.EstadosProducto"
                                        class="form-select">

                                    <option value="">
                                        -- Selecciona un estado --
                                    </option>

                                </select>

                                <span asp-validation-for="IdEstadoProducto"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- =================================================
                                 DESCRIPCIÓN
                                 ================================================= -->

                            <div class="col-12">

                                <label asp-for="Descripcion"
                                       class="form-label fw-semibold">

                                    Descripción

                                </label>

                                <textarea asp-for="Descripcion"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Describe el platillo..."></textarea>

                                <span asp-validation-for="Descripcion"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- =================================================
                                 PRECIO
                                 ================================================= -->

                            <div class="col-md-4">

                                <label asp-for="PrecioVenta"
                                       class="form-label fw-semibold">

                                    Precio de venta

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        C$
                                    </span>

                                    <input asp-for="PrecioVenta"
                                           class="form-control"
                                           type="number"
                                           step="0.01"
                                           min="0" />

                                </div>

                                <span asp-validation-for="PrecioVenta"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- =================================================
                                 COSTO
                                 ================================================= -->

                            <div class="col-md-4">

                                <label asp-for="Costo"
                                       class="form-label fw-semibold">

                                    Costo

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        C$
                                    </span>

                                    <input asp-for="Costo"
                                           class="form-control"
                                           type="number"
                                           step="0.01"
                                           min="0" />

                                </div>

                                <span asp-validation-for="Costo"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- =================================================
                                 TIEMPO DE PREPARACIÓN
                                 ================================================= -->

                            <div class="col-md-4">

                                <label asp-for="TiempoPreparacion"
                                       class="form-label fw-semibold">

                                    Tiempo de preparación

                                </label>

                                <div class="input-group">

                                    <input asp-for="TiempoPreparacion"
                                           class="form-control"
                                           type="number"
                                           min="0"
                                           step="1"
                                           inputmode="numeric" />

                                    <span class="input-group-text">
                                        minutos
                                    </span>

                                </div>

                                <span asp-validation-for="TiempoPreparacion"
                                      class="text-danger small">
                                </span>

                                <div class="form-text">

                                    Ingresa el tiempo en minutos enteros.

                                </div>

                            </div>


                            <!-- =================================================
                                 IMAGEN
                                 ================================================= -->

                            <div class="col-12">

                                <label asp-for="Imagen"
                                       class="form-label fw-semibold">

                                    Imagen

                                </label>

                                <input asp-for="Imagen"
                                       class="form-control"
                                       placeholder="URL de la imagen" />

                                <span asp-validation-for="Imagen"
                                      class="text-danger small">
                                </span>

                                @if (!string.IsNullOrWhiteSpace(Model.Imagen))
                                {
                                    <div class="mt-3">

                                        <small class="text-muted d-block mb-2">

                                            Imagen actual

                                        </small>

                                        <img src="@Model.Imagen"
                                             alt="@Model.Nombre"
                                             class="edit-image-preview" />

                                    </div>
                                }

                            </div>


                            <!-- =================================================
                                 CONTROL DE INVENTARIO
                                 ================================================= -->

                            <div class="col-12">

                                <div class="border rounded p-3">

                                    <div class="form-check form-switch">

                                        <input asp-for="ControlaInventario"
                                               class="form-check-input"
                                               type="checkbox" />

                                        <label asp-for="ControlaInventario"
                                               class="form-check-label fw-semibold">

                                            Control de Inventario

                                        </label>

                                    </div>

                                    <small class="text-muted">

                                        Activa esta opción si este platillo
                                        debe estar relacionado con el control
                                        de inventario.

                                    </small>

                                </div>

                            </div>

                        </div>


                        <hr class="my-4" />


                        <!-- =================================================
                             INFORMACIÓN DEL SISTEMA
                             ================================================= -->

                        <h6 class="fw-bold mb-3">

                            <i class="bi bi-info-circle text-primary me-1"></i>

                            Información del sistema

                        </h6>


                        <div class="row g-3 mb-4">


                            <!-- ID -->

                            <div class="col-md-6">

                                <div class="border rounded p-3 h-100">

                                    <div class="text-muted small">

                                        ID del producto

                                    </div>

                                    <div class="fw-bold">

                                        #@Model.IdProducto

                                    </div>

                                </div>

                            </div>


                            <!-- FECHA -->

                            <div class="col-md-6">

                                <div class="border rounded p-3 h-100">

                                    <div class="text-muted small">

                                        Fecha de registro

                                    </div>

                                    <div class="fw-bold">

                                        @(
                                            Model.FechaRegistro?.ToString("dd/MM/yyyy HH:mm")
                                            ?? "Sin fecha"
                                        )

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- =================================================
                             ESTADO ACTUAL
                             ================================================= -->

                        <div class="alert
                            @(Model.Estado
                                ? "alert-success"
                                : "alert-secondary")">

                            <div class="d-flex">

                                @if (Model.Estado)
                                {
                                    <i class="bi bi-check-circle-fill
                                    me-2
                                    mt-1"></i>

                                    <div>

                                        <strong>
                                            Platillo activo
                                        </strong>

                                        <div class="small">

                                            El platillo está disponible
                                            actualmente.

                                        </div>

                                        <div class="small mt-1">

                                            Puedes desactivarlo desde
                                            su página de detalles.

                                        </div>

                                    </div>
                                }
                                else
                                {
                                    <i class="bi bi-pause-circle-fill
                                    me-2
                                    mt-1"></i>

                                    <div>

                                        <strong>
                                            Platillo inactivo
                                        </strong>

                                        <div class="small">

                                            El platillo está desactivado
                                            actualmente.

                                        </div>

                                        <div class="small mt-1">

                                            Puedes activarlo desde
                                            su página de detalles.

                                        </div>

                                    </div>
                                }

                            </div>

                        </div>


                        <!-- =================================================
                             BOTONES
                             ================================================= -->

                        <div class="d-flex
                            justify-content-end
                            gap-2">

                            <a asp-action="Details"
                               asp-route-id="@Model.IdProducto"
                               class="btn btn-outline-secondary">

                                <i class="bi bi-x-lg me-1"></i>

                                Cancelar

                            </a>

                            <button type="submit"
                                    class="btn btn-primary px-4">

                                <i class="bi bi-check-lg me-1"></i>

                                Guardar cambios

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ================================================================
     ESTILOS
     ================================================================ -->

<style>

    .edit-image-preview {
        width: 220px;
        height: 160px;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid #dee2e6;
    }

</style>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        // ============================================================
        // TIEMPO DE PREPARACIÓN: SOLO NÚMEROS ENTEROS
        // ============================================================

        const tiempoPreparacion =
            document.getElementById("TiempoPreparacion");

        if (tiempoPreparacion) {

            tiempoPreparacion.addEventListener("input", function() {

                this.value =
                    this.value.replace(/[^\d]/g, "");

            });

        }

    </script>

}
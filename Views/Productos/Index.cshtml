@model IEnumerable<WebApplication1.Models.Producto>

@{
    ViewData["Title"] = "Platillos";

    var productos = Model?.ToList()
        ?? new List<WebApplication1.Models.Producto>();

    var totalProductos = productos.Count;

    var productosActivos = productos.Count(p => p.Estado);

    var productosInactivos = totalProductos - productosActivos;
}

<div class="container-fluid">

    <!-- ENCABEZADO -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-egg-fried text-primary me-2"></i>

                Platillos

            </h2>

            <p class="text-muted mb-0">

                Administra los productos y platillos del restaurante

            </p>

        </div>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-lg me-1"></i>

            Nuevo platillo

        </a>

    </div>


    <!-- MENSAJES -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Mensaje"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- RESUMEN -->

    <div class="row g-3 mb-4">

        <!-- TOTAL -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="rounded-circle
                        bg-primary
                        bg-opacity-10
                        text-primary
                        p-3
                        me-3">

                        <i class="bi bi-egg-fried fs-4"></i>

                    </div>

                    <div>

                        <div class="text-muted small">
                            Total de platillos
                        </div>

                        <div class="fs-4 fw-bold">
                            @totalProductos
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ACTIVOS -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="rounded-circle
                        bg-success
                        bg-opacity-10
                        text-success
                        p-3
                        me-3">

                        <i class="bi bi-check-circle-fill fs-4"></i>

                    </div>

                    <div>

                        <div class="text-muted small">
                            Platillos activos
                        </div>

                        <div class="fs-4 fw-bold text-success">
                            @productosActivos
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- INACTIVOS -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="rounded-circle
                        bg-secondary
                        bg-opacity-10
                        text-secondary
                        p-3
                        me-3">

                        <i class="bi bi-pause-circle-fill fs-4"></i>

                    </div>

                    <div>

                        <div class="text-muted small">
                            Platillos inactivos
                        </div>

                        <div class="fs-4 fw-bold text-secondary">
                            @productosInactivos
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- LISTADO -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <h5 class="fw-bold mb-1">
                Todos los platillos
            </h5>

            <small class="text-muted">
                Administra los productos registrados en el restaurante.
            </small>

        </div>


        <div class="card-body">

            @if (productos.Any())
            {
                <div class="row g-4">

                    @foreach (var producto in productos)
                    {
                        <div class="col-xl-4 col-lg-6">

                            <div class="card border h-100 product-card">

                                <!-- IMAGEN -->
                                @if (!string.IsNullOrWhiteSpace(producto.Imagen))
                                {
                                    <img src="@producto.Imagen"
                                         alt="@producto.Nombre"
                                         class="product-image" />
                                }
                                else
                                {
                                    <div class="product-placeholder">

                                        <i class="bi bi-image fs-1"></i>

                                        <span>Sin imagen</span>

                                    </div>
                                }


                                <div class="card-body">

                                    <div class="d-flex
                                        justify-content-between
                                        align-items-start
                                        mb-2">

                                        <!-- CATEGORÍA -->

                                        <span class="badge
                                            bg-primary-subtle
                                            text-primary">

                                            @(producto.IdCategoriaNavigation?.Nombre
                                                ?? "Sin categoría")

                                        </span>


                                        <!-- ESTADO -->
                                        @if (producto.Estado)
                                        {
                                            <span class="badge
                                                rounded-pill
                                                bg-success-subtle
                                                text-success">

                                                Activo

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge
                                                rounded-pill
                                                bg-secondary-subtle
                                                text-secondary">

                                                Inactivo

                                            </span>
                                        }

                                    </div>


                                    <!-- NOMBRE -->

                                    <h5 class="fw-bold mb-1">

                                        @producto.Nombre

                                    </h5>


                                    <!-- CÓDIGO -->

                                    <small class="text-muted">

                                        Código:
                                        @producto.CodigoProducto

                                    </small>


                                    <!-- DESCRIPCIÓN -->
                                    @if (!string.IsNullOrWhiteSpace(producto.Descripcion))
                                    {
                                        <p class="text-muted small mt-3">

                                            @producto.Descripcion

                                        </p>
                                    }


                                    <!-- PRECIO / ESTADO PRODUCTO -->

                                    <div class="d-flex
                                        justify-content-between
                                        align-items-center
                                        mt-3">

                                        <span class="fs-5
                                            fw-bold
                                            text-primary">

                                            C$ @producto.PrecioVenta.ToString("N2")

                                        </span>


                                        <span class="small text-muted">

                                            @(producto.IdEstadoProductoNavigation?.Nombre
                                                ?? "Sin estado")

                                        </span>

                                    </div>

                                </div>


                                <!-- BOTONES -->

                                <div class="card-footer
                                    bg-white
                                    border-0
                                    pt-0
                                    pb-3">

                                    <div class="d-flex gap-2">

                                        <a asp-action="Details"
                                           asp-route-id="@producto.IdProducto"
                                           class="btn btn-sm
                                            btn-outline-secondary
                                            flex-fill">

                                            <i class="bi bi-eye me-1"></i>

                                            Ver

                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@producto.IdProducto"
                                           class="btn btn-sm
                                            btn-outline-primary
                                            flex-fill">

                                            <i class="bi bi-pencil me-1"></i>

                                            Editar

                                        </a>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <div class="rounded-circle
                        bg-primary
                        bg-opacity-10
                        text-primary
                        d-inline-flex
                        align-items-center
                        justify-content-center
                        p-4
                        mb-3">

                        <i class="bi bi-egg-fried fs-1"></i>

                    </div>

                    <h5 class="fw-bold">
                        Aún no hay platillos
                    </h5>

                    <p class="text-muted mb-4">
                        Crea el primer platillo del restaurante.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">

                        <i class="bi bi-plus-lg me-1"></i>

                        Crear primer platillo

                    </a>

                </div>
            }

        </div>

    </div>

</div>


<style>

    .product-card {
        transition: all .2s ease;
        overflow: hidden;
    }

        .product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 .4rem 1rem rgba(0,0,0,.10);
        }

    .product-image {
        width: 100%;
        height: 200px;
        object-fit: cover;
    }

    .product-placeholder {
        width: 100%;
        height: 200px;
        background: #f8f9fa;
        color: #adb5bd;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

</style>
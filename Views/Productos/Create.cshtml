@model WebApplication1.Models.Producto

@{
    ViewData["Title"] = "Nuevo platillo";
}

<div class="container-fluid">

    <!-- ============================================================
         ENCABEZADO
         ============================================================ -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-plus-circle text-primary me-2"></i>

                Nuevo platillo

            </h2>

            <p class="text-muted mb-0">

                Registra un nuevo producto en el menú.

            </p>

        </div>


        <!-- VOLVER A LA CATEGORÍA -->
        @if (Model.IdCategoria > 0)
        {
            <a asp-controller="Categorias"
               asp-action="Details"
               asp-route-id="@Model.IdCategoria"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>

                Volver a categoría

            </a>
        }
        else
        {
            <a asp-controller="Productos"
               asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>

                Volver

            </a>
        }

    </div>


    <div class="row justify-content-center">

        <div class="col-xl-9 col-lg-11">

            <div class="card border-0 shadow-sm">

                <!-- ====================================================
                     CABECERA
                     ==================================================== -->

                <div class="card-header bg-white border-0 py-3">

                    <div class="d-flex align-items-center">

                        <div class="rounded-3
                            bg-primary
                            bg-opacity-10
                            text-primary
                            p-3
                            me-3">

                            <i class="bi bi-egg-fried fs-4"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-1">

                                Información del platillo

                            </h5>

                            <small class="text-muted">

                                Completa los datos del producto.

                            </small>

                        </div>

                    </div>

                </div>


                <!-- ====================================================
                     FORMULARIO
                     ==================================================== -->

                <div class="card-body p-4">

                    <form asp-controller="Productos"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- =================================================
                             RESUMEN DE ERRORES
                             ================================================= -->
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger">

                                <div class="d-flex">

                                    <i class="bi bi-exclamation-triangle-fill me-2 mt-1"></i>

                                    <div>

                                        <strong>
                                            No se pudo guardar el platillo.
                                        </strong>

                                        <div class="mt-2">

                                            Revisa los siguientes errores:

                                        </div>

                                        <ul class="mb-0 mt-2">

                                            @foreach (var error in ViewData.ModelState.Values
                                                .SelectMany(v => v.Errors))
                                            {
                                                <li>
                                                    @error.ErrorMessage
                                                </li>
                                            }

                                        </ul>

                                    </div>

                                </div>

                            </div>
                        }


                        <div class="row g-4">


                            <!-- =================================================
                                 NOMBRE
                                 ================================================= -->

                            <div class="col-md-8">

                                <label asp-for="Nombre"
                                       class="form-label fw-semibold">

                                    Nombre del platillo

                                </label>

                                <input asp-for="Nombre"
                                       class="form-control"
                                       placeholder="Ej. Hamburguesa clásica" />

                                <span asp-validation-for="Nombre"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- =================================================
                                 CÓDIGO
                                 ================================================= -->

                            <div class="col-md-4">

                                <label asp-for="CodigoProducto"
                                       class="form-label fw-semibold">

                                    Código

                                </label>

                                <input asp-for="CodigoProducto"
                                       class="form-control"
                                       placeholder="Ej. HAM-001" />

                                <span asp-validation-for="CodigoProducto"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- =================================================
                                 CATEGORÍA
                                 ================================================= -->

                            <div class="col-md-6">

                                <label asp-for="IdCategoria"
                                       class="form-label fw-semibold">

                                    Categoría

                                </label>

                                <select asp-for="IdCategoria"
                                        asp-items="ViewBag.Categorias"
                                        class="form-select">

                                    <option value="">

                                        -- Selecciona una categoría --

                                    </option>

                                </select>

                                <span asp-validation-for="IdCategoria"
                                      class="text-danger small">
                                </span>

                                @if (Model.IdCategoria > 0)
                                {
                                    <div class="form-text text-success">

                                        <i class="bi bi-check-circle me-1"></i>

                                        Categoría seleccionada automáticamente.

                                    </div>
                                }

                            </div>


                            <!-- =================================================
                                 ESTADO
                                 ================================================= -->

                            <div class="col-md-6">

                                <label asp-for="IdEstadoProducto"
                                       class="form-label fw-semibold">

                                    Estado del producto

                                </label>

                                <select asp-for="IdEstadoProducto"
                                        asp-items="ViewBag.EstadosProducto"
                                        class="form-select">

                                    <option value="">

                                        -- Selecciona un estado --

                                    </option>

                                </select>

                                <span asp-validation-for="IdEstadoProducto"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- =================================================
                                 DESCRIPCIÓN
                                 ================================================= -->

                            <div class="col-12">

                                <label asp-for="Descripcion"
                                       class="form-label fw-semibold">

                                    Descripción

                                </label>

                                <textarea asp-for="Descripcion"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Describe el platillo..."></textarea>

                                <span asp-validation-for="Descripcion"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- =================================================
                                 PRECIO
                                 ================================================= -->

                            <div class="col-md-4">

                                <label asp-for="PrecioVenta"
                                       class="form-label fw-semibold">

                                    Precio de venta

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        C$
                                    </span>

                                    <input asp-for="PrecioVenta"
                                           class="form-control"
                                           type="number"
                                           step="0.01"
                                           min="0" />

                                </div>

                                <span asp-validation-for="PrecioVenta"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- =================================================
                                 COSTO
                                 ================================================= -->

                            <div class="col-md-4">

                                <label asp-for="Costo"
                                       class="form-label fw-semibold">

                                    Costo

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        C$
                                    </span>

                                    <input asp-for="Costo"
                                           class="form-control"
                                           type="number"
                                           step="0.01"
                                           min="0" />

                                </div>

                                <span asp-validation-for="Costo"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- =================================================
                                 TIEMPO
                                 ================================================= -->

                            <div class="col-md-4">

                                <label asp-for="TiempoPreparacion"
                                       class="form-label fw-semibold">

                                    Tiempo de preparación

                                </label>

                                <div class="input-group">

                                    <input asp-for="TiempoPreparacion"
                                           class="form-control"
                                           type="number"
                                           min="0" />

                                    <span class="input-group-text">

                                        minutos

                                    </span>

                                </div>

                                <span asp-validation-for="TiempoPreparacion"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- =================================================
                                 IMAGEN
                                 ================================================= -->

                            <div class="col-12">

                                <label asp-for="Imagen"
                                       class="form-label fw-semibold">

                                    Imagen

                                </label>

                                <input asp-for="Imagen"
                                       class="form-control"
                                       placeholder="Ruta o URL de la imagen" />

                                <span asp-validation-for="Imagen"
                                      class="text-danger small">
                                </span>

                                <div class="form-text">

                                    Puedes colocar la ruta o URL
                                    correspondiente a la imagen.

                                </div>

                            </div>


                            <!-- =================================================
                                 INVENTARIO
                                 ================================================= -->
                            <!-- CONTROL DE INVENTARIO -->

                            <div class="col-12">

                                <div class="form-check form-switch">

                                    <input asp-for="ControlaInventario"
                                           class="form-check-input"
                                           type="checkbox" />

                                    <label asp-for="ControlaInventario"
                                           class="form-check-label fw-semibold">

                                        Control de Inventario

                                    </label>

                                </div>

                                <div class="form-text">

                                    Activa esta opción si deseas llevar el control
                                    de inventario de este platillo.

                                </div>

                            </div>

                        </div>


                        <hr class="my-4" />


                        <!-- =================================================
                             BOTONES
                             ================================================= -->

                        <div class="d-flex
                            justify-content-end
                            gap-2">

                            @if (Model.IdCategoria > 0)
                            {
                                <a asp-controller="Categorias"
                                   asp-action="Details"
                                   asp-route-id="@Model.IdCategoria"
                                   class="btn btn-outline-secondary">

                                    Cancelar

                                </a>
                            }
                            else
                            {
                                <a asp-controller="Productos"
                                   asp-action="Index"
                                   class="btn btn-outline-secondary">

                                    Cancelar

                                </a>
                            }


                            <button type="submit"
                                    class="btn btn-primary px-4">

                                <i class="bi bi-check-lg me-1"></i>

                                Guardar platillo

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
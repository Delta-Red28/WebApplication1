@model IEnumerable<WebApplication1.ViewModels.InventarioViewModel>

@{
    ViewData["Title"] = "Inventario";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="h3 mb-1">Inventario</h1>
            <p class="text-muted mb-0">
                Existencias actuales de los insumos
            </p>
        </div>

        <div>
            <a asp-controller="MovimientosInventario"
               asp-action="Crear"
               class="btn btn-primary">
                <i class="bi bi-plus-circle"></i>
                Nuevo movimiento
            </a>
        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Insumo</th>
                            <th>Unidad</th>
                            <th>Ubicación</th>
                            <th>Stock</th>
                            <th>Mínimo</th>
                            <th>Máximo</th>
                            <th>Estado</th>
                            <th>Actualización</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @item.CodigoInsumo
                                    </strong>
                                </td>

                                <td>
                                    @item.NombreInsumo
                                </td>

                                <td>
                                    @item.AbreviaturaUnidad
                                </td>

                                <td>
                                    @item.Ubicacion
                                </td>

                                <td>
                                    <strong>
                                        @item.StockActual.ToString("N2")
                                    </strong>
                                </td>

                                <td>
                                    @item.StockMinimo.ToString("N2")
                                </td>

                                <td>
                                    @(item.StockMaximo?.ToString("N2") ?? "-")
                                </td>

                                <td>

                                    @if (item.StockAgotado)
                                    {
                                        <span class="badge bg-danger">
                                            Agotado
                                        </span>
                                    }
                                    else if (item.StockBajo)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Stock bajo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            Normal
                                        </span>
                                    }

                                </td>

                                <td>
                                    @item.UltimaActualizacion.ToString(
                                        "dd/MM/yyyy HH:mm")
                                </td>

                                <td>

                                    <a asp-action="Detalle"
                                       asp-route-idInsumo="@item.IdInsumo"
                                       asp-route-idUbicacion="@item.IdUbicacion"
                                       class="btn btn-sm btn-outline-primary">
                                        Ver
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
@model WebApplication1.Models.Factura

@{
    ViewData["Title"] = "Crear Factura";

    var pedidos = ViewBag.Pedidos as List<WebApplication1.Models.Pedido>
                   ?? new List<WebApplication1.Models.Pedido>();

    var monedas = ViewBag.Monedas as List<WebApplication1.Models.Monedum>
                   ?? new List<WebApplication1.Models.Monedum>();

    var tiposComprobante = ViewBag.TiposComprobante as List<WebApplication1.Models.TipoComprobante>
                           ?? new List<WebApplication1.Models.TipoComprobante>();

    var seriesFactura = ViewBag.SeriesFactura as List<WebApplication1.Models.SerieFactura>
                        ?? new List<WebApplication1.Models.SerieFactura>();

    var impuestos = ViewBag.Impuestos as List<WebApplication1.Models.Impuesto>
                    ?? new List<WebApplication1.Models.Impuesto>();

    var pedidoSeleccionado = ViewBag.Pedido as WebApplication1.Models.Pedido;

    /*
     * ============================================================
     * PEDIDO ACTUAL
     * ============================================================
     */

    WebApplication1.Models.Pedido? pedidoActual = pedidoSeleccionado;

    if (pedidoActual == null && Model.IdPedido > 0)
    {
        pedidoActual = pedidos.FirstOrDefault(
            p => p.IdPedido == Model.IdPedido
        );
    }

    /*
     * ============================================================
     * IMPUESTO ACTUAL
     * ============================================================
     */

    WebApplication1.Models.Impuesto? impuestoSeleccionado = null;

    if (Model.IdImpuesto.HasValue && Model.IdImpuesto.Value > 0)
    {
        impuestoSeleccionado = impuestos.FirstOrDefault(
            i => i.IdImpuesto == Model.IdImpuesto.Value
        );
    }

    decimal porcentajeImpuesto =
        impuestoSeleccionado?.Porcentaje ?? 0m;
}

<div class="container mt-4">

    <!-- ============================================================
         ENCABEZADO
    ============================================================ -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="mb-1">
                <i class="bi bi-receipt"></i>
                Crear Factura
            </h2>

            <p class="text-muted mb-0">
                Registra una nueva factura a partir de un pedido.
            </p>

        </div>

        <div>

            <a asp-controller="Factura"
               asp-action="Index"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left"></i>
                Volver

            </a>

        </div>

    </div>


    <!-- ============================================================
         MENSAJE TEMPORAL DE ERROR
    ============================================================ -->

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">

            <i class="bi bi-exclamation-triangle-fill"></i>

            @TempData["Error"]

        </div>
    }


    <!-- ============================================================
         VALIDACIONES
    ============================================================ -->

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">

            <h6 class="alert-heading">

                <i class="bi bi-exclamation-triangle-fill"></i>

                No se pudo crear la factura

            </h6>

            <div asp-validation-summary="All"></div>

        </div>
    }


    <!-- ============================================================
         PEDIDO SELECCIONADO
    ============================================================ -->

    @if (pedidoActual != null)
    {
        <div class="alert alert-info">

            <div class="d-flex align-items-center">

                <i class="bi bi-cart-check fs-3 me-3"></i>

                <div>

                    <strong>
                        Facturando pedido @pedidoActual.NumeroPedido
                    </strong>

                    <div class="small">

                        Total original del pedido:

                        <strong>
                            @pedidoActual.Total.ToString("N2")
                        </strong>

                    </div>

                </div>

            </div>

        </div>
    }


    <!-- ============================================================
         FORMULARIO
    ============================================================ -->

    <form asp-controller="Factura"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()


        <!-- ========================================================
             PEDIDO
        ======================================================== -->

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-primary text-white">

                <h5 class="mb-0">

                    <i class="bi bi-cart"></i>

                    Pedido

                </h5>

            </div>

            <div class="card-body">

                <div class="row">

                    <!-- PEDIDO -->

                    <div class="col-md-8 mb-3">

                        <label asp-for="IdPedido"
                               class="form-label fw-bold">

                            Pedido
                            <span class="text-danger">*</span>

                        </label>

                        @if (pedidoActual != null)
                        {
                            <select class="form-select"
                                    disabled>

                                <option value="@pedidoActual.IdPedido">

                                    @pedidoActual.NumeroPedido
                                    -
                                    Total:
                                    @pedidoActual.Total.ToString("N2")

                                </option>

                            </select>

                            <!--
                                El select está disabled y por lo tanto
                                no se envía al servidor.

                                Este hidden sí se envía.
                            -->

                            <input type="hidden"
                                   asp-for="IdPedido" />
                        }
                        else
                        {
                            <select asp-for="IdPedido"
                                    id="IdPedido"
                                    class="form-select">

                                <option value="0">
                                    -- Seleccione un pedido --
                                </option>

                                @foreach (var pedido in pedidos)
                                {
                                    <option value="@pedido.IdPedido"
                                            data-subtotal="@pedido.Subtotal.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-descuento="@pedido.Descuento.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-total="@pedido.Total.ToString(System.Globalization.CultureInfo.InvariantCulture)">

                                        @pedido.NumeroPedido
                                        -
                                        @pedido.FechaPedido.ToString("dd/MM/yyyy HH:mm")
                                        -
                                        Total:
                                        @pedido.Total.ToString("N2")

                                    </option>
                                }

                            </select>
                        }

                        <span asp-validation-for="IdPedido"
                              class="text-danger">
                        </span>

                        <div class="form-text">

                            Seleccione el pedido que desea facturar.

                        </div>

                    </div>


                    <!-- FECHA -->

                    <div class="col-md-4 mb-3">

                        <label asp-for="FechaFactura"
                               class="form-label fw-bold">

                            Fecha de factura
                            <span class="text-danger">*</span>

                        </label>

                        <input asp-for="FechaFactura"
                               type="datetime-local"
                               class="form-control" />

                        <span asp-validation-for="FechaFactura"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- ========================================================
             DATOS DEL COMPROBANTE
        ======================================================== -->

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-light">

                <h5 class="mb-0">

                    <i class="bi bi-file-earmark-text"></i>

                    Datos del comprobante

                </h5>

            </div>

            <div class="card-body">

                <div class="row">

                    <!-- TIPO COMPROBANTE -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="IdTipoComprobante"
                               class="form-label fw-bold">

                            Tipo de comprobante
                            <span class="text-danger">*</span>

                        </label>

                        <select asp-for="IdTipoComprobante"
                                class="form-select">

                            <option value="0">
                                -- Seleccione un tipo de comprobante --
                            </option>

                            @foreach (var tipo in tiposComprobante)
                            {
                                <option value="@tipo.IdTipoComprobante">

                                    @tipo.Nombre

                                </option>
                            }

                        </select>

                        <span asp-validation-for="IdTipoComprobante"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- SERIE -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="IdSerieFactura"
                               class="form-label fw-bold">

                            Serie
                            <span class="text-danger">*</span>

                        </label>

                        <select asp-for="IdSerieFactura"
                                class="form-select">

                            <option value="0">
                                -- Seleccione una serie --
                            </option>

                            @foreach (var serie in seriesFactura)
                            {
                                <option value="@serie.IdSerieFactura">

                                    @serie.Nombre
                                    (@serie.Prefijo)

                                </option>
                            }

                        </select>

                        <span asp-validation-for="IdSerieFactura"
                              class="text-danger">
                        </span>

                        <div class="form-text">

                            El número de factura será generado
                            automáticamente.

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ========================================================
             MONEDA E IMPUESTO
        ======================================================== -->

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-light">

                <h5 class="mb-0">

                    <i class="bi bi-currency-exchange"></i>

                    Configuración fiscal y monetaria

                </h5>

            </div>

            <div class="card-body">

                <div class="row">

                    <!-- MONEDA -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="IdMoneda"
                               class="form-label fw-bold">

                            Moneda
                            <span class="text-danger">*</span>

                        </label>

                        <select asp-for="IdMoneda"
                                class="form-select">

                            <option value="0">
                                -- Seleccione una moneda --
                            </option>

                            @foreach (var moneda in monedas)
                            {
                                <option value="@moneda.IdMoneda">

                                    @moneda.Nombre
                                    (@moneda.CodigoIso)

                                    @if (!string.IsNullOrWhiteSpace(moneda.Simbolo))
                                    {
                                        @: - @moneda.Simbolo
                                    }

                                </option>
                            }

                        </select>

                        <span asp-validation-for="IdMoneda"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- IMPUESTO -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="IdImpuesto"
                               class="form-label fw-bold">

                            Impuesto / IVA
                            <span class="text-danger">*</span>

                        </label>

                        <select asp-for="IdImpuesto"
                                id="IdImpuesto"
                                class="form-select">

                            <option value="">
                                -- Seleccione un impuesto --
                            </option>

                            @foreach (var impuesto in impuestos)
                            {
                                <option value="@impuesto.IdImpuesto"
                                        data-porcentaje="@impuesto.Porcentaje.ToString(System.Globalization.CultureInfo.InvariantCulture)">

                                    @impuesto.Nombre
                                    -
                                    @impuesto.Porcentaje.ToString("N2")%

                                </option>
                            }

                        </select>

                        <span asp-validation-for="IdImpuesto"
                              class="text-danger">
                        </span>

                        <div class="form-text">

                            El porcentaje seleccionado se utilizará
                            para calcular el IVA de la factura.

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ========================================================
             RESUMEN DE LA FACTURA
        ======================================================== -->

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-success text-white">

                <h5 class="mb-0">

                    <i class="bi bi-calculator"></i>

                    Resumen de la factura

                </h5>

            </div>

            <div class="card-body">

                <div class="alert alert-info">

                    <i class="bi bi-info-circle"></i>

                    Los importes se calculan automáticamente.
                    El IVA se calcula utilizando el porcentaje
                    seleccionado en el campo Impuesto / IVA.

                </div>


                <div class="row">

                    <!-- ==================================================
                         SUBTOTAL
                    ================================================== -->

                    <div class="col-md-3 mb-3">

                        <label class="text-muted">
                            Subtotal
                        </label>

                        <div id="resumenSubtotal"
                             class="form-control bg-light fw-bold">

                            @Model.Subtotal.ToString("N2")

                        </div>

                    </div>


                    <!-- ==================================================
                         DESCUENTO
                    ================================================== -->

                    <div class="col-md-3 mb-3">

                        <label class="text-muted">
                            Descuento
                        </label>

                        <div id="resumenDescuento"
                             class="form-control bg-light fw-bold">

                            @Model.Descuento.ToString("N2")

                        </div>

                    </div>


                    <!-- ==================================================
                         BASE IMPONIBLE
                    ================================================== -->

                    <div class="col-md-3 mb-3">

                        <label class="text-muted">
                            Base imponible
                        </label>

                        <div id="resumenBase"
                             class="form-control bg-light fw-bold">

                            0.00

                        </div>

                    </div>


                    <!-- ==================================================
                         IVA
                    ================================================== -->

                    <div class="col-md-3 mb-3">

                        <label class="text-muted">
                            IVA / Impuesto
                        </label>

                        <div id="resumenImpuesto"
                             class="form-control bg-light fw-bold text-primary">

                            @Model.Impuesto.ToString("N2")

                        </div>

                        <div class="small text-muted mt-1">

                            Porcentaje aplicado:

                            <strong id="resumenPorcentajeImpuesto">
                                @porcentajeImpuesto.ToString("N2")%
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- ==================================================
                     TOTAL
                ================================================== -->

                <div class="row mt-2">

                    <div class="col-md-6">

                        <label class="text-muted">
                            Total factura
                        </label>

                        <div id="resumenTotal"
                             class="form-control bg-light fw-bold text-success fs-4">

                            @Model.Total.ToString("N2")

                        </div>

                    </div>


                    <!-- SALDO -->

                    <div class="col-md-6">

                        <label class="text-muted">
                            Saldo pendiente inicial
                        </label>

                        <div id="resumenSaldo"
                             class="form-control bg-light fw-bold text-danger fs-4">

                            @Model.SaldoPendiente.ToString("N2")

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ========================================================
             OBSERVACIÓN
        ======================================================== -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">

                <h5 class="mb-0">

                    <i class="bi bi-chat-left-text"></i>

                    Observación

                </h5>

            </div>

            <div class="card-body">

                <label asp-for="Observacion"
                       class="form-label">

                    Observación

                </label>

                <textarea asp-for="Observacion"
                          class="form-control"
                          rows="4"
                          maxlength="300"
                          placeholder="Ingrese una observación opcional..."></textarea>

                <span asp-validation-for="Observacion"
                      class="text-danger">
                </span>

                <div class="form-text">

                    Máximo 300 caracteres.

                </div>

            </div>

        </div>


        <!-- ========================================================
             NÚMERO DE FACTURA
        ======================================================== -->

        <div class="alert alert-secondary">

            <div class="d-flex">

                <i class="bi bi-hash fs-4 me-3"></i>

                <div>

                    <strong>
                        Número de factura
                    </strong>

                    <p class="mb-0">

                        El número de factura será generado
                        automáticamente al guardar.

                    </p>

                </div>

            </div>

        </div>


        <!-- ========================================================
             BOTONES
        ======================================================== -->

        <div class="card shadow-sm mb-4">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <a asp-controller="Factura"
                       asp-action="Index"
                       class="btn btn-secondary">

                        <i class="bi bi-x-circle"></i>

                        Cancelar

                    </a>

                    <button type="submit"
                            class="btn btn-primary btn-lg">

                        <i class="bi bi-check-circle"></i>

                        Crear factura

                    </button>

                </div>

            </div>

        </div>

    </form>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            /*
             * ========================================================
             * ELEMENTOS
             * ========================================================
             */

            const pedidoSelect =
                document.getElementById("IdPedido");

            const impuestoSelect =
                document.getElementById("IdImpuesto");

            const subtotalElement =
                document.getElementById("resumenSubtotal");

            const descuentoElement =
                document.getElementById("resumenDescuento");

            const baseElement =
                document.getElementById("resumenBase");

            const impuestoElement =
                document.getElementById("resumenImpuesto");

            const totalElement =
                document.getElementById("resumenTotal");

            const saldoElement =
                document.getElementById("resumenSaldo");

            const porcentajeElement =
                document.getElementById("resumenPorcentajeImpuesto");


            /*
             * ========================================================
             * FORMATEAR NÚMERO
             * ========================================================
             */

            function formatearNumero(valor) {

                const numero = Number(valor);

                if (!Number.isFinite(numero)) {
                    return "0.00";
                }

                return numero.toLocaleString("es-NI", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
            }


            /*
             * ========================================================
             * OBTENER DATOS DEL PEDIDO
             * ========================================================
             */

            function obtenerDatosPedido() {

                let subtotal = 0;
                let descuento = 0;
                let totalPedido = 0;

                /*
                 * CASO 1:
                 * Hay un select de pedidos.
                 */

                if (pedidoSelect) {

                    const opcion =
                        pedidoSelect.options[
                            pedidoSelect.selectedIndex
                        ];

                    if (opcion) {

                        subtotal =
                            Number(
                                opcion.getAttribute(
                                    "data-subtotal"
                                )
                            ) || 0;

                        descuento =
                            Number(
                                opcion.getAttribute(
                                    "data-descuento"
                                )
                            ) || 0;

                        totalPedido =
                            Number(
                                opcion.getAttribute(
                                    "data-total"
                                )
                            ) || 0;
                    }
                }

                /*
                 * CASO 2:
                 * El pedido viene seleccionado desde el servidor
                 * y el select está disabled.
                 *
                 * En ese caso el pedido no tiene data-* porque
                 * solamente mostramos un hidden.
                 *
                 * Pasamos los valores desde Razor mediante
                 * variables JavaScript.
                 */

                @if (pedidoActual != null)
                {
                    <text>
                    subtotal = @pedidoActual.Subtotal.ToString(
                        System.Globalization.CultureInfo.InvariantCulture
                    );

                    descuento = @pedidoActual.Descuento.ToString(
                        System.Globalization.CultureInfo.InvariantCulture
                    );

                    totalPedido = @pedidoActual.Total.ToString(
                        System.Globalization.CultureInfo.InvariantCulture
                    );
                    </text>
                }


                /*
                 * Si no tenemos subtotal pero sí tenemos total,
                 * dejamos que el subtotal sea el total del pedido.
                 *
                 * Esto solamente actúa como respaldo.
                 */

                if (subtotal === 0 && descuento === 0 && totalPedido > 0) {

                    subtotal = totalPedido;
                }


                return {
                    subtotal: subtotal,
                    descuento: descuento,
                    totalPedido: totalPedido
                };
            }


            /*
             * ========================================================
             * OBTENER PORCENTAJE DEL IMPUESTO
             * ========================================================
             */

            function obtenerPorcentajeImpuesto() {

                if (!impuestoSelect) {
                    return 0;
                }

                const opcion =
                    impuestoSelect.options[
                        impuestoSelect.selectedIndex
                    ];

                if (!opcion) {
                    return 0;
                }

                const atributo =
                    opcion.getAttribute("data-porcentaje");

                if (!atributo) {
                    return 0;
                }

                return Number(atributo) || 0;
            }


            /*
             * ========================================================
             * CALCULAR RESUMEN
             * ========================================================
             */

            function calcularResumen() {

                const datos =
                    obtenerDatosPedido();

                const porcentaje =
                    obtenerPorcentajeImpuesto();


                /*
                 * Subtotal
                 */

                const subtotal =
                    datos.subtotal;


                /*
                 * Descuento
                 */

                const descuento =
                    datos.descuento;


                /*
                 * Base imponible
                 *
                 * Subtotal - descuento
                 */

                let baseImponible =
                    subtotal - descuento;

                if (baseImponible < 0) {
                    baseImponible = 0;
                }


                /*
                 * IVA
                 *
                 * Base imponible × porcentaje / 100
                 */

                const impuesto =
                    baseImponible *
                    porcentaje /
                    100;


                /*
                 * TOTAL
                 *
                 * Base + IVA
                 */

                const total =
                    baseImponible +
                    impuesto;


                /*
                 * SALDO INICIAL
                 *
                 * Al crear una factura el saldo inicial
                 * es igual al total.
                 */

                const saldo =
                    total;


                /*
                 * MOSTRAR RESULTADOS
                 */

                if (subtotalElement) {

                    subtotalElement.textContent =
                        formatearNumero(subtotal);

                }


                if (descuentoElement) {

                    descuentoElement.textContent =
                        formatearNumero(descuento);

                }


                if (baseElement) {

                    baseElement.textContent =
                        formatearNumero(baseImponible);

                }


                if (impuestoElement) {

                    impuestoElement.textContent =
                        formatearNumero(impuesto);

                }


                if (totalElement) {

                    totalElement.textContent =
                        formatearNumero(total);

                }


                if (saldoElement) {

                    saldoElement.textContent =
                        formatearNumero(saldo);

                }


                if (porcentajeElement) {

                    porcentajeElement.textContent =
                        porcentaje.toLocaleString("es-NI", {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        }) + "%";

                }

            }


            /*
             * ========================================================
             * EVENTO CAMBIO DE PEDIDO
             * ========================================================
             */

            if (pedidoSelect) {

                pedidoSelect.addEventListener(
                    "change",
                    function () {

                        calcularResumen();

                    }
                );

            }


            /*
             * ========================================================
             * EVENTO CAMBIO DE IMPUESTO
             * ========================================================
             */

            if (impuestoSelect) {

                impuestoSelect.addEventListener(
                    "change",
                    function () {

                        calcularResumen();

                    }
                );

            }

            calcularResumen();

        });

    </script>
}
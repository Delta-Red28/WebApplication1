@model WebApplication1.Models.Factura

@{
    ViewData["Title"] = "Crear Factura";

    var pedidos = ViewBag.Pedidos as List<WebApplication1.Models.Pedido>
                   ?? new List<WebApplication1.Models.Pedido>();

    var monedas = ViewBag.Monedas as List<WebApplication1.Models.Monedum>
                   ?? new List<WebApplication1.Models.Monedum>();

    var tiposComprobante = ViewBag.TiposComprobante as List<WebApplication1.Models.TipoComprobante>
                           ?? new List<WebApplication1.Models.TipoComprobante>();

    var seriesFactura = ViewBag.SeriesFactura as List<WebApplication1.Models.SerieFactura>
                        ?? new List<WebApplication1.Models.SerieFactura>();

    var impuestos = ViewBag.Impuestos as List<WebApplication1.Models.Impuesto>
                    ?? new List<WebApplication1.Models.Impuesto>();

    /*
     * ============================================================
     * PEDIDO ACTUAL
     * ============================================================
     *
     * Cuando la vista viene desde CreateParaPedido(), el controlador
     * envía ViewBag.Pedido.
     *
     * Cuando viene desde Create(), buscamos el pedido en ViewBag.Pedidos.
     */

    WebApplication1.Models.Pedido? pedidoActual = ViewBag.Pedido as WebApplication1.Models.Pedido;

    if (pedidoActual == null && Model.IdPedido > 0)
    {
        pedidoActual = pedidos.FirstOrDefault(
            p => p.IdPedido == Model.IdPedido
        );
    }

    /*
     * ============================================================
     * IMPUESTO ACTUAL
     * ============================================================
     */

    WebApplication1.Models.Impuesto? impuestoSeleccionado = null;

    if (Model.IdImpuesto.HasValue && Model.IdImpuesto.Value > 0)
    {
        impuestoSeleccionado = impuestos.FirstOrDefault(
            i => i.IdImpuesto == Model.IdImpuesto.Value
        );
    }

    decimal porcentajeImpuesto =
        impuestoSeleccionado?.Porcentaje ?? 0m;
}

<div class="container mt-4">

    <!-- ============================================================
         ENCABEZADO
    ============================================================ -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                <i class="bi bi-receipt"></i>
                Crear Factura
            </h2>

            <p class="text-muted mb-0">
                Registra una nueva factura a partir de un pedido entregado.
            </p>
        </div>

        <div>
            <a asp-controller="Factura"
               asp-action="Index"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left"></i>
                Volver

            </a>
        </div>

    </div>


    <!-- ============================================================
         MENSAJE TEMPORAL
    ============================================================ -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ============================================================
         VALIDACIONES
    ============================================================ -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">

            <h6 class="alert-heading">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                No se pudo crear la factura
            </h6>

            <hr />

            <div asp-validation-summary="All"></div>

        </div>
    }


    <!-- ============================================================
         INFORMACIÓN DEL PEDIDO
    ============================================================ -->
    @if (pedidoActual != null)
    {
        <div class="alert alert-info shadow-sm">

            <div class="d-flex align-items-center">

                <i class="bi bi-cart-check fs-2 me-3"></i>

                <div>

                    <strong>
                        Pedido seleccionado:
                        @pedidoActual.NumeroPedido
                    </strong>

                    <div class="small mt-1">

                        Fecha:
                        <strong>
                            @pedidoActual.FechaPedido.ToString("dd/MM/yyyy HH:mm")
                        </strong>

                        &nbsp; | &nbsp;

                        Estado:
                        <strong>
                            Entregado
                        </strong>

                        &nbsp; | &nbsp;

                        Total:
                        <strong>
                            @pedidoActual.Total.ToString("N2")
                        </strong>

                    </div>

                </div>

            </div>

        </div>
    }


    <!-- ============================================================
         FORMULARIO
    ============================================================ -->

    <form asp-controller="Factura"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <!-- ========================================================
             PEDIDO Y FECHA
        ======================================================== -->

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-primary text-white">

                <h5 class="mb-0">
                    <i class="bi bi-cart me-2"></i>
                    Pedido
                </h5>

            </div>

            <div class="card-body">

                <div class="row">

                    <!-- ==================================================
                         PEDIDO
                    ================================================== -->

                    <div class="col-md-8 mb-3">

                        <label asp-for="IdPedido"
                               class="form-label fw-bold">

                            Pedido
                            <span class="text-danger">*</span>

                        </label>

                        @if (pedidoActual != null)
                        {
                            /*
                             * El select visual está deshabilitado para
                             * impedir que se cambie el pedido cuando
                             * CreateParaPedido() abrió esta vista.
                             *
                             * El hidden sí envía IdPedido al controlador.
                             */

                            <select class="form-select"
                                    disabled>

                                <option value="@pedidoActual.IdPedido">
                                    @pedidoActual.NumeroPedido
                                    -
                                    @pedidoActual.FechaPedido.ToString("dd/MM/yyyy HH:mm")
                                    -
                                    Total:
                                    @pedidoActual.Total.ToString("N2")
                                </option>

                            </select>

                            <input type="hidden"
                                   asp-for="IdPedido" />
                        }
                        else
                        {
                            <select asp-for="IdPedido"
                                    id="IdPedido"
                                    class="form-select">

                                <option value="0">
                                    -- Seleccione un pedido entregado --
                                </option>

                                @foreach (var pedido in pedidos)
                                {
                                    <option value="@pedido.IdPedido"
                                            data-subtotal="@pedido.Subtotal.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-descuento="@pedido.Descuento.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-impuesto-pedido="@pedido.Impuesto.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-total="@pedido.Total.ToString(System.Globalization.CultureInfo.InvariantCulture)">

                                        @pedido.NumeroPedido
                                        -
                                        @pedido.FechaPedido.ToString("dd/MM/yyyy HH:mm")
                                        -
                                        Total:
                                        @pedido.Total.ToString("N2")

                                    </option>
                                }

                            </select>
                        }

                        <span asp-validation-for="IdPedido"
                              class="text-danger">
                        </span>

                        <div class="form-text">

                            Solo se muestran pedidos entregados
                            que todavía no tienen factura.

                        </div>

                    </div>


                    <!-- ==================================================
                         FECHA
                    ================================================== -->

                    <div class="col-md-4 mb-3">

                        <label asp-for="FechaFactura"
                               class="form-label fw-bold">

                            Fecha de factura
                            <span class="text-danger">*</span>

                        </label>

                        <input asp-for="FechaFactura"
                               type="datetime-local"
                               class="form-control" />

                        <span asp-validation-for="FechaFactura"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            Si se deja vacío, el controlador utilizará
                            la fecha actual.
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ============================================================
             DATOS DEL COMPROBANTE
        ============================================================ -->

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-light">

                <h5 class="mb-0">

                    <i class="bi bi-file-earmark-text me-2"></i>

                    Datos del comprobante

                </h5>

            </div>

            <div class="card-body">

                <div class="row">

                    <!-- ==================================================
                         TIPO COMPROBANTE
                    ================================================== -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="IdTipoComprobante"
                               class="form-label fw-bold">

                            Tipo de comprobante
                            <span class="text-danger">*</span>

                        </label>

                        <select asp-for="IdTipoComprobante"
                                class="form-select">

                            <option value="0">
                                -- Seleccione un tipo de comprobante --
                            </option>

                            @foreach (var tipo in tiposComprobante)
                            {
                                <option value="@tipo.IdTipoComprobante">

                                    @tipo.Nombre

                                </option>
                            }

                        </select>

                        <span asp-validation-for="IdTipoComprobante"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ==================================================
                         SERIE
                    ================================================== -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="IdSerieFactura"
                               class="form-label fw-bold">

                            Serie
                            <span class="text-danger">*</span>

                        </label>

                        <select asp-for="IdSerieFactura"
                                class="form-select">

                            <option value="0">
                                -- Seleccione una serie --
                            </option>

                            @foreach (var serie in seriesFactura)
                            {
                                <option value="@serie.IdSerieFactura">

                                    @serie.Nombre
                                    (@serie.Prefijo)

                                </option>
                            }

                        </select>

                        <span asp-validation-for="IdSerieFactura"
                              class="text-danger">
                        </span>

                        <div class="form-text">

                            El número de factura será generado
                            automáticamente por el controlador.

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ============================================================
             CONFIGURACIÓN MONETARIA Y FISCAL
        ============================================================ -->

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-light">

                <h5 class="mb-0">

                    <i class="bi bi-currency-exchange me-2"></i>

                    Configuración fiscal y monetaria

                </h5>

            </div>

            <div class="card-body">

                <div class="row">

                    <!-- ==================================================
                         MONEDA
                    ================================================== -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="IdMoneda"
                               class="form-label fw-bold">

                            Moneda
                            <span class="text-danger">*</span>

                        </label>

                        <select asp-for="IdMoneda"
                                class="form-select">

                            <option value="0">
                                -- Seleccione una moneda --
                            </option>

                            @foreach (var moneda in monedas)
                            {
                                <option value="@moneda.IdMoneda">

                                    @moneda.Nombre
                                    (@moneda.CodigoIso)

                                    @if (!string.IsNullOrWhiteSpace(moneda.Simbolo))
                                    {
                                        @: - @moneda.Simbolo
                                    }

                                </option>
                            }

                        </select>

                        <span asp-validation-for="IdMoneda"
                              class="text-danger">
                        </span>

                        <div class="form-text">

                            Solo se muestran monedas activas.

                        </div>

                    </div>


                    <!-- ==================================================
                         IMPUESTO
                    ================================================== -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="IdImpuesto"
                               class="form-label fw-bold">

                            Impuesto / IVA

                        </label>

                        <select asp-for="IdImpuesto"
                                id="IdImpuesto"
                                class="form-select">

                            <option value="">
                                -- Sin impuesto / usar impuesto del pedido --
                            </option>

                            @foreach (var impuesto in impuestos)
                            {
                                <option value="@impuesto.IdImpuesto"
                                        data-porcentaje="@impuesto.Porcentaje.ToString(System.Globalization.CultureInfo.InvariantCulture)">

                                    @impuesto.Nombre
                                    -
                                    @impuesto.Porcentaje.ToString("N2")%

                                </option>
                            }

                        </select>

                        <span asp-validation-for="IdImpuesto"
                              class="text-danger">
                        </span>

                        <div class="form-text">

                            Si selecciona un impuesto, el controlador
                            calculará el impuesto sobre la base imponible.
                            Si no selecciona ninguno, se utilizará el
                            impuesto registrado en el pedido.

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ============================================================
             RESUMEN
        ============================================================ -->

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-success text-white">

                <h5 class="mb-0">

                    <i class="bi bi-calculator me-2"></i>

                    Resumen de la factura

                </h5>

            </div>

            <div class="card-body">

                <div class="alert alert-info">

                    <i class="bi bi-info-circle me-2"></i>

                    Los importes se calculan automáticamente a partir
                    del pedido. El servidor volverá a calcularlos
                    antes de guardar la factura.

                </div>


                <div class="row">

                    <!-- ==================================================
                         SUBTOTAL
                    ================================================== -->

                    <div class="col-md-3 mb-3">

                        <label class="text-muted">
                            Subtotal
                        </label>

                        <div id="resumenSubtotal"
                             class="form-control bg-light fw-bold">

                            @Model.Subtotal.ToString("N2")

                        </div>

                    </div>


                    <!-- ==================================================
                         DESCUENTO
                    ================================================== -->

                    <div class="col-md-3 mb-3">

                        <label class="text-muted">
                            Descuento
                        </label>

                        <div id="resumenDescuento"
                             class="form-control bg-light fw-bold">

                            @Model.Descuento.ToString("N2")

                        </div>

                    </div>


                    <!-- ==================================================
                         BASE IMPONIBLE
                    ================================================== -->

                    <div class="col-md-3 mb-3">

                        <label class="text-muted">
                            Base imponible
                        </label>

                        <div id="resumenBase"
                             class="form-control bg-light fw-bold">

                            0.00

                        </div>

                    </div>


                    <!-- ==================================================
                         IMPUESTO
                    ================================================== -->

                    <div class="col-md-3 mb-3">

                        <label class="text-muted">
                            IVA / Impuesto
                        </label>

                        <div id="resumenImpuesto"
                             class="form-control bg-light fw-bold text-primary">

                            @Model.Impuesto.ToString("N2")

                        </div>

                        <div class="small text-muted mt-1">

                            Porcentaje aplicado:

                            <strong id="resumenPorcentajeImpuesto">
                                @porcentajeImpuesto.ToString("N2")%
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- ==================================================
                     TOTAL Y SALDO
                ================================================== -->

                <div class="row mt-2">

                    <!-- TOTAL -->

                    <div class="col-md-6 mb-3">

                        <label class="text-muted">
                            Total factura
                        </label>

                        <div id="resumenTotal"
                             class="form-control bg-light fw-bold text-success fs-4">

                            @Model.Total.ToString("N2")

                        </div>

                    </div>


                    <!-- SALDO -->

                    <div class="col-md-6 mb-3">

                        <label class="text-muted">
                            Saldo pendiente inicial
                        </label>

                        <div id="resumenSaldo"
                             class="form-control bg-light fw-bold text-danger fs-4">

                            @Model.SaldoPendiente.ToString("N2")

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ============================================================
             OBSERVACIÓN
        ============================================================ -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">

                <h5 class="mb-0">

                    <i class="bi bi-chat-left-text me-2"></i>

                    Observación

                </h5>

            </div>

            <div class="card-body">

                <label asp-for="Observacion"
                       class="form-label">

                    Observación

                </label>

                <textarea asp-for="Observacion"
                          class="form-control"
                          rows="4"
                          maxlength="300"
                          placeholder="Ingrese una observación opcional..."></textarea>

                <span asp-validation-for="Observacion"
                      class="text-danger">
                </span>

                <div class="form-text">

                    Máximo 300 caracteres.

                </div>

            </div>

        </div>


        <!-- ============================================================
             NÚMERO DE FACTURA
        ============================================================ -->

        <div class="alert alert-secondary">

            <div class="d-flex align-items-center">

                <i class="bi bi-hash fs-3 me-3"></i>

                <div>

                    <strong>
                        Número de factura
                    </strong>

                    <p class="mb-0">

                        El número será generado automáticamente
                        utilizando la serie seleccionada.

                    </p>

                </div>

            </div>

        </div>


        <!-- ============================================================
             BOTONES
        ============================================================ -->

        <div class="card shadow-sm mb-4">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <a asp-controller="Factura"
                       asp-action="Index"
                       class="btn btn-secondary">

                        <i class="bi bi-x-circle me-1"></i>

                        Cancelar

                    </a>

                    <button type="submit"
                            class="btn btn-primary btn-lg">

                        <i class="bi bi-check-circle me-1"></i>

                        Crear factura

                    </button>

                </div>

            </div>

        </div>

    </form>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            // ========================================================
            // ELEMENTOS
            // ========================================================

            const pedidoSelect =
                document.getElementById("IdPedido");

            const impuestoSelect =
                document.getElementById("IdImpuesto");

            const subtotalElement =
                document.getElementById("resumenSubtotal");

            const descuentoElement =
                document.getElementById("resumenDescuento");

            const baseElement =
                document.getElementById("resumenBase");

            const impuestoElement =
                document.getElementById("resumenImpuesto");

            const totalElement =
                document.getElementById("resumenTotal");

            const saldoElement =
                document.getElementById("resumenSaldo");

            const porcentajeElement =
                document.getElementById(
                    "resumenPorcentajeImpuesto"
                );


            // ========================================================
            // DATOS DEL PEDIDO SELECCIONADO DESDE EL SERVIDOR
            // ========================================================

            let pedidoServidor = null;

            @if (pedidoActual != null)
                {
                    <text>
                            pedidoServidor = {
                                subtotal:
                            @pedidoActual.Subtotal.ToString(
                            System.Globalization.CultureInfo.InvariantCulture
                            ),

                            descuento:
                            @pedidoActual.Descuento.ToString(
                            System.Globalization.CultureInfo.InvariantCulture
                            ),

                            impuesto:
                            @pedidoActual.Impuesto.ToString(
                            System.Globalization.CultureInfo.InvariantCulture
                            ),

                            total:
                            @pedidoActual.Total.ToString(
                            System.Globalization.CultureInfo.InvariantCulture
                            )
                                };
                    </text>
            }


                // ========================================================
                // FORMATEAR NÚMEROS
                // ========================================================

                function formatearNumero(valor) {

                    const numero = Number(valor);

                    if (!Number.isFinite(numero)) {
                        return "0.00";
                    }

                    return numero.toLocaleString("es-NI", {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
                }


            // ========================================================
            // OBTENER PEDIDO
            // ========================================================

            function obtenerDatosPedido() {

                // ----------------------------------------------------
                // Si viene desde CreateParaPedido()
                // ----------------------------------------------------

                if (pedidoServidor !== null) {

                    return {
                        subtotal: Number(
                            pedidoServidor.subtotal
                        ) || 0,

                        descuento: Number(
                            pedidoServidor.descuento
                        ) || 0,

                        impuesto: Number(
                            pedidoServidor.impuesto
                        ) || 0,

                        total: Number(
                            pedidoServidor.total
                        ) || 0
                    };
                }


                // ----------------------------------------------------
                // Si se seleccionó desde el combo
                // ----------------------------------------------------

                if (!pedidoSelect) {

                    return {
                        subtotal: 0,
                        descuento: 0,
                        impuesto: 0,
                        total: 0
                    };
                }


                const opcion =
                    pedidoSelect.options[
                    pedidoSelect.selectedIndex
                    ];


                if (!opcion) {

                    return {
                        subtotal: 0,
                        descuento: 0,
                        impuesto: 0,
                        total: 0
                    };
                }


                return {

                    subtotal:
                        Number(
                            opcion.getAttribute(
                                "data-subtotal"
                            )
                        ) || 0,

                    descuento:
                        Number(
                            opcion.getAttribute(
                                "data-descuento"
                            )
                        ) || 0,

                    impuesto:
                        Number(
                            opcion.getAttribute(
                                "data-impuesto-pedido"
                            )
                        ) || 0,

                    total:
                        Number(
                            opcion.getAttribute(
                                "data-total"
                            )
                        ) || 0
                };
            }


            // ========================================================
            // OBTENER IMPUESTO SELECCIONADO
            // ========================================================

            function obtenerImpuestoSeleccionado() {

                if (!impuestoSelect) {

                    return {
                        seleccionado: false,
                        porcentaje: 0
                    };
                }


                const valor =
                    impuestoSelect.value;


                // ----------------------------------------------------
                // SIN IMPUESTO SELECCIONADO
                // ----------------------------------------------------

                if (!valor) {

                    return {
                        seleccionado: false,
                        porcentaje: 0
                    };
                }


                const opcion =
                    impuestoSelect.options[
                    impuestoSelect.selectedIndex
                    ];


                if (!opcion) {

                    return {
                        seleccionado: false,
                        porcentaje: 0
                    };
                }


                const porcentaje =
                    Number(
                        opcion.getAttribute(
                            "data-porcentaje"
                        )
                    ) || 0;


                return {
                    seleccionado: true,
                    porcentaje: porcentaje
                };
            }


            // ========================================================
            // CALCULAR RESUMEN
            // ========================================================

            function calcularResumen() {

                const datos =
                    obtenerDatosPedido();


                const impuestoSeleccionado =
                    obtenerImpuestoSeleccionado();


                const subtotal =
                    Math.round(
                        (datos.subtotal + Number.EPSILON) *
                        100
                    ) / 100;


                const descuento =
                    Math.round(
                        (datos.descuento + Number.EPSILON) *
                        100
                    ) / 100;


                // ----------------------------------------------------
                // BASE IMPONIBLE
                // ----------------------------------------------------

                let baseImponible =
                    subtotal - descuento;


                if (baseImponible < 0) {
                    baseImponible = 0;
                }


                baseImponible =
                    Math.round(
                        (baseImponible + Number.EPSILON) *
                        100
                    ) / 100;


                // ----------------------------------------------------
                // IMPUESTO
                // ----------------------------------------------------

                let impuesto = 0;


                if (impuestoSeleccionado.seleccionado) {

                    impuesto =
                        baseImponible *
                        (
                            impuestoSeleccionado.porcentaje /
                            100
                        );

                    impuesto =
                        Math.round(
                            (impuesto + Number.EPSILON) *
                            100
                        ) / 100;

                }
                else {

                    /*
                     * Igual que el controlador:
                     *
                     * si no se selecciona un impuesto,
                     * utiliza pedido.Impuesto.
                     */

                    impuesto =
                        Math.round(
                            (datos.impuesto + Number.EPSILON) *
                            100
                        ) / 100;
                }


                // ----------------------------------------------------
                // TOTAL
                // ----------------------------------------------------

                let total =
                    baseImponible +
                    impuesto;


                total =
                    Math.round(
                        (total + Number.EPSILON) *
                        100
                    ) / 100;


                // ----------------------------------------------------
                // SALDO INICIAL
                // ----------------------------------------------------

                const saldo =
                    total;


                // ====================================================
                // MOSTRAR
                // ====================================================

                if (subtotalElement) {

                    subtotalElement.textContent =
                        formatearNumero(subtotal);
                }


                if (descuentoElement) {

                    descuentoElement.textContent =
                        formatearNumero(descuento);
                }


                if (baseElement) {

                    baseElement.textContent =
                        formatearNumero(baseImponible);
                }


                if (impuestoElement) {

                    impuestoElement.textContent =
                        formatearNumero(impuesto);
                }


                if (totalElement) {

                    totalElement.textContent =
                        formatearNumero(total);
                }


                if (saldoElement) {

                    saldoElement.textContent =
                        formatearNumero(saldo);
                }


                if (porcentajeElement) {

                    if (impuestoSeleccionado.seleccionado) {

                        porcentajeElement.textContent =
                            impuestoSeleccionado.porcentaje.toLocaleString(
                                "es-NI",
                                {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                }
                            ) + "%";

                    }
                    else {

                        porcentajeElement.textContent =
                            "Impuesto del pedido";
                    }
                }

            }


            // ========================================================
            // CAMBIO DE PEDIDO
            // ========================================================

            if (pedidoSelect) {

                pedidoSelect.addEventListener(
                    "change",
                    function() {

                        /*
                         * Si el usuario selecciona un pedido desde
                         * Create normal, eliminamos cualquier valor
                         * servidor.
                         */

                        pedidoServidor = null;

                        calcularResumen();
                    }
                );
            }


            // ========================================================
            // CAMBIO DE IMPUESTO
            // ========================================================

            if (impuestoSelect) {

                impuestoSelect.addEventListener(
                    "change",
                    function() {

                        calcularResumen();
                    }
                );
            }


            // ========================================================
            // CÁLCULO INICIAL
            // ========================================================

            calcularResumen();

        });

    </script>
}

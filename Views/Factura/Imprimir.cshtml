@model WebApplication1.Models.Factura

@{
    Layout = null;

    var pedido = Model.IdPedidoNavigation;
    var cliente = pedido?.IdClienteNavigation;

    string nombreCliente = cliente != null
        ? $"{cliente.Nombres} {cliente.Apellidos}".Trim()
        : "Consumidor final";

    string moneda = Model.IdMonedaNavigation?.Nombre ?? "";

    string tipoComprobante =
        Model.IdTipoComprobanteNavigation?.Nombre
        ?? "Factura";

    string serie =
        Model.IdSerieFacturaNavigation?.Nombre
        ?? "";

    string estado =
        Model.IdEstadoFacturaNavigation?.Nombre
        ?? "";

    var detalles =
        pedido?.DetallePedidos
        ?? new List<WebApplication1.Models.DetallePedido>();
}

<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @tipoComprobante
        @(string.IsNullOrWhiteSpace(Model.NumeroFactura)
            ? ""
            : $" #{Model.NumeroFactura}")
    </title>

    <style>

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            background: #f3f4f6;
            color: #111827;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            padding: 30px 15px;
        }

        .factura {
            width: 800px;
            max-width: 100%;
            margin: 0 auto;
            background: #ffffff;
            padding: 35px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, .08);
        }

        /* =========================================================
           ENCABEZADO
           ========================================================= */

        .encabezado {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 30px;
            border-bottom: 2px solid #111827;
            padding-bottom: 20px;
            margin-bottom: 20px;
        }

        .empresa {
            flex: 1;
        }

        .empresa h1 {
            margin: 0 0 6px 0;
            font-size: 26px;
            font-weight: 800;
            color: #111827;
        }

        .empresa p {
            margin: 3px 0;
            color: #4b5563;
            font-size: 13px;
        }

        .documento {
            width: 250px;
            text-align: right;
        }

        .documento-titulo {
            font-size: 20px;
            font-weight: 800;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .numero {
            font-size: 17px;
            font-weight: 700;
            color: #b91c1c;
        }

        .documento-info {
            margin-top: 8px;
            font-size: 12px;
            color: #4b5563;
        }

        /* =========================================================
           INFORMACIÓN
           ========================================================= */

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 25px;
        }

        .info-box {
            border: 1px solid #d1d5db;
            border-radius: 6px;
            padding: 14px;
        }

        .info-box h3 {
            margin: 0 0 10px 0;
            font-size: 13px;
            text-transform: uppercase;
            color: #374151;
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 7px;
        }

        .dato {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            font-size: 13px;
            margin-bottom: 6px;
        }

        .dato:last-child {
            margin-bottom: 0;
        }

        .dato .label {
            color: #6b7280;
        }

        .dato .valor {
            font-weight: 600;
            text-align: right;
        }

        /* =========================================================
           DETALLES
           ========================================================= */

        .titulo-detalle {
            font-size: 15px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .tabla {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        .tabla th {
            background: #111827;
            color: #ffffff;
            padding: 9px 8px;
            font-size: 11px;
            text-transform: uppercase;
            text-align: left;
        }

        .tabla td {
            border-bottom: 1px solid #e5e7eb;
            padding: 9px 8px;
            font-size: 12px;
            vertical-align: top;
        }

        .tabla .cantidad {
            width: 75px;
            text-align: center;
        }

        .tabla .precio {
            width: 110px;
            text-align: right;
        }

        .tabla .descuento {
            width: 100px;
            text-align: right;
        }

        .tabla .total {
            width: 120px;
            text-align: right;
            font-weight: 700;
        }

        .producto {
            font-weight: 600;
        }

        .codigo {
            color: #6b7280;
            font-size: 10px;
            margin-top: 3px;
        }

        /* =========================================================
           TOTALES
           ========================================================= */

        .totales-container {
            display: flex;
            justify-content: flex-end;
        }

        .totales {
            width: 330px;
        }

        .total-linea {
            display: flex;
            justify-content: space-between;
            padding: 7px 0;
            font-size: 13px;
            border-bottom: 1px solid #e5e7eb;
        }

        .total-linea .label {
            color: #4b5563;
        }

        .total-linea .valor {
            font-weight: 600;
        }

        .total-final {
            display: flex;
            justify-content: space-between;
            margin-top: 8px;
            padding: 12px 0;
            border-top: 2px solid #111827;
            font-size: 18px;
            font-weight: 800;
        }

        /* =========================================================
           OBSERVACIÓN
           ========================================================= */

        .observacion {
            margin-top: 25px;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            padding: 12px;
        }

        .observacion h3 {
            margin: 0 0 7px 0;
            font-size: 12px;
            text-transform: uppercase;
        }

        .observacion p {
            margin: 0;
            font-size: 12px;
            color: #4b5563;
        }

        /* =========================================================
           PIE
           ========================================================= */

        .footer {
            border-top: 1px solid #d1d5db;
            margin-top: 30px;
            padding-top: 15px;
            text-align: center;
            color: #6b7280;
            font-size: 11px;
        }

        .estado-anulada {
            margin-top: 20px;
            padding: 12px;
            text-align: center;
            border: 2px solid #dc2626;
            color: #dc2626;
            font-weight: 800;
            text-transform: uppercase;
        }

        /* =========================================================
           BOTONES
           ========================================================= */

        .acciones {
            width: 800px;
            max-width: 100%;
            margin: 0 auto 15px auto;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .btn {
            border: none;
            border-radius: 6px;
            padding: 10px 16px;
            cursor: pointer;
            font-size: 13px;
            font-weight: 600;
        }

        .btn-imprimir {
            background: #111827;
            color: white;
        }

        .btn-cerrar {
            background: #e5e7eb;
            color: #111827;
        }

        /* =========================================================
           IMPRESIÓN
           ========================================================= */

        @@media print {

            @@page {
                size: A4;
                margin: 12mm;
            }

            html,
            body {
                background: #ffffff;
            }

            body {
                padding: 0;
            }

            .acciones {
                display: none !important;
            }

            .factura {
                width: 100%;
                max-width: none;
                margin: 0;
                padding: 0;
                box-shadow: none;
            }

            .tabla th {
                background: #111827 !important;
                color: #ffffff !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .info-box,
            .observacion {
                break-inside: avoid;
            }

            .tabla {
                break-inside: auto;
            }

            .tabla tr {
                break-inside: avoid;
                break-after: auto;
            }

            .totales-container {
                break-inside: avoid;
            }

            .footer {
                break-inside: avoid;
            }
        }

        /* =========================================================
           RESPONSIVE
           ========================================================= */

        @@media (max-width: 650px) {

            body {
                padding: 10px;
            }

            .factura {
                padding: 18px;
            }

            .encabezado {
                flex-direction: column;
            }

            .documento {
                width: 100%;
                text-align: left;
            }

            .info-grid {
                grid-template-columns: 1fr;
            }

            .tabla {
                font-size: 11px;
            }

            .tabla th,
            .tabla td {
                padding: 6px 4px;
            }

            .tabla .descuento {
                display: none;
            }

            .totales {
                width: 100%;
            }
        }

    </style>

</head>

<body>

    <!-- =========================================================
         ACCIONES
         ========================================================= -->

    <div class="acciones">

        <button type="button"
                class="btn btn-cerrar"
                onclick="window.close();">
            Cerrar
        </button>

        <button type="button"
                class="btn btn-imprimir"
                onclick="window.print();">
            Imprimir factura
        </button>

    </div>


    <!-- =========================================================
         FACTURA
         ========================================================= -->

    <div class="factura">

        <!-- =====================================================
             ENCABEZADO
             ===================================================== -->

        <div class="encabezado">

            <div class="empresa">

                <h1>RESTAURANTE</h1>

                <p>Restaurante y servicios de alimentación</p>

                <p>Managua, Nicaragua</p>

            </div>


            <div class="documento">

                <div class="documento-titulo">
                    @tipoComprobante
                </div>

                <div class="numero">

                    @(string.IsNullOrWhiteSpace(Model.NumeroFactura)
                        ? "SIN NÚMERO"
                        : Model.NumeroFactura)

                </div>

                <div class="documento-info">

                    @if (!string.IsNullOrWhiteSpace(serie))
                    {
                        <div>
                            Serie: <strong>@serie</strong>
                        </div>
                    }

                    <div>
                        Fecha:
                        <strong>
                            @Model.FechaFactura.ToString("dd/MM/yyyy HH:mm")
                        </strong>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(estado))
                    {
                        <div>
                            Estado:
                            <strong>@estado</strong>
                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- =====================================================
             INFORMACIÓN DEL CLIENTE / PEDIDO
             ===================================================== -->

        <div class="info-grid">

            <div class="info-box">

                <h3>Cliente</h3>

                <div class="dato">
                    <span class="label">
                        Nombre
                    </span>

                    <span class="valor">
                        @nombreCliente
                    </span>
                </div>

                @if (cliente != null &&
                     !string.IsNullOrWhiteSpace(cliente.Cedula))
                {
                    <div class="dato">

                        <span class="label">
                            Cédula
                        </span>

                        <span class="valor">
                            @cliente.Cedula
                        </span>

                    </div>
                }

                @if (cliente != null &&
                     !string.IsNullOrWhiteSpace(cliente.Telefono))
                {
                    <div class="dato">

                        <span class="label">
                            Teléfono
                        </span>

                        <span class="valor">
                            @cliente.Telefono
                        </span>

                    </div>
                }

                @if (cliente != null &&
                     !string.IsNullOrWhiteSpace(cliente.Correo))
                {
                    <div class="dato">

                        <span class="label">
                            Correo
                        </span>

                        <span class="valor">
                            @cliente.Correo
                        </span>

                    </div>
                }

            </div>


            <div class="info-box">

                <h3>Pedido</h3>

                <div class="dato">

                    <span class="label">
                        Número
                    </span>

                    <span class="valor">

                        @(pedido?.NumeroPedido
                            ?? $"#{Model.IdPedido}")

                    </span>

                </div>

                <div class="dato">

                    <span class="label">
                        Fecha
                    </span>

                    <span class="valor">

                        @(pedido?.FechaPedido.ToString(
                            "dd/MM/yyyy HH:mm")
                            ?? "-")

                    </span>

                </div>

                <div class="dato">

                    <span class="label">
                        Moneda
                    </span>

                    <span class="valor">
                        @moneda
                    </span>

                </div>

            </div>

        </div>


        <!-- =====================================================
             DETALLE DE PRODUCTOS
             ===================================================== -->

        <div class="titulo-detalle">
            Detalle de productos
        </div>


        <table class="tabla">

            <thead>

                <tr>

                    <th>
                        Producto
                    </th>

                    <th class="cantidad">
                        Cant.
                    </th>

                    <th class="precio">
                        P. Unitario
                    </th>

                    <th class="descuento">
                        Descuento
                    </th>

                    <th class="total">
                        Total
                    </th>

                </tr>

            </thead>

            <tbody>

                @if (detalles.Any())
                {
                    foreach (var detalle in detalles)
                    {
                        <tr>

                            <td>

                                <div class="producto">
                                    @detalle.IdProductoNavigation?.Nombre
                                </div>

                                @if (detalle.IdProductoNavigation != null)
                                {
                                    <div class="codigo">

                                        Código:
                                        @detalle.IdProductoNavigation.CodigoProducto

                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(
                                    detalle.Observacion))
                                {
                                    <div class="codigo">

                                        @detalle.Observacion

                                    </div>
                                }

                            </td>


                            <td class="cantidad">

                                @detalle.Cantidad.ToString("N2")

                            </td>


                            <td class="precio">

                                @detalle.PrecioUnitario.ToString("N2")

                            </td>


                            <td class="descuento">

                                @detalle.Descuento.ToString("N2")

                            </td>


                            <td class="total">

                                @detalle.TotalLinea.ToString("N2")

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="5"
                            style="text-align:center; color:#6b7280;">

                            No hay productos registrados.

                        </td>

                    </tr>
                }

            </tbody>

        </table>


        <!-- =====================================================
             TOTALES
             ===================================================== -->

        <div class="totales-container">

            <div class="totales">

                <div class="total-linea">

                    <span class="label">
                        Subtotal
                    </span>

                    <span class="valor">
                        @Model.Subtotal.ToString("N2")
                    </span>

                </div>


                <div class="total-linea">

                    <span class="label">
                        Descuento
                    </span>

                    <span class="valor">
                        @Model.Descuento.ToString("N2")
                    </span>

                </div>


                <div class="total-linea">

                    <span class="label">
                        Impuesto
                    </span>

                    <span class="valor">
                        @Model.Impuesto.ToString("N2")
                    </span>

                </div>


                <div class="total-final">

                    <span>
                        TOTAL
                    </span>

                    <span>
                        @Model.Total.ToString("N2")
                        @moneda
                    </span>

                </div>


                <div class="total-linea">

                    <span class="label">
                        Saldo pendiente
                    </span>

                    <span class="valor">

                        @Model.SaldoPendiente.ToString("N2")
                        @moneda

                    </span>

                </div>

            </div>

        </div>


        <!-- =====================================================
             OBSERVACIÓN
             ===================================================== -->

        @if (!string.IsNullOrWhiteSpace(Model.Observacion))
        {
            <div class="observacion">

                <h3>
                    Observación
                </h3>

                <p>
                    @Model.Observacion
                </p>

            </div>
        }


        <!-- =====================================================
             FACTURA ANULADA
             ===================================================== -->

        @if (Model.IdEstadoFactura == 3)
        {
            <div class="estado-anulada">

                FACTURA ANULADA

                @if (Model.FechaAnulacion.HasValue)
                {
                    <div style="font-size:11px; margin-top:5px;">
                        Fecha de anulación:
                        @Model.FechaAnulacion.Value.ToString(
                            "dd/MM/yyyy HH:mm")
                    </div>
                }

            </div>
        }


        <!-- =====================================================
             PIE
             ===================================================== -->

        <div class="footer">

            <div>
                Gracias por su preferencia.
            </div>

            <div>
                Documento generado por el sistema.
            </div>

            <div style="margin-top:5px;">
                Factura:
                @(Model.NumeroFactura ?? $"#{Model.IdFactura}")
            </div>

        </div>

    </div>


    <!-- =========================================================
         AUTO-IMPRESIÓN OPCIONAL
         ========================================================= -->

    <script>

        window.addEventListener("load", function () {

            // Si quieres que el cuadro de impresión
            // aparezca automáticamente al abrir la vista,
            // descomenta la siguiente línea:
            //
            // window.print();

        });

    </script>

</body>

</html>
@model IEnumerable<WebApplication1.Models.Factura>

@{
    ViewData["Title"] = "Facturas";

    var facturas = Model?.ToList()
        ?? new List<WebApplication1.Models.Factura>();

    const int ESTADO_PENDIENTE = 1;
    const int ESTADO_PAGADA = 2;
    const int ESTADO_ANULADA = 3;
    const int ESTADO_PARCIAL = 4;

    var totalFacturas = facturas.Count;

    var pendientes = facturas.Count(x =>
        x.IdEstadoFactura == ESTADO_PENDIENTE);

    var pagadas = facturas.Count(x =>
        x.IdEstadoFactura == ESTADO_PAGADA);

    var parciales = facturas.Count(x =>
        x.IdEstadoFactura == ESTADO_PARCIAL);

    var anuladas = facturas.Count(x =>
        x.IdEstadoFactura == ESTADO_ANULADA);
}

<style>

    /* ============================================================
       GENERAL
       ============================================================ */

    .facturas-page {
        padding-bottom: 40px;
    }

    .page-title {
        font-size: 1.65rem;
        font-weight: 700;
        color: #172033;
    }

    .page-subtitle {
        font-size: .85rem;
        color: #6c757d;
    }


    /* ============================================================
       BOTONES
       ============================================================ */

    .btn-action {
        width: 32px;
        height: 32px;
        padding: 0;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        border-radius: 6px;
    }


    /* ============================================================
       TARJETAS RESUMEN
       ============================================================ */

    .summary-card {
        border: 0;
        border-radius: 10px;
        background: #fff;

        box-shadow: 0 2px 10px rgba(0, 0, 0, .06);

        transition: all .2s ease;
    }

    .summary-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 18px rgba(0, 0, 0, .09);
    }

    .summary-label {
        font-size: .75rem;
        color: #6c757d;
        margin-bottom: 4px;
    }

    .summary-number {
        font-size: 1.55rem;
        font-weight: 700;
        line-height: 1;
    }

    .summary-icon {
        width: 42px;
        height: 42px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 10px;

        font-size: 1.25rem;
    }

    .summary-primary .summary-icon {
        background: #eaf2ff;
        color: #0d6efd;
    }

    .summary-warning .summary-icon {
        background: #fff5d9;
        color: #f0ad00;
    }

    .summary-success .summary-icon {
        background: #e8f7ef;
        color: #198754;
    }

    .summary-info .summary-icon {
        background: #e5f8fc;
        color: #0dcaf0;
    }


    /* ============================================================
       TABLA
       ============================================================ */

    .invoice-card {
        border: 0;
        border-radius: 10px;
        overflow: hidden;

        box-shadow: 0 2px 12px rgba(0, 0, 0, .06);
    }

    .invoice-header {
        background: #0d6efd;
        color: #fff;

        padding: 11px 16px;
    }

    .invoice-header-title {
        font-size: .9rem;
        font-weight: 600;
        margin: 0;
    }

    .invoice-count {
        font-size: .7rem;
        font-weight: 600;
        padding: 4px 8px;
        border-radius: 20px;
    }


    /* ============================================================
       TABLA
       ============================================================ */

    .invoice-table {
        margin: 0;
        font-size: .78rem;
        white-space: nowrap;
    }

    .invoice-table thead th {
        background: #f8f9fa;
        color: #495057;

        font-size: .68rem;
        font-weight: 700;

        text-transform: uppercase;
        letter-spacing: .02em;

        border-bottom: 1px solid #dee2e6;

        padding: 10px 9px;
    }

    .invoice-table tbody td {
        padding: 9px;
        vertical-align: middle;

        border-color: #edf0f3;
    }

    .invoice-table tbody tr {
        transition: background-color .15s ease;
    }

    .invoice-table tbody tr:hover {
        background: #f8fbff;
    }


    /* ============================================================
       COLUMNAS
       ============================================================ */

    .col-id {
        width: 35px;
        color: #8a94a6;
    }

    .col-factura {
        min-width: 125px;
        max-width: 145px;
    }

    .col-pedido {
        min-width: 90px;
    }

    .col-fecha {
        min-width: 105px;
    }

    .col-cliente {
        min-width: 150px;
        max-width: 190px;
    }

    .col-moneda {
        min-width: 70px;
    }

    .col-money {
        min-width: 85px;
    }

    .col-estado {
        min-width: 105px;
    }

    .col-acciones {
        min-width: 125px;
        width: 125px;
    }


    /* ============================================================
       DATOS
       ============================================================ */

    .invoice-number {
        color: #0d6efd;
        font-weight: 700;
    }

    .invoice-type {
        display: block;
        margin-top: 2px;

        color: #8a94a6;
        font-size: .66rem;
    }

    .invoice-serie {
        color: #6c757d;
        font-size: .65rem;
    }

    .client-name {
        max-width: 180px;

        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;

        font-weight: 600;
    }

    .client-document {
        display: block;

        margin-top: 2px;

        color: #8a94a6;
        font-size: .65rem;
    }

    .date-main {
        font-weight: 600;
    }

    .date-time {
        display: block;

        margin-top: 2px;

        color: #8a94a6;
        font-size: .65rem;
    }

    .currency-code {
        font-weight: 700;
        color: #343a40;
    }

    .currency-symbol {
        color: #8a94a6;
        font-size: .65rem;
    }

    .money {
        font-variant-numeric: tabular-nums;
        font-weight: 500;
    }

    .total {
        font-weight: 700;
        color: #172033;
    }

    .balance-paid {
        color: #198754;
        font-weight: 700;
    }

    .balance-pending {
        color: #dc3545;
        font-weight: 700;
    }


    /* ============================================================
       BADGES
       ============================================================ */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;

        padding: 4px 7px;

        border-radius: 20px;

        font-size: .66rem;
        font-weight: 600;
    }


    /* ============================================================
       ACCIONES
       ============================================================ */

    .actions {
        display: flex;
        align-items: center;
        justify-content: center;

        gap: 4px;
        flex-wrap: nowrap;
    }

    .actions .btn {
        flex-shrink: 0;
    }


    /* ============================================================
       TABLA VACÍA
       ============================================================ */

    .empty-state {
        padding: 65px 20px;
        text-align: center;
    }

    .empty-icon {
        width: 70px;
        height: 70px;

        margin: 0 auto 15px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;

        background: #f1f5f9;
        color: #94a3b8;

        font-size: 2rem;
    }


    /* ============================================================
       RESPONSIVE
       ============================================================ */

    @@media (max-width: 768px) {

        .page-title {
            font-size: 1.35rem;
        }

        .page-actions {
            width: 100%;
        }

        .page-actions .btn {
            flex: 1;
        }

        .summary-number {
            font-size: 1.35rem;
        }

        .invoice-table {
            font-size: .75rem;
        }
    }

</style>


<div class="container-fluid mt-4 facturas-page">

    <!-- ============================================================
         ENCABEZADO
         ============================================================ -->

    <div class="d-flex flex-wrap justify-content-between
                align-items-center mb-4">

        <div>

            <h2 class="page-title mb-1">

                <i class="bi bi-receipt-cutoff text-primary me-2"></i>

                Facturas

            </h2>

            <div class="page-subtitle">

                Administración y consulta de facturas del restaurante.

            </div>

        </div>


        <div class="d-flex gap-2 mt-3 mt-md-0 page-actions">

            <a asp-controller="Factura"
               asp-action="BuscarFactura"
               class="btn btn-outline-primary">

                <i class="bi bi-search me-1"></i>

                Buscar

            </a>


            <a asp-controller="Factura"
               asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-plus-lg me-1"></i>

                Nueva factura

            </a>

        </div>

    </div>


    <!-- ============================================================
         MENSAJES
         ============================================================ -->

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ============================================================
         RESUMEN
         ============================================================ -->

    <div class="row g-3 mb-4">

        <!-- TOTAL -->

        <div class="col-xl-3 col-md-6">

            <div class="card summary-card summary-primary h-100">

                <div class="card-body py-3">

                    <div class="d-flex justify-content-between
                                align-items-center">

                        <div>

                            <div class="summary-label">
                                Total facturas
                            </div>

                            <div class="summary-number">
                                @totalFacturas
                            </div>

                        </div>

                        <div class="summary-icon">

                            <i class="bi bi-receipt"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- PENDIENTES -->

        <div class="col-xl-3 col-md-6">

            <div class="card summary-card summary-warning h-100">

                <div class="card-body py-3">

                    <div class="d-flex justify-content-between
                                align-items-center">

                        <div>

                            <div class="summary-label">
                                Pendientes
                            </div>

                            <div class="summary-number text-warning">
                                @pendientes
                            </div>

                        </div>

                        <div class="summary-icon">

                            <i class="bi bi-clock-history"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- PAGADAS -->

        <div class="col-xl-3 col-md-6">

            <div class="card summary-card summary-success h-100">

                <div class="card-body py-3">

                    <div class="d-flex justify-content-between
                                align-items-center">

                        <div>

                            <div class="summary-label">
                                Pagadas
                            </div>

                            <div class="summary-number text-success">
                                @pagadas
                            </div>

                        </div>

                        <div class="summary-icon">

                            <i class="bi bi-check-circle"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- PARCIALES -->

        <div class="col-xl-3 col-md-6">

            <div class="card summary-card summary-info h-100">

                <div class="card-body py-3">

                    <div class="d-flex justify-content-between
                                align-items-center">

                        <div>

                            <div class="summary-label">
                                Pago parcial
                            </div>

                            <div class="summary-number text-info">
                                @parciales
                            </div>

                        </div>

                        <div class="summary-icon">

                            <i class="bi bi-hourglass-split"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ============================================================
         ANULADAS
         ============================================================ -->

    @if (anuladas > 0)
    {
        <div class="alert alert-secondary d-flex align-items-center mb-4">

            <i class="bi bi-info-circle me-2"></i>

            <span>
                Hay <strong>@anuladas</strong>
                factura(s) anulada(s) en el sistema.
            </span>

        </div>
    }


    <!-- ============================================================
         TABLA
         ============================================================ -->

    <div class="card invoice-card">

        <div class="invoice-header">

            <div class="d-flex justify-content-between
                        align-items-center">

                <div class="invoice-header-title">

                    <i class="bi bi-list-ul me-2"></i>

                    Listado de facturas

                </div>

                <span class="badge bg-light text-dark invoice-count">

                    @totalFacturas registro(s)

                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (!facturas.Any())
            {
                <div class="empty-state">

                    <div class="empty-icon">

                        <i class="bi bi-receipt"></i>

                    </div>

                    <h5 class="mb-2">
                        No hay facturas registradas
                    </h5>

                    <p class="text-muted mb-4">
                        Todavía no existen facturas en el sistema.
                    </p>

                    <a asp-controller="Factura"
                       asp-action="Create"
                       class="btn btn-primary">

                        <i class="bi bi-plus-lg me-1"></i>

                        Crear primera factura

                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table invoice-table">

                        <thead>

                            <tr>

                                <th class="col-id">#</th>

                                <th class="col-factura">
                                    Factura
                                </th>

                                <th class="col-pedido">
                                    Pedido
                                </th>

                                <th class="col-fecha">
                                    Fecha
                                </th>

                                <th class="col-cliente">
                                    Cliente
                                </th>

                                <th class="col-moneda">
                                    Moneda
                                </th>

                                <th class="col-money text-end">
                                    Subtotal
                                </th>

                                <th class="col-money text-end">
                                    Descuento
                                </th>

                                <th class="col-money text-end">
                                    Impuesto
                                </th>

                                <th class="col-money text-end">
                                    Total
                                </th>

                                <th class="col-money text-end">
                                    Saldo
                                </th>

                                <th class="col-estado">
                                    Estado
                                </th>

                                <th class="col-acciones text-center">
                                    Acciones
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                        @foreach (var factura in facturas)
                        {
                            <tr>

                                <!-- ID -->

                                <td class="text-center">

                                    <span class="col-id">
                                        @factura.IdFactura
                                    </span>

                                </td>


                                <!-- FACTURA -->

                                <td>

                                    <div class="invoice-number">

                                        @(string.IsNullOrWhiteSpace(
                                            factura.NumeroFactura)
                                            ? $"Factura #{factura.IdFactura}"
                                            : factura.NumeroFactura)

                                    </div>


                                    @if (factura.IdTipoComprobanteNavigation != null)
                                    {
                                        <span class="invoice-type">

                                            @factura.IdTipoComprobanteNavigation.Nombre

                                        </span>
                                    }


                                    @if (factura.IdSerieFacturaNavigation != null)
                                    {
                                        <span class="invoice-serie">

                                            Serie:
                                            @factura.IdSerieFacturaNavigation.Nombre

                                        </span>
                                    }

                                </td>


                                <!-- PEDIDO -->

                                <td>

                                    @if (factura.IdPedidoNavigation != null)
                                    {
                                        <a asp-controller="Pedido"
                                           asp-action="Details"
                                           asp-route-id="@factura.IdPedidoNavigation.IdPedido"
                                           class="text-decoration-none">

                                            #@factura.IdPedidoNavigation.NumeroPedido

                                        </a>
                                    }
                                    else if (factura.IdPedido > 0)
                                    {
                                        <span>
                                            #@factura.IdPedido
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- FECHA -->

                                <td>

                                    <span class="date-main">

                                        @factura.FechaFactura.ToString("dd/MM/yyyy")

                                    </span>

                                    <span class="date-time">

                                        @factura.FechaFactura.ToString("HH:mm")

                                    </span>

                                </td>


                                <!-- CLIENTE -->

                                <td>

                                    @if (factura.IdPedidoNavigation?
                                        .IdClienteNavigation != null)
                                    {
                                        var cliente =
                                            factura.IdPedidoNavigation
                                                .IdClienteNavigation;

                                        var nombre =
                                            $"{cliente.Nombres} {cliente.Apellidos}"
                                            .Trim();

                                        if (string.IsNullOrWhiteSpace(nombre))
                                        {
                                            nombre =
                                                $"Cliente #{cliente.IdCliente}";
                                        }

                                        <div class="client-name"
                                             title="@nombre">

                                            @nombre

                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(
                                            cliente.Cedula))
                                        {
                                            <span class="client-document">

                                                Cédula:
                                                @cliente.Cedula

                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span>
                                            Consumidor final
                                        </span>
                                    }

                                </td>


                                <!-- MONEDA -->

                                <td>

                                    @if (factura.IdMonedaNavigation != null)
                                    {
                                        <span class="currency-code">

                                            @factura.IdMonedaNavigation.CodigoIso

                                        </span>

                                        @if (!string.IsNullOrWhiteSpace(
                                            factura.IdMonedaNavigation.Simbolo))
                                        {
                                            <span class="currency-symbol">

                                                (@factura.IdMonedaNavigation.Simbolo)

                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- SUBTOTAL -->

                                <td class="text-end money">

                                    @factura.Subtotal.ToString("N2")

                                </td>


                                <!-- DESCUENTO -->

                                <td class="text-end money">

                                    @if (factura.Descuento > 0)
                                    {
                                        <span class="text-danger">

                                            -@factura.Descuento.ToString("N2")

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            0.00
                                        </span>
                                    }

                                </td>


                                <!-- IMPUESTO -->

                                <td class="text-end money">

                                    @if (factura.Impuesto > 0)
                                    {
                                        @factura.Impuesto.ToString("N2")
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            0.00
                                        </span>
                                    }

                                </td>


                                <!-- TOTAL -->

                                <td class="text-end">

                                    <span class="total">

                                        @factura.Total.ToString("N2")

                                    </span>

                                </td>


                                <!-- SALDO -->

                                <td class="text-end">

                                    @if (factura.SaldoPendiente <= 0)
                                    {
                                        <span class="balance-paid">
                                            0.00
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="balance-pending">

                                            @factura.SaldoPendiente.ToString("N2")

                                        </span>
                                    }

                                </td>


                                <!-- ESTADO -->

                                <td>

                                    @switch (factura.IdEstadoFactura)
                                    {
                                        case ESTADO_PENDIENTE:

                                            <span class="status-badge bg-warning text-dark">

                                                <i class="bi bi-clock"></i>

                                                @(factura.IdEstadoFacturaNavigation
                                                    ?.Nombre ?? "Pendiente")

                                            </span>

                                            break;


                                        case ESTADO_PAGADA:

                                            <span class="status-badge bg-success text-white">

                                                <i class="bi bi-check-circle"></i>

                                                @(factura.IdEstadoFacturaNavigation
                                                    ?.Nombre ?? "Pagada")

                                            </span>

                                            break;


                                        case ESTADO_ANULADA:

                                            <span class="status-badge bg-danger text-white">

                                                <i class="bi bi-x-circle"></i>

                                                @(factura.IdEstadoFacturaNavigation
                                                    ?.Nombre ?? "Anulada")

                                            </span>

                                            break;


                                        case ESTADO_PARCIAL:

                                            <span class="status-badge bg-info text-dark">

                                                <i class="bi bi-hourglass-split"></i>

                                                @(factura.IdEstadoFacturaNavigation
                                                    ?.Nombre ?? "Pago parcial")

                                            </span>

                                            break;


                                        default:

                                            <span class="status-badge bg-secondary text-white">

                                                <i class="bi bi-question-circle"></i>

                                                @(factura.IdEstadoFacturaNavigation
                                                    ?.Nombre ?? "Desconocido")

                                            </span>

                                            break;
                                    }

                                </td>


                                <!-- ====================================================
                                     ACCIONES
                                     ==================================================== -->

                                <td>

                                    <div class="actions">

                                        <!-- VER -->

                                        <a asp-controller="Factura"
                                           asp-action="Details"
                                           asp-route-id="@factura.IdFactura"
                                           class="btn btn-sm btn-outline-primary btn-action"
                                           title="Ver detalle"
                                           data-bs-toggle="tooltip">

                                            <i class="bi bi-eye"></i>

                                        </a>


                                        <!-- ====================================================
                                             IMPRIMIR
                                             SOLO FACTURAS PAGADAS
                                             ==================================================== -->

                                        @if (factura.IdEstadoFactura == ESTADO_PAGADA)
                                        {
                                            <a asp-controller="Factura"
                                               asp-action="Imprimir"
                                               asp-route-id="@factura.IdFactura"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               class="btn btn-sm btn-outline-dark btn-action"
                                               title="Imprimir factura pagada"
                                               data-bs-toggle="tooltip">

                                                <i class="bi bi-printer"></i>

                                            </a>
                                        }


                                        <!-- HISTORIAL -->

                                        <a asp-controller="Factura"
                                           asp-action="Historial"
                                           asp-route-id="@factura.IdFactura"
                                           class="btn btn-sm btn-outline-secondary btn-action"
                                           title="Historial"
                                           data-bs-toggle="tooltip">

                                            <i class="bi bi-clock-history"></i>

                                        </a>


                                        <!-- EDITAR -->

                                        @if (factura.IdEstadoFactura != ESTADO_ANULADA)
                                        {
                                            <a asp-controller="Factura"
                                               asp-action="Edit"
                                               asp-route-id="@factura.IdFactura"
                                               class="btn btn-sm btn-outline-warning btn-action"
                                               title="Editar"
                                               data-bs-toggle="tooltip">

                                                <i class="bi bi-pencil"></i>

                                            </a>
                                        }


                                        <!-- PAGAR -->

                                        @if (factura.IdEstadoFactura != ESTADO_ANULADA &&
                                             factura.SaldoPendiente > 0)
                                        {
                                            <a asp-controller="Pago"
                                               asp-action="CreateParaFactura"
                                               asp-route-id="@factura.IdFactura"
                                               class="btn btn-sm btn-outline-success btn-action"
                                               title="Registrar pago"
                                               data-bs-toggle="tooltip">

                                                <i class="bi bi-cash-coin"></i>

                                            </a>
                                        }


                                        <!-- ANULAR -->

                                        @if (factura.IdEstadoFactura != ESTADO_ANULADA)
                                        {
                                            <a asp-controller="Factura"
                                               asp-action="Delete"
                                               asp-route-id="@factura.IdFactura"
                                               class="btn btn-sm btn-outline-danger btn-action"
                                               title="Anular"
                                               data-bs-toggle="tooltip">

                                                <i class="bi bi-x-lg"></i>

                                            </a>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>



@model WebApplication1.Models.Factura

@{
    ViewData["Title"] = "Editar Factura";

    var pedido = Model.IdPedidoNavigation;
    var estado = Model.IdEstadoFacturaNavigation;
    var moneda = Model.IdMonedaNavigation;
    var tipoComprobante = Model.IdTipoComprobanteNavigation;
    var serie = Model.IdSerieFacturaNavigation;

    bool facturaAnulada = Model.IdEstadoFactura == 3;

    var monedas = ViewBag.Monedas as IEnumerable<WebApplication1.Models.Monedum>
                   ?? Enumerable.Empty<WebApplication1.Models.Monedum>();

    var tiposComprobante = ViewBag.TiposComprobante as IEnumerable<WebApplication1.Models.TipoComprobante>
                           ?? Enumerable.Empty<WebApplication1.Models.TipoComprobante>();

    var impuestos = ViewBag.Impuestos as IEnumerable<WebApplication1.Models.Impuesto>
                    ?? Enumerable.Empty<WebApplication1.Models.Impuesto>();

    WebApplication1.Models.Impuesto? impuestoActual = null;

    if (Model.IdImpuesto.HasValue && Model.IdImpuesto.Value > 0)
    {
        impuestoActual = impuestos.FirstOrDefault(
            i => i.IdImpuesto == Model.IdImpuesto.Value
        );
    }

    decimal porcentajeImpuesto = impuestoActual?.Porcentaje ?? 0m;
}

<div class="container mt-4">

    <!-- ============================================================
         ENCABEZADO
    ============================================================ -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="mb-1">

                <i class="bi bi-pencil-square"></i>

                Editar Factura

            </h2>

            <p class="text-muted mb-0">

                Modifique la información permitida de la factura.

            </p>

        </div>

        <div>

            <a asp-controller="Factura"
               asp-action="Details"
               asp-route-id="@Model.IdFactura"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left"></i>

                Volver al detalle

            </a>

        </div>

    </div>


    <!-- ============================================================
         MENSAJES
    ============================================================ -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">

            <i class="bi bi-exclamation-triangle-fill"></i>

            @TempData["Error"]

        </div>
    }


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">

            <i class="bi bi-check-circle-fill"></i>

            @TempData["Success"]

        </div>
    }


    <!-- ============================================================
         ERRORES DE VALIDACIÓN
    ============================================================ -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">

            <h6 class="alert-heading">

                <i class="bi bi-exclamation-triangle-fill"></i>

                No se pudieron guardar los cambios

            </h6>

            <div asp-validation-summary="All"></div>

        </div>
    }


    @if (facturaAnulada)
    {
        <div class="alert alert-danger">

            <i class="bi bi-x-circle-fill"></i>

            Esta factura se encuentra anulada y no puede ser modificada.

        </div>
    }


    <!-- ============================================================
         FORMULARIO PRINCIPAL
    ============================================================ -->

    <form asp-controller="Factura"
          asp-action="Edit"
          asp-route-id="@Model.IdFactura"
          method="post"
          id="formEditarFactura">

        @Html.AntiForgeryToken()


        <!-- ========================================================
             CAMPOS OCULTOS
        ======================================================== -->

        <input type="hidden"
               asp-for="IdFactura" />

        <input type="hidden"
               asp-for="IdPedido" />

        <input type="hidden"
               asp-for="IdEstadoFactura" />

        <input type="hidden"
               asp-for="NumeroFactura" />

        <input type="hidden"
               asp-for="IdSerieFactura" />

        <input type="hidden"
               asp-for="Subtotal" />

        <input type="hidden"
               asp-for="Descuento" />

        <input type="hidden"
               asp-for="Impuesto" />

        <input type="hidden"
               asp-for="Total" />

        <input type="hidden"
               asp-for="SaldoPendiente" />


        <!-- ========================================================
             INFORMACIÓN DE LA FACTURA
        ======================================================== -->

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-primary text-white">

                <h5 class="mb-0">

                    <i class="bi bi-receipt"></i>

                    Información de la factura

                </h5>

            </div>

            <div class="card-body">

                <div class="row">

                    <!-- ID FACTURA -->

                    <div class="col-md-3 mb-3">

                        <label class="form-label text-muted">

                            ID Factura

                        </label>

                        <div class="form-control bg-light">

                            #@Model.IdFactura

                        </div>

                    </div>


                    <!-- NÚMERO -->

                    <div class="col-md-3 mb-3">

                        <label class="form-label text-muted">

                            Número de factura

                        </label>

                        <div class="form-control bg-light fw-bold">

                            @Model.NumeroFactura

                        </div>

                    </div>


                    <!-- PEDIDO -->

                    <div class="col-md-3 mb-3">

                        <label class="form-label text-muted">

                            Pedido

                        </label>

                        <div class="form-control bg-light">

                            @if (pedido != null)
                            {
                                @pedido.NumeroPedido
                            }
                            else
                            {
                                @:#@Model.IdPedido
                            }

                        </div>

                    </div>


                    <!-- ESTADO -->

                    <div class="col-md-3 mb-3">

                        <label class="form-label text-muted">

                            Estado

                        </label>

                        <div class="form-control bg-light">

                            @if (estado != null)
                            {
                                @estado.Nombre
                            }
                            else
                            {
                                <span class="text-muted">
                                    No especificado
                                </span>
                            }

                        </div>

                    </div>

                </div>


                <div class="row">

                    <!-- SERIE -->

                    <div class="col-md-4 mb-3">

                        <label class="form-label text-muted">

                            Serie

                        </label>

                        <div class="form-control bg-light">

                            @if (serie != null)
                            {
                                @serie.Nombre

                                <span class="text-muted">

                                    (@serie.Prefijo)

                                </span>
                            }
                            else
                            {
                                <span class="text-muted">

                                    No especificada

                                </span>
                            }

                        </div>

                    </div>


                    <!-- TIPO COMPROBANTE -->

                    <div class="col-md-4 mb-3">

                        <label asp-for="IdTipoComprobante"
                               class="form-label fw-bold">

                            Tipo de comprobante

                            <span class="text-danger">*</span>

                        </label>

                        <select asp-for="IdTipoComprobante"
                                class="form-select">

                            <option value="0">

                                -- Seleccione un tipo de comprobante --

                            </option>

                            @foreach (var tipo in tiposComprobante)
                            {
                                <option value="@tipo.IdTipoComprobante">

                                    @tipo.Nombre

                                </option>
                            }

                        </select>

                        <span asp-validation-for="IdTipoComprobante"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- FECHA -->

                    <div class="col-md-4 mb-3">

                        <label asp-for="FechaFactura"
                               class="form-label fw-bold">

                            Fecha de factura

                            <span class="text-danger">*</span>

                        </label>

                        <input asp-for="FechaFactura"
                               type="datetime-local"
                               class="form-control" />

                        <span asp-validation-for="FechaFactura"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- ========================================================
             MONEDA E IMPUESTO
        ======================================================== -->

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-light">

                <h5 class="mb-0">

                    <i class="bi bi-currency-exchange"></i>

                    Configuración fiscal y monetaria

                </h5>

            </div>

            <div class="card-body">

                <div class="row">

                    <!-- MONEDA -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="IdMoneda"
                               class="form-label fw-bold">

                            Moneda

                            <span class="text-danger">*</span>

                        </label>

                        <select asp-for="IdMoneda"
                                class="form-select">

                            <option value="0">

                                -- Seleccione una moneda --

                            </option>

                            @foreach (var monedaItem in monedas)
                            {
                                <option value="@monedaItem.IdMoneda">

                                    @monedaItem.Nombre

                                    (@monedaItem.CodigoIso)

                                    @if (!string.IsNullOrWhiteSpace(monedaItem.Simbolo))
                                    {
                                        @: - @monedaItem.Simbolo
                                    }

                                </option>
                            }

                        </select>

                        <span asp-validation-for="IdMoneda"
                              class="text-danger">
                        </span>

                        @if (moneda != null)
                        {
                            <div class="form-text">

                                Moneda actual:

                                <strong>

                                    @moneda.Nombre

                                    (@moneda.CodigoIso)

                                </strong>

                            </div>
                        }

                    </div>


                    <!-- IMPUESTO -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="IdImpuesto"
                               class="form-label fw-bold">

                            Impuesto / IVA

                        </label>

                        <select asp-for="IdImpuesto"
                                id="IdImpuesto"
                                class="form-select">

                            <option value="">

                                -- Sin impuesto --

                            </option>

                            @foreach (var impuesto in impuestos)
                            {
                                <option value="@impuesto.IdImpuesto"
                                        data-porcentaje="@impuesto.Porcentaje.ToString(System.Globalization.CultureInfo.InvariantCulture)">

                                    @impuesto.Nombre

                                    -

                                    @impuesto.Porcentaje.ToString("N2")%

                                </option>
                            }

                        </select>

                        <span asp-validation-for="IdImpuesto"
                              class="text-danger">
                        </span>

                        <div class="form-text">

                            Seleccione el impuesto o IVA aplicado
                            a esta factura.

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ========================================================
             IMPORTES
        ======================================================== -->

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-success text-white">

                <h5 class="mb-0">

                    <i class="bi bi-calculator"></i>

                    Resumen de la factura

                </h5>

            </div>

            <div class="card-body">

                <div class="alert alert-info">

                    <i class="bi bi-info-circle"></i>

                    Los importes se obtienen del pedido asociado.
                    No deben modificarse manualmente.

                </div>


                <div class="row">

                    <!-- SUBTOTAL -->

                    <div class="col-md-3 mb-3">

                        <label class="form-label text-muted">

                            Subtotal

                        </label>

                        <div id="resumenSubtotal"
                             class="form-control bg-light text-end fw-bold">

                            @Model.Subtotal.ToString("N2")

                        </div>

                    </div>


                    <!-- DESCUENTO -->

                    <div class="col-md-3 mb-3">

                        <label class="form-label text-muted">

                            Descuento

                        </label>

                        <div id="resumenDescuento"
                             class="form-control bg-light text-end fw-bold">

                            @Model.Descuento.ToString("N2")

                        </div>

                    </div>


                    <!-- IMPUESTO -->

                    <div class="col-md-3 mb-3">

                        <label class="form-label text-muted">

                            Impuesto / IVA

                        </label>

                        <div id="resumenImpuesto"
                             class="form-control bg-light text-end fw-bold">

                            @Model.Impuesto.ToString("N2")

                        </div>

                        <div class="small text-muted mt-1">

                            Porcentaje:

                            <strong id="resumenPorcentajeImpuesto">

                                @porcentajeImpuesto.ToString("N2")%

                            </strong>

                        </div>

                    </div>


                    <!-- TOTAL -->

                    <div class="col-md-3 mb-3">

                        <label class="form-label text-muted">

                            Total

                        </label>

                        <div id="resumenTotal"
                             class="form-control bg-light text-end fw-bold text-success">

                            @Model.Total.ToString("N2")

                        </div>

                    </div>

                </div>


                <!-- SALDO -->

                <div class="row mt-2">

                    <div class="col-md-4">

                        <label class="form-label text-muted">

                            Saldo pendiente

                        </label>

                        <div id="resumenSaldo"
                             class="form-control bg-light text-end fw-bold
                            @(Model.SaldoPendiente > 0
                                ? "text-danger"
                                : "text-success")">

                            @Model.SaldoPendiente.ToString("N2")

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ========================================================
             OBSERVACIÓN
        ======================================================== -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">

                <h5 class="mb-0">

                    <i class="bi bi-chat-left-text"></i>

                    Observación

                </h5>

            </div>

            <div class="card-body">

                <label asp-for="Observacion"
                       class="form-label">

                    Observación de la factura

                </label>

                <textarea asp-for="Observacion"
                          class="form-control"
                          rows="4"
                          maxlength="300"
                          placeholder="Ingrese una observación si es necesario..."></textarea>

                <span asp-validation-for="Observacion"
                      class="text-danger">
                </span>

                <div class="form-text">

                    Máximo 300 caracteres.

                </div>

            </div>

        </div>


        <!-- ========================================================
             INFORMACIÓN DE ANULACIÓN
        ======================================================== -->
        @if (Model.FechaAnulacion.HasValue)
        {
            <div class="card shadow-sm mb-4 border-danger">

                <div class="card-header bg-danger text-white">

                    <h5 class="mb-0">

                        <i class="bi bi-x-circle"></i>

                        Información de anulación

                    </h5>

                </div>

                <div class="card-body">

                    <div class="row">

                        <div class="col-md-4">

                            <label class="text-muted">

                                Fecha de anulación

                            </label>

                            <div class="fw-bold">

                                @Model.FechaAnulacion.Value.ToString(
                                    "dd/MM/yyyy HH:mm"
                                )

                            </div>

                        </div>


                        <div class="col-md-8">

                            <label class="text-muted">

                                Observación de anulación

                            </label>

                            <div class="fw-bold">

                                @(string.IsNullOrWhiteSpace(
                                    Model.ObservacionAnulacion)
                                    ? "Sin observación"
                                    : Model.ObservacionAnulacion)

                            </div>

                        </div>

                    </div>

                </div>

            </div>
        }


        <!-- ========================================================
             BOTONES
        ======================================================== -->

        <div class="card shadow-sm mb-4">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <a asp-controller="Factura"
                       asp-action="Details"
                       asp-route-id="@Model.IdFactura"
                       class="btn btn-secondary">

                        <i class="bi bi-x-lg"></i>

                        Cancelar

                    </a>


                    @if (!facturaAnulada)
                    {
                        <button type="submit"
                                class="btn btn-primary btn-lg">

                            <i class="bi bi-check-circle"></i>

                            Guardar cambios

                        </button>
                    }

                </div>

            </div>

        </div>

    </form>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const impuestoSelect =
                document.getElementById("IdImpuesto");

            const porcentajeElement =
                document.getElementById("resumenPorcentajeImpuesto");


            function actualizarPorcentajeImpuesto() {

                if (!impuestoSelect || !porcentajeElement) {
                    return;
                }

                const opcion =
                    impuestoSelect.options[
                        impuestoSelect.selectedIndex
                    ];

                if (!opcion) {
                    porcentajeElement.textContent = "0.00%";
                    return;
                }

                const porcentaje =
                    Number(
                        opcion.getAttribute("data-porcentaje")
                    ) || 0;

                porcentajeElement.textContent =
                    porcentaje.toLocaleString("es-NI", {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }) + "%";
            }


            if (impuestoSelect) {

                impuestoSelect.addEventListener(
                    "change",
                    actualizarPorcentajeImpuesto
                );

            }


            actualizarPorcentajeImpuesto();

        });

    </script>
}
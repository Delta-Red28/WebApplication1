@model WebApplication1.Models.Factura

@{
    ViewData["Title"] = "Editar Factura";

    var pedido = Model.IdPedidoNavigation;
    var estado = Model.IdEstadoFacturaNavigation;
    var moneda = Model.IdMonedaNavigation;
    var tipoComprobante = Model.IdTipoComprobanteNavigation;
    var serie = Model.IdSerieFacturaNavigation;
    var impuestoActual = Model.IdImpuestoNavigation;

    bool facturaAnulada = Model.IdEstadoFactura == 3;

    var monedas = ViewBag.Monedas as IEnumerable<WebApplication1.Models.Monedum>
                   ?? Enumerable.Empty<WebApplication1.Models.Monedum>();

    var tiposComprobante = ViewBag.TiposComprobante as IEnumerable<WebApplication1.Models.TipoComprobante>
                           ?? Enumerable.Empty<WebApplication1.Models.TipoComprobante>();

    var impuestos = ViewBag.Impuestos as IEnumerable<WebApplication1.Models.Impuesto>
                    ?? Enumerable.Empty<WebApplication1.Models.Impuesto>();

    decimal porcentajeImpuesto = impuestoActual?.Porcentaje ?? 0m;
}

<div class="container-fluid py-4">

    <!-- ========================================================= -->
    <!-- ENCABEZADO -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-pencil-square me-2"></i>
                Editar factura
            </h2>

            <p class="text-muted mb-0">
                Modifique la información permitida de la factura.
            </p>
        </div>

        <div>
            <a asp-controller="Factura"
               asp-action="Details"
               asp-route-id="@Model.IdFactura"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Volver al detalle

            </a>
        </div>

    </div>


    <!-- ========================================================= -->
    <!-- MENSAJES -->
    <!-- ========================================================= -->

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">

            <div class="fw-bold mb-2">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                No se pudieron guardar los cambios
            </div>

            <div asp-validation-summary="All"
                 class="mb-0">
            </div>

        </div>
    }


    @if (facturaAnulada)
    {
        <div class="alert alert-danger">

            <i class="bi bi-x-circle-fill me-2"></i>

            Esta factura se encuentra anulada y no puede ser modificada.

        </div>
    }


    <!-- ========================================================= -->
    <!-- FORMULARIO -->
    <!-- ========================================================= -->

    <form asp-controller="Factura"
          asp-action="Edit"
          asp-route-id="@Model.IdFactura"
          method="post"
          id="formEditarFactura">

        @Html.AntiForgeryToken()

        <!-- ===================================================== -->
        <!-- CAMPOS OCULTOS -->
        <!-- ===================================================== -->

        <input type="hidden"
               asp-for="IdFactura" />

        <input type="hidden"
               asp-for="IdPedido" />

        <input type="hidden"
               asp-for="NumeroFactura" />

        <input type="hidden"
               asp-for="IdSerieFactura" />

        <input type="hidden"
               asp-for="IdEstadoFactura" />


        <!-- ===================================================== -->
        <!-- INFORMACIÓN GENERAL -->
        <!-- ===================================================== -->

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-primary text-white py-3">

                <h5 class="mb-0 fw-semibold">

                    <i class="bi bi-receipt me-2"></i>

                    Información de la factura

                </h5>

            </div>


            <div class="card-body">

                <div class="row g-4">

                    <!-- ID -->

                    <div class="col-md-3">

                        <label class="form-label text-muted">
                            ID Factura
                        </label>

                        <input type="text"
                               class="form-control bg-light"
                               value="#@Model.IdFactura"
                               readonly />

                    </div>


                    <!-- NUMERO -->

                    <div class="col-md-3">

                        <label class="form-label text-muted">
                            Número de factura
                        </label>

                        <input type="text"
                               class="form-control bg-light fw-bold"
                               value="@Model.NumeroFactura"
                               readonly />

                    </div>


                    <!-- PEDIDO -->

                    <div class="col-md-3">

                        <label class="form-label text-muted">
                            Pedido asociado
                        </label>

                        <div class="input-group">

                            <input type="text"
                                   class="form-control bg-light"
                                   value="@(pedido?.NumeroPedido ?? $"#{Model.IdPedido}")"
                                   readonly />

                            <a asp-controller="Pedido"
                               asp-action="Details"
                               asp-route-id="@Model.IdPedido"
                               class="btn btn-outline-primary"
                               title="Ver pedido">

                                <i class="bi bi-box-arrow-up-right"></i>

                            </a>

                        </div>

                    </div>


                    <!-- ESTADO -->

                    <div class="col-md-3">

                        <label class="form-label text-muted">
                            Estado
                        </label>

                        <input type="text"
                               class="form-control bg-light"
                               value="@(estado?.Nombre ?? "No especificado")"
                               readonly />

                    </div>

                </div>


                <hr class="my-4" />


                <div class="row g-4">

                    <!-- SERIE -->

                    <div class="col-md-4">

                        <label class="form-label text-muted">
                            Serie
                        </label>

                        <input type="text"
                               class="form-control bg-light"
                               value="@(serie != null
                                   ? $"{serie.Nombre} ({serie.Prefijo})"
                                   : "No especificada")"
                               readonly />

                        <div class="form-text">
                            La serie no puede cambiarse al editar una factura.
                        </div>

                    </div>


                    <!-- TIPO COMPROBANTE -->

                    <div class="col-md-4">

                        <label asp-for="IdTipoComprobante"
                               class="form-label fw-bold">

                            Tipo de comprobante

                            <span class="text-danger">*</span>

                        </label>

                        <select asp-for="IdTipoComprobante"
                                class="form-select">

                            <option value="0">
                                -- Seleccione un tipo de comprobante --
                            </option>

                            @foreach (var tipo in tiposComprobante)
                            {
                                <option value="@tipo.IdTipoComprobante">
                                    @tipo.Nombre
                                </option>
                            }

                        </select>

                        <span asp-validation-for="IdTipoComprobante"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- FECHA -->

                    <div class="col-md-4">

                        <label asp-for="FechaFactura"
                               class="form-label fw-bold">

                            Fecha de factura

                            <span class="text-danger">*</span>

                        </label>

                        <input asp-for="FechaFactura"
                               type="datetime-local"
                               class="form-control" />

                        <span asp-validation-for="FechaFactura"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- ========================================================= -->
        <!-- PEDIDO ASOCIADO -->
        <!-- ========================================================= -->

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-white py-3">

                <div class="d-flex justify-content-between align-items-center">

                    <h5 class="mb-0 fw-semibold">

                        <i class="bi bi-cart-check me-2"></i>

                        Pedido asociado

                    </h5>

                    <span class="badge bg-primary">
                        Pedido #@Model.IdPedido
                    </span>

                </div>

            </div>


            <div class="card-body">

                <div class="alert alert-info">

                    <i class="bi bi-info-circle-fill me-2"></i>

                    El pedido asociado no puede cambiarse desde la edición
                    de una factura existente.

                </div>


                @if (pedido != null)
                {
                    <div class="row g-4">

                        <!-- ================================================= -->
                        <!-- CLIENTE -->
                        <!-- ================================================= -->

                        <div class="col-md-4">

                            <label class="form-label text-muted">
                                Cliente
                            </label>

                            <div class="form-control bg-light">

                                @if (pedido.IdClienteNavigation != null)
                                {
                                    @pedido.IdClienteNavigation.Nombres
                                    @:
                                    @pedido.IdClienteNavigation.Apellidos
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Cliente no especificado
                                    </span>
                                }

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- MESA -->
                        <!-- ================================================= -->

                        <div class="col-md-4">

                            <label class="form-label text-muted">
                                Mesa
                            </label>

                            <div class="form-control bg-light">

                                @if (pedido.IdMesaNavigation != null)
                                {
                                    @pedido.IdMesaNavigation.NumeroMesa
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Sin mesa
                                    </span>
                                }

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- TIPO PEDIDO -->
                        <!-- ================================================= -->

                        <div class="col-md-4">

                            <label class="form-label text-muted">
                                Tipo de pedido
                            </label>

                            <div class="form-control bg-light">

                                @if (pedido.IdTipoPedidoNavigation != null)
                                {
                                    @pedido.IdTipoPedidoNavigation.Nombre
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No especificado
                                    </span>
                                }

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- NUMERO PEDIDO -->
                        <!-- ================================================= -->

                        <div class="col-md-4">

                            <label class="form-label text-muted">
                                Número de pedido
                            </label>

                            <div class="form-control bg-light">
                                @pedido.NumeroPedido
                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- FECHA PEDIDO -->
                        <!-- ================================================= -->

                        <div class="col-md-4">

                            <label class="form-label text-muted">
                                Fecha del pedido
                            </label>

                            <div class="form-control bg-light">

                                @pedido.FechaPedido.ToString(
                                    "dd/MM/yyyy HH:mm"
                                )

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- ESTADO PEDIDO -->
                        <!-- ================================================= -->

                        <div class="col-md-4">

                            <label class="form-label text-muted">
                                Estado del pedido
                            </label>

                            <div class="form-control bg-light">

                                @if (pedido.IdEstadoPedidoNavigation != null)
                                {
                                    @pedido.IdEstadoPedidoNavigation.Nombre
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No especificado
                                    </span>
                                }

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- OBSERVACION PEDIDO -->
                        <!-- ================================================= -->

                        <div class="col-12">

                            <label class="form-label text-muted">
                                Observación del pedido
                            </label>

                            <div class="form-control bg-light"
                                 style="min-height: 80px;">

                                @(string.IsNullOrWhiteSpace(pedido.Observacion)
                                    ? "Sin observación"
                                    : pedido.Observacion)

                            </div>

                        </div>

                    </div>
                }
                else
                {
                    <div class="alert alert-warning mb-0">

                        <i class="bi bi-exclamation-triangle-fill me-2"></i>

                        No se pudo cargar el pedido asociado a esta factura.

                    </div>
                }

            </div>

        </div>


        <!-- ========================================================= -->
        <!-- CONFIGURACIÓN FISCAL -->
        <!-- ========================================================= -->

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-white py-3">

                <h5 class="mb-0 fw-semibold">

                    <i class="bi bi-currency-exchange me-2"></i>

                    Configuración fiscal y monetaria

                </h5>

            </div>


            <div class="card-body">

                <div class="row g-4">

                    <!-- ================================================= -->
                    <!-- MONEDA -->
                    <!-- ================================================= -->

                    <div class="col-md-6">

                        <label asp-for="IdMoneda"
                               class="form-label fw-bold">

                            Moneda

                            <span class="text-danger">*</span>

                        </label>

                        <select asp-for="IdMoneda"
                                class="form-select">

                            <option value="0">
                                -- Seleccione una moneda --
                            </option>

                            @foreach (var monedaItem in monedas)
                            {
                                <option value="@monedaItem.IdMoneda">

                                    @monedaItem.Nombre
                                    (@monedaItem.CodigoIso)

                                    @if (!string.IsNullOrWhiteSpace(
                                        monedaItem.Simbolo))
                                    {
                                        @: - @monedaItem.Simbolo
                                    }

                                </option>
                            }

                        </select>

                        <span asp-validation-for="IdMoneda"
                              class="text-danger">
                        </span>


                        @if (moneda != null)
                        {
                            <div class="form-text">

                                Moneda actual:

                                <strong>
                                    @moneda.Nombre
                                    (@moneda.CodigoIso)
                                </strong>

                            </div>
                        }


                        <div class="mt-2">

                            <span class="badge bg-warning text-dark">

                                <i class="bi bi-exclamation-circle me-1"></i>

                                @if (Model.Pagos != null &&
                                     Model.Pagos.Any(p =>
                                         p.IdEstadoPago == 2))
                                {
                                    @:No puede cambiarse si existen pagos confirmados.
                                }
                                else
                                {
                                    @:Puede cambiarse mientras no existan pagos confirmados.
                                }

                            </span>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- IMPUESTO -->
                    <!-- ================================================= -->

                    <div class="col-md-6">

                        <label asp-for="IdImpuesto"
                               class="form-label fw-bold">

                            Impuesto / IVA

                        </label>

                        <select asp-for="IdImpuesto"
                                id="IdImpuesto"
                                class="form-select">

                            <option value="">
                                -- Sin impuesto --
                            </option>

                            @foreach (var impuesto in impuestos)
                            {
                                <option value="@impuesto.IdImpuesto">

                                    @impuesto.Nombre
                                    -
                                    @impuesto.Porcentaje.ToString("N2")%

                                </option>
                            }

                        </select>

                        <span asp-validation-for="IdImpuesto"
                              class="text-danger">
                        </span>

                        <div class="form-text">

                            El impuesto seleccionado se guarda en la
                            factura. Los importes de la factura no se
                            recalculan durante la edición.

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ========================================================= -->
        <!-- RESUMEN DE IMPORTES -->
        <!-- ========================================================= -->

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-success text-white py-3">

                <h5 class="mb-0 fw-semibold">

                    <i class="bi bi-calculator me-2"></i>

                    Resumen de la factura

                </h5>

            </div>


            <div class="card-body">

                <div class="alert alert-info">

                    <i class="bi bi-info-circle-fill me-2"></i>

                    Estos importes son los registrados actualmente en
                    la factura. El controlador de edición los conserva
                    y no permite modificarlos desde este formulario.

                </div>


                <div class="row g-4">

                    <!-- ================================================= -->
                    <!-- SUBTOTAL -->
                    <!-- ================================================= -->

                    <div class="col-md-3">

                        <label class="form-label text-muted">
                            Subtotal
                        </label>

                        <div class="form-control bg-light text-end fw-bold">

                            C$
                            @Model.Subtotal.ToString("N2")

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- DESCUENTO -->
                    <!-- ================================================= -->

                    <div class="col-md-3">

                        <label class="form-label text-muted">
                            Descuento
                        </label>

                        <div class="form-control bg-light text-end fw-bold text-danger">

                            C$
                            @Model.Descuento.ToString("N2")

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- BASE -->
                    <!-- ================================================= -->

                    <div class="col-md-3">

                        <label class="form-label text-muted">
                            Base imponible
                        </label>

                        <div class="form-control bg-light text-end fw-bold">

                            C$
                            @((Model.Subtotal - Model.Descuento)
                                .ToString("N2"))

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- IVA % -->
                    <!-- ================================================= -->

                    <div class="col-md-3">

                        <label class="form-label text-muted">
                            Porcentaje impuesto
                        </label>

                        <div class="form-control bg-light text-end fw-bold">

                            @porcentajeImpuesto.ToString("N2")%

                        </div>

                    </div>

                </div>


                <div class="row g-4 mt-1">

                    <!-- ================================================= -->
                    <!-- IMPUESTO -->
                    <!-- ================================================= -->

                    <div class="col-md-4">

                        <label class="form-label text-muted">
                            Impuesto / IVA
                        </label>

                        <div class="form-control bg-light text-end fw-bold">

                            C$
                            @Model.Impuesto.ToString("N2")

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- TOTAL -->
                    <!-- ================================================= -->

                    <div class="col-md-4">

                        <label class="form-label text-muted">
                            Total factura
                        </label>

                        <div class="form-control bg-light text-end fw-bold text-success fs-5">

                            C$
                            @Model.Total.ToString("N2")

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- SALDO -->
                    <!-- ================================================= -->

                    <div class="col-md-4">

                        <label class="form-label text-muted">
                            Saldo pendiente
                        </label>

                        <div class="form-control bg-light text-end fw-bold
                            @(Model.SaldoPendiente > 0
                                ? "text-danger"
                                : "text-success")">

                            C$
                            @Model.SaldoPendiente.ToString("N2")

                        </div>

                    </div>

                </div>


                @if (Model.Pagos != null && Model.Pagos.Any())
                {
                    <div class="alert alert-warning mt-4 mb-0">

                        <i class="bi bi-cash-coin me-2"></i>

                        Esta factura tiene pagos registrados.
                        Si existen pagos confirmados, la moneda no
                        puede cambiarse.

                    </div>
                }

            </div>

        </div>


        <!-- ========================================================= -->
        <!-- OBSERVACIÓN -->
        <!-- ========================================================= -->

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-white py-3">

                <h5 class="mb-0 fw-semibold">

                    <i class="bi bi-chat-left-text me-2"></i>

                    Observación

                </h5>

            </div>


            <div class="card-body">

                <label asp-for="Observacion"
                       class="form-label">

                    Observación de la factura

                </label>

                <textarea asp-for="Observacion"
                          class="form-control"
                          rows="4"
                          maxlength="300"
                          placeholder="Ingrese una observación si es necesario..."></textarea>

                <span asp-validation-for="Observacion"
                      class="text-danger">
                </span>

                <div class="form-text">
                    Máximo 300 caracteres.
                </div>

            </div>

        </div>


        <!-- ========================================================= -->
        <!-- INFORMACIÓN DE ANULACIÓN -->
        <!-- ========================================================= -->

        @if (Model.FechaAnulacion.HasValue)
        {
            <div class="card shadow-sm border-danger mb-4">

                <div class="card-header bg-danger text-white py-3">

                    <h5 class="mb-0">

                        <i class="bi bi-x-circle me-2"></i>

                        Información de anulación

                    </h5>

                </div>


                <div class="card-body">

                    <div class="row g-4">

                        <div class="col-md-4">

                            <label class="text-muted">
                                Fecha de anulación
                            </label>

                            <div class="fw-bold">

                                @Model.FechaAnulacion.Value.ToString(
                                    "dd/MM/yyyy HH:mm"
                                )

                            </div>

                        </div>


                        <div class="col-md-8">

                            <label class="text-muted">
                                Observación de anulación
                            </label>

                            <div class="fw-bold">

                                @(string.IsNullOrWhiteSpace(
                                    Model.ObservacionAnulacion)
                                    ? "Sin observación"
                                    : Model.ObservacionAnulacion)

                            </div>

                        </div>

                    </div>

                </div>

            </div>
        }


        <!-- ========================================================= -->
        <!-- BOTONES -->
        <!-- ========================================================= -->

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <a asp-controller="Factura"
                       asp-action="Details"
                       asp-route-id="@Model.IdFactura"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-x-circle me-1"></i>

                        Cancelar

                    </a>


                    @if (!facturaAnulada)
                    {
                        <button type="submit"
                                class="btn btn-primary btn-lg"
                                id="btnGuardar">

                            <i class="bi bi-check-circle me-1"></i>

                            Guardar cambios

                        </button>
                    }

                </div>

            </div>

        </div>

    </form>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const formulario =
                document.getElementById("formEditarFactura");

            const btnGuardar =
                document.getElementById("btnGuardar");

            const facturaAnulada =
                @facturaAnulada.ToString().ToLowerInvariant();


            /*
             * ---------------------------------------------------------
             * FACTURA ANULADA
             * ---------------------------------------------------------
             */

            if (formulario && facturaAnulada) {

                formulario.addEventListener(
                    "submit",
                    function (event) {

                        event.preventDefault();

                        alert(
                            "Esta factura se encuentra anulada y no puede ser modificada."
                        );

                    }
                );

                return;
            }


            /*
             * ---------------------------------------------------------
             * EVITAR DOBLE ENVÍO
             * ---------------------------------------------------------
             */

            if (formulario && btnGuardar) {

                formulario.addEventListener(
                    "submit",
                    function () {

                        btnGuardar.disabled = true;

                        btnGuardar.innerHTML =
                            '<span class="spinner-border spinner-border-sm me-2"></span>' +
                            'Guardando...';

                    }
                );

            }

        });

    </script>
}
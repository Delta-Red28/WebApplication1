@model WebApplication1.Models.Factura

@{
    ViewData["Title"] = "Anular Factura";

    var motivosAnulacion =
        ViewBag.MotivosAnulacion as IEnumerable<WebApplication1.Models.MotivoAnulacion>
        ?? Enumerable.Empty<WebApplication1.Models.MotivoAnulacion>();

    var pedido = Model.IdPedidoNavigation;
    var moneda = Model.IdMonedaNavigation;
    var estado = Model.IdEstadoFacturaNavigation;
}

<div class="container mt-4">

    <!-- ============================================================
         ENCABEZADO
    ============================================================ -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                <i class="bi bi-x-circle text-danger"></i>
                Anular Factura
            </h2>

            <p class="text-muted mb-0">
                Revise la información y confirme la anulación de la factura.
            </p>
        </div>

        <div>
            <a asp-controller="Factura"
               asp-action="Details"
               asp-route-id="@Model.IdFactura"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left"></i>
                Volver
            </a>
        </div>

    </div>


    <!-- ============================================================
         MENSAJE TEMPORAL
    ============================================================ -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger shadow-sm">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            <strong>Error:</strong>

            @TempData["Error"]

        </div>
    }


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success shadow-sm">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

        </div>
    }


    <!-- ============================================================
         ADVERTENCIA PRINCIPAL
    ============================================================ -->

    <div class="alert alert-danger shadow-sm">

        <div class="d-flex align-items-start">

            <div class="me-3">

                <i class="bi bi-exclamation-triangle-fill fs-2"></i>

            </div>

            <div>

                <h5 class="alert-heading mb-2">
                    ¿Está seguro de anular esta factura?
                </h5>

                <p class="mb-2">

                    La factura

                    <strong>
                        @Model.NumeroFactura
                    </strong>

                    cambiará al estado

                    <strong>
                        Anulada
                    </strong>.

                </p>

                <p class="mb-0">

                    La anulación quedará registrada en el historial
                    con el usuario, fecha, motivo y observación.

                </p>

            </div>

        </div>

    </div>


    <!-- ============================================================
         INFORMACIÓN GENERAL
    ============================================================ -->

    <div class="card shadow-sm mb-4">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">

                <i class="bi bi-receipt me-2"></i>

                Información de la factura

            </h5>

        </div>

        <div class="card-body">

            <div class="row">

                <!-- ==================================================
                     NÚMERO
                ================================================== -->

                <div class="col-md-4 mb-3">

                    <label class="text-muted">
                        Número de factura
                    </label>

                    <div class="fw-bold fs-5">

                        @if (!string.IsNullOrWhiteSpace(Model.NumeroFactura))
                        {
                            @Model.NumeroFactura
                        }
                        else
                        {
                            <span class="text-muted">
                                Sin número
                            </span>
                        }

                    </div>

                </div>


                <!-- ==================================================
                     ID FACTURA
                ================================================== -->

                <div class="col-md-4 mb-3">

                    <label class="text-muted">
                        ID Factura
                    </label>

                    <div class="fw-bold">

                        #@Model.IdFactura

                    </div>

                </div>


                <!-- ==================================================
                     FECHA
                ================================================== -->

                <div class="col-md-4 mb-3">

                    <label class="text-muted">
                        Fecha de factura
                    </label>

                    <div class="fw-bold">

                        @Model.FechaFactura.ToString("dd/MM/yyyy HH:mm")

                    </div>

                </div>


                <!-- ==================================================
                     PEDIDO
                ================================================== -->

                <div class="col-md-4 mb-3">

                    <label class="text-muted">
                        Pedido
                    </label>

                    <div class="fw-bold">

                        @if (pedido != null)
                        {
                            <span>
                                #@pedido.IdPedido
                            </span>

                            @if (!string.IsNullOrWhiteSpace(pedido.NumeroPedido))
                            {
                                <span class="text-muted">
                                    (@pedido.NumeroPedido)
                                </span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">
                                No disponible
                            </span>
                        }

                    </div>

                </div>


                <!-- ==================================================
                     ESTADO
                ================================================== -->

                <div class="col-md-4 mb-3">

                    <label class="text-muted">
                        Estado actual
                    </label>

                    <div>

                        @if (estado != null)
                        {
                            if (Model.IdEstadoFactura == 1)
                            {
                                <span class="badge bg-warning text-dark">

                                    <i class="bi bi-clock me-1"></i>

                                    @estado.Nombre

                                </span>
                            }
                            else if (Model.IdEstadoFactura == 2)
                            {
                                <span class="badge bg-success">

                                    <i class="bi bi-check-circle me-1"></i>

                                    @estado.Nombre

                                </span>
                            }
                            else if (Model.IdEstadoFactura == 4)
                            {
                                <span class="badge bg-info text-dark">

                                    <i class="bi bi-hourglass-split me-1"></i>

                                    @estado.Nombre

                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">

                                    <i class="bi bi-info-circle me-1"></i>

                                    @estado.Nombre

                                </span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">
                                No disponible
                            </span>
                        }

                    </div>

                </div>


                <!-- ==================================================
                     MONEDA
                ================================================== -->

                <div class="col-md-4 mb-3">

                    <label class="text-muted">
                        Moneda
                    </label>

                    <div class="fw-bold">

                        @if (moneda != null)
                        {
                            @moneda.Nombre

                            @if (!string.IsNullOrWhiteSpace(moneda.CodigoIso))
                            {
                                <span class="text-muted">
                                    (@moneda.CodigoIso)
                                </span>
                            }

                            @if (!string.IsNullOrWhiteSpace(moneda.Simbolo))
                            {
                                <span class="text-muted">
                                    - @moneda.Simbolo
                                </span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">
                                No disponible
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ============================================================
         RESUMEN ECONÓMICO
    ============================================================ -->

    <div class="card shadow-sm mb-4">

        <div class="card-header bg-light">

            <h5 class="mb-0">

                <i class="bi bi-calculator me-2"></i>

                Resumen de la factura

            </h5>

        </div>

        <div class="card-body">

            <div class="row">

                <!-- ==================================================
                     SUBTOTAL
                ================================================== -->

                <div class="col-md-3 mb-3">

                    <label class="text-muted">
                        Subtotal
                    </label>

                    <div class="fw-bold fs-5">

                        @Model.Subtotal.ToString("N2")

                    </div>

                </div>


                <!-- ==================================================
                     DESCUENTO
                ================================================== -->

                <div class="col-md-3 mb-3">

                    <label class="text-muted">
                        Descuento
                    </label>

                    <div class="fw-bold fs-5">

                        @Model.Descuento.ToString("N2")

                    </div>

                </div>


                <!-- ==================================================
                     IMPUESTO
                ================================================== -->

                <div class="col-md-3 mb-3">

                    <label class="text-muted">
                        Impuesto
                    </label>

                    <div class="fw-bold fs-5 text-primary">

                        @Model.Impuesto.ToString("N2")

                    </div>

                </div>


                <!-- ==================================================
                     TOTAL
                ================================================== -->

                <div class="col-md-3 mb-3">

                    <label class="text-muted">
                        Total
                    </label>

                    <div class="fw-bold fs-4 text-success">

                        @Model.Total.ToString("N2")

                    </div>

                </div>

            </div>


            <hr />


            <div class="row align-items-center">

                <!-- ==================================================
                     SALDO PENDIENTE
                ================================================== -->

                <div class="col-md-6">

                    <label class="text-muted">
                        Saldo pendiente
                    </label>

                    <div class="fw-bold fs-4
                        @(Model.SaldoPendiente > 0
                            ? "text-danger"
                            : "text-success")">

                        @Model.SaldoPendiente.ToString("N2")

                    </div>

                </div>


                <!-- ==================================================
                     ESTADO DE PAGO
                ================================================== -->

                <div class="col-md-6 text-md-end">

                    @if (Model.SaldoPendiente <= 0)
                    {
                        <span class="badge bg-success fs-6">

                            <i class="bi bi-check-circle me-1"></i>

                            Factura pagada

                        </span>
                    }
                    else if (Model.SaldoPendiente < Model.Total)
                    {
                        <span class="badge bg-warning text-dark fs-6">

                            <i class="bi bi-hourglass-split me-1"></i>

                            Pago parcial

                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger fs-6">

                            <i class="bi bi-clock me-1"></i>

                            Pendiente de pago

                        </span>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- ============================================================
         REGLAS DE ANULACIÓN
    ============================================================ -->

    <div class="card shadow-sm mb-4">

        <div class="card-header bg-warning text-dark">

            <h5 class="mb-0">

                <i class="bi bi-info-circle me-2"></i>

                Consideraciones antes de anular

            </h5>

        </div>

        <div class="card-body">

            <ul class="mb-0">

                <li class="mb-2">
                    La factura pasará al estado
                    <strong>Anulada</strong>.
                </li>

                <li class="mb-2">
                    Se registrará la fecha de anulación.
                </li>

                <li class="mb-2">
                    Se registrará el usuario que realizó la anulación.
                </li>

                <li class="mb-2">
                    Debe seleccionar un motivo de anulación activo.
                </li>

                <li class="mb-2">
                    Puede agregar una observación adicional.
                </li>

                <li>
                    <strong>
                        No se puede anular una factura que tenga pagos confirmados.
                    </strong>
                </li>

            </ul>

        </div>

    </div>


    <!-- ============================================================
         FORMULARIO DE ANULACIÓN
    ============================================================ -->

    <div class="card shadow-sm mb-4">

        <div class="card-header bg-danger text-white">

            <h5 class="mb-0">

                <i class="bi bi-x-octagon me-2"></i>

                Datos de anulación

            </h5>

        </div>

        <div class="card-body">

            <form asp-controller="Factura"
                  asp-action="Delete"
                  method="post"
                  id="formAnulacion">

                @Html.AntiForgeryToken()


                <!-- ==================================================
                     ID FACTURA
                ================================================== -->

                <input type="hidden"
                       name="id"
                       value="@Model.IdFactura" />


                <!-- ==================================================
                     MOTIVO
                ================================================== -->

                <div class="mb-4">

                    <label for="idMotivoAnulacion"
                           class="form-label fw-bold">

                        Motivo de anulación

                        <span class="text-danger">*</span>

                    </label>

                    <select id="idMotivoAnulacion"
                            name="idMotivoAnulacion"
                            class="form-select"
                            required>

                        <option value="0">
                            -- Seleccione un motivo --
                        </option>

                        @foreach (var motivo in motivosAnulacion)
                        {
                            <option value="@motivo.IdMotivoAnulacion">

                                @motivo.Nombre

                            </option>
                        }

                    </select>

                    <div class="form-text">

                        Seleccione el motivo que corresponde
                        a la anulación de esta factura.

                    </div>

                    <div id="errorMotivo"
                         class="text-danger mt-1 d-none">

                        Debe seleccionar un motivo de anulación.

                    </div>

                </div>


                <!-- ==================================================
                     OBSERVACIÓN
                ================================================== -->

                <div class="mb-4">

                    <label for="observacionAnulacion"
                           class="form-label fw-bold">

                        Observación de anulación

                    </label>

                    <textarea id="observacionAnulacion"
                              name="observacionAnulacion"
                              class="form-control"
                              rows="4"
                              maxlength="300"
                              placeholder="Ingrese una observación adicional, si es necesario..."></textarea>

                    <div class="d-flex justify-content-between">

                        <div class="form-text">

                            La observación es opcional.

                        </div>

                        <div class="form-text">

                            <span id="contadorCaracteres">
                                0
                            </span>
                            / 300

                        </div>

                    </div>

                </div>


                <!-- ==================================================
                     CONFIRMACIÓN
                ================================================== -->

                <div class="alert alert-warning">

                    <div class="form-check">

                        <input class="form-check-input"
                               type="checkbox"
                               id="confirmarAnulacion"
                               required />

                        <label class="form-check-label"
                               for="confirmarAnulacion">

                            Confirmo que deseo anular la factura

                            <strong>
                                @Model.NumeroFactura
                            </strong>

                            y comprendo que esta operación
                            quedará registrada en el historial.

                        </label>

                    </div>

                </div>


                <!-- ==================================================
                     BOTONES
                ================================================== -->

                <div class="d-flex justify-content-between align-items-center">

                    <a asp-controller="Factura"
                       asp-action="Details"
                       asp-route-id="@Model.IdFactura"
                       class="btn btn-secondary">

                        <i class="bi bi-arrow-left me-1"></i>

                        Cancelar

                    </a>


                    <button type="submit"
                            id="btnAnular"
                            class="btn btn-danger btn-lg">

                        <i class="bi bi-x-circle me-1"></i>

                        Anular factura

                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- ============================================================
         PIE INFORMATIVO
    ============================================================ -->

    <div class="text-muted small mb-4">

        <i class="bi bi-shield-check me-1"></i>

        La anulación será procesada por el sistema y registrada
        automáticamente en el historial de la factura.

    </div>

</div>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            const formulario =
                document.getElementById("formAnulacion");

            const motivo =
                document.getElementById("idMotivoAnulacion");

            const confirmacion =
                document.getElementById("confirmarAnulacion");

            const boton =
                document.getElementById("btnAnular");

            const observacion =
                document.getElementById("observacionAnulacion");

            const contador =
                document.getElementById("contadorCaracteres");

            const errorMotivo =
                document.getElementById("errorMotivo");


            /*
             * ========================================================
             * CONTADOR DE CARACTERES
             * ========================================================
             */

            function actualizarContador() {

                if (!observacion || !contador) {
                    return;
                }

                contador.textContent =
                    observacion.value.length;

            }


            if (observacion) {

                observacion.addEventListener(
                    "input",
                    actualizarContador
                );

            }


            actualizarContador();


            /*
             * ========================================================
             * VALIDAR FORMULARIO
             * ========================================================
             */

            if (formulario) {

                formulario.addEventListener(
                    "submit",
                    function(event) {

                        let valido = true;


                        /*
                         * ------------------------------------------------
                         * VALIDAR MOTIVO
                         * ------------------------------------------------
                         */

                        if (!motivo ||
                            !motivo.value ||
                            motivo.value === "0") {

                            valido = false;

                            if (errorMotivo) {

                                errorMotivo.classList.remove(
                                    "d-none"
                                );

                            }

                            if (motivo) {

                                motivo.classList.add(
                                    "is-invalid"
                                );

                            }

                        }
                        else {

                            if (errorMotivo) {

                                errorMotivo.classList.add(
                                    "d-none"
                                );

                            }

                            motivo.classList.remove(
                                "is-invalid"
                            );

                        }


                        /*
                         * ------------------------------------------------
                         * VALIDAR CONFIRMACIÓN
                         * ------------------------------------------------
                         */

                        if (!confirmacion ||
                            !confirmacion.checked) {

                            valido = false;

                        }


                        /*
                         * ------------------------------------------------
                         * CANCELAR ENVÍO SI HAY ERRORES
                         * ------------------------------------------------
                         */

                        if (!valido) {

                            event.preventDefault();

                            if (!confirmacion ||
                                !confirmacion.checked) {

                                alert(
                                    "Debe confirmar que desea anular la factura."
                                );

                            }

                            return;

                        }


                        /*
                         * ------------------------------------------------
                         * CONFIRMACIÓN FINAL
                         * ------------------------------------------------
                         */

                        const numeroFactura =
                            "@Html.Raw(
                                                                            System.Text.Encodings.Web.HtmlEncoder.Default.Encode(
                                                                                    Model.NumeroFactura ?? ""
                                                    )
                                                    )";


                        const confirmar =
                            window.confirm(
                                "¿Está seguro de anular la factura " +
                                numeroFactura +
                                "?\n\n" +
                                "Esta operación quedará registrada " +
                                "en el historial."
                            );


                        if (!confirmar) {

                            event.preventDefault();

                            return;

                        }


                        /*
                         * ------------------------------------------------
                         * EVITAR DOBLE ENVÍO
                         * ------------------------------------------------
                         */

                        if (boton) {

                            boton.disabled = true;

                            boton.innerHTML =
                                '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>' +
                                'Anulando factura...';

                        }

                    }
                );

            }


            /*
             * ========================================================
             * QUITAR ERROR DEL MOTIVO AL SELECCIONAR
             * ========================================================
             */

            if (motivo) {

                motivo.addEventListener(
                    "change",
                    function() {

                        if (motivo.value &&
                            motivo.value !== "0") {

                            motivo.classList.remove(
                                "is-invalid"
                            );

                            if (errorMotivo) {

                                errorMotivo.classList.add(
                                    "d-none"
                                );

                            }

                        }

                    }
                );

            }

        });

    </script>

}
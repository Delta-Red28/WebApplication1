@model WebApplication1.Models.Factura

@{
    ViewData["Title"] = "Detalle de factura";

    // ============================================================
    // HISTORIAL
    // ============================================================

    var historial =
        ViewBag.Historial as IEnumerable<WebApplication1.Models.HistorialFactura>
        ?? Enumerable.Empty<WebApplication1.Models.HistorialFactura>();


    // ============================================================
    // DATOS PRINCIPALES
    // ============================================================

    var pedido = Model.IdPedidoNavigation;
    var estado = Model.IdEstadoFacturaNavigation;
    var moneda = Model.IdMonedaNavigation;
    var tipoComprobante = Model.IdTipoComprobanteNavigation;
    var serie = Model.IdSerieFacturaNavigation;
    var impuesto = Model.IdImpuestoNavigation;
    var motivoAnulacion = Model.IdMotivoAnulacionNavigation;
    var usuarioAnulo = Model.IdUsuarioAnuloNavigation;


    // ============================================================
    // NOMBRES
    // ============================================================

    var estadoNombre = estado?.Nombre ?? "Sin estado";

    var monedaNombre = moneda?.Nombre ?? "Sin moneda";

    var monedaCodigo = moneda?.CodigoIso ?? "";

    var monedaSimbolo = moneda?.Simbolo ?? "";

    var impuestoNombre = impuesto?.Nombre ?? "Sin impuesto";

    var impuestoPorcentaje = impuesto?.Porcentaje ?? 0m;


    // ============================================================
    // CLASE Y COLOR DEL ESTADO
    // ============================================================

    var estadoClase = "bg-secondary";

    switch (Model.IdEstadoFactura)
    {
        case 1:
            estadoClase = "bg-warning text-dark";
            break;

        case 2:
            estadoClase = "bg-success";
            break;

        case 3:
            estadoClase = "bg-danger";
            break;

        case 4:
            estadoClase = "bg-info text-dark";
            break;
    }


    // ============================================================
    // ESTADO DE PAGO
    // ============================================================

    var estadoPagoTexto = "Pendiente de pago";
    var estadoPagoClase = "bg-danger";
    var estadoPagoIcono = "bi-clock";

    if (Model.IdEstadoFactura == 3)
    {
        estadoPagoTexto = "Factura anulada";
        estadoPagoClase = "bg-danger";
        estadoPagoIcono = "bi-x-circle";
    }
    else if (Model.IdEstadoFactura == 2 || Model.SaldoPendiente <= 0)
    {
        estadoPagoTexto = "Factura pagada";
        estadoPagoClase = "bg-success";
        estadoPagoIcono = "bi-check-circle";
    }
    else if (
        Model.IdEstadoFactura == 4 ||
        (Model.SaldoPendiente > 0 && Model.SaldoPendiente < Model.Total)
    )
    {
        estadoPagoTexto = "Pago parcial";
        estadoPagoClase = "bg-warning text-dark";
        estadoPagoIcono = "bi-hourglass-split";
    }


    // ============================================================
    // SALDO PAGADO
    // ============================================================

    decimal saldoPagado = Model.Total - Model.SaldoPendiente;

    if (saldoPagado < 0)
    {
        saldoPagado = 0;
    }

    if (saldoPagado > Model.Total)
    {
        saldoPagado = Model.Total;
    }


    // ============================================================
    // PORCENTAJE PAGADO
    // ============================================================

    decimal porcentajePagado = 0m;

    if (Model.Total > 0)
    {
        porcentajePagado = (saldoPagado / Model.Total) * 100m;
    }

    if (porcentajePagado < 0)
    {
        porcentajePagado = 0;
    }

    if (porcentajePagado > 100)
    {
        porcentajePagado = 100;
    }


    // ============================================================
    // VARIABLES PARA EVITAR EXPRESIONES COMPLEJAS EN HTML
    // ============================================================

    var porcentajePagadoTexto =
        porcentajePagado.ToString(
            System.Globalization.CultureInfo.InvariantCulture);

    var progresoStyle =
        $"width: {porcentajePagadoTexto}%;";

    var saldoPendienteClase =
        Model.SaldoPendiente <= 0
            ? "text-success"
            : "text-danger";


    // ============================================================
    // TEXTO DEL IMPUESTO
    // ============================================================

    var impuestoTexto = "Sin impuesto";

    if (impuesto != null)
    {
        impuestoTexto =
            $"{impuestoNombre} ({impuestoPorcentaje:N2}%)";
    }


    // ============================================================
    // CANTIDAD DE PAGOS
    // ============================================================

    var cantidadPagos = Model.Pagos?.Count ?? 0;


    // ============================================================
    // FECHA DE ANULACIÓN
    // ============================================================

    var fechaAnulacionTexto = "No registrada";

    if (Model.FechaAnulacion.HasValue)
    {
        fechaAnulacionTexto =
            Model.FechaAnulacion.Value.ToString("dd/MM/yyyy HH:mm");
    }
}


<div class="container-fluid">

    <!-- ========================================================= -->
    <!-- ENCABEZADO -->
    <!-- ========================================================= -->

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

        <div>

            <div class="d-flex align-items-center gap-2 mb-1">

                <a asp-action="Index"
                   class="btn btn-sm btn-outline-secondary"
                   title="Volver a facturas">

                    <i class="bi bi-arrow-left"></i>

                </a>

                <h2 class="mb-0">
                    Factura @Model.NumeroFactura
                </h2>

            </div>

            <p class="text-muted mb-0">
                Detalle de la factura y movimientos asociados.
            </p>

        </div>


        <!-- ===================================================== -->
        <!-- ACCIONES -->
        <!-- ===================================================== -->

        <div class="d-flex flex-wrap gap-2 mt-3 mt-md-0">

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-list me-1"></i>
                Facturas

            </a>


            <a asp-action="Historial"
               asp-route-id="@Model.IdFactura"
               class="btn btn-outline-primary">

                <i class="bi bi-clock-history me-1"></i>
                Historial

            </a>


            @if (Model.IdEstadoFactura != 3)
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.IdFactura"
                   class="btn btn-primary">

                    <i class="bi bi-pencil me-1"></i>
                    Editar

                </a>


                <a asp-action="Delete"
                   asp-route-id="@Model.IdFactura"
                   class="btn btn-outline-danger">

                    <i class="bi bi-x-circle me-1"></i>
                    Anular

                </a>
            }

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- MENSAJES -->
    <!-- ========================================================= -->

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-triangle me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ========================================================= -->
    <!-- AVISO DE FACTURA ANULADA -->
    <!-- ========================================================= -->

    @if (Model.IdEstadoFactura == 3)
    {
        <div class="alert alert-danger shadow-sm">

            <div class="d-flex align-items-start">

                <i class="bi bi-x-octagon-fill fs-3 me-3"></i>

                <div>

                    <h5 class="alert-heading mb-1">
                        Factura anulada
                    </h5>

                    <p class="mb-0">
                        Esta factura se encuentra anulada y no puede
                        ser modificada nuevamente.
                    </p>

                </div>

            </div>

        </div>
    }


    <!-- ========================================================= -->
    <!-- INFORMACIÓN PRINCIPAL -->
    <!-- ========================================================= -->

    <div class="row g-4">

        <!-- ===================================================== -->
        <!-- DATOS DE FACTURA -->
        <!-- ===================================================== -->

        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-white py-3">

                    <div class="d-flex justify-content-between align-items-center">

                        <h5 class="mb-0">

                            <i class="bi bi-file-earmark-text me-2"></i>
                            Información de la factura

                        </h5>

                        <span class="badge @estadoClase">
                            @estadoNombre
                        </span>

                    </div>

                </div>


                <div class="card-body">

                    <div class="row g-4">

                        <!-- NÚMERO -->

                        <div class="col-md-6">

                            <div class="text-muted small">
                                Número de factura
                            </div>

                            <div class="fw-semibold fs-5">
                                @Model.NumeroFactura
                            </div>

                        </div>


                        <!-- ID -->

                        <div class="col-md-6">

                            <div class="text-muted small">
                                ID de factura
                            </div>

                            <div class="fw-semibold">
                                #@Model.IdFactura
                            </div>

                        </div>


                        <!-- FECHA -->

                        <div class="col-md-6">

                            <div class="text-muted small">
                                Fecha de factura
                            </div>

                            <div class="fw-semibold">
                                @Model.FechaFactura.ToString("dd/MM/yyyy HH:mm")
                            </div>

                        </div>


                        <!-- PEDIDO -->

                        <div class="col-md-6">

                            <div class="text-muted small">
                                Pedido
                            </div>

                            @if (pedido != null)
                            {
                                <div class="fw-semibold">

                                    #@pedido.IdPedido

                                    @if (!string.IsNullOrWhiteSpace(pedido.NumeroPedido))
                                    {
                                        <span class="text-muted">
                                            (@pedido.NumeroPedido)
                                        </span>
                                    }

                                </div>

                                <div class="mt-1">

                                    <a asp-controller="Pedido"
                                       asp-action="Details"
                                       asp-route-id="@pedido.IdPedido"
                                       class="small text-decoration-none">

                                        Ver pedido
                                        <i class="bi bi-arrow-right"></i>

                                    </a>

                                </div>
                            }
                            else
                            {
                                <div class="text-muted">
                                    Pedido no disponible
                                </div>
                            }

                        </div>


                        <!-- TIPO COMPROBANTE -->

                        <div class="col-md-6">

                            <div class="text-muted small">
                                Tipo de comprobante
                            </div>

                            <div class="fw-semibold">

                                @if (tipoComprobante != null)
                                {
                                    @tipoComprobante.Nombre
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No especificado
                                    </span>
                                }

                            </div>

                        </div>


                        <!-- SERIE -->

                        <div class="col-md-6">

                            <div class="text-muted small">
                                Serie
                            </div>

                            @if (serie != null)
                            {
                                <div class="fw-semibold">
                                    @serie.Nombre
                                </div>

                                @if (!string.IsNullOrWhiteSpace(serie.Prefijo))
                                {
                                    <div class="small text-muted">
                                        Prefijo: @serie.Prefijo
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-muted">
                                    Serie no especificada
                                </div>
                            }

                        </div>


                        <!-- MONEDA -->

                        <div class="col-md-6">

                            <div class="text-muted small">
                                Moneda
                            </div>

                            <div class="fw-semibold">

                                @if (!string.IsNullOrWhiteSpace(monedaSimbolo))
                                {
                                    <span class="me-1">
                                        @monedaSimbolo
                                    </span>
                                }

                                @monedaNombre

                                @if (!string.IsNullOrWhiteSpace(monedaCodigo))
                                {
                                    <span class="text-muted">
                                        (@monedaCodigo)
                                    </span>
                                }

                            </div>

                        </div>


                        <!-- IMPUESTO -->

                        <div class="col-md-6">

                            <div class="text-muted small">
                                Impuesto / IVA
                            </div>

                            @if (impuesto != null)
                            {
                                <div class="fw-semibold">

                                    <i class="bi bi-percent text-primary me-1"></i>

                                    @impuesto.Nombre

                                </div>

                                <div class="small text-muted">

                                    Tasa aplicada:

                                    <strong>
                                        @impuesto.Porcentaje.ToString("N2")%
                                    </strong>

                                </div>
                            }
                            else
                            {
                                <div class="fw-semibold text-muted">
                                    Sin impuesto
                                </div>
                            }

                        </div>


                        <!-- TIPO DE CAMBIO -->

                        <div class="col-md-6">

                            <div class="text-muted small">
                                Tipo de cambio aplicado
                            </div>

                            @if (Model.TipoCambioAplicado.HasValue)
                            {
                                <div class="fw-semibold">
                                    @Model.TipoCambioAplicado.Value.ToString("N6")
                                </div>
                            }
                            else
                            {
                                <div class="text-muted">
                                    No especificado
                                </div>
                            }

                        </div>

                    </div>


                    <!-- OBSERVACIÓN -->

                    @if (!string.IsNullOrWhiteSpace(Model.Observacion))
                    {
                        <hr class="my-4" />

                        <div>

                            <div class="text-muted small mb-1">
                                Observación
                            </div>

                            <div class="p-3 bg-light rounded">
                                @Model.Observacion
                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- RESUMEN ECONÓMICO -->
        <!-- ===================================================== -->

        <div class="col-lg-4">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-white py-3">

                    <h5 class="mb-0">

                        <i class="bi bi-calculator me-2"></i>
                        Resumen de factura

                    </h5>

                </div>


                <div class="card-body">

                    <!-- SUBTOTAL -->

                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Subtotal
                        </span>

                        <span class="fw-semibold">
                            @monedaSimbolo @Model.Subtotal.ToString("N2")
                        </span>

                    </div>


                    <!-- DESCUENTO -->

                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Descuento
                        </span>

                        <span class="fw-semibold text-danger">
                            - @monedaSimbolo @Model.Descuento.ToString("N2")
                        </span>

                    </div>


                    <!-- IMPUESTO -->

                    <div class="d-flex justify-content-between align-items-start mb-3">

                        <div>

                            <div class="text-muted">
                                Impuesto / IVA
                            </div>

                            <div class="small text-muted">
                                @impuestoTexto
                            </div>

                        </div>

                        <span class="fw-semibold">
                            @monedaSimbolo @Model.Impuesto.ToString("N2")
                        </span>

                    </div>


                    <hr />


                    <!-- TOTAL -->

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <span class="fw-bold">
                            Total
                        </span>

                        <span class="fw-bold fs-4 text-primary">
                            @monedaSimbolo @Model.Total.ToString("N2")
                        </span>

                    </div>


                    <!-- SALDO PENDIENTE -->

                    <div class="d-flex justify-content-between align-items-center p-3 rounded bg-light">

                        <span class="fw-semibold">
                            Saldo pendiente
                        </span>

                        <span class="fw-bold @saldoPendienteClase">
                            @monedaSimbolo @Model.SaldoPendiente.ToString("N2")
                        </span>

                    </div>


                    <!-- PAGADO -->

                    <div class="d-flex justify-content-between mt-3">

                        <span class="text-muted">
                            Pagado
                        </span>

                        <span class="fw-semibold text-success">
                            @monedaSimbolo @saldoPagado.ToString("N2")
                        </span>

                    </div>


                    <!-- ESTADO DE PAGO -->

                    <div class="mt-3 text-center">

                        <span class="badge @estadoPagoClase">

                            <i class="bi @estadoPagoIcono me-1"></i>

                            @estadoPagoTexto

                        </span>

                    </div>


                    <!-- PROGRESO -->

                    <div class="mt-3">

                        <div class="d-flex justify-content-between mb-1">

                            <span class="small text-muted">
                                Progreso de pago
                            </span>

                            <span class="small fw-semibold">
                                @porcentajePagado.ToString("N1")%
                            </span>

                        </div>


                        <div class="progress"
                             role="progressbar"
                             aria-valuenow="@porcentajePagadoTexto"
                             aria-valuemin="0"
                             aria-valuemax="100"
                             style="height: 8px;">

                            <div class="progress-bar bg-success"
                                 style="@progresoStyle">
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- INFORMACIÓN DE ANULACIÓN -->
    <!-- ========================================================= -->

    @if (Model.IdEstadoFactura == 3)
    {
        <div class="card shadow-sm border-0 mt-4">

            <div class="card-header bg-danger text-white py-3">

                <h5 class="mb-0">

                    <i class="bi bi-x-octagon me-2"></i>
                    Información de anulación

                </h5>

            </div>


            <div class="card-body">

                <div class="row g-4">

                    <!-- FECHA -->

                    <div class="col-md-4">

                        <div class="text-muted small">
                            Fecha de anulación
                        </div>

                        <div class="fw-semibold">
                            @fechaAnulacionTexto
                        </div>

                    </div>


                    <!-- MOTIVO -->

                    <div class="col-md-4">

                        <div class="text-muted small">
                            Motivo
                        </div>

                        <div class="fw-semibold">

                            @if (motivoAnulacion != null)
                            {
                                @motivoAnulacion.Nombre
                            }
                            else
                            {
                                <span class="text-muted">
                                    No especificado
                                </span>
                            }

                        </div>

                    </div>


                    <!-- USUARIO -->

                    <div class="col-md-4">

                        <div class="text-muted small">
                            Usuario que anuló
                        </div>

                        @if (usuarioAnulo != null)
                        {
                            <div class="fw-semibold">

                                @usuarioAnulo.Nombres
                                @usuarioAnulo.Apellidos

                            </div>

                            @if (!string.IsNullOrWhiteSpace(usuarioAnulo.Usuario1))
                            {
                                <div class="small text-muted">
                                    @usuarioAnulo.Usuario1
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-muted">
                                No registrado
                            </div>
                        }

                    </div>


                    <!-- OBSERVACIÓN -->

                    @if (!string.IsNullOrWhiteSpace(Model.ObservacionAnulacion))
                    {
                        <div class="col-12">

                            <div class="text-muted small mb-1">
                                Observación de anulación
                            </div>

                            <div class="p-3 bg-light rounded">
                                @Model.ObservacionAnulacion
                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>
    }


    <!-- ========================================================= -->
    <!-- PAGOS -->
    <!-- ========================================================= -->

    <div class="card shadow-sm border-0 mt-4">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0">

                    <i class="bi bi-cash-coin me-2"></i>
                    Pagos

                </h5>

                <span class="badge bg-secondary">
                    @cantidadPagos
                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model.Pagos != null && Model.Pagos.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Fecha
                                </th>

                                <th>
                                    Método
                                </th>

                                <th>
                                    Moneda
                                </th>

                                <th>
                                    Estado
                                </th>

                                <th class="text-end">
                                    Monto
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (
                                var pago in Model.Pagos.OrderByDescending(p => p.FechaPago)
                            )
                            {
                                var estadoPagoNombre =
                                    pago.IdEstadoPagoNavigation?.Nombre
                                    ?? "Sin estado";

                                var claseEstadoPago =
                                    pago.IdEstadoPago == 2
                                        ? "bg-success"
                                        : "bg-secondary";

                                <tr>

                                    <!-- FECHA -->

                                    <td>
                                        @pago.FechaPago.ToString("dd/MM/yyyy HH:mm")
                                    </td>


                                    <!-- MÉTODO -->

                                    <td>

                                        @if (pago.IdMetodoPagoNavigation != null)
                                        {
                                            @pago.IdMetodoPagoNavigation.Nombre
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No especificado
                                            </span>
                                        }

                                    </td>


                                    <!-- MONEDA -->

                                    <td>

                                        @if (pago.IdMonedaNavigation != null)
                                        {
                                            @if (!string.IsNullOrWhiteSpace(
                                                pago.IdMonedaNavigation.CodigoIso))
                                            {
                                                @pago.IdMonedaNavigation.CodigoIso
                                            }
                                            else
                                            {
                                                @pago.IdMonedaNavigation.Nombre
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No especificada
                                            </span>
                                        }

                                    </td>


                                    <!-- ESTADO -->

                                    <td>

                                        <span class="badge @claseEstadoPago">
                                            @estadoPagoNombre
                                        </span>

                                    </td>


                                    <!-- MONTO -->

                                    <td class="text-end fw-semibold">

                                        @if (pago.IdMonedaNavigation != null)
                                        {
                                            @pago.IdMonedaNavigation.Simbolo
                                        }

                                        @pago.Monto.ToString("N2")

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-cash-stack fs-1 text-muted"></i>

                    <p class="text-muted mt-3 mb-0">
                        Esta factura todavía no tiene pagos registrados.
                    </p>

                </div>
            }

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- HISTORIAL -->
    <!-- ========================================================= -->

    <div class="card shadow-sm border-0 mt-4">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0">

                    <i class="bi bi-clock-history me-2"></i>
                    Historial reciente

                </h5>


                <a asp-action="Historial"
                   asp-route-id="@Model.IdFactura"
                   class="btn btn-sm btn-outline-primary">

                    <i class="bi bi-clock-history me-1"></i>
                    Ver historial completo

                </a>

            </div>

        </div>


        <div class="card-body p-0">

            @if (historial.Any())
            {
                <div class="list-group list-group-flush">

                    @foreach (var item in historial.Take(5))
                    {
                        <div class="list-group-item py-3">

                            <div class="d-flex justify-content-between align-items-start">

                                <div>

                                    <div class="fw-semibold">

                                        @if (item.IdEstadoFacturaNavigation != null)
                                        {
                                            @item.IdEstadoFacturaNavigation.Nombre
                                        }
                                        else
                                        {
                                            <span>
                                                Estado no disponible
                                            </span>
                                        }

                                    </div>


                                    @if (!string.IsNullOrWhiteSpace(item.Observacion))
                                    {
                                        <div class="text-muted small mt-1">
                                            @item.Observacion
                                        </div>
                                    }


                                    @if (item.IdUsuarioNavigation != null)
                                    {
                                        <div class="small text-muted mt-2">

                                            <i class="bi bi-person me-1"></i>

                                            @item.IdUsuarioNavigation.Nombres
                                            @item.IdUsuarioNavigation.Apellidos

                                            @if (!string.IsNullOrWhiteSpace(
                                                item.IdUsuarioNavigation.Usuario1))
                                            {
                                                <span class="ms-1">
                                                    (@item.IdUsuarioNavigation.Usuario1)
                                                </span>
                                            }

                                        </div>
                                    }

                                </div>


                                <div class="text-muted small text-nowrap ms-3">

                                    @item.Fecha.ToString("dd/MM/yyyy HH:mm")

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-clock-history fs-1 text-muted"></i>

                    <p class="text-muted mt-3 mb-0">
                        No hay movimientos registrados.
                    </p>

                </div>
            }

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- PIE -->
    <!-- ========================================================= -->

    <div class="d-flex flex-wrap justify-content-between align-items-center mt-4 mb-4">

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Volver a facturas

        </a>


        <div class="text-muted small mt-2 mt-md-0">
            ID factura: @Model.IdFactura
        </div>

    </div>

</div>